---
import ServiceDetail from '../../../components/pages/ServiceDetail.astro';
import { getServices, slugOf } from '../../../lib';
export async function getStaticPaths() {
  return (await getServices('en')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ServiceDetail lang="en" entry={entry} />