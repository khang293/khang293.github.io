---
import Base from '../../layouts/Base.astro';
import EntryItem from '../../components/EntryItem.astro';
import { getPosts, getJournal, getTags, tagSlug } from '../../lib';

export async function getStaticPaths() {
  const [posts, journal, tags] = await Promise.all([getPosts(), getJournal(), getTags()]);
  return [...tags.entries()].map(([slug, t]) => ({
    params: { tag: slug },
    props: {
      name: t.name,
      posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === slug)),
      journal: journal.filter((j) => j.data.tags.some((x) => tagSlug(x) === slug)),
    },
  }));
}
const { name, posts, journal } = Astro.props;
---
<Base title={`#${name}`}>
  <h1>#{name}</h1>
  {posts.length > 0 && <>
    <div class="section-title"><h2>Bài viết</h2></div>
    <ul class="list">
      {posts.map((p) => <EntryItem href={`/posts/${p.id}/`} title={p.data.title} date={p.data.date} description={p.data.description} tags={p.data.tags} />)}
    </ul>
  </>}
  {journal.length > 0 && <>
    <div class="section-title"><h2>Nhật ký</h2></div>
    <ul class="list timeline">
      {journal.map((j) => <EntryItem href={`/journal/${j.id}/`} title={j.data.title} date={j.data.date} tags={j.data.tags} />)}
    </ul>
  </>}
  <p><a href="/tags/">← Tất cả tags</a></p>
</Base>
