---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { ui, lp, type Lang } from '../../i18n';

interface Props { lang: Lang; entry: any; }
const { lang, entry } = Astro.props;
const t = ui[lang];
const d = entry.data;
const { Content } = await render(entry);
---
<Base lang={lang} title={d.title} description={d.summary}>
  <article class="article">
    <header>
      <div class="hero-ico">{d.icon}</div>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      {d.price && <p class="meta">{t.priceFrom}: <b>{d.price}</b></p>}
    </header>
    {d.features.length > 0 && (
      <section class="panel">
        <h2>{t.features}</h2>
        <ul class="ticks">{d.features.map((f: string) => <li>{f}</li>)}</ul>
      </section>
    )}
    <div class="prose"><Content /></div>
  </article>
  <p><a href={lp(lang, '/services/')}>{t.back}</a></p>
  <CtaBand lang={lang} />
</Base>
