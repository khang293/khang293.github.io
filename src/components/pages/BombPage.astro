---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const b = g.bomb;
const levels = ['easy', 'normal', 'hard'] as const;
const mapKeys = ['grass', 'desert', 'lava'] as const;
---
<Base lang={lang} title={b.title} description={b.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{b.title}</h1>
  <p class="meta">{b.sub}</p>

  <div id="bomb" data-ui={JSON.stringify(b)}>
    <div id="bm-menu">
      <h2 class="bm-h">{b.pickHero}</h2>
      <div class="bm-heroes">
        {b.heroes.map((h, i) => (
          <button class="bm-hero" type="button" data-hero={i} aria-pressed="false">
            <canvas width="96" height="100" aria-hidden="true"></canvas>
            <b>{h.name}</b><span>{h.desc}</span>
            <small class="bm-ultline">⚡ {h.ult.name}: {h.ult.desc}</small>
          </button>
        ))}
      </div>
      <h2 class="bm-h">{b.pickMap}</h2>
      <div class="bm-maps">
        {mapKeys.map((m) => (
          <button class="bm-map" type="button" data-map={m} aria-pressed="false">
            <i class={`bm-swatch bm-sw-${m}`} aria-hidden="true"></i>
            <b>{b.mapInfo[m].name}</b><span>{b.mapInfo[m].desc}</span>
          </button>
        ))}
      </div>
      <h2 class="bm-h">{b.pickLevel}</h2>
      <div class="bm-levels">
        {levels.map((lv) => (
          <button class={`bm-level bm-${lv}`} type="button" data-level={lv}>
            <b>{b.levels[lv]}</b><span>{b.levelDesc[lv]}</span>
            <em class="bm-stat" data-stat={lv}></em>
          </button>
        ))}
      </div>
      <p class="meta">{b.keys}</p>
      <p class="meta">{b.ultHint}</p>
      <p class="meta">{b.items}</p>
    </div>

    <div id="bm-game" hidden>
      <div class="bm-hud">
        <span>🤖 {b.botsLeft}: <b id="bm-bots">0</b></span>
        <span id="bm-stats">💣 1 · 🔥 1 · 👟 1</span>
        <span id="bm-ult-st">⚡</span>
        <span>⏱ <b id="bm-time">0</b> {b.s}</span>
      </div>
      <canvas id="bm-canvas" width="720" height="624" aria-label={b.title}></canvas>
      <div class="bm-pad" aria-hidden="false">
        <div class="joy" id="bm-joy" role="application" aria-label="Joystick"></div>
        <div class="bm-btns">
          <button type="button" class="bm-ult" id="bm-ult">⚡ {b.ultLabel}</button>
          <button type="button" class="bm-drop" id="bm-drop">💣 {b.bombBtn}</button>
        </div>
      </div>
      <div id="bm-result" class="bm-result" hidden>
        <div class="bm-big" id="bm-msg"></div>
        <p id="bm-sub" class="meta"></p>
        <p id="bm-rec" class="meta"></p>
        <div class="bm-actions">
          <button type="button" class="btn" id="bm-again">{b.again}</button>
          <button type="button" class="btn ghost" id="bm-change">{b.change}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { paintHero, type Look, type G } from '../../data/heroArt';
  import { createJoystick } from '../../data/joystick';

  const root = document.getElementById('bomb') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('bm-menu') as HTMLElement;
  const gameEl = document.getElementById('bm-game') as HTMLElement;
  const canvas = document.getElementById('bm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const elBots = document.getElementById('bm-bots')!;
  const elTime = document.getElementById('bm-time')!;
  const elStats = document.getElementById('bm-stats')!;
  const resultEl = document.getElementById('bm-result') as HTMLElement;

  const W = 15, H = 13, C = 48;
  const FUSE = 2.2, FLAME = 0.55;
  const DIRS = { up: { x: 0, y: -1 }, down: { x: 0, y: 1 }, left: { x: -1, y: 0 }, right: { x: 1, y: 0 } };
  type Dir = { x: number; y: number };
  type Item = 'B' | 'R' | 'S';
  interface Actor {
    skin: number; human: boolean; alive: boolean; die: number; fx: number; fy: number;
    gx: number; gy: number; tx: number; ty: number; p: number; moving: boolean;
    maxBombs: number; range: number; speed: number; wait: number; fuse: number; tp: number; shield: number; stealth: number;
  }
  interface Bomb { gx: number; gy: number; t: number; range: number; owner: Actor }
  // brick: tỉ lệ ô trống được lấp bằng gạch (càng cao càng chật)
  // Độ thông minh của bot: aggr = hay đặt bom phá gạch, kill = đặt bom khi người chơi nằm trong tầm,
  // hunt = đuổi theo người chơi, item = đi nhặt vật phẩm, think = thời gian đứng nghĩ khi hết việc
  const LEVELS: Record<string, { bots: number; speed: number; aggr: number; think: number; brick: number; kill: number; hunt: number; item: number }> = {
    easy: { bots: 2, speed: 2.2, aggr: 0.3, think: 0.45, brick: 0.6, kill: 0.5, hunt: 0.3, item: 0.4 },
    normal: { bots: 3, speed: 2.7, aggr: 0.6, think: 0.2, brick: 0.78, kill: 0.85, hunt: 0.65, item: 0.7 },
    hard: { bots: 3, speed: 3.2, aggr: 0.9, think: 0.05, brick: 0.88, kill: 1, hunt: 0.95, item: 1 },
  };
  // Ba bản đồ, mỗi bản có một cơ chế riêng: grass = cổng dịch chuyển, desert = cát lún, lava = miệng phun lửa
  const MAPS = ['grass', 'desert', 'lava'];
  let mapKey = 'grass';
  try { const m = localStorage.getItem('bomb-map'); if (m && MAPS.includes(m)) mapKey = m; } catch {}
  const BASE_SPEED = 3.2; // ô mỗi giây của người chơi lúc đầu
  // Chỉ số khởi đầu của 4 nhân vật: Hiệp sĩ, Pháp sư, Cung thủ, Nhẫn giả
  const HEROES = [
    { speed: 2.8, range: 2, bombs: 1, fuse: FUSE },
    { speed: 3.0, range: 1, bombs: 2, fuse: FUSE },
    { speed: 3.8, range: 1, bombs: 1, fuse: FUSE },
    { speed: 3.3, range: 1, bombs: 1, fuse: 1.6 },
  ];
  let hero = 0;
  try { const h = Number(localStorage.getItem('bomb-hero')); if (h >= 0 && h < HEROES.length) hero = h; } catch {}
  const key = (x: number, y: number) => y * W + x;
  // Số ô một nhân vật chạy được trước khi bom nổ, dùng để bot không đặt bom khi không kịp thoát
  const escapeDepth = (speed: number) => Math.max(3, Math.floor(speed * FUSE * 0.7));

  // Trạng thái ván chơi
  let level = 'normal';
  let grid: number[][] = []; // 0 trống, 1 tường cứng, 2 gạch
  let actors: Actor[] = [];
  let player: Actor;
  let bombs: Bomb[] = [];
  let fire = new Map<number, number>();
  let items = new Map<number, Item>();
  let time = 0;
  let over = false;
  let overTimer = 0;
  let outcome = '';
  let running = false;
  let last = 0;
  let raf = 0;
  const dirStack: Dir[] = [];
  let wantBomb = false;
  interface Particle { x: number; y: number; vx: number; vy: number; g: number; life: number; max: number; size: number; color: string }
  let particles: Particle[] = [];
  let shake = 0;
  let portals: [number, number][] = [];
  let sand = new Set<number>();
  let vents: { x: number; y: number; t: number }[] = [];
  // Tuyệt chiêu: mỗi ván dùng một lần
  let ultUsed = false;
  let wantUlt = false;
  let meteors: { x: number; y: number; t: number; max: number }[] = [];
  let beams: { sx: number; sy: number; ex: number; ey: number; t: number }[] = [];
  let banner: { text: string; t: number } | null = null;

  // Đặt cơ chế riêng của bản đồ, tránh vùng xuất phát. Ô được đặt luôn là ô trống đi được.
  function placeHazards(spawns: [number, number][]) {
    portals = []; sand = new Set(); vents = [];
    const taken = new Set<number>();
    const pick = (x0: number, x1: number, y0: number, y1: number): [number, number] | null => {
      for (let n = 0; n < 80; n++) {
        const x = x0 + Math.floor(Math.random() * (x1 - x0 + 1)), y = y0 + Math.floor(Math.random() * (y1 - y0 + 1));
        const far = spawns.every(([sx, sy]) => Math.abs(x - sx) + Math.abs(y - sy) > 3);
        if (grid[y][x] !== 1 && far && !taken.has(key(x, y))) { taken.add(key(x, y)); grid[y][x] = 0; return [x, y]; }
      }
      return null;
    };
    if (mapKey === 'grass') {
      const a = pick(2, 5, 1, H - 2), b = pick(W - 6, W - 3, 1, H - 2);
      if (a && b) portals = [a, b];
    } else if (mapKey === 'desert') {
      for (let i = 0; i < 10; i++) { const c = pick(1, W - 2, 1, H - 2); if (c) sand.add(key(c[0], c[1])); }
    } else {
      [[2, 6, 1, 5], [8, 12, 1, 5], [2, 6, 7, 11], [8, 12, 7, 11]].forEach((q, i) => {
        const c = pick(q[0], q[1], q[2], q[3]);
        if (c) vents.push({ x: c[0], y: c[1], t: 5 + i * 1.5 });
      });
    }
  }

  // Các ô miệng phun lửa sẽ phun tới: chính nó và 4 ô liền kề đi được
  function ventCells(v: { x: number; y: number }): number[] {
    return [[0, 0], [1, 0], [-1, 0], [0, 1], [0, -1]]
      .map(([dx, dy]) => [v.x + dx, v.y + dy])
      .filter(([x, y]) => inBounds(x, y) && grid[y][x] === 0)
      .map(([x, y]) => key(x, y));
  }

  function spark(cx: number, cy: number, n: number, colors: string[], speed: number, g: number) {
    for (let i = 0; i < n; i++) {
      const ang = Math.random() * Math.PI * 2, v = speed * (0.4 + Math.random() * 0.8);
      const life = 0.35 + Math.random() * 0.4;
      particles.push({ x: cx, y: cy, vx: Math.cos(ang) * v, vy: Math.sin(ang) * v, g, life, max: life, size: 3 + Math.random() * 4, color: colors[Math.floor(Math.random() * colors.length)] });
    }
  }

  function makeActor(x: number, y: number, skin: number, human: boolean, speed: number): Actor {
    return { skin, human, alive: true, die: 0.5, fx: 0, fy: 1, gx: x, gy: y, tx: x, ty: y, p: 0, moving: false, maxBombs: 1, range: 1, speed, wait: 0.5, fuse: FUSE, tp: 0, shield: 0, stealth: 0 };
  }

  function start(lv: string) {
    level = lv;
    const cfg = LEVELS[lv];
    const spawns: [number, number][] = [[1, 1], [W - 2, 1], [1, H - 2], [W - 2, H - 2]];
    const botSpawns = cfg.bots === 2 ? [spawns[3], spawns[1]] : spawns.slice(1);
    grid = [];
    for (let y = 0; y < H; y++) {
      const row: number[] = [];
      for (let x = 0; x < W; x++) {
        if (x === 0 || y === 0 || x === W - 1 || y === H - 1 || (x % 2 === 0 && y % 2 === 0)) row.push(1);
        else {
          const nearSpawn = spawns.some(([sx, sy]) => Math.abs(x - sx) + Math.abs(y - sy) <= 2);
          row.push(!nearSpawn && Math.random() < cfg.brick ? 2 : 0);
        }
      }
      grid.push(row);
    }
    placeHazards(spawns);
    ultUsed = false; wantUlt = false; meteors = []; beams = []; banner = null;
    updateUltUi();
    const hs = HEROES[hero];
    player = makeActor(spawns[0][0], spawns[0][1], hero, true, hs.speed);
    player.range = hs.range; player.maxBombs = hs.bombs; player.fuse = hs.fuse;
    actors = [player, ...botSpawns.map(([x, y], i) => makeActor(x, y, i + 4, false, cfg.speed))];
    bombs = [];
    particles = [];
    shake = 0;
    bgDirty = true;
    canvas.style.borderColor = THEMES[mapKey].border;
    canvas.style.backgroundColor = THEMES[mapKey].border;
    fire = new Map();
    items = new Map();
    time = 0; over = false; overTimer = 0; outcome = '';
    dirStack.length = 0; wantBomb = false;
    resultEl.hidden = true;
    menu.hidden = true;
    gameEl.hidden = false;
    running = true;
    last = performance.now();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(frame);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(raf);
  }

  const inBounds = (x: number, y: number) => x >= 0 && y >= 0 && x < W && y < H;
  const bombAt = (x: number, y: number) => bombs.find((b) => b.gx === x && b.gy === y);
  const canWalk = (x: number, y: number) => inBounds(x, y) && grid[y][x] === 0 && !bombAt(x, y);
  const cellOf = (a: Actor): [number, number] => (a.moving && a.p >= 0.5 ? [a.tx, a.ty] : [a.gx, a.gy]);

  // Các ô bị ảnh hưởng khi một quả bom nổ (dừng ở tường, tính cả viên gạch đầu tiên)
  function blast(gx: number, gy: number, range: number): number[] {
    const cells = [key(gx, gy)];
    for (const d of Object.values(DIRS)) {
      for (let i = 1; i <= range; i++) {
        const x = gx + d.x * i, y = gy + d.y * i;
        if (!inBounds(x, y) || grid[y][x] === 1) break;
        cells.push(key(x, y));
        if (grid[y][x] === 2) break;
        if (bombAt(x, y)) break;
      }
    }
    return cells;
  }

  function placeBomb(a: Actor): boolean {
    const [x, y] = cellOf(a);
    if (bombAt(x, y)) return false;
    if (bombs.filter((b) => b.owner === a).length >= a.maxBombs) return false;
    bombs.push({ gx: x, gy: y, t: a.fuse, range: a.range, owner: a });
    return true;
  }

  function explode(b: Bomb) {
    bombs.splice(bombs.indexOf(b), 1);
    explodeAt(b.gx, b.gy, b.range);
  }

  // Vụ nổ hình chữ thập tại một ô, dùng cho bom lẫn thiên thạch
  function explodeAt(gx: number, gy: number, range: number) {
    const fresh: [number, Item][] = [];
    const burn = (x: number, y: number) => {
      const k = key(x, y);
      fire.set(k, FLAME);
      items.delete(k);
      spark(x * C + C / 2, y * C + C / 2, 3, ['#fde047', '#fb923c', '#ffffff'], 130, 0);
      const other = bombAt(x, y);
      if (other) other.t = 0; // nổ dây chuyền
    };
    burn(gx, gy);
    for (const d of Object.values(DIRS)) {
      for (let i = 1; i <= range; i++) {
        const x = gx + d.x * i, y = gy + d.y * i;
        if (!inBounds(x, y) || grid[y][x] === 1) break;
        burn(x, y);
        if (grid[y][x] === 2) {
          grid[y][x] = 0;
          bgDirty = true;
          spark(x * C + C / 2, y * C + C / 2, 8, ['#b45309', '#f59e0b', '#7c2d12'], 150, 420);
          if (Math.random() < 0.35) fresh.push([key(x, y), (['B', 'R', 'S'] as Item[])[Math.floor(Math.random() * 3)]]);
          break;
        }
        if (bombAt(x, y)) break;
      }
    }
    fresh.forEach(([k, it]) => items.set(k, it));
    shake = Math.max(shake, 0.22);
  }

  // Ô nguy hiểm: đang cháy hoặc sắp bị bom nổ tới
  function dangerSet(extra?: Bomb): Set<number> {
    const s = new Set<number>(fire.keys());
    for (const b of bombs) blast(b.gx, b.gy, b.range).forEach((k) => s.add(k));
    if (extra) blast(extra.gx, extra.gy, extra.range).forEach((k) => s.add(k));
    for (const v of vents) if (v.t < 1.6) ventCells(v).forEach((k) => s.add(k));
    for (const m of meteors) ventCells(m).forEach((k) => s.add(k));
    return s;
  }

  // Tìm bước đi đầu tiên tới ô đích gần nhất (BFS). avoid: các ô không được đi vào.
  function bfsStep(a: Actor, goal: (x: number, y: number) => boolean, avoid: Set<number>, depth: number, extra?: Bomb): Dir | null {
    const sx = a.gx, sy = a.gy;
    const seen = new Set<number>([key(sx, sy)]);
    let frontier: { x: number; y: number; first: Dir | null }[] = [{ x: sx, y: sy, first: null }];
    for (let step = 0; step < depth; step++) {
      const nextF: typeof frontier = [];
      for (const n of frontier) {
        for (const d of Object.values(DIRS)) {
          const x = n.x + d.x, y = n.y + d.y;
          const k = key(x, y);
          if (seen.has(k) || !inBounds(x, y) || grid[y][x] !== 0) continue;
          if (bombAt(x, y) || (extra && extra.gx === x && extra.gy === y)) continue;
          if (avoid.has(k) && !goal(x, y)) continue;
          seen.add(k);
          const first = n.first || d;
          if (goal(x, y)) return first;
          nextF.push({ x, y, first });
        }
      }
      frontier = nextF;
      if (!frontier.length) break;
    }
    return null;
  }

  // Các ô người chơi đang đứng hoặc sắp bước tới. Rỗng khi người chơi chết hoặc đang ẩn thân.
  function playerCells(): [number, number][] {
    if (!player.alive || player.stealth > 0) return [];
    const c: [number, number][] = [cellOf(player)];
    if (player.moving) c.push([player.tx, player.ty]);
    return c;
  }

  // Bom đặt tại (x, y) với tầm range có nổ trúng (tx, ty) không (không có gì chắn giữa)
  function lineHit(x: number, y: number, range: number, tx: number, ty: number): boolean {
    if (x !== tx && y !== ty) return false;
    const d = Math.abs(x - tx) + Math.abs(y - ty);
    if (d > range) return false;
    const sx = Math.sign(tx - x), sy = Math.sign(ty - y);
    for (let i = 1; i < d; i++) if (grid[y + sy * i][x + sx * i] !== 0) return false;
    return true;
  }

  function wantsToBomb(a: Actor, cfg: (typeof LEVELS)[string]): boolean {
    if (a.wait > 0) return false;
    if (bombs.filter((b) => b.owner === a).length >= a.maxBombs) return false;
    const hitPlayer = playerCells().some(([tx, ty]) => lineHit(a.gx, a.gy, a.range, tx, ty));
    let hitBrick = false;
    for (const d of Object.values(DIRS)) {
      for (let i = 1; i <= a.range; i++) {
        const x = a.gx + d.x * i, y = a.gy + d.y * i;
        if (!inBounds(x, y) || grid[y][x] === 1) break;
        if (grid[y][x] === 2) { hitBrick = true; break; }
      }
    }
    if (!hitPlayer && !hitBrick) return false;
    if (Math.random() > (hitPlayer ? cfg.kill : cfg.aggr)) return false;
    // Chỉ đặt bom khi còn đường thoát
    const fake: Bomb = { gx: a.gx, gy: a.gy, t: a.fuse, range: a.range, owner: a };
    const danger = dangerSet(fake);
    return !!bfsStep(a, (x, y) => !danger.has(key(x, y)), new Set(fire.keys()), escapeDepth(a.speed), fake);
  }

  function botThink(a: Actor): Dir | null {
    const cfg = LEVELS[level];
    let danger = dangerSet();
    const hot = new Set(fire.keys());
    // 1. Đang ở ô nguy hiểm thì chạy
    if (danger.has(key(a.gx, a.gy))) {
      return bfsStep(a, (x, y) => !danger.has(key(x, y)), hot, 12);
    }
    // 2. Đặt bom nếu trúng gạch hoặc người chơi và còn đường thoát, rồi chạy ngay
    if (wantsToBomb(a, cfg) && placeBomb(a)) {
      danger = dangerSet();
      return bfsStep(a, (x, y) => !danger.has(key(x, y)), hot, 12);
    }
    if (a.wait > 0) return null;
    // Khi đi bình thường: tránh vùng nguy hiểm và tránh cát lún
    const avoid = new Set(danger);
    sand.forEach((k) => avoid.add(k));
    // 3. Nhặt vật phẩm
    if (items.size && Math.random() < cfg.item) {
      const s = bfsStep(a, (x, y) => items.has(key(x, y)), avoid, 14);
      if (s) return s;
    }
    // 4. Săn người chơi: đi tới ô mà bom đặt xuống sẽ trúng người chơi
    const targets = playerCells();
    if (targets.length && Math.random() < cfg.hunt) {
      const s = bfsStep(a, (x, y) => targets.some(([tx, ty]) => lineHit(x, y, a.range, tx, ty)), avoid, 30);
      if (s) return s;
    }
    // 5. Đi tới gần gạch để phá
    const nearBrick = (x: number, y: number) => Object.values(DIRS).some((d) => inBounds(x + d.x, y + d.y) && grid[y + d.y][x + d.x] === 2);
    let step = bfsStep(a, nearBrick, avoid, 30);
    if (!step) {
      const opts = Object.values(DIRS).filter((d) => canWalk(a.gx + d.x, a.gy + d.y) && !danger.has(key(a.gx + d.x, a.gy + d.y)));
      step = opts.length ? opts[Math.floor(Math.random() * opts.length)] : null;
    }
    if (!step) a.wait = cfg.think;
    return step;
  }

  // Tuyệt chiêu của từng nhân vật, dùng được một lần mỗi ván
  function updateUltUi() {
    const st = document.getElementById('bm-ult-st')!;
    const btn = document.getElementById('bm-ult') as HTMLButtonElement;
    const name = ui.heroes[hero].ult.name;
    st.textContent = ultUsed ? '⚡ ' + ui.ultUsed : '⚡ Q · ' + name;
    st.classList.toggle('used', ultUsed);
    btn.disabled = ultUsed;
    btn.textContent = '⚡ ' + (ultUsed ? ui.ultUsed : name);
  }

  function castUlt() {
    if (ultUsed || !player.alive || over) return;
    const pc = cellOf(player);
    if (hero === 2) { // Xạ tiễn xuyên
      let dx = player.fx, dy = player.fy;
      if (!dx && !dy) dy = 1;
      const cells: [number, number][] = [];
      for (let x = pc[0] + dx, y = pc[1] + dy; inBounds(x, y) && grid[y][x] !== 1; x += dx, y += dy) cells.push([x, y]);
      if (!cells.length) return; // đang đứng sát tường thì chưa tiêu tuyệt chiêu
      for (const [x, y] of cells) {
        if (grid[y][x] === 2) {
          grid[y][x] = 0; bgDirty = true;
          spark(x * C + C / 2, y * C + C / 2, 8, ['#b45309', '#f59e0b', '#7c2d12'], 150, 420);
        }
        for (const a of actors) {
          if (a.human || !a.alive) continue;
          const [ax, ay] = cellOf(a);
          if (ax === x && ay === y) a.alive = false;
        }
        const bm = bombAt(x, y);
        if (bm) bm.t = 0;
      }
      const last = cells[cells.length - 1];
      beams.push({ sx: pc[0], sy: pc[1], ex: last[0], ey: last[1], t: 0.45 });
      shake = Math.max(shake, 0.12);
    } else if (hero === 0) { // Khiên thần
      player.shield = 4;
    } else if (hero === 1) { // Mưa thiên thạch: nhắm quanh các bot, tránh xa người chơi
      const used = new Set<number>();
      const add = (x: number, y: number, t: number) => {
        const k = key(x, y);
        if (!inBounds(x, y) || grid[y][x] !== 0 || used.has(k)) return;
        if (Math.abs(x - pc[0]) + Math.abs(y - pc[1]) <= 2) return;
        used.add(k);
        meteors.push({ x, y, t, max: t });
      };
      for (const b of actors.filter((a) => !a.human && a.alive)) {
        const [bx, by] = cellOf(b);
        const d = Object.values(DIRS)[Math.floor(Math.random() * 4)];
        add(bx, by, 1.0); add(b.tx, b.ty, 1.1); add(bx + d.x, by + d.y, 0.9);
      }
      for (let n = 0; n < 40 && meteors.length < 9; n++) add(1 + Math.floor(Math.random() * (W - 2)), 1 + Math.floor(Math.random() * (H - 2)), 0.8 + Math.random() * 0.5);
    } else { // Ẩn thân
      player.stealth = 5;
    }
    ultUsed = true;
    banner = { text: ui.heroes[hero].ult.name, t: 1.6 };
    updateUltUi();
  }

  function humanDir(): Dir | null {
    return dirStack.length ? dirStack[dirStack.length - 1] : null;
  }

  function pickup(a: Actor) {
    const k = key(a.gx, a.gy);
    const it = items.get(k);
    if (!it) return;
    items.delete(k);
    if (it === 'B') a.maxBombs = Math.min(a.maxBombs + 1, 5);
    if (it === 'R') a.range = Math.min(a.range + 1, 6);
    if (it === 'S') a.speed = Math.min(a.speed + 0.4, a.human ? 5 : 4);
  }

  // Cổng dịch chuyển: bước vào một cổng thì xuất hiện ở cổng còn lại
  function teleport(a: Actor) {
    if (a.tp > 0 || portals.length < 2) return;
    const i = portals.findIndex(([x, y]) => x === a.gx && y === a.gy);
    if (i < 0) return;
    const [nx, ny] = portals[1 - i];
    if (bombAt(nx, ny)) return;
    const cols = ['#38bdf8', '#f472b6', '#ffffff'];
    spark(a.gx * C + C / 2, a.gy * C + C / 2, 8, cols, 120, 0);
    a.gx = a.tx = nx; a.gy = a.ty = ny; a.p = 0;
    spark(nx * C + C / 2, ny * C + C / 2, 8, cols, 120, 0);
    a.tp = 1.2;
  }

  // Cát lún làm chậm nhân vật khi đang bước vào ô đó
  const speedOf = (a: Actor) => a.speed * (a.moving && sand.has(key(a.tx, a.ty)) ? 0.5 : 1) * (a.stealth > 0 ? 1.4 : 1);

  function updateActor(a: Actor, dt: number) {
    if (!a.alive) return;
    a.wait = Math.max(0, a.wait - dt);
    a.tp = Math.max(0, a.tp - dt);
    let left = dt;
    for (let guard = 0; guard < 3 && left > 0; guard++) {
      if (a.moving) {
        const sp = speedOf(a);
        const need = (1 - a.p) / sp;
        if (left < need) { a.p += left * sp; return; }
        left -= need;
        a.gx = a.tx; a.gy = a.ty; a.p = 0; a.moving = false;
        pickup(a);
        teleport(a);
      }
      const d = a.human ? humanDir() : botThink(a);
      if (d) { a.fx = d.x; a.fy = d.y; }
      if (!d || !canWalk(a.gx + d.x, a.gy + d.y)) return;
      a.tx = a.gx + d.x; a.ty = a.gy + d.y; a.p = 0; a.moving = true;
    }
  }

  function update(dt: number) {
    time += dt;
    if (wantBomb) { if (player.alive) placeBomb(player); wantBomb = false; }
    if (wantUlt) { wantUlt = false; castUlt(); }
    player.shield = Math.max(0, player.shield - dt);
    player.stealth = Math.max(0, player.stealth - dt);
    for (const m of meteors) m.t -= dt;
    const landed = meteors.filter((m) => m.t <= 0);
    if (landed.length) {
      meteors = meteors.filter((m) => m.t > 0);
      landed.forEach((m) => explodeAt(m.x, m.y, 1));
      shake = Math.max(shake, 0.3);
    }
    for (const b of beams) b.t -= dt;
    beams = beams.filter((b) => b.t > 0);
    if (banner) { banner.t -= dt; if (banner.t <= 0) banner = null; }
    for (const [k, t] of fire) {
      if (t - dt <= 0) fire.delete(k); else fire.set(k, t - dt);
    }
    for (const v of vents) {
      v.t -= dt;
      if (v.t > 0) continue;
      v.t = 6 + Math.random() * 2;
      for (const k of ventCells(v)) {
        const x = k % W, y = Math.floor(k / W);
        fire.set(k, FLAME + 0.2);
        items.delete(k);
        spark(x * C + C / 2, y * C + C / 2, 4, ['#fde047', '#fb923c', '#ef4444'], 140, 0);
        const other = bombAt(x, y);
        if (other) other.t = 0;
      }
      shake = Math.max(shake, 0.15);
    }
    for (const b of bombs) b.t -= dt;
    let due: Bomb | undefined;
    while ((due = bombs.find((b) => b.t <= 0))) explode(due);
    actors.forEach((a) => updateActor(a, dt));
    for (const a of actors) {
      if (!a.alive) continue;
      const [x, y] = cellOf(a);
      if (fire.has(key(x, y)) && a.shield <= 0) a.alive = false;
    }
    for (const a of actors) if (!a.alive && a.die > 0) a.die -= dt;
    shake = Math.max(0, shake - dt);
    for (const p of particles) { p.life -= dt; p.x += p.vx * dt; p.y += p.vy * dt; p.vy += p.g * dt; }
    particles = particles.filter((p) => p.life > 0);
    if (!over) {
      const botsAlive = actors.filter((a) => !a.human && a.alive).length;
      if (!player.alive || botsAlive === 0) {
        over = true;
        overTimer = 0.9;
        outcome = !player.alive ? (botsAlive === 0 ? 'draw' : 'lose') : 'win';
      }
    } else {
      overTimer -= dt;
      if (overTimer <= 0) finish();
    }
  }

  // Thành tích theo độ khó, lưu trên máy người chơi
  interface Stat { played: number; won: number; streak: number; bestStreak: number; bestTime: number | null }
  const EMPTY: Stat = { played: 0, won: 0, streak: 0, bestStreak: 0, bestTime: null };
  function loadStats(): Record<string, Stat> {
    try { return JSON.parse(localStorage.getItem('bomb-stats') || '{}'); } catch { return {}; }
  }
  function statOf(lv: string): Stat { return { ...EMPTY, ...loadStats()[lv] }; }
  function recordResult(lv: string, res: string, secs: number): Stat {
    const all = loadStats();
    const s = { ...EMPTY, ...all[lv] };
    s.played++;
    if (res === 'win') {
      s.won++; s.streak++;
      s.bestStreak = Math.max(s.bestStreak, s.streak);
      s.bestTime = s.bestTime === null ? secs : Math.min(s.bestTime, secs);
    } else s.streak = 0;
    all[lv] = s;
    try { localStorage.setItem('bomb-stats', JSON.stringify(all)); } catch {}
    return s;
  }
  const statLine = (s: Stat) => s.played
    ? ui.statWins + ' ' + s.won + '/' + s.played + ' · ' + ui.statStreak + ' ' + s.streak + ' (' + ui.statBest + ' ' + s.bestStreak + ')'
    : '';
  function renderStats() {
    document.querySelectorAll<HTMLElement>('.bm-stat').forEach((el) => { el.textContent = statLine(statOf(el.dataset.stat || '')); });
  }

  function finish() {
    running = false;
    resultEl.hidden = false;
    const msg = document.getElementById('bm-msg')!;
    const sub = document.getElementById('bm-sub')!;
    const rec = document.getElementById('bm-rec')!;
    msg.textContent = ui[outcome];
    msg.className = 'bm-big ' + outcome;
    const secs = Math.round(time);
    const before = statOf(level);
    const s = recordResult(level, outcome, secs);
    sub.textContent = outcome === 'win' ? ui.winTime + ' ' + secs + ' ' + ui.s : '';
    const parts = [statLine(s)];
    if (s.bestTime !== null) parts.push(ui.statFastest + ' ' + s.bestTime + ' ' + ui.s);
    if (outcome === 'win' && s.streak > 1 && s.streak > before.bestStreak) parts.push(ui.statNew);
    rec.textContent = parts.join(' · ');
  }

  // Vẽ
  const FONT = 'system-ui, "Segoe UI Emoji", "Apple Color Emoji", sans-serif';
  const bg = document.createElement('canvas');
  bg.width = W * C; bg.height = H * C;
  const bgx = bg.getContext('2d')!;
  let bgDirty = true;

  // Ba bản đồ, mỗi độ khó một bản
  const THEMES: Record<string, {
    f1: string; f2: string; cracks: boolean; border: string;
    wTop1: string; wTop2: string; wSide: string; eTop1: string; eTop2: string; eSide: string;
    bTop1: string; bTop2: string; bSide: string; mortar: string;
  }> = {
    grass: { f1: '#3a8a5b', f2: '#43996a', cracks: false, border: '#1e293b', wTop1: '#a8b5c7', wTop2: '#7b8aa0', wSide: '#475569', eTop1: '#64748b', eTop2: '#475569', eSide: '#334155', bTop1: '#f59e0b', bTop2: '#d9770a', bSide: '#7c2d12', mortar: '#92400e' },
    desert: { f1: '#d6b373', f2: '#dfbf82', cracks: false, border: '#5b4026', wTop1: '#e6c79b', wTop2: '#b8946a', wSide: '#8a6a45', eTop1: '#a07c52', eTop2: '#7c5a3a', eSide: '#5b4026', bTop1: '#d9663a', bTop2: '#b4482a', bSide: '#6e2a16', mortar: '#7c2d12' },
    lava: { f1: '#2b1d27', f2: '#33232f', cracks: true, border: '#1a0f1c', wTop1: '#7d6a96', wTop2: '#4f4063', wSide: '#33284a', eTop1: '#4a3b5c', eTop2: '#2f2440', eSide: '#1a1226', bTop1: '#b91c1c', bTop2: '#7f1d1d', bSide: '#450a0a', mortar: '#3f0d0d' },
  };
  const theme = () => THEMES[mapKey];

  // Lớp nền (sàn, tường, gạch) chỉ vẽ lại khi có gạch bị phá
  function renderBg() {
    const g = bgx;
    const T = theme();
    g.clearRect(0, 0, bg.width, bg.height);
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const px = x * C, py = y * C;
        g.fillStyle = (x + y) % 2 ? T.f1 : T.f2;
        g.fillRect(px, py, C, C);
        g.fillStyle = 'rgba(255,255,255,.07)';
        g.fillRect(px, py, C, 2); g.fillRect(px, py, 2, C);
        g.fillStyle = 'rgba(0,0,0,.08)';
        g.fillRect(px, py + C - 2, C, 2); g.fillRect(px + C - 2, py, 2, C);
        // Vết nứt phát sáng trên nền núi lửa
        if (T.cracks && (x * 7 + y * 13) % 5 === 0 && grid[y][x] === 0) {
          g.strokeStyle = 'rgba(251,146,60,.55)'; g.lineWidth = 2; g.lineCap = 'round';
          g.beginPath(); g.moveTo(px + 10, py + 14); g.lineTo(px + 22, py + 22); g.lineTo(px + 20, py + 34); g.lineTo(px + 34, py + 38); g.stroke();
        }
      }
    }
    // Cát lún
    for (const k of sand) {
      const cx = (k % W) * C + C / 2, cy = Math.floor(k / W) * C + C / 2;
      g.fillStyle = 'rgba(120,80,30,.4)'; g.beginPath(); g.ellipse(cx, cy, 20, 17, 0, 0, Math.PI * 2); g.fill();
      g.strokeStyle = 'rgba(90,55,20,.55)'; g.lineWidth = 2;
      for (const r of [5, 10, 15]) { g.beginPath(); g.ellipse(cx, cy, r * 1.2, r, 0, 0.4, Math.PI * 1.7); g.stroke(); }
    }
    // Bóng đổ của các khối lên sàn
    g.fillStyle = 'rgba(0,0,0,.28)';
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) if (grid[y][x] !== 0) g.fillRect(x * C + 5, y * C + 8, C, C);
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const px = x * C, py = y * C, t = C - 9;
        if (grid[y][x] === 1) {
          const edgeCell = x === 0 || y === 0 || x === W - 1 || y === H - 1;
          g.fillStyle = edgeCell ? T.eSide : T.wSide; g.fillRect(px, py + t, C, 9);
          const gr = g.createLinearGradient(px, py, px, py + t);
          gr.addColorStop(0, edgeCell ? T.eTop1 : T.wTop1); gr.addColorStop(1, edgeCell ? T.eTop2 : T.wTop2);
          g.fillStyle = gr; g.fillRect(px, py, C, t);
          g.fillStyle = 'rgba(255,255,255,.3)'; g.fillRect(px, py, C, 2); g.fillRect(px, py, 2, t);
          g.fillStyle = 'rgba(0,0,0,.18)'; g.fillRect(px + 8, py + 8, C - 16, t - 16);
        } else if (grid[y][x] === 2) {
          g.fillStyle = T.bSide; g.fillRect(px + 1, py + t, C - 2, 9);
          const gr = g.createLinearGradient(px, py, px, py + t);
          gr.addColorStop(0, T.bTop1); gr.addColorStop(1, T.bTop2);
          g.fillStyle = gr; g.fillRect(px + 1, py + 1, C - 2, t - 1);
          g.strokeStyle = T.mortar; g.lineWidth = 2;
          const rows = 3, rh = (t - 1) / rows;
          for (let r = 0; r < rows; r++) {
            const ry = py + 1 + r * rh;
            g.strokeRect(px + 1, ry, C - 2, rh);
            const off = r % 2 ? C / 2 : C / 4;
            g.beginPath(); g.moveTo(px + off, ry); g.lineTo(px + off, ry + rh); g.stroke();
          }
          g.fillStyle = 'rgba(255,255,255,.25)'; g.fillRect(px + 1, py + 1, C - 2, 2);
        }
      }
    }
    bgDirty = false;
  }

  // 0-3: bốn nhân vật người chơi (vẽ riêng ở paintHero), 4-6: bot dạng quái tròn
  const SKINS = [
    { c1: '#f1f5f9', c2: '#64748b' },
    { c1: '#c4b5fd', c2: '#6d28d9' },
    { c1: '#86efac', c2: '#15803d' },
    { c1: '#64748b', c2: '#111827' },
    { c1: '#fca5a5', c2: '#dc2626' },
    { c1: '#a5f3fc', c2: '#0e7490' },
    { c1: '#fdba74', c2: '#c2410c' },
  ];
  // Bot: quái tròn có phụ kiện riêng
  function paintBlob(g: G, skin: number, o: Look) {
    const r = C * 0.33;
    const sk = SKINS[skin];
    const step = o.moving ? Math.sin(time * 18) * 3 : 0;
    g.fillStyle = '#1e293b';
    g.beginPath(); g.ellipse(-r * 0.5 + step, r * 0.95, r * 0.35, r * 0.22, 0, 0, Math.PI * 2); g.fill();
    g.beginPath(); g.ellipse(r * 0.5 - step, r * 0.95, r * 0.35, r * 0.22, 0, 0, Math.PI * 2); g.fill();
    const gr = g.createRadialGradient(-r * 0.35, -r * 0.4, r * 0.1, 0, 0, r * 1.1);
    gr.addColorStop(0, sk.c1); gr.addColorStop(1, sk.c2);
    g.fillStyle = gr;
    g.beginPath(); g.arc(0, 0, r, 0, Math.PI * 2); g.fill();
    g.lineWidth = 2; g.strokeStyle = 'rgba(0,0,0,.35)'; g.stroke();
    g.fillStyle = sk.c2;
    if (skin === 4) {
      g.fillRect(-1.5, -r * 1.35, 3, r * 0.4);
      g.fillStyle = '#fde047'; g.beginPath(); g.arc(0, -r * 1.4, 4, 0, Math.PI * 2); g.fill();
    } else if (skin === 5) {
      g.beginPath(); g.moveTo(-r * 0.75, -r * 0.55); g.lineTo(-r * 0.5, -r * 1.3); g.lineTo(-r * 0.15, -r * 0.85); g.fill();
      g.beginPath(); g.moveTo(r * 0.75, -r * 0.55); g.lineTo(r * 0.5, -r * 1.3); g.lineTo(r * 0.15, -r * 0.85); g.fill();
    } else {
      for (let i = -1; i <= 1; i++) {
        g.beginPath(); g.moveTo(i * r * 0.5 - 5, -r * 0.85); g.lineTo(i * r * 0.5, -r * 1.35); g.lineTo(i * r * 0.5 + 5, -r * 0.85); g.fill();
      }
    }
    const ex = o.fx * r * 0.14, ey = o.fy * r * 0.1;
    for (const sx of [-1, 1]) {
      g.fillStyle = '#fff';
      g.beginPath(); g.ellipse(sx * r * 0.36, -r * 0.1, r * 0.22, r * 0.28, 0, 0, Math.PI * 2); g.fill();
      g.fillStyle = '#0f172a';
      g.beginPath(); g.arc(sx * r * 0.36 + ex, -r * 0.08 + ey, r * 0.11, 0, Math.PI * 2); g.fill();
    }
  }

  // Vẽ một nhân vật tại (x, y). Dùng cho cả sân chơi lẫn ảnh xem trước ở menu.
  function paintChar(g: G, skin: number, x: number, y: number, o: Look) {
    const s = o.s;
    const bob = o.moving && s === 1 ? Math.sin(time * 18) * 1.5 : 0;
    g.save();
    g.fillStyle = 'rgba(0,0,0,.35)';
    g.beginPath(); g.ellipse(x, y + C * 0.4, C * 0.3 * s, C * 0.1 * s, 0, 0, Math.PI * 2); g.fill();
    g.translate(x, y + bob);
    g.rotate((1 - s) * 6);
    g.scale(s * (C / 48), s * (C / 48));
    if (skin < 4) paintHero(g, skin, o, time); else paintBlob(g, skin, o);
    g.restore();
    // Mũi tên báo đây là nhân vật của bạn
    if (o.human && s === 1) {
      const ay = y + bob - 35 * (C / 48) + Math.sin(time * 6) * 2;
      g.fillStyle = '#fde047'; g.strokeStyle = 'rgba(0,0,0,.45)'; g.lineWidth = 1.5;
      g.beginPath(); g.moveTo(x - 6, ay - 5); g.lineTo(x + 6, ay - 5); g.lineTo(x, ay + 4); g.closePath(); g.fill(); g.stroke();
    }
  }

  function drawActor(a: Actor) {
    const x = (a.gx + (a.tx - a.gx) * a.p) * C + C / 2;
    const y = (a.gy + (a.ty - a.gy) * a.p) * C + C / 2;
    ctx.save();
    if (a.stealth > 0) ctx.globalAlpha = a.stealth < 1 ? 0.4 + (1 - a.stealth) * 0.6 : 0.4;
    paintChar(ctx, a.skin, x, y, { fx: a.fx, fy: a.fy, moving: a.moving && a.alive, s: a.alive ? 1 : Math.max(0, a.die / 0.5), human: a.human });
    ctx.restore();
    if (a.shield > 0 && a.alive) {
      const blink = a.shield < 1 && Math.floor(time * 12) % 2 ? 0.35 : 1;
      const k = ctx.createRadialGradient(x, y + 2, 8, x, y + 2, 25);
      k.addColorStop(0, 'rgba(253,224,71,.05)'); k.addColorStop(1, `rgba(250,204,21,${0.4 * blink})`);
      ctx.fillStyle = k; ctx.beginPath(); ctx.arc(x, y + 2, 25, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = `rgba(250,204,21,${0.9 * blink})`; ctx.lineWidth = 3; ctx.stroke();
    }
  }

  function drawBomb(b: Bomb) {
    const cx = b.gx * C + C / 2, cy = b.gy * C + C / 2 + 2;
    const pulse = 1 + Math.sin(time * 10) * 0.06;
    const r = C * 0.31 * pulse;
    ctx.fillStyle = 'rgba(0,0,0,.35)';
    ctx.beginPath(); ctx.ellipse(cx, cy + C * 0.26, C * 0.26, C * 0.09, 0, 0, Math.PI * 2); ctx.fill();
    const gr = ctx.createRadialGradient(cx - r * 0.4, cy - r * 0.4, r * 0.1, cx, cy, r);
    gr.addColorStop(0, b.t < 0.7 && Math.floor(time * 14) % 2 ? '#fecaca' : '#64748b');
    gr.addColorStop(1, b.t < 0.7 && Math.floor(time * 14) % 2 ? '#dc2626' : '#0f172a');
    ctx.fillStyle = gr;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,.55)';
    ctx.beginPath(); ctx.ellipse(cx - r * 0.4, cy - r * 0.45, r * 0.22, r * 0.14, -0.6, 0, Math.PI * 2); ctx.fill();
    // Ngòi và tia lửa
    ctx.strokeStyle = '#a16207'; ctx.lineWidth = 3; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(cx + r * 0.3, cy - r * 0.85); ctx.quadraticCurveTo(cx + r * 0.7, cy - r * 1.3, cx + r * 0.95, cy - r * 1.05); ctx.stroke();
    const sp = 3 + Math.random() * 3;
    ctx.fillStyle = '#fde047';
    ctx.beginPath(); ctx.arc(cx + r * 0.95, cy - r * 1.05, sp, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#f97316';
    ctx.beginPath(); ctx.arc(cx + r * 0.95, cy - r * 1.05, sp * 0.5, 0, Math.PI * 2); ctx.fill();
  }

  function draw() {
    if (bgDirty) renderBg();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    if (shake > 0) ctx.translate((Math.random() - 0.5) * shake * 28, (Math.random() - 0.5) * shake * 28);
    ctx.drawImage(bg, 0, 0);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    // Cổng dịch chuyển
    portals.forEach(([px, py], i) => {
      const cx = px * C + C / 2, cy = py * C + C / 2;
      const col = i ? '#f472b6' : '#38bdf8';
      const k = ctx.createRadialGradient(cx, cy, 2, cx, cy, C * 0.5);
      k.addColorStop(0, '#ffffff'); k.addColorStop(0.35, col); k.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = k; ctx.beginPath(); ctx.arc(cx, cy, C * 0.5, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = col; ctx.lineWidth = 3; ctx.lineCap = 'round';
      for (let j = 0; j < 3; j++) {
        const a0 = time * 3 + j * 2.09;
        ctx.beginPath(); ctx.arc(cx, cy, C * 0.36, a0, a0 + 1.2); ctx.stroke();
      }
    });

    // Miệng phun lửa: sáng dần và báo vùng nguy hiểm trước khi phun
    for (const v of vents) {
      const warn = v.t < 1.2 ? 1 - v.t / 1.2 : 0;
      if (warn > 0) {
        ctx.fillStyle = `rgba(239,68,68,${0.15 + warn * 0.35 + Math.sin(time * 20) * 0.05})`;
        for (const k of ventCells(v)) ctx.fillRect((k % W) * C + 2, Math.floor(k / W) * C + 2, C - 4, C - 4);
      }
      const cx = v.x * C + C / 2, cy = v.y * C + C / 2;
      ctx.fillStyle = '#0f0a12'; ctx.beginPath(); ctx.arc(cx, cy, C * 0.3, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = `rgba(251,146,60,${0.35 + warn * 0.65})`; ctx.beginPath(); ctx.arc(cx, cy, C * 0.2, 0, Math.PI * 2); ctx.fill();
    }

    // Vật phẩm
    const glow: Record<Item, string> = { B: '#93c5fd', R: '#fdba74', S: '#86efac' };
    ctx.font = (C * 0.5) + 'px ' + FONT;
    for (const [k, it] of items) {
      const x = (k % W) * C + C / 2, y = Math.floor(k / W) * C + C / 2 + Math.sin(time * 4 + k) * 2;
      const gr = ctx.createRadialGradient(x, y, 2, x, y, C * 0.46);
      gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.5, glow[it]); gr.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = gr; ctx.beginPath(); ctx.arc(x, y, C * 0.46, 0, Math.PI * 2); ctx.fill();
      ctx.fillText(it === 'B' ? '💣' : it === 'R' ? '🔥' : '👟', x, y + 2);
    }

    bombs.forEach(drawBomb);

    // Lửa nổ
    for (const [k, t] of fire) {
      const x = (k % W) * C + C / 2, y = Math.floor(k / W) * C + C / 2;
      const a = Math.min(1, t / 0.3);
      const rad = C * (0.62 + Math.sin(time * 40 + k) * 0.05);
      const gr = ctx.createRadialGradient(x, y, 2, x, y, rad);
      gr.addColorStop(0, `rgba(255,255,255,${a})`);
      gr.addColorStop(0.35, `rgba(253,224,71,${a})`);
      gr.addColorStop(0.7, `rgba(249,115,22,${a * 0.9})`);
      gr.addColorStop(1, 'rgba(220,38,38,0)');
      ctx.fillStyle = gr; ctx.fillRect(x - rad, y - rad, rad * 2, rad * 2);
    }

    // Thiên thạch: vùng báo nguy hiểm và quả cầu lửa đang rơi
    for (const m of meteors) {
      const cx = m.x * C + C / 2, cy = m.y * C + C / 2;
      const k = 1 - Math.max(0, m.t) / m.max;
      ctx.fillStyle = `rgba(239,68,68,${0.12 + k * 0.28})`;
      for (const c of ventCells(m)) ctx.fillRect((c % W) * C + 3, Math.floor(c / W) * C + 3, C - 6, C - 6);
      ctx.strokeStyle = `rgba(254,226,226,${0.4 + k * 0.5})`; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(cx, cy, C * (0.55 - k * 0.25), 0, Math.PI * 2); ctx.stroke();
      const fy = cy - Math.max(0, m.t) * 300;
      const g = ctx.createRadialGradient(cx, fy, 1, cx, fy, 16);
      g.addColorStop(0, '#ffffff'); g.addColorStop(0.4, '#fde047'); g.addColorStop(1, 'rgba(249,115,22,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, fy, 16, 0, Math.PI * 2); ctx.fill();
    }

    // Mũi tên xuyên
    for (const b of beams) {
      const a = Math.min(1, b.t / 0.3);
      ctx.save();
      ctx.lineCap = 'round';
      ctx.strokeStyle = `rgba(134,239,172,${a * 0.55})`; ctx.lineWidth = 14;
      ctx.beginPath(); ctx.moveTo(b.sx * C + C / 2, b.sy * C + C / 2); ctx.lineTo(b.ex * C + C / 2, b.ey * C + C / 2); ctx.stroke();
      ctx.strokeStyle = `rgba(255,255,255,${a})`; ctx.lineWidth = 5; ctx.stroke();
      ctx.restore();
    }

    // Nhân vật, vẽ theo hàng để người phía dưới che người phía trên
    actors
      .filter((a) => a.alive || a.die > 0)
      .sort((p, q) => p.gy + (p.ty - p.gy) * p.p - (q.gy + (q.ty - q.gy) * q.p))
      .forEach(drawActor);

    for (const p of particles) {
      ctx.globalAlpha = Math.max(0, p.life / p.max);
      ctx.fillStyle = p.color;
      ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
    }
    ctx.globalAlpha = 1;
    ctx.restore();

    if (banner) {
      ctx.save();
      ctx.globalAlpha = Math.min(1, banner.t / 0.5);
      ctx.font = 'bold 34px ' + FONT;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.lineWidth = 6; ctx.strokeStyle = 'rgba(15,23,42,.85)';
      ctx.strokeText('⚡ ' + banner.text, canvas.width / 2, 92);
      ctx.fillStyle = '#fde047'; ctx.fillText('⚡ ' + banner.text, canvas.width / 2, 92);
      ctx.restore();
    }

    elBots.textContent = String(actors.filter((a) => !a.human && a.alive).length);
    elTime.textContent = String(Math.floor(time));
    elStats.textContent = '💣 ' + player.maxBombs + ' · 🔥 ' + player.range + ' · 👟 ' + player.speed.toFixed(1);
  }

  function frame(now: number) {
    if (!running) { draw(); return; }
    const dt = Math.max(0, Math.min(0.05, (now - last) / 1000));
    last = now;
    update(dt);
    draw();
    raf = requestAnimationFrame(frame);
  }

  // Điều khiển bàn phím
  const KEYS: Record<string, Dir> = {
    ArrowUp: DIRS.up, w: DIRS.up, W: DIRS.up,
    ArrowDown: DIRS.down, s: DIRS.down, S: DIRS.down,
    ArrowLeft: DIRS.left, a: DIRS.left, A: DIRS.left,
    ArrowRight: DIRS.right, d: DIRS.right, D: DIRS.right,
  };
  const dropDir = (d: Dir) => { const i = dirStack.indexOf(d); if (i >= 0) dirStack.splice(i, 1); };
  window.addEventListener('keydown', (e) => {
    if (!running || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === ' ' || e.code === 'Space') { e.preventDefault(); if (!e.repeat) wantBomb = true; return; }
    if (e.key === 'q' || e.key === 'Q') { e.preventDefault(); wantUlt = true; return; }
    const d = KEYS[e.key];
    if (d) { e.preventDefault(); if (!dirStack.includes(d)) dirStack.push(d); }
  });
  window.addEventListener('keyup', (e) => {
    const d = KEYS[e.key];
    if (d) dropDir(d);
  });
  window.addEventListener('blur', () => { dirStack.length = 0; });

  // Điều khiển cảm ứng
  // Cần điều khiển tròn: chạm giữ rồi kéo, chọn hướng theo trục lệch nhiều hơn
  let joyDir: Dir | null = null;
  createJoystick(document.getElementById('bm-joy') as HTMLElement, (x, y) => {
    let d: Dir | null = null;
    if (Math.hypot(x, y) > 0.3) d = Math.abs(x) > Math.abs(y) ? (x > 0 ? DIRS.right : DIRS.left) : (y > 0 ? DIRS.down : DIRS.up);
    if (d === joyDir) return;
    if (joyDir) dropDir(joyDir);
    joyDir = d;
    if (d && !dirStack.includes(d)) dirStack.push(d);
  });
  document.getElementById('bm-drop')!.addEventListener('pointerdown', (e) => { e.preventDefault(); wantBomb = true; });
  document.getElementById('bm-ult')!.addEventListener('pointerdown', (e) => { e.preventDefault(); wantUlt = true; });

  // Chọn nhân vật
  const heroBtns = document.querySelectorAll<HTMLButtonElement>('.bm-hero');
  function markHero() {
    heroBtns.forEach((btn, i) => {
      btn.classList.toggle('sel', i === hero);
      btn.setAttribute('aria-pressed', String(i === hero));
    });
  }
  heroBtns.forEach((btn, i) => {
    const g = btn.querySelector('canvas')!.getContext('2d')!;
    g.scale(1.5, 1.5);
    paintChar(g, i, 32, 44, { fx: 0, fy: 1, moving: false, s: 1, human: false });
    btn.addEventListener('click', () => {
      hero = i;
      try { localStorage.setItem('bomb-hero', String(i)); } catch {}
      markHero();
    });
  });
  markHero();

  // Chọn bản đồ
  const mapBtns = document.querySelectorAll<HTMLButtonElement>('.bm-map');
  function markMap() {
    mapBtns.forEach((btn) => {
      const on = btn.dataset.map === mapKey;
      btn.classList.toggle('sel', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  }
  mapBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      mapKey = btn.dataset.map || 'grass';
      try { localStorage.setItem('bomb-map', mapKey); } catch {}
      markMap();
    });
  });
  markMap();

  // Menu
  document.querySelectorAll<HTMLButtonElement>('.bm-level').forEach((btn) => {
    btn.addEventListener('click', () => start(btn.dataset.level || 'normal'));
  });
  document.getElementById('bm-again')!.addEventListener('click', () => start(level));
  renderStats();
  document.getElementById('bm-change')!.addEventListener('click', () => {
    stop();
    renderStats();
    gameEl.hidden = true;
    menu.hidden = false;
  });
</script>

