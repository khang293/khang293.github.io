---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ui, lp, type Lang } from '../../i18n';
import { fmtDate, readingTime, tagSlug } from '../../lib';

interface Props { lang: Lang; entry: any; }
const { lang, entry } = Astro.props;
const t = ui[lang];
const { Content } = await render(entry);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <header>
      <h1>{entry.data.title}</h1>
      <div class="meta">
        {fmtDate(entry.data.date, t.locale)} · {readingTime(entry.body)} {t.readingTime}{entry.data.draft ? ' · DRAFT' : ''}
      </div>
      <span class="tags">
        {entry.data.tags.map((tag: string) => lang === 'vi'
          ? <a class="tag" href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
          : <span class="tag">#{tag}</span>)}
      </span>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <p><a href={lp(lang, '/posts/')}>{t.back}</a></p>
</Base>
