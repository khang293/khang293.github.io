---
import Base from '../../layouts/Base.astro';
import { lp, ui, type Lang } from '../../i18n';
import { quizUi, questions, type Level } from '../../data/quiz';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = quizUi[lang];
const levels: Level[] = ['easy', 'medium', 'hard'];
// Chỉ gửi xuống trình duyệt phần của ngôn ngữ hiện tại
const data = Object.fromEntries(
  levels.map((lv) => [lv, questions[lv].map((x) => ({ q: x.q[lang], a: x.a[lang], c: x.c, e: x.e[lang] }))])
);
const payload = { ui: g, data };
---
<Base lang={lang} title={g.title} description={g.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{gamesUi[lang].back}</a></p>
  <h1>{g.title}</h1>
  <p class="meta">{g.sub}</p>

  <div id="quiz" data-contact={lp(lang, '/contact/')} data-blog={lp(lang, '/posts/')} data-contact-label={ui[lang].nav.contact}>
    <noscript><p>JavaScript is required to play.</p></noscript>
  </div>
  <script type="application/json" id="quiz-data" set:html={JSON.stringify(payload)} />
</Base>

<script>
  type Q = { q: string; a: string[]; c: number; e: string };
  const root = document.getElementById('quiz') as HTMLElement;
  const raw = JSON.parse(document.getElementById('quiz-data')!.textContent || '{}');
  const ui = raw.ui;
  const data: Record<string, Q[]> = raw.data;
  const LEVELS = ['easy', 'medium', 'hard'];
  const ROUND = 10;

  const bestKey = (lv: string) => 'quiz-best-' + lv;
  const getBest = (lv: string): number | null => {
    try { const v = localStorage.getItem(bestKey(lv)); return v === null ? null : Number(v); } catch { return null; }
  };
  const setBest = (lv: string, n: number) => { try { localStorage.setItem(bestKey(lv), String(n)); } catch {} };

  function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  function menu() {
    root.replaceChildren();
    const grid = el('div', 'qz-levels');
    LEVELS.forEach((lv) => {
      const b = el('button', 'qz-level qz-' + lv) as HTMLButtonElement;
      b.type = 'button';
      b.append(el('b', '', ui.levels[lv]), el('span', '', ui.levelDesc[lv]));
      const best = getBest(lv);
      if (best !== null) b.append(el('em', '', ui.best + ': ' + best + '/' + ROUND));
      b.addEventListener('click', () => play(lv));
      grid.append(b);
    });
    root.append(grid);
  }

  function play(lv: string) {
    const picked = shuffle(data[lv]).slice(0, ROUND).map((x) => {
      const order = shuffle(x.a.map((_, i) => i));
      return { q: x.q, e: x.e, opts: order.map((i) => x.a[i]), c: order.indexOf(x.c) };
    });
    let idx = 0;
    let score = 0;

    function show() {
      const cur = picked[idx];
      root.replaceChildren();
      const head = el('div', 'qz-head');
      head.append(el('span', 'qz-tag qz-' + lv, ui.levels[lv]), el('span', 'meta', ui.question + ' ' + (idx + 1) + '/' + picked.length));
      const bar = el('div', 'qz-bar');
      const fill = el('i');
      fill.style.width = (idx / picked.length) * 100 + '%';
      bar.append(fill);
      const q = el('h2', 'qz-q', cur.q);
      const list = el('div', 'qz-opts');
      const fb = el('div', 'qz-fb');
      fb.setAttribute('aria-live', 'polite');
      const next = el('button', 'btn qz-next', idx === picked.length - 1 ? ui.finish : ui.next) as HTMLButtonElement;
      next.type = 'button';
      next.hidden = true;
      next.addEventListener('click', () => { idx++; idx < picked.length ? show() : result(); });

      const buttons: HTMLButtonElement[] = cur.opts.map((text, i) => {
        const b = el('button', 'qz-opt', text) as HTMLButtonElement;
        b.type = 'button';
        b.addEventListener('click', () => {
          buttons.forEach((x, k) => {
            x.disabled = true;
            if (k === cur.c) x.classList.add('ok');
          });
          if (i === cur.c) { score++; fb.className = 'qz-fb ok'; fb.textContent = ui.right + ' ' + cur.e; }
          else { b.classList.add('bad'); fb.className = 'qz-fb bad'; fb.textContent = ui.wrong + ' ' + cur.e; }
          next.hidden = false;
          next.focus();
        });
        return b;
      });
      list.append(...buttons);
      root.append(head, bar, q, list, fb, next);
    }

    function result() {
      const prev = getBest(lv);
      if (prev === null || score > prev) setBest(lv, score);
      const ratio = score / picked.length;
      const grade = ui.grades[ratio < 0.4 ? 0 : ratio < 0.7 ? 1 : ratio < 0.9 ? 2 : 3];
      root.replaceChildren();
      const box = el('div', 'qz-result');
      box.append(el('p', 'meta', ui.score), el('div', 'qz-big', score + '/' + picked.length), el('p', '', grade));
      const actions = el('div', 'qz-actions');
      const again = el('button', 'btn', ui.again) as HTMLButtonElement;
      again.type = 'button';
      again.addEventListener('click', () => play(lv));
      const change = el('button', 'btn ghost', ui.change) as HTMLButtonElement;
      change.type = 'button';
      change.addEventListener('click', menu);
      actions.append(again, change);
      const cta = el('div', 'qz-cta');
      const a1 = el('a', 'btn ghost', ui.ctaBtn) as HTMLAnchorElement;
      a1.href = root.dataset.contact || '/';
      const a2 = el('a', 'btn ghost', ui.blog) as HTMLAnchorElement;
      a2.href = root.dataset.blog || '/';
      cta.append(el('p', '', ui.cta), a1, ' ', a2);
      box.append(actions, cta);
      root.append(box);
    }

    show();
  }

  menu();
</script>

<style is:global>
  .qz-levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-top: 22px; }
  .qz-level { text-align: left; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 16px; padding: 18px; cursor: pointer; display: flex; flex-direction: column; gap: 4px; font: inherit; border-top: 4px solid var(--accent); }
  .qz-level:hover { border-color: var(--accent); }
  .qz-level b { font-size: 1.15rem; }
  .qz-level span { color: var(--muted); font-size: .92rem; line-height: 1.4; }
  .qz-level em { font-style: normal; font-size: .85rem; color: var(--badge); font-weight: 600; margin-top: 4px; }
  .qz-level.qz-easy { border-top-color: #16a34a; }
  .qz-level.qz-medium { border-top-color: #f59e0b; }
  .qz-level.qz-hard { border-top-color: #dc2626; }
  .qz-head { display: flex; justify-content: space-between; align-items: center; margin: 18px 0 8px; }
  .qz-tag { font-size: .8rem; font-weight: 700; padding: 2px 10px; border-radius: 99px; color: #fff; background: #16a34a; }
  .qz-tag.qz-medium { background: #d97706; }
  .qz-tag.qz-hard { background: #dc2626; }
  .qz-bar { height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .qz-bar i { display: block; height: 100%; background: var(--accent); transition: width .3s; }
  .qz-q { margin: 22px 0 14px; font-size: 1.25rem; line-height: 1.4; }
  .qz-opts { display: grid; gap: 10px; }
  .qz-opt { text-align: left; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; font: inherit; cursor: pointer; }
  .qz-opt:hover:not(:disabled) { border-color: var(--accent); }
  .qz-opt:disabled { cursor: default; }
  .qz-opt.ok { border-color: #16a34a; background: color-mix(in srgb, #16a34a 16%, var(--card)); }
  .qz-opt.bad { border-color: #dc2626; background: color-mix(in srgb, #dc2626 16%, var(--card)); }
  .qz-fb { margin: 14px 0 4px; min-height: 1.5em; font-size: .95rem; }
  .qz-fb.ok { color: #16a34a; }
  .qz-fb.bad { color: #dc2626; }
  .qz-next { margin-top: 10px; }
  .qz-result { text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 28px 18px; margin-top: 22px; }
  .qz-big { font-size: 3.2rem; font-weight: 800; color: var(--accent); line-height: 1.1; margin: 4px 0 8px; }
  .qz-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 18px 0; }
  .qz-cta { border-top: 1px solid var(--line); padding-top: 16px; color: var(--muted); }
</style>
