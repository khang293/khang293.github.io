---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const T = {
  vi: {
    title: 'Dò Mìn', sub: 'Mở các ô an toàn, đừng chạm mìn. Số trên ô cho biết có bao nhiêu mìn xung quanh.',
    sizes: ['Dễ 9×9', 'Vừa 16×16', 'Khó 24×14'], again: 'Ván mới', flagMode: 'Chế độ cờ', best: 'Kỷ lục',
    keys: 'Bấm trái để mở ô. Bấm phải hoặc nhấn giữ để cắm cờ (trên điện thoại có thể bật nút Chế độ cờ). Bấm vào ô số đã đủ cờ xung quanh để mở nhanh các ô còn lại. Ô đầu tiên luôn an toàn.',
    win: 'Bạn thắng!', lose: 'Nổ mìn rồi!', newBest: 'Kỷ lục mới!',
  },
  en: {
    title: 'Minesweeper', sub: 'Open the safe squares and avoid the mines. A number tells how many mines touch that square.',
    sizes: ['Easy 9×9', 'Medium 16×16', 'Hard 24×14'], again: 'New game', flagMode: 'Flag mode', best: 'Best',
    keys: 'Left click to open. Right click or long press to flag (on a phone you can switch on Flag mode). Click a number that has enough flags around it to open the rest quickly. The first click is always safe.',
    win: 'You win!', lose: 'Boom!', newBest: 'New best time!',
  },
}[lang];
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="mn" data-ui={JSON.stringify(T)}>
    <div class="bd-row">
      {T.sizes.map((s, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-s={i}>{s}</button>)}
    </div>
    <div class="mn-bar">
      <span class="mn-pill"><svg viewBox="0 0 24 24" width="18" height="18"><use href="#mn-flag" /></svg> <b id="mn-left">10</b></span>
      <span class="mn-pill">⏱ <b id="mn-time">0</b></span>
      <span class="mn-pill" id="mn-best"></span>
      <button type="button" class="btn ghost sm" id="mn-fm" aria-pressed="false"><svg viewBox="0 0 24 24" width="16" height="16" style="vertical-align:-3px"><use href="#mn-flag" /></svg> {T.flagMode}</button>
      <button type="button" class="btn sm" id="mn-new">{T.again}</button>
    </div>
    <p class="bd-status" id="mn-status" aria-live="polite"></p>
    <div class="mn-scroll"><div class="mn-board" id="mn-board"></div></div>
    <p class="meta">{T.keys}</p>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="mn-flag" viewBox="0 0 24 24"><path d="M6 21V3" stroke="#475569" stroke-width="2.2" stroke-linecap="round" /><path d="M6 4l12 4.5L6 13z" fill="#ef4444" /></symbol>
        <symbol id="mn-mine" viewBox="0 0 24 24">
          <g stroke="#1f2937" stroke-width="2" stroke-linecap="round"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l2.8 2.8M16.2 16.2L19 19M19 5l-2.8 2.8M7.8 16.2L5 19" /></g>
          <circle cx="12" cy="12" r="6.2" fill="#1f2937" /><circle cx="10" cy="10" r="1.7" fill="#fff" opacity=".8" />
        </symbol>
      </defs>
    </svg>
  </div>
</Base>

<style is:global>
  .mn-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 16px 0 4px; }
  .mn-pill { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 5px 14px; font-size: .95rem; display: inline-flex; gap: 6px; align-items: center; }
  .mn-pill:empty { display: none; }
  #mn-fm[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .mn-scroll { overflow-x: auto; padding: 4px 0 8px; }
  .mn-board { --cols: 9; --cs: 38px; display: grid; grid-template-columns: repeat(var(--cols), var(--cs)); gap: 3px; width: max-content; max-width: none; padding: 10px; border-radius: 16px; background: color-mix(in srgb, var(--accent) 12%, var(--card)); border: 1px solid var(--line); box-shadow: 0 10px 28px rgba(0,0,0,.12); margin: 0 auto; touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .mn-c { width: var(--cs); height: var(--cs); border-radius: 8px; border: 0; padding: 0; cursor: pointer; display: grid; place-items: center; font: 800 calc(var(--cs) * .5)/1 system-ui, sans-serif; background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 55%, #fff), color-mix(in srgb, var(--accent) 80%, #000)); box-shadow: inset 0 -3px 0 rgba(0,0,0,.18), inset 0 2px 0 rgba(255,255,255,.28); transition: transform .08s, filter .15s; color: var(--fg); }
  .mn-c:hover:not(.open) { filter: brightness(1.12); }
  .mn-c:active:not(.open) { transform: scale(.94); }
  .mn-c svg { width: 66%; height: 66%; }
  .mn-c.open { cursor: default; background: color-mix(in srgb, var(--accent) 7%, var(--bg)); box-shadow: inset 0 0 0 1px var(--line), inset 0 3px 6px rgba(0,0,0,.14); animation: mnOpen .3s cubic-bezier(.2,.9,.3,1.2) backwards; animation-delay: calc(var(--d, 0) * 22ms); text-shadow: 0 1px 0 rgba(255,255,255,.25); }
  @keyframes mnOpen { 0% { transform: scale(.35) rotate(-10deg); opacity: 0; filter: brightness(1.8); } 70% { transform: scale(1.08); opacity: 1; } 100% { transform: none; opacity: 1; filter: none; } }
  .mn-c.n1 { color: #3b82f6; } .mn-c.n2 { color: #16a34a; } .mn-c.n3 { color: #ef4444; } .mn-c.n4 { color: #7c3aed; }
  .mn-c.n5 { color: #b45309; } .mn-c.n6 { color: #0891b2; } .mn-c.n7 { color: #be185d; } .mn-c.n8 { color: #64748b; }
  .mn-c.boom { background: #ef4444; animation: mnBoom .5s ease-out; position: relative; z-index: 2; }
  .mn-c.mine { background: color-mix(in srgb, #ef4444 25%, var(--bg)); }
  .mn-c.chain { animation: mnChain .5s ease-out; position: relative; }
  .mn-c.boom::after, .mn-c.chain::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 3px solid #fb923c; animation: mnRing .55s ease-out forwards; pointer-events: none; }
  .mn-c.wrong { background: color-mix(in srgb, #f59e0b 35%, var(--bg)); }
  @keyframes mnBoom { 0% { transform: scale(.6); filter: brightness(2.5); } 60% { transform: scale(1.4); } 100% { transform: scale(1); filter: none; } }
  @keyframes mnChain { 0% { transform: scale(.4); background: #fde047; filter: brightness(2); } 55% { transform: scale(1.25); background: #f97316; } 100% { transform: scale(1); } }
  @keyframes mnRing { from { transform: scale(.5); opacity: 1; } to { transform: scale(2.4); opacity: 0; } }
  .mn-board.shake { animation: mnShake .45s ease-out; }
  @keyframes mnShake { 0%, 100% { transform: none; } 15% { transform: translate(-6px, 3px); } 30% { transform: translate(5px, -4px); } 45% { transform: translate(-4px, -2px); } 60% { transform: translate(3px, 3px); } 80% { transform: translate(-2px, 1px); } }
  .mn-c.wave { animation: mnWave .7s ease-in-out backwards; animation-delay: calc(var(--w, 0) * 35ms); }
  @keyframes mnWave { 0%, 100% { transform: none; } 40% { transform: translateY(-8px) scale(1.1); filter: brightness(1.3); } }
  .mn-confetti { position: fixed; inset: 0; pointer-events: none; z-index: 80; overflow: hidden; }
  .mn-confetti i { position: absolute; top: -14px; width: 9px; height: 14px; border-radius: 2px; animation: mnFall 2.4s ease-in forwards; }
  @keyframes mnFall { to { transform: translate(var(--dx, 0), 110vh) rotate(var(--rot, 540deg)); opacity: .9; } }
  @media (max-width: 520px) { .mn-board { --cs: 34px; } }
</style>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  // <logic>
  // Rải mìn, tránh ô (sr,sc) và 8 ô quanh nó. rnd là hàm ngẫu nhiên [0,1)
  function placeMines(rows, cols, mines, sr, sc, rnd) {
    const cand = [];
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      if (Math.abs(r - sr) <= 1 && Math.abs(c - sc) <= 1) continue;
      cand.push(r * cols + c);
    }
    for (let i = cand.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [cand[i], cand[j]] = [cand[j], cand[i]]; }
    const mine = new Array(rows * cols).fill(false);
    for (let i = 0; i < mines && i < cand.length; i++) mine[cand[i]] = true;
    return mine;
  }
  function countNear(mine, rows, cols) {
    const near = new Array(rows * cols).fill(0);
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      let n = 0;
      for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
        const rr = r + dr, cc = c + dc;
        if ((dr || dc) && rr >= 0 && rr < rows && cc >= 0 && cc < cols && mine[rr * cols + cc]) n++;
      }
      near[r * cols + c] = n;
    }
    return near;
  }
  // Mở ô start, loang ra các ô 0. Trả về danh sách [chỉ số, khoảng cách] theo thứ tự mở. Bỏ qua ô đã mở hoặc đã cắm cờ.
  function floodOpen(start, rows, cols, mine, near, opened, flagged) {
    const out = [];
    const dist = new Map();
    const q = [start];
    dist.set(start, 0);
    for (let h = 0; h < q.length; h++) {
      const i = q[h];
      if (opened[i] || flagged[i] || mine[i]) continue;
      opened[i] = true;
      out.push([i, dist.get(i)]);
      if (near[i] !== 0) continue;
      const r = Math.floor(i / cols), c = i % cols;
      for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
        const rr = r + dr, cc = c + dc;
        if (rr < 0 || rr >= rows || cc < 0 || cc >= cols) continue;
        const j = rr * cols + cc;
        if (!dist.has(j)) { dist.set(j, dist.get(i) + 1); q.push(j); }
      }
    }
    return out;
  }
  // </logic>

  const root = document.getElementById('mn') as HTMLElement;
  mountMute(root);
  const ui = JSON.parse(root.dataset.ui || '{}');
  const boardEl = document.getElementById('mn-board') as HTMLElement;
  const leftEl = document.getElementById('mn-left') as HTMLElement;
  const timeEl = document.getElementById('mn-time') as HTMLElement;
  const bestEl = document.getElementById('mn-best') as HTMLElement;
  const statusEl = document.getElementById('mn-status') as HTMLElement;
  const fmBtn = document.getElementById('mn-fm') as HTMLButtonElement;

  const SIZES = [{ r: 9, c: 9, m: 10 }, { r: 16, c: 16, m: 40 }, { r: 14, c: 24, m: 62 }];
  let si = 0, R = 9, C = 9, M = 10;
  let mine: boolean[] = [], near: number[] = [], opened: boolean[] = [], flagged: boolean[] = [];
  let cells: HTMLElement[] = [];
  let started = false, over = false, flagMode = false;
  let t0 = 0, timer = 0, flags = 0, openCount = 0;

  const bestKey = () => 'mines-best' + si;
  const getBest = () => { try { return +(localStorage.getItem(bestKey()) || 0) || 0; } catch { return 0; } };
  const paintBest = () => { const b = getBest(); bestEl.textContent = b ? `${ui.best}: ${b}s` : ''; };
  const stopTimer = () => { clearInterval(timer); timer = 0; };

  function newGame(s?: number) {
    if (s !== undefined) si = s;
    ({ r: R, c: C, m: M } = SIZES[si]);
    stopTimer(); started = false; over = false; flags = 0; openCount = 0;
    boardEl.classList.remove('shake');
    mine = []; near = []; opened = new Array(R * C).fill(false); flagged = new Array(R * C).fill(false);
    leftEl.textContent = String(M); timeEl.textContent = '0'; statusEl.textContent = ''; statusEl.className = 'bd-status';
    boardEl.style.setProperty('--cols', String(C));
    boardEl.innerHTML = ''; cells = [];
    for (let i = 0; i < R * C; i++) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'mn-c'; b.dataset.i = String(i);
      b.setAttribute('aria-label', `${Math.floor(i / C) + 1},${(i % C) + 1}`);
      boardEl.appendChild(b); cells.push(b);
    }
    paintBest();
  }

  function paintOpen(i: number, d: number) {
    const el = cells[i];
    el.classList.add('open'); el.style.setProperty('--d', String(Math.min(d, 14)));
    el.innerHTML = '';
    if (near[i] > 0) { el.textContent = String(near[i]); el.classList.add('n' + near[i]); }
  }
  function openFrom(i: number) {
    if (opened[i] || flagged[i]) return;
    if (!started) {
      started = true;
      mine = placeMines(R, C, M, Math.floor(i / C), i % C, Math.random);
      near = countNear(mine, R, C);
      t0 = Date.now();
      timer = window.setInterval(() => { timeEl.textContent = String(Math.floor((Date.now() - t0) / 1000)); }, 250);
    }
    if (mine[i]) return lose(i);
    const res = floodOpen(i, R, C, mine, near, opened, flagged);
    for (const [j, d] of res) { paintOpen(j, d); openCount++; }
    // âm thanh: ô số kêu cao thấp theo số mìn, vùng trống loang ra như gợn sóng
    if (res.length > 1) {
      const seen = new Set<number>();
      for (const [, d] of res) if (!seen.has(d) && seen.size < 12) { seen.add(d); sfx.tone(340 + d * 38, 0.06, 'sine', 0.13, undefined, d * 0.03); }
    } else sfx.tone(380 + near[i] * 70, 0.09, 'triangle', 0.22, 420 + near[i] * 80);
    if (openCount === R * C - M) win();
  }
  function toggleFlag(i: number) {
    if (opened[i] || over) return;
    flagged[i] = !flagged[i]; flags += flagged[i] ? 1 : -1;
    sfx.play(flagged[i] ? 'place' : 'click');
    cells[i].innerHTML = flagged[i] ? '<svg viewBox="0 0 24 24"><use href="#mn-flag"/></svg>' : '';
    leftEl.textContent = String(M - flags);
  }
  function chord(i: number) {
    if (!opened[i] || near[i] === 0) return;
    const r = Math.floor(i / C), c = i % C;
    const ns: number[] = []; let f = 0;
    for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
      const rr = r + dr, cc = c + dc;
      if ((!dr && !dc) || rr < 0 || rr >= R || cc < 0 || cc >= C) continue;
      const j = rr * C + cc; ns.push(j); if (flagged[j]) f++;
    }
    if (f !== near[i]) return;
    sfx.play('swoosh');
    for (const j of ns) { if (over) break; if (!flagged[j] && !opened[j]) openFrom(j); }
  }
  function lose(hit: number) {
    over = true; stopTimer();
    for (let i = 0; i < R * C; i++) if (!mine[i] && flagged[i]) cells[i].classList.add('wrong');
    // nổ dây chuyền: mìn nổ lần lượt từ ô trúng ra xa dần
    const hr = Math.floor(hit / C), hc = hit % C;
    const rest = [];
    for (let i = 0; i < R * C; i++) if (mine[i] && !flagged[i] && i !== hit) rest.push(i);
    rest.sort((a, b) => Math.hypot(Math.floor(a / C) - hr, (a % C) - hc) - Math.hypot(Math.floor(b / C) - hr, (b % C) - hc));
    const showMine = (i: number, cls: string) => {
      cells[i].classList.add('open', 'mine', cls); cells[i].style.setProperty('--d', '0');
      cells[i].innerHTML = '<svg viewBox="0 0 24 24"><use href="#mn-mine"/></svg>';
    };
    cells[hit].classList.add('open', 'boom'); showMine(hit, 'boom');
    boardEl.classList.remove('shake'); void boardEl.offsetWidth; boardEl.classList.add('shake');
    sfx.play('explode');
    const step = Math.max(18, Math.min(90, 1400 / Math.max(1, rest.length)));
    rest.forEach((i, k) => {
      setTimeout(() => {
        if (!over) return;
        showMine(i, 'chain');
        if (k % 2 === 0 || rest.length < 10) sfx.play('boom');
      }, 220 + k * step);
    });
    statusEl.textContent = ui.lose; statusEl.className = 'bd-status';
    setTimeout(() => { if (over) sfx.play('lose'); }, 300 + rest.length * step * 0.6);
  }
  function confetti() {
    const box = document.createElement('div');
    box.className = 'mn-confetti';
    const colors = ['#f87171', '#fbbf24', '#34d399', '#60a5fa', '#c084fc', '#f472b6'];
    for (let i = 0; i < 70; i++) {
      const p = document.createElement('i');
      p.style.cssText = `left:${Math.random() * 100}%;background:${colors[i % colors.length]};--dx:${(Math.random() - 0.5) * 240}px;--rot:${Math.random() * 900}deg;animation-delay:${Math.random() * 0.5}s;animation-duration:${1.8 + Math.random() * 1.4}s`;
      box.appendChild(p);
    }
    document.body.appendChild(box);
    setTimeout(() => box.remove(), 3800);
  }
  function win() {
    over = true; stopTimer();
    sfx.play('win'); confetti();
    // sóng nhấp nhô lan khắp bàn
    cells.forEach((el, i) => { el.style.setProperty('--w', String(Math.floor(i / C) + (i % C))); el.classList.add('wave'); });
    const secs = Math.max(1, Math.round((Date.now() - t0) / 1000));
    timeEl.textContent = String(secs);
    for (let i = 0; i < R * C; i++) if (mine[i] && !flagged[i]) { flagged[i] = true; cells[i].innerHTML = '<svg viewBox="0 0 24 24"><use href="#mn-flag"/></svg>'; }
    leftEl.textContent = '0';
    let msg = ui.win + ` (${secs}s)`;
    const b = getBest();
    if (!b || secs < b) { try { localStorage.setItem(bestKey(), String(secs)); } catch {} msg += ' ' + ui.newBest; paintBest(); }
    statusEl.textContent = msg; statusEl.className = 'bd-status done';
  }

  // Chuột / cảm ứng
  let pressTimer = 0, longFired = false, pressI = -1;
  boardEl.addEventListener('contextmenu', (e) => e.preventDefault());
  boardEl.addEventListener('pointerdown', (e) => {
    const t = (e.target as HTMLElement).closest('.mn-c') as HTMLElement | null;
    if (!t) return;
    pressI = +(t.dataset.i || -1); longFired = false;
    if (e.pointerType === 'mouse' && e.button === 2) { longFired = true; toggleFlag(pressI); return; }
    if (e.pointerType !== 'mouse') {
      clearTimeout(pressTimer);
      pressTimer = window.setTimeout(() => { longFired = true; if (navigator.vibrate) try { navigator.vibrate(20); } catch {} toggleFlag(pressI); }, 380);
    }
  });
  const cancelPress = () => clearTimeout(pressTimer);
  boardEl.addEventListener('pointerleave', cancelPress);
  boardEl.addEventListener('pointercancel', () => { cancelPress(); pressI = -1; });
  boardEl.addEventListener('pointerup', (e) => {
    cancelPress();
    const t = (e.target as HTMLElement).closest('.mn-c') as HTMLElement | null;
    if (!t || over || longFired) return;
    const i = +(t.dataset.i || -1);
    if (i !== pressI || (e.pointerType === 'mouse' && e.button !== 0)) return;
    if (opened[i]) chord(i);
    else if (flagMode) toggleFlag(i);
    else openFrom(i);
  });

  fmBtn.addEventListener('click', () => { flagMode = !flagMode; fmBtn.setAttribute('aria-pressed', String(flagMode)); });
  document.getElementById('mn-new')!.addEventListener('click', () => newGame());
  root.querySelectorAll<HTMLButtonElement>('[data-s]').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('[data-s]').forEach((x) => x.classList.remove('sel'));
    b.classList.add('sel'); newGame(+(b.dataset.s || 0));
  }));

  newGame(0);
  if (location.hash.includes('debug')) (window as any).__mn = { placeMines, countNear, floodOpen, get mine() { return mine; }, get state() { return { over, started, openCount, R, C, M }; }, openFrom, toggleFlag };
</script>
