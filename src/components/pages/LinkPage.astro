---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const S = {
  vi: {
    title: 'Nối Cặp Cổ Điển',
    sub: 'Nối hai hình giống nhau bằng đường gấp khúc không quá 2 góc rẽ, đường được đi qua vùng trống kể cả viền ngoài bàn. Xóa hết bàn trước khi hết giờ.',
    pick: 'Chọn màn chơi', level: 'Màn', score: 'Điểm', time: 'Thời gian', left: 'Còn lại',
    hint: 'Gợi ý', shuffle: 'Xáo bàn', restart: 'Chơi lại', next: 'Màn tiếp →', toLevels: 'Chọn màn',
    win: 'Xóa sạch bàn!', lose: 'Hết giờ rồi.', timeBonus: 'Thưởng thời gian', best: 'Điểm cao',
    reshuffle: 'Hết cặp nối được, xáo lại bàn!', combo: 'Liên tiếp', stars: 'Tổng số sao', locked: 'Qua màn trước để mở',
    modes: { none: 'Đứng yên', down: 'Rơi xuống', left: 'Dồn sang trái' },
    keys: 'Bấm hai hình giống nhau: nếu nối được bằng đường có tối đa 2 góc rẽ thì cả hai biến mất. Nối liên tiếp nhanh để được cộng giờ và nhân điểm. Có 3 lần gợi ý và 3 lần xáo bàn mỗi màn.',
  },
  en: {
    title: 'Classic Pair Link',
    sub: 'Connect two identical tiles with a path of at most 2 turns. The path may run through empty space, even around the outside of the board. Clear the board before time runs out.',
    pick: 'Choose a level', level: 'Level', score: 'Score', time: 'Time', left: 'Left',
    hint: 'Hint', shuffle: 'Shuffle', restart: 'Retry', next: 'Next level →', toLevels: 'Levels',
    win: 'Board cleared!', lose: 'Time is up.', timeBonus: 'Time bonus', best: 'Best',
    reshuffle: 'No pairs left to connect, reshuffling!', combo: 'Combo', stars: 'Total stars', locked: 'Clear the previous level to unlock',
    modes: { none: 'Static', down: 'Falls down', left: 'Slides left' },
    keys: 'Tap two identical tiles: if they can be joined by a path with at most 2 turns, both vanish. Chain matches quickly for extra time and a score multiplier. You get 3 hints and 3 shuffles per level.',
  },
}[lang];
const ui = { ...S };
---
<Base lang={lang} title={S.title} description={S.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{S.title}</h1>
  <p class="meta">{S.sub}</p>

  <div id="lk" data-ui={JSON.stringify(ui)}>
    <div id="lk-menu">
      <h2 class="bd-h">{S.pick}</h2>
      <div id="lk-levels" class="lk-grid"></div>
      <p class="bd-stat" id="lk-stat"></p>
      <p class="meta">{S.keys}</p>
    </div>

    <div id="lk-game" hidden>
      <div class="lk-hud">
        <div><span>{S.level}</span><b id="lk-lv">1</b></div>
        <div><span>{S.score}</span><b id="lk-sc">0</b></div>
        <div><span>{S.time}</span><b id="lk-tm">0</b></div>
        <div><span>{S.left}</span><b id="lk-left">0</b></div>
      </div>
      <div class="lk-bar"><i id="lk-fill"></i></div>
      <div class="lk-wrap" id="lk-wrap">
        <div class="lk-scroll"><canvas id="lk-canvas" width="1008" height="704" aria-label={S.title}></canvas></div>
        <div class="lk-ov" id="lk-ov" hidden>
          <div class="lk-card">
            <h2 id="lk-ovt"></h2>
            <div class="lk-stars" id="lk-ovs"></div>
            <p id="lk-ovp"></p>
            <div class="bd-row bd-actions">
              <button type="button" class="btn ghost sm" id="lk-ovr">↻ {S.restart}</button>
              <button type="button" class="btn sm" id="lk-ovn" hidden>{S.next}</button>
              <button type="button" class="btn ghost sm" id="lk-ovl">{S.toLevels}</button>
            </div>
          </div>
        </div>
      </div>
      <p class="bd-status" id="lk-status" aria-live="polite"></p>
      <div class="bd-row bd-actions">
        <button type="button" class="btn ghost sm" id="lk-hint">💡 {S.hint} (<span id="lk-hn">3</span>)</button>
        <button type="button" class="btn ghost sm" id="lk-shuf">🔀 {S.shuffle} (<span id="lk-sn">3</span>)</button>
        <button type="button" class="btn ghost sm" id="lk-restart">↻ {S.restart}</button>
        <button type="button" class="btn ghost sm" id="lk-back">{S.toLevels}</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  const root = document.getElementById('lk') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const menu = $('lk-menu'), gameEl = $('lk-game');
  const canvas = $('lk-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const statusEl = $('lk-status');

  // <logic>
  type Grid = Int8Array; // -1 = ô trống, >= 0 = loại hình. Có viền trống bao quanh bàn.
  const DR = [-1, 0, 1, 0], DC = [0, 1, 0, -1];

  // Đường nối tối đa 2 góc rẽ, đi qua ô trống (kể cả viền ngoài). Trả về danh sách các điểm gấp khúc.
  function findPath(g: Grid, W: number, H: number, a: number, b: number): number[] | null {
    const best = new Int8Array(W * H * 4).fill(9);
    const par = new Int32Array(W * H * 4).fill(-1);
    const q: number[] = [];
    const ar = Math.floor(a / W), ac = a % W;
    for (let d = 0; d < 4; d++) {
      const r = ar + DR[d], c = ac + DC[d];
      if (r < 0 || r >= H || c < 0 || c >= W) continue;
      const n = r * W + c;
      if (g[n] >= 0 && n !== b) continue;
      best[n * 4 + d] = 0; par[n * 4 + d] = a * 4 + d; q.push(n * 4 + d);
    }
    let found = -1;
    for (let qi = 0; qi < q.length; qi++) {
      const s = q[qi], p = s >> 2, d = s & 3, k = best[s];
      if (p === b) { if (found < 0 || k < best[found]) found = s; continue; }
      const pr = Math.floor(p / W), pc = p % W;
      for (let nd = 0; nd < 4; nd++) {
        const nk = k + (nd !== d ? 1 : 0);
        if (nk > 2) continue;
        const r = pr + DR[nd], c = pc + DC[nd];
        if (r < 0 || r >= H || c < 0 || c >= W) continue;
        const n = r * W + c;
        if (g[n] >= 0 && n !== b) continue;
        const ns = n * 4 + nd;
        if (best[ns] > nk) { best[ns] = nk; par[ns] = s; q.push(ns); }
      }
    }
    if (found < 0) return null;
    // dựng lại đường đi từ b về a, rồi gộp các điểm thẳng hàng
    const cells: number[] = [];
    let s = found;
    for (let guard = 0; guard < 400; guard++) {
      cells.push(s >> 2);
      const pp = par[s];
      if ((pp >> 2) === a) { cells.push(a); break; }
      s = pp;
    }
    cells.reverse();
    const pts = [cells[0]];
    for (let i = 1; i < cells.length - 1; i++) {
      const p = cells[i - 1], c = cells[i], n = cells[i + 1];
      const d1 = c - p, d2 = n - c;
      if (d1 !== d2) pts.push(c);
    }
    pts.push(cells[cells.length - 1]);
    return pts;
  }

  // Tìm một cặp nối được. Trả về [a, b, đường đi] hoặc null.
  // rand = true: thử theo thứ tự ngẫu nhiên. mode ('down' / 'left'): ưu tiên tháo các hình ở phía "lộ ra"
  // (đỉnh cột khi rơi xuống, cuối hàng khi dồn trái) để việc xóa không làm hình khác dịch chuyển, giúp giải được bàn.
  function findPair(g: Grid, W: number, H: number, rand = false, mode = 'none'): [number, number, number[]] | null {
    const by = new Map<number, number[]>();
    for (let i = 0; i < g.length; i++) if (g[i] >= 0) { const l = by.get(g[i]); if (l) l.push(i); else by.set(g[i], [i]); }
    const cand: [number, number, number][] = [];
    for (const l of by.values()) {
      for (let i = 0; i < l.length; i++) for (let j = i + 1; j < l.length; j++) {
        let sc = 0;
        if (mode === 'left') sc = (l[i] % W) + (l[j] % W);
        else if (mode === 'down') sc = -(Math.floor(l[i] / W) + Math.floor(l[j] / W));
        cand.push([l[i], l[j], rand ? sc + Math.random() * 3 : sc]);
      }
    }
    if (rand) cand.sort((x, y) => y[2] - x[2]);
    for (const [a, b] of cand) {
      const p = findPath(g, W, H, a, b);
      if (p) return [a, b, p];
    }
    return null;
  }

  // Trọng lực: 'down' tụt xuống đáy cột, 'left' dồn sang trái hàng. Trả về danh sách [từ, đến] của các ô đã dời.
  function gravity(g: Grid, W: number, H: number, mode: string): [number, number][] {
    const mv: [number, number][] = [];
    if (mode === 'down') {
      for (let c = 1; c < W - 1; c++) {
        let w = H - 2;
        for (let r = H - 2; r >= 1; r--) {
          const i = r * W + c;
          if (g[i] >= 0) { if (r !== w) { g[w * W + c] = g[i]; g[i] = -1; mv.push([i, w * W + c]); } w--; }
        }
      }
    } else if (mode === 'left') {
      for (let r = 1; r < H - 1; r++) {
        let w = 1;
        for (let c = 1; c < W - 1; c++) {
          const i = r * W + c;
          if (g[i] >= 0) { if (c !== w) { g[r * W + w] = g[i]; g[i] = -1; mv.push([i, r * W + w]); } w++; }
        }
      }
    }
    return mv;
  }

  // Giải thử bằng cách xóa liên tiếp; nếu xóa hết được thì bàn chắc chắn có lời giải.
  function solvable(g0: Grid, W: number, H: number, mode: string): boolean {
    for (let k = 0; k < 8; k++) if (solveOnce(g0, W, H, mode)) return true;
    return false;
  }
  function solveOnce(g0: Grid, W: number, H: number, mode: string): boolean {
    const g = g0.slice();
    let left = 0;
    for (let i = 0; i < g.length; i++) if (g[i] >= 0) left++;
    while (left > 0) {
      const p = findPair(g, W, H, true, mode);
      if (!p) return false;
      g[p[0]] = -1; g[p[1]] = -1; left -= 2;
      gravity(g, W, H, mode);
    }
    return true;
  }

  function shuffleArr<T>(a: T[]) { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }

  function genGrid(R: number, C: number, types: number, mode: string): Grid {
    const W = C + 2, H = R + 2;
    let g: Grid = new Int8Array(W * H).fill(-1);
    for (let attempt = 0; attempt < 120; attempt++) {
      const list: number[] = [];
      const typeOrder = shuffleArr(Array.from({ length: types }, (_, i) => i));
      for (let p = 0; p < (R * C) / 2; p++) { const t = typeOrder[p % types]; list.push(t, t); }
      shuffleArr(list);
      g = new Int8Array(W * H).fill(-1);
      let k = 0;
      for (let r = 1; r <= R; r++) for (let c = 1; c <= C; c++) g[r * W + c] = list[k++];
      if (solvable(g, W, H, mode)) return g;
    }
    return g;
  }

  // Xáo lại các hình còn trên bàn (giữ nguyên các ô đang có hình), bảo đảm vẫn giải được.
  function reshuffle(g: Grid, W: number, H: number, mode: string): Grid {
    const pos: number[] = [], vals: number[] = [];
    for (let i = 0; i < g.length; i++) if (g[i] >= 0) { pos.push(i); vals.push(g[i]); }
    let out = g.slice();
    for (let attempt = 0; attempt < 150; attempt++) {
      shuffleArr(vals);
      out = new Int8Array(g.length).fill(-1);
      pos.forEach((p, i) => { out[p] = vals[i]; });
      if (solvable(out, W, H, mode)) return out;
    }
    return out;
  }
  // </logic>

  // ---------- Cấu hình màn chơi ----------
  const LV = [
    { r: 6, c: 10, t: 8, g: 'none' }, { r: 6, c: 12, t: 10, g: 'none' }, { r: 7, c: 12, t: 12, g: 'none' },
    { r: 8, c: 12, t: 14, g: 'down' }, { r: 8, c: 14, t: 16, g: 'left' }, { r: 8, c: 14, t: 18, g: 'none' },
    { r: 8, c: 16, t: 20, g: 'down' }, { r: 9, c: 16, t: 22, g: 'left' }, { r: 9, c: 16, t: 24, g: 'down' },
    { r: 9, c: 16, t: 24, g: 'left' },
  ];
  const CW = 56, CH = 64, TW = 52, TH = 60;
  const NT = 24;

  let lv = 0, R = 6, C = 10, W = 12, H = 8, mode = 'none';
  let g: Grid = new Int8Array(0);
  let ox: Float32Array = new Float32Array(0), oy: Float32Array = new Float32Array(0);
  let sel = -1, hintPair: number[] | null = null, hintT = 0;
  let timeMax = 100, timeLeft = 100, score = 0, combo = 0, lastMatch = -9999;
  let hints = 3, shufs = 3;
  let busy = false, over = false, running = false, fast = false;
  let line: { pts: number[]; t: number } | null = null;
  let hover = -1;
  const shakeT = new Map<number, number>();
  let best: { s: number; b: number }[] = LV.map(() => ({ s: 0, b: 0 }));
  try { const s = JSON.parse(localStorage.getItem('link-best') || 'null'); if (Array.isArray(s)) best = LV.map((_, i) => ({ s: +(s[i] && s[i].s) || 0, b: +(s[i] && s[i].b) || 0 })); } catch {}
  const saveBest = () => { try { localStorage.setItem('link-best', JSON.stringify(best)); } catch {} };

  const snd = (n: string) => { if (!fast) sfx.play(n); };
  const tween = (ms: number, fn: (k: number) => void) => new Promise<void>((res) => {
    if (fast || ms <= 0) { fn(1); res(); return; }
    const t0 = performance.now();
    const step = (now: number) => { const k = Math.min(1, (now - t0) / ms); fn(k); if (k < 1) requestAnimationFrame(step); else res(); };
    requestAnimationFrame(step);
  });

  // ---------- Hình vẽ 24 biểu tượng (tự vẽ, không dùng hình có bản quyền) ----------
  const sprites: HTMLCanvasElement[] = [];
  const HUE = (i: number) => (i * 15 + 8) % 360;
  function icon(c: CanvasRenderingContext2D, i: number) {
    const cir = (x: number, y: number, r: number, f: string) => { c.beginPath(); c.arc(x, y, r, 0, 7); c.fillStyle = f; c.fill(); };
    const ell = (x: number, y: number, rx: number, ry: number, f: string, rot = 0) => { c.beginPath(); c.ellipse(x, y, rx, ry, rot, 0, 7); c.fillStyle = f; c.fill(); };
    const poly = (pts: number[][], f: string) => { c.beginPath(); pts.forEach(([x, y], k) => (k ? c.lineTo(x, y) : c.moveTo(x, y))); c.closePath(); c.fillStyle = f; c.fill(); };
    const ln = (x1: number, y1: number, x2: number, y2: number, col: string, w = 3) => { c.beginPath(); c.moveTo(x1, y1); c.lineTo(x2, y2); c.strokeStyle = col; c.lineWidth = w; c.lineCap = 'round'; c.stroke(); };
    const eye = (x: number, y: number, r = 5) => { cir(x, y, r, '#fff'); cir(x + 1, y + 1, r * 0.55, '#1b1f33'); };
    const dot = (x: number, y: number, r = 3) => cir(x, y, r, '#1b1f33');
    const leaf = (x: number, y: number, rot: number) => ell(x, y, 11, 5, '#4cb04a', rot);
    switch (i) {
      case 0: ell(50, 58, 31, 28, '#e8392f'); ell(38, 46, 9, 5, 'rgba(255,255,255,.55)', -0.6); ln(50, 30, 53, 16, '#6b4423', 4); leaf(62, 20, -0.4); break;
      case 1: ln(36, 68, 52, 22, '#4c8a3a', 3); ln(66, 64, 52, 22, '#4c8a3a', 3); cir(36, 70, 15, '#d6203a'); cir(66, 66, 15, '#c4182f'); cir(31, 65, 4, 'rgba(255,255,255,.6)'); cir(61, 61, 4, 'rgba(255,255,255,.6)'); leaf(62, 20, -0.3); break;
      case 2: cir(50, 56, 33, '#ff9b1f'); ell(38, 44, 10, 6, 'rgba(255,255,255,.45)', -0.6); leaf(52, 22, -0.5); cir(50, 24, 3, '#7a4a1b'); for (let k = 0; k < 5; k++) cir(34 + k * 8, 62 + (k % 2) * 8, 1.8, 'rgba(180,80,0,.5)'); break;
      case 3: for (const [x, y] of [[34, 46], [50, 44], [66, 46], [42, 62], [58, 62], [50, 78]]) { cir(x, y, 12, '#8b4fd6'); cir(x - 4, y - 4, 3.5, 'rgba(255,255,255,.5)'); } ln(50, 34, 50, 18, '#6b4423', 4); leaf(62, 22, -0.4); break;
      case 4: poly([[20, 38], [80, 38], [50, 90]], '#e8283f'); cir(28, 42, 10, '#e8283f'); cir(72, 42, 10, '#e8283f'); for (const [x, y] of [[36, 48], [50, 46], [64, 48], [42, 62], [58, 62], [50, 74]]) ell(x, y, 2, 3, '#ffe27a'); poly([[50, 34], [36, 24], [46, 32], [50, 18], [54, 32], [64, 24]], '#3fae4a'); break;
      case 5: c.beginPath(); c.arc(50, 34, 42, 0, Math.PI); c.closePath(); c.fillStyle = '#2f9e44'; c.fill(); c.beginPath(); c.arc(50, 34, 35, 0, Math.PI); c.closePath(); c.fillStyle = '#ff5468'; c.fill(); for (const [x, y] of [[34, 50], [50, 56], [66, 50], [42, 66], [58, 66]]) ell(x, y, 2.5, 4, '#1b1f33', 0.3); break;
      case 6: ell(50, 54, 36, 25, '#ffe14a', -0.4); poly([[16, 70], [22, 62], [28, 70]], '#ffe14a'); poly([[84, 38], [78, 46], [72, 38]], '#ffe14a'); ell(40, 46, 10, 4, 'rgba(255,255,255,.55)', -0.5); break;
      case 7: cir(50, 68, 25, '#9ccc3c'); cir(50, 42, 16, '#9ccc3c'); ell(42, 66, 7, 11, 'rgba(255,255,255,.4)'); ln(50, 28, 54, 14, '#6b4423', 4); leaf(64, 18, -0.4); break;
      case 8: poly([[20, 42], [24, 10], [46, 30]], '#ffa84a'); poly([[80, 42], [76, 10], [54, 30]], '#ffa84a'); cir(50, 58, 31, '#ffa84a'); poly([[50, 28], [44, 40], [56, 40]], '#e07a1a'); eye(38, 54, 6); eye(62, 54, 6); poly([[46, 66], [54, 66], [50, 71]], '#ff7fa6'); ln(26, 66, 8, 62, '#6b4423', 2); ln(74, 66, 92, 62, '#6b4423', 2); break;
      case 9: cir(30, 36, 14, '#5fcf5a'); cir(70, 36, 14, '#5fcf5a'); ell(50, 60, 38, 28, '#5fcf5a'); eye(30, 34, 8); eye(70, 34, 8); c.beginPath(); c.arc(50, 62, 18, 0.2, Math.PI - 0.2); c.strokeStyle = '#1f6b2a'; c.lineWidth = 3; c.stroke(); cir(40, 54, 2.2, '#1f6b2a'); cir(60, 54, 2.2, '#1f6b2a'); break;
      case 10: poly([[70, 52], [94, 32], [94, 72]], '#2f7fe0'); ell(46, 52, 32, 22, '#4fa3ff'); poly([[40, 32], [56, 24], [58, 36]], '#2f7fe0'); ell(40, 58, 14, 6, 'rgba(255,255,255,.35)', 0.2); eye(30, 46, 5); ln(54, 36, 54, 68, 'rgba(255,255,255,.35)', 3); break;
      case 11: cir(50, 54, 33, '#ffd83a'); poly([[44, 60], [56, 60], [50, 70]], '#ff8a1f'); eye(38, 50, 5); eye(62, 50, 5); ln(50, 22, 44, 12, '#ffd83a', 5); ln(50, 22, 56, 12, '#ffd83a', 5); ell(22, 62, 8, 12, '#f2b91a', 0.3); ell(78, 62, 8, 12, '#f2b91a', -0.3); break;
      case 12: ell(36, 26, 9, 22, '#f4f0ff'); ell(64, 26, 9, 22, '#f4f0ff'); ell(36, 28, 4, 15, '#ffb3cc'); ell(64, 28, 4, 15, '#ffb3cc'); cir(50, 64, 28, '#f4f0ff'); eye(40, 60, 5); eye(60, 60, 5); cir(50, 70, 3, '#ff7fa6'); ln(50, 73, 50, 78, '#c9bfe6', 2); break;
      case 13: cir(24, 30, 13, '#a56a3a'); cir(76, 30, 13, '#a56a3a'); cir(24, 30, 6, '#e6b98a'); cir(76, 30, 6, '#e6b98a'); cir(50, 56, 31, '#c28548'); ell(50, 67, 15, 12, '#f2d3a0'); cir(50, 62, 4, '#3a2412'); eye(38, 50, 5); eye(62, 50, 5); break;
      case 14: ell(50, 56, 29, 34, '#2d3a5c'); ell(50, 62, 18, 26, '#fff'); poly([[44, 44], [56, 44], [50, 54]], '#ff9a1f'); eye(40, 36, 5); eye(60, 36, 5); ell(38, 90, 10, 5, '#ff9a1f'); ell(62, 90, 10, 5, '#ff9a1f'); break;
      case 15: poly([[22, 38], [30, 14], [46, 30]], '#ff8fb0'); poly([[78, 38], [70, 14], [54, 30]], '#ff8fb0'); cir(50, 56, 33, '#ff9fbd'); ell(50, 66, 16, 12, '#ff7fa6'); cir(44, 66, 2.8, '#b3365f'); cir(56, 66, 2.8, '#b3365f'); eye(35, 48, 5); eye(65, 48, 5); break;
      case 16: { const pts: number[][] = []; for (let k = 0; k < 10; k++) { const a = -Math.PI / 2 + (k * Math.PI) / 5, r = k % 2 ? 17 : 40; pts.push([50 + Math.cos(a) * r, 54 + Math.sin(a) * r]); } poly(pts, '#ffcf33'); cir(44, 46, 5, 'rgba(255,255,255,.55)'); break; }
      case 17: c.beginPath(); c.moveTo(50, 86); c.bezierCurveTo(6, 56, 14, 18, 38, 22); c.bezierCurveTo(46, 23, 50, 32, 50, 36); c.bezierCurveTo(50, 32, 54, 23, 62, 22); c.bezierCurveTo(86, 18, 94, 56, 50, 86); c.fillStyle = '#ff4f7a'; c.fill(); ell(34, 36, 8, 5, 'rgba(255,255,255,.5)', -0.6); break;
      case 18: poly([[22, 38], [38, 18], [62, 18], [78, 38], [50, 84]], '#3fd0e8'); poly([[22, 38], [78, 38], [50, 84]], '#1fa6c9'); poly([[38, 18], [44, 38], [30, 38]], '#8ff0ff'); poly([[62, 18], [56, 38], [70, 38]], '#7ae3f5'); break;
      case 19: c.beginPath(); c.arc(48, 52, 36, 0, 7); c.arc(64, 44, 30, 0, 7); c.fillStyle = '#ffd95a'; c.fill('evenodd'); cir(78, 74, 4, '#ffd95a'); cir(84, 30, 3, '#ffd95a'); break;
      case 20: for (let k = 0; k < 12; k++) { const a = (k * Math.PI) / 6; poly([[50 + Math.cos(a - 0.14) * 28, 52 + Math.sin(a - 0.14) * 28], [50 + Math.cos(a) * 46, 52 + Math.sin(a) * 46], [50 + Math.cos(a + 0.14) * 28, 52 + Math.sin(a + 0.14) * 28]], '#ffb21f'); } cir(50, 52, 26, '#ffc93a'); eye(42, 48, 4); eye(58, 48, 4); c.beginPath(); c.arc(50, 56, 9, 0.2, Math.PI - 0.2); c.strokeStyle = '#c4731a'; c.lineWidth = 2.5; c.stroke(); break;
      case 21: for (let k = 0; k < 5; k++) { const a = -Math.PI / 2 + (k * 2 * Math.PI) / 5; cir(50 + Math.cos(a) * 22, 54 + Math.sin(a) * 22, 15, '#ff8fc4'); } cir(50, 54, 12, '#ffd23f'); cir(46, 50, 3, 'rgba(255,255,255,.6)'); break;
      case 22: { c.fillStyle = '#f6e6c8'; c.beginPath(); c.roundRect(36, 52, 28, 36, 8); c.fill(); c.beginPath(); c.ellipse(50, 54, 42, 36, 0, Math.PI, 0); c.closePath(); c.fillStyle = '#e8392f'; c.fill(); cir(34, 40, 6, '#fff'); cir(54, 30, 7, '#fff'); cir(68, 44, 5, '#fff'); break; }
      case 23: for (const [x, y] of [[36, 38], [64, 38], [36, 62], [64, 62]]) { cir(x, y, 17, '#3fb34a'); } cir(50, 50, 7, '#2e8f3a'); ln(50, 66, 58, 92, '#2e8f3a', 4); ell(34, 34, 6, 3, 'rgba(255,255,255,.4)', -0.5); break;
    }
  }
  function buildSprites() {
    if (sprites.length) return;
    for (let i = 0; i < NT; i++) {
      const cv = document.createElement('canvas'); cv.width = CW; cv.height = CH;
      const c = cv.getContext('2d')!;
      const x = (CW - TW) / 2, y = (CH - TH) / 2 - 1;
      const h = HUE(i);
      c.fillStyle = `hsl(${h} 55% 42%)`; c.beginPath(); c.roundRect(x, y + 3, TW, TH, 10); c.fill(); // đáy tối tạo độ nổi
      const gr = c.createLinearGradient(0, y, 0, y + TH);
      gr.addColorStop(0, '#ffffff'); gr.addColorStop(1, `hsl(${h} 70% 90%)`);
      c.fillStyle = gr; c.beginPath(); c.roundRect(x, y, TW, TH - 1, 10); c.fill();
      c.strokeStyle = `hsl(${h} 60% 60%)`; c.lineWidth = 2; c.beginPath(); c.roundRect(x + 1, y + 1, TW - 2, TH - 3, 9); c.stroke();
      c.fillStyle = 'rgba(255,255,255,.55)'; c.beginPath(); c.roundRect(x + 5, y + 3, TW - 10, 9, 5); c.fill(); // vệt bóng
      c.save(); const s = (TW - 14) / 100; c.translate(CW / 2 - 50 * s, y + (TH - 100 * s) / 2 + 2); c.scale(s, s);
      icon(c, i); c.restore();
      sprites.push(cv);
    }
  }

  // ---------- Hiệu ứng ----------
  const parts: { x: number; y: number; vx: number; vy: number; life: number; max: number; c: string; r: number; k: number }[] = [];
  const pops: { x: number; y: number; txt: string; life: number; col: string; size: number }[] = [];
  const cellXY = (i: number) => [(i % W) * CW + CW / 2, Math.floor(i / W) * CH + CH / 2];
  function burst(i: number, t: number) {
    if (fast) return;
    const [x, y] = cellXY(i), col = `hsl(${HUE(t)} 85% 60%)`;
    for (let k = 0; k < 12; k++) {
      const a = Math.random() * 6.283, v = 70 + Math.random() * 200;
      parts.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 50, life: 0.7, max: 0.7, c: k % 3 === 0 ? '#fff' : col, r: 3 + Math.random() * 4, k: k < 4 ? 1 : 0 });
    }
    parts.push({ x, y, vx: 0, vy: 0, life: 0.3, max: 0.3, c: col, r: 12, k: 2 });
  }
  function popup(x: number, y: number, txt: string, col = '#fff', size = 24) { if (!fast) pops.push({ x, y, txt, life: 1, col, size }); }

  // ---------- Bắt đầu màn ----------
  function say(t: string) { statusEl.textContent = t; }
  function fmtT(s: number) { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }
  function paintHud() {
    $('lk-lv').textContent = String(lv + 1);
    $('lk-sc').textContent = String(score);
    $('lk-tm').textContent = fmtT(timeLeft);
    let left = 0; for (let i = 0; i < g.length; i++) if (g[i] >= 0) left++;
    $('lk-left').textContent = String(left);
    $('lk-hn').textContent = String(hints); $('lk-sn').textContent = String(shufs);
    const f = $('lk-fill'); f.style.width = Math.max(0, (timeLeft / timeMax) * 100) + '%';
    f.classList.toggle('low', timeLeft / timeMax < 0.2);
  }
  function tilesLeft() { let n = 0; for (let i = 0; i < g.length; i++) if (g[i] >= 0) n++; return n; }

  function startLevel(i: number) {
    buildSprites();
    lv = i; const L = LV[i];
    R = L.r; C = L.c; W = C + 2; H = R + 2; mode = L.g;
    g = genGrid(R, C, L.t, mode);
    ox = new Float32Array(g.length); oy = new Float32Array(g.length);
    canvas.width = W * CW; canvas.height = H * CH;
    canvas.style.maxWidth = canvas.width + 'px';
    const wrapEl = $('lk-wrap'); wrapEl.style.maxWidth = canvas.width + 2 + 'px'; wrapEl.style.marginInline = 'auto';
    canvas.style.minWidth = Math.min(canvas.width, W * 30) + 'px';
    const pairs = (R * C) / 2;
    timeMax = Math.round(pairs * (5 - 0.2 * i)); timeLeft = timeMax;
    score = 0; combo = 0; lastMatch = -9999; hints = 3; shufs = 3;
    sel = -1; hintPair = null; line = null; busy = false; over = false; running = true; hover = -1;
    parts.length = 0; pops.length = 0; shakeT.clear();
    $('lk-ov').hidden = true;
    menu.hidden = true; gameEl.hidden = false;
    say(ui.modes[mode]);
    paintHud();
    sfx.music('calm');
    lastFrame = performance.now(); lastSec = Math.ceil(timeLeft);
    if (!raf) raf = requestAnimationFrame(frame);
  }

  // ---------- Luật chơi ----------
  async function connect(a: number, b: number, path: number[]) {
    busy = true; sel = -1; hintPair = null;
    const now = performance.now();
    combo = fast || now - lastMatch < 3200 ? combo + 1 : 1;
    lastMatch = now;
    const t = g[a];
    const mult = Math.min(5, combo);
    score += 100 * mult;
    timeLeft = Math.min(timeMax, timeLeft + 1.5 + Math.min(3, (combo - 1) * 0.5));
    if (!fast) {
      sfx.tone(523.25 * Math.pow(2, Math.min(combo - 1, 8) / 6), 0.14, 'triangle', 0.24);
      sfx.tone(784 * Math.pow(2, Math.min(combo - 1, 8) / 6), 0.18, 'sine', 0.16, undefined, 0.06);
    }
    line = { pts: path, t: 0 };
    await tween(240, (k) => { if (line) line.t = k; });
    line = null;
    burst(a, t); burst(b, t);
    const [mx, my] = cellXY(b);
    popup(mx, my - 20, combo > 1 ? `${ui.combo} x${mult}` : `+${100 * mult}`, combo > 1 ? '#ffd23f' : '#fff', combo > 1 ? 30 : 24);
    g[a] = -1; g[b] = -1;
    snd('gem');
    // trọng lực
    const mv = gravity(g, W, H, mode);
    if (mv.length) {
      const sx = new Float32Array(g.length), sy = new Float32Array(g.length);
      for (const [from, to] of mv) { sx[to] = ((from % W) - (to % W)) * CW; sy[to] = (Math.floor(from / W) - Math.floor(to / W)) * CH; }
      await tween(200, (k) => { const e = 1 - Math.pow(1 - k, 3); for (const [, to] of mv) { ox[to] = sx[to] * (1 - e); oy[to] = sy[to] * (1 - e); } });
      for (const [, to] of mv) { ox[to] = 0; oy[to] = 0; }
    }
    paintHud();
    if (tilesLeft() === 0) { finish(true); return; }
    if (!findPair(g, W, H)) await doReshuffle(true);
    busy = false;
  }

  async function doReshuffle(auto: boolean) {
    say(auto ? ui.reshuffle : '');
    snd('swoosh');
    g = reshuffle(g, W, H, mode);
    ox.fill(0); oy.fill(0);
    for (let i = 0; i < g.length; i++) if (g[i] >= 0) burst(i, g[i]);
    sel = -1; hintPair = null;
    setTimeout(() => { if (!over) say(ui.modes[mode]); }, 1800);
    paintHud();
  }

  function finish(win: boolean) {
    over = true; busy = true; running = false; sel = -1; line = null;
    sfx.music(null);
    const star = win ? (timeLeft / timeMax >= 0.45 ? 3 : timeLeft / timeMax >= 0.2 ? 2 : 1) : 0;
    let bonus = 0;
    if (win) { bonus = Math.round(timeLeft) * 10; score += bonus; }
    const b = best[lv];
    const newBest = win && score > b.b;
    if (win) { if (star > b.s) b.s = star; if (score > b.b) b.b = score; saveBest(); }
    snd(win ? 'win' : 'lose');
    $('lk-ovt').textContent = win ? ui.win : ui.lose;
    $('lk-ovs').innerHTML = win ? [1, 2, 3].map((n) => `<span class="${n <= star ? 'on' : ''}">★</span>`).join('') : '';
    $('lk-ovp').innerHTML = `${ui.score}: <b>${score}</b>${win ? ` · ${ui.timeBonus}: +${bonus}` : ''}<br>${ui.best}: <b>${Math.max(b.b, 0)}</b>${newBest ? ' 🏆' : ''}`;
    ($('lk-ovn') as HTMLElement).hidden = !(win && lv < LV.length - 1);
    $('lk-ov').hidden = false;
    paintHud();
    if (win) for (let i = 0; i < 30; i++) setTimeout(() => { if (!fast) { const x = Math.random() * canvas.width; parts.push({ x, y: -10, vx: (Math.random() - 0.5) * 120, vy: 120 + Math.random() * 160, life: 2.5, max: 2.5, c: `hsl(${Math.random() * 360} 85% 60%)`, r: 4 + Math.random() * 4, k: 0 }); } }, i * 40);
  }

  function click(i: number) {
    if (busy || over || !running) return;
    if (i < 0 || g[i] < 0) { sel = -1; return; }
    hintPair = null;
    if (sel < 0) { sel = i; snd('select'); return; }
    if (sel === i) { sel = -1; snd('click'); return; }
    if (g[sel] === g[i]) {
      const p = findPath(g, W, H, sel, i);
      if (p) { connect(sel, i, p); return; }
    }
    // không nối được: rung nhẹ rồi chọn quân mới
    const now = performance.now();
    shakeT.set(sel, now); shakeT.set(i, now);
    snd('error');
    sel = i;
  }

  // ---------- Vẽ ----------
  let raf = 0, lastFrame = 0, lastSec = 0;
  function draw(now: number) {
    const w = canvas.width, h = canvas.height;
    const bg = ctx.createLinearGradient(0, 0, 0, h);
    bg.addColorStop(0, '#1d2a5b'); bg.addColorStop(1, '#3a1f5e');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, w, h);
    // họa tiết chấm nền
    ctx.fillStyle = 'rgba(255,255,255,.05)';
    for (let y = 12; y < h; y += 32) for (let x = ((y / 32) % 2) * 16 + 12; x < w; x += 32) { ctx.beginPath(); ctx.arc(x, y, 2, 0, 7); ctx.fill(); }
    // khay bàn
    ctx.fillStyle = 'rgba(8,10,30,.35)';
    ctx.beginPath(); ctx.roundRect(CW - 8, CH - 8, C * CW + 16, R * CH + 16, 16); ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,.12)'; ctx.lineWidth = 2; ctx.stroke();

    const pulse = 0.5 + 0.5 * Math.sin(now / 160);
    for (let i = 0; i < g.length; i++) {
      if (g[i] < 0) continue;
      const r = Math.floor(i / W), c = i % W;
      let x = c * CW + ox[i], y = r * CH + oy[i];
      const st = shakeT.get(i);
      if (st !== undefined) { const k = (now - st) / 320; if (k >= 1) shakeT.delete(i); else x += Math.sin(k * 30) * 5 * (1 - k); }
      const isSel = i === sel, isHint = hintPair && (hintPair[0] === i || hintPair[1] === i);
      if (isSel) y -= 4 + pulse * 2;
      ctx.save();
      if (isSel) { ctx.shadowColor = '#ffe066'; ctx.shadowBlur = 18 + pulse * 10; }
      else if (isHint) { ctx.shadowColor = '#7dffb0'; ctx.shadowBlur = 10 + pulse * 18; }
      else if (i === hover) { ctx.shadowColor = '#9bd1ff'; ctx.shadowBlur = 10; }
      ctx.drawImage(sprites[g[i]], x, y);
      ctx.restore();
      if (isSel || isHint) {
        ctx.strokeStyle = isSel ? '#ffe066' : '#7dffb0'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.roundRect(x + (CW - TW) / 2 - 1, y + (CH - TH) / 2 - 2, TW + 2, TH + 1, 11); ctx.stroke();
      }
    }
    // đường nối đang hiện
    if (line) {
      const pts = line.pts.map(cellXY);
      ctx.save();
      ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      ctx.globalAlpha = 1 - Math.max(0, line.t - 0.6) / 0.4;
      ctx.shadowColor = '#fff27a'; ctx.shadowBlur = 20;
      ctx.strokeStyle = '#fff6b0'; ctx.lineWidth = 7;
      ctx.beginPath(); pts.forEach(([px, py], k) => (k ? ctx.lineTo(px, py) : ctx.moveTo(px, py))); ctx.stroke();
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3; ctx.stroke();
      ctx.restore();
    }
    // hạt
    for (const p of parts) {
      const a = Math.max(0, p.life / p.max);
      ctx.globalAlpha = a;
      if (p.k === 2) { ctx.strokeStyle = p.c; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(p.x, p.y, p.r + (1 - a) * 50, 0, 7); ctx.stroke(); }
      else if (p.k === 1) { ctx.fillStyle = p.c; ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.life * 8); ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r); ctx.restore(); }
      else { ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (0.4 + a * 0.6), 0, 7); ctx.fill(); }
    }
    ctx.globalAlpha = 1;
    for (const p of pops) {
      ctx.globalAlpha = Math.min(1, p.life * 1.6);
      ctx.font = `800 ${p.size}px system-ui, sans-serif`; ctx.textAlign = 'center';
      ctx.lineWidth = 5; ctx.strokeStyle = 'rgba(20,10,50,.85)'; ctx.strokeText(p.txt, p.x, p.y - (1 - p.life) * 40);
      ctx.fillStyle = p.col; ctx.fillText(p.txt, p.x, p.y - (1 - p.life) * 40);
    }
    ctx.globalAlpha = 1;
  }

  function frame(now: number) {
    raf = 0;
    if (gameEl.hidden) return;
    const dt = Math.min(0.05, (now - lastFrame) / 1000); lastFrame = now;
    if (running && !over && !document.hidden) {
      timeLeft -= dt;
      const sec = Math.ceil(timeLeft);
      if (sec !== lastSec) { lastSec = sec; if (sec <= 10 && sec > 0) sfx.play('tick'); paintHud(); }
      if (timeLeft <= 0) { timeLeft = 0; finish(false); }
      else { const f = $('lk-fill'); f.style.width = (timeLeft / timeMax) * 100 + '%'; }
    }
    for (let i = parts.length - 1; i >= 0; i--) { const p = parts[i]; p.life -= dt; if (p.life <= 0) { parts.splice(i, 1); continue; } p.x += p.vx * dt; p.y += p.vy * dt; if (p.k !== 2) { p.vy += 380 * dt; p.vx *= 0.99; } }
    for (let i = pops.length - 1; i >= 0; i--) { pops[i].life -= dt * 0.9; if (pops[i].life <= 0) pops.splice(i, 1); }
    draw(now);
    raf = requestAnimationFrame(frame);
  }

  // ---------- Điều khiển ----------
  function cellAt(e: PointerEvent) {
    const rc = canvas.getBoundingClientRect();
    const x = ((e.clientX - rc.left) * canvas.width) / rc.width, y = ((e.clientY - rc.top) * canvas.height) / rc.height;
    const c = Math.floor(x / CW), r = Math.floor(y / CH);
    if (c < 1 || c > C || r < 1 || r > R) return -1;
    return r * W + c;
  }
  canvas.addEventListener('pointerdown', (e) => { e.preventDefault(); click(cellAt(e)); });
  canvas.addEventListener('pointermove', (e) => { hover = e.pointerType === 'mouse' ? cellAt(e) : -1; });
  canvas.addEventListener('pointerleave', () => { hover = -1; });

  $('lk-hint').addEventListener('click', () => {
    if (busy || over || hints <= 0) { if (hints <= 0) snd('error'); return; }
    const p = findPair(g, W, H, true); if (!p) return;
    hints--; hintPair = [p[0], p[1]]; sel = -1; snd('power'); paintHud();
    setTimeout(() => { hintPair = null; }, 2500);
  });
  $('lk-shuf').addEventListener('click', async () => {
    if (busy || over || shufs <= 0) { if (shufs <= 0) snd('error'); return; }
    shufs--; busy = true; await doReshuffle(false); busy = false;
  });
  const restart = () => startLevel(lv);
  $('lk-restart').addEventListener('click', () => { snd('click'); restart(); });
  $('lk-ovr').addEventListener('click', () => { snd('click'); restart(); });
  $('lk-ovn').addEventListener('click', () => { snd('click'); startLevel(lv + 1); });
  function toMenu() { running = false; sfx.music(null); gameEl.hidden = true; menu.hidden = false; $('lk-ov').hidden = true; paintMenu(); }
  $('lk-back').addEventListener('click', () => { snd('click'); toMenu(); });
  $('lk-ovl').addEventListener('click', () => { snd('click'); toMenu(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) sfx.music(null); else if (running && !over) sfx.music('calm'); });
  mountMute($('lk-wrap'));

  function paintMenu() {
    const box = $('lk-levels'); box.innerHTML = '';
    LV.forEach((L, i) => {
      const unlocked = i === 0 || best[i - 1].s > 0;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'lk-lvl' + (unlocked ? '' : ' lock');
      b.disabled = !unlocked;
      if (!unlocked) b.title = ui.locked;
      b.innerHTML = `<b>${unlocked ? i + 1 : '🔒'}</b><span class="st">${[1, 2, 3].map((n) => (n <= best[i].s ? '★' : '☆')).join('')}</span><small>${L.c}×${L.r} · ${ui.modes[L.g]}</small>`;
      b.addEventListener('click', () => { sfx.play('click'); startLevel(i); });
      box.appendChild(b);
    });
    const total = best.reduce((a, x) => a + x.s, 0);
    $('lk-stat').textContent = total ? `${ui.stars}: ${total} / ${LV.length * 3}` : '';
  }
  paintMenu();

  // ---------- Hook thử nghiệm (chỉ khi có #debug trong URL) ----------
  if (location.hash.includes('debug')) {
    (window as any).__lk = {
      start: (i: number) => startLevel(i),
      state: () => ({ lv, R, C, left: tilesLeft(), score, over, timeLeft: Math.round(timeLeft), hints, shufs, over2: over }),
      findPath, findPair, genGrid, solvable,
      grid: () => g, dims: () => ({ W, H, mode }),
      async bot() {
        fast = true;
        let guard = 0;
        while (!over && guard++ < 500) {
          if (busy) { await new Promise((r) => setTimeout(r, 0)); continue; }
          const p = findPair(g, W, H);
          if (!p) break;
          await connect(p[0], p[1], p[2]);
        }
        fast = false;
        return { left: tilesLeft(), over, score };
      },
    };
  }
</script>

<style is:global>
  #lk .lk-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); margin: 6px 0 14px; }
  #lk .lk-lvl { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 12px 8px; border-radius: 14px; border: 1px solid var(--line); background: var(--card); color: var(--fg); cursor: pointer; font: inherit; transition: transform .15s, border-color .15s; }
  #lk .lk-lvl:hover:not(:disabled) { transform: translateY(-2px); border-color: var(--accent); }
  #lk .lk-lvl b { font-size: 1.5rem; }
  #lk .lk-lvl .st { color: #ffb21f; letter-spacing: 2px; font-size: 1rem; }
  #lk .lk-lvl small { color: var(--muted); font-size: .72rem; text-align: center; }
  #lk .lk-lvl.lock { opacity: .5; cursor: not-allowed; }
  #lk .lk-hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 8px; }
