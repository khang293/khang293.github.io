---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const T = {
  vi: {
    title: '2048', sub: 'Trượt các ô số, hai ô giống nhau gặp nhau thì gộp lại. Gộp được ô 2048 là thắng, nhưng bạn vẫn chơi tiếp được.',
    size4: 'Bàn 4×4', size5: 'Bàn 5×5', score: 'Điểm', best: 'Kỷ lục', undo: 'Đi lại', again: 'Ván mới',
    keys: 'Dùng phím mũi tên hoặc WASD, hoặc vuốt trên bàn cờ trên điện thoại.',
    win: 'Bạn đạt 2048! 🎉', cont: 'Chơi tiếp', over: 'Hết nước đi', tryAgain: 'Chơi lại',
  },
  en: {
    title: '2048', sub: 'Slide the tiles; when two equal tiles touch they merge. Build a 2048 tile to win, then keep going if you like.',
    size4: '4×4 board', size5: '5×5 board', score: 'Score', best: 'Best', undo: 'Undo', again: 'New game',
    keys: 'Use the arrow keys or WASD, or swipe on the board on a phone.',
    win: 'You made 2048! 🎉', cont: 'Keep going', over: 'No more moves', tryAgain: 'Try again',
  },
}[lang];
---
<Base lang={lang} title={T.title} description={T.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="g48" data-ui={JSON.stringify(T)}>
    <div class="bd-row">
      <button type="button" class="bd-opt sel" data-n="4">{T.size4}</button>
      <button type="button" class="bd-opt" data-n="5">{T.size5}</button>
    </div>
    <div class="g48-top">
      <div class="g48-box"><span>{T.score}</span><b id="g48-score">0</b></div>
      <div class="g48-box"><span>{T.best}</span><b id="g48-best">0</b></div>
      <button type="button" class="btn ghost sm" id="g48-undo">↶ {T.undo}</button>
      <button type="button" class="btn sm" id="g48-new">{T.again}</button>
    </div>
    <div class="g48-board" id="g48-board">
      <div class="g48-cells" id="g48-cells"></div>
      <div class="g48-tiles" id="g48-tiles"></div>
      <div class="g48-ov" id="g48-ov" hidden>
        <p id="g48-ovt"></p>
        <div class="bd-row" style="justify-content:center">
          <button type="button" class="btn sm" id="g48-ov1"></button>
          <button type="button" class="btn ghost sm" id="g48-ov2">{T.again}</button>
        </div>
      </div>
    </div>
    <p class="meta">{T.keys}</p>
  </div>
</Base>

<style is:global>
  #g48 { max-width: 520px; }
  .g48-top { display: flex; flex-wrap: wrap; gap: 10px; align-items: stretch; margin: 16px 0 12px; }
  .g48-box { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 6px 16px; text-align: center; min-width: 84px; }
  .g48-box span { display: block; font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .g48-box b { font-size: 1.25rem; }
  .g48-top .btn { align-self: center; }
  .g48-board { --n: 4; --gap: 2.6%; position: relative; width: 100%; aspect-ratio: 1; background: color-mix(in srgb, var(--accent) 14%, var(--card)); border: 1px solid var(--line); border-radius: 16px; touch-action: none; user-select: none; box-shadow: 0 10px 30px rgba(0,0,0,.12); }
  .g48-cells, .g48-tiles { position: absolute; inset: 0; }
  .g48-cell { position: absolute; border-radius: 10px; background: color-mix(in srgb, var(--accent) 10%, var(--bg)); opacity: .8; }
  .g48-tile { position: absolute; border-radius: 10px; display: grid; place-items: center; font-weight: 800; color: #fff; transition: left .12s ease, top .12s ease; text-shadow: 0 1px 2px rgba(0,0,0,.25); box-shadow: 0 2px 6px rgba(0,0,0,.18); container-type: size; }
  .g48-tile span { font-size: 42cqh; line-height: 1; }
  .g48-tile.l3 span { font-size: 34cqh; }
  .g48-tile.l4 span { font-size: 28cqh; }
  .g48-tile.l5 span { font-size: 23cqh; }
  .g48-tile.new { animation: g48pop .18s ease-out; }
  .g48-tile.mrg { animation: g48merge .2s ease-out; z-index: 3; }
  @keyframes g48pop { from { transform: scale(.3); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes g48merge { 0% { transform: scale(1); } 50% { transform: scale(1.22); } 100% { transform: scale(1); } }
  .g48-ov { position: absolute; inset: 0; border-radius: 16px; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(3px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; z-index: 5; text-align: center; }
  .g48-ov[hidden] { display: none; }
  .g48-ov p { font-size: 1.6rem; font-weight: 800; margin: 0 0 6px; }
</style>

<script>
  // <logic>
  // Trượt và gộp một hàng: nhận mảng giá trị theo thứ tự từ mép đẩy tới, trả về mảng mới + điểm
  function slideLine(vals) {
    const nz = vals.filter((v) => v > 0);
    const out = [];
    let score = 0;
    for (let i = 0; i < nz.length; i++) {
      if (i + 1 < nz.length && nz[i] === nz[i + 1]) { out.push(nz[i] * 2); score += nz[i] * 2; i++; }
      else out.push(nz[i]);
    }
    while (out.length < vals.length) out.push(0);
    return { line: out, score };
  }
  function canMove(grid, n) {
    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) {
      const v = grid[r][c];
      if (v === 0) return true;
      if (c + 1 < n && grid[r][c + 1] === v) return true;
      if (r + 1 < n && grid[r + 1][c] === v) return true;
    }
    return false;
  }
  // </logic>

  const root = document.getElementById('g48') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const board = document.getElementById('g48-board') as HTMLElement;
  const cellsEl = document.getElementById('g48-cells') as HTMLElement;
  const tilesEl = document.getElementById('g48-tiles') as HTMLElement;
  const scoreEl = document.getElementById('g48-score') as HTMLElement;
  const bestEl = document.getElementById('g48-best') as HTMLElement;
  const ov = document.getElementById('g48-ov') as HTMLElement;
  const ovt = document.getElementById('g48-ovt') as HTMLElement;
  const ov1 = document.getElementById('g48-ov1') as HTMLButtonElement;

  type Tile = { id: number; v: number; r: number; c: number; el: HTMLElement };
  let N = 4;
  let tiles: Tile[] = [];
  let score = 0, won = false, keep = false, over = false, busy = false, uid = 1;
  let hist: { cells: { v: number; r: number; c: number }[]; score: number; won: boolean; keep: boolean }[] = [];
  const bestKey = () => 'g2048-best' + N;
  let best = 0;
  const loadBest = () => { try { best = +(localStorage.getItem(bestKey()) || 0) || 0; } catch { best = 0; } bestEl.textContent = String(best); };
  const saveBest = () => { try { localStorage.setItem(bestKey(), String(best)); } catch {} };

  const GAP = 2.6;
  const sz = () => (100 - GAP * (N + 1)) / N;
  const pos = (i: number) => GAP + i * (sz() + GAP);
  const color = (v: number) => {
    const k = Math.log2(v);
    const hue = (k * 33 + 200) % 360;
    return `linear-gradient(145deg, hsl(${hue} 70% 58%), hsl(${hue} 68% 44%))`;
  };

  function drawCells() {
    cellsEl.innerHTML = '';
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
      const d = document.createElement('div');
      d.className = 'g48-cell';
      d.style.cssText = `left:${pos(c)}%;top:${pos(r)}%;width:${sz()}%;height:${sz()}%`;
      cellsEl.appendChild(d);
    }
  }
  function style(t: Tile) {
    t.el.style.left = pos(t.c) + '%'; t.el.style.top = pos(t.r) + '%';
    t.el.style.width = sz() + '%'; t.el.style.height = sz() + '%';
  }
  function makeTile(v: number, r: number, c: number, cls = ''): Tile {
    const el = document.createElement('div');
    const len = String(v).length;
    el.className = 'g48-tile' + (len >= 3 ? ' l' + Math.min(len, 5) : '') + (cls ? ' ' + cls : '');
    el.style.background = color(v);
    el.innerHTML = `<span>${v}</span>`;
    const t = { id: uid++, v, r, c, el };
    style(t);
    tilesEl.appendChild(el);
    return t;
  }
  const grid = () => {
    const g = Array.from({ length: N }, () => Array(N).fill(0));
    for (const t of tiles) g[t.r][t.c] = t.v;
    return g;
  };
  function spawn() {
    const g = grid();
    const free: [number, number][] = [];
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) if (!g[r][c]) free.push([r, c]);
    if (!free.length) return;
    const [r, c] = free[Math.floor(Math.random() * free.length)];
    tiles.push(makeTile(Math.random() < 0.9 ? 2 : 4, r, c, 'new'));
  }
  function setScore(s: number) {
    score = s; scoreEl.textContent = String(s);
    if (s > best) { best = s; bestEl.textContent = String(best); saveBest(); }
  }
  function showOv(text: string, btn: string, fn: () => void) {
    ovt.textContent = text; ov1.textContent = btn; ov1.onclick = fn; ov.hidden = false;
  }

  function newGame(n?: number) {
    if (n) N = n;
    board.style.setProperty('--n', String(N));
    tilesEl.innerHTML = ''; tiles = []; hist = []; score = 0; won = false; keep = false; over = false; busy = false;
    scoreEl.textContent = '0'; ov.hidden = true;
    loadBest(); drawCells();
    spawn(); spawn();
  }

  function restore(s: typeof hist[number]) {
    tilesEl.innerHTML = ''; tiles = [];
    for (const c of s.cells) tiles.push(makeTile(c.v, c.r, c.c));
    score = s.score; scoreEl.textContent = String(score); won = s.won; keep = s.keep; over = false; ov.hidden = true;
  }

  function move(dir: 'L' | 'R' | 'U' | 'D') {
    if (busy || over) return;
    if (!ov.hidden) return;
    const horiz = dir === 'L' || dir === 'R';
    const fwd = dir === 'R' || dir === 'D'; // đẩy về chỉ số lớn
    const snap = { cells: tiles.map((t) => ({ v: t.v, r: t.r, c: t.c })), score, won, keep };
    let moved = false, gain = 0;
    const consumed: Tile[] = [], created: Tile[] = [];
    for (let i = 0; i < N; i++) {
      let line = tiles.filter((t) => (horiz ? t.r : t.c) === i);
      line.sort((a, b) => (horiz ? a.c - b.c : a.r - b.r));
      if (fwd) line.reverse();
      let slot = 0;
      for (let k = 0; k < line.length; k++) {
        const t = line[k], nx = line[k + 1];
        const idx = fwd ? N - 1 - slot : slot;
        if (nx && nx.v === t.v) {
          for (const s of [t, nx]) { if (horiz) { if (s.c !== idx) moved = true; s.c = idx; } else { if (s.r !== idx) moved = true; s.r = idx; } style(s); }
          moved = true; gain += t.v * 2;
          consumed.push(t, nx);
          created.push({ id: 0, v: t.v * 2, r: horiz ? i : idx, c: horiz ? idx : i, el: null as any });
          k++; slot++;
        } else {
          if (horiz) { if (t.c !== idx) moved = true; t.c = idx; } else { if (t.r !== idx) moved = true; t.r = idx; }
          style(t); slot++;
        }
      }
    }
    if (!moved) return;
    hist.push(snap); if (hist.length > 30) hist.shift();
    busy = true;
    setTimeout(() => {
      for (const t of consumed) t.el.remove();
      tiles = tiles.filter((t) => !consumed.includes(t));
      for (const c of created) tiles.push(makeTile(c.v, c.r, c.c, 'mrg'));
      if (gain) setScore(score + gain);
      spawn();
      busy = false;
      if (!won && !keep && tiles.some((t) => t.v >= 2048)) {
        won = true; showOv(ui.win, ui.cont, () => { keep = true; ov.hidden = true; });
      } else if (!canMove(grid(), N)) {
        over = true; showOv(ui.over, ui.tryAgain, () => newGame());
      }
    }, 125);
  }

  document.addEventListener('keydown', (e) => {
    const m: Record<string, 'L' | 'R' | 'U' | 'D'> = { ArrowLeft: 'L', a: 'L', A: 'L', ArrowRight: 'R', d: 'R', D: 'R', ArrowUp: 'U', w: 'U', W: 'U', ArrowDown: 'D', s: 'D', S: 'D' };
    const d = m[e.key];
    if (!d || e.ctrlKey || e.metaKey || e.altKey) return;
    e.preventDefault(); move(d);
  });
  let sx = 0, sy = 0, sid = -1;
  board.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; sid = e.pointerId; });
  board.addEventListener('pointerup', (e) => {
    if (e.pointerId !== sid) return; sid = -1;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
    move(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'R' : 'L') : (dy > 0 ? 'D' : 'U'));
  });
  board.addEventListener('pointercancel', () => { sid = -1; });

  document.getElementById('g48-new')!.addEventListener('click', () => newGame());
  document.getElementById('g48-undo')!.addEventListener('click', () => {
    if (busy) return;
    const s = hist.pop(); if (s) restore(s);
  });
  root.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('[data-n]').forEach((x) => x.classList.remove('sel'));
    b.classList.add('sel'); newGame(+(b.dataset.n || 4));
  }));

  newGame(4);
  if (location.hash.includes('debug')) (window as any).__g48 = { slideLine, canMove, get tiles() { return tiles; }, move, grid, setTiles(arr: number[][]) {
    tilesEl.innerHTML = ''; tiles = [];
    arr.forEach((row, r) => row.forEach((v, c) => { if (v) tiles.push(makeTile(v, r, c)); }));
  } };
</script>
