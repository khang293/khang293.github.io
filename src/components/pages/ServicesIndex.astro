---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../ServiceCard.astro';
import CtaBand from '../CtaBand.astro';
import CalcTeaser from '../CalcTeaser.astro';
import { SITE } from '../../config';
import { ui, lp, type Lang } from '../../i18n';
import { getServices } from '../../lib';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const services = await getServices(lang);
---
<Base wide lang={lang} title={t.servicesPage.title} description={t.servicesPage.sub}>
  <div class="page-head"><h1>{t.servicesPage.title}</h1><p>{t.servicesPage.sub}</p></div>
  <div class="grid">{services.map((s) => <ServiceCard entry={s} lang={lang} />)}</div>

  <section class="block">
    <div class="block-head"><h2>{t.servicesPage.engageTitle}</h2></div>
    <div class="grid">
      {t.servicesPage.engage.map((x, i) => (
        <div class="card static pkg">
          <h3>{x.t}</h3>
          <p>{x.d}</p>
          <ul class="ticks">{x.b.map((b) => <li>{b}</li>)}</ul>
          <div class="price">
            <small>{t.servicesPage.priceLabel}</small>
            <b>{SITE.packagePrices[lang][i] || t.servicesPage.priceOnRequest}</b>
          </div>
          <a class="btn sm" href={lp(lang, '/contact/')}>{t.servicesPage.cta}</a>
        </div>
      ))}
    </div>
    <p class="meta engage-note">{t.servicesPage.engageNote}</p>
    <div class="cta-actions left engage-links">
      <a class="btn ghost" href={lp(lang, '/how-we-work/')}>{t.howLink}</a>
      <a class="btn ghost" href={t.profile.file} download>{t.profile.download}</a>
    </div>
  </section>

  <CalcTeaser lang={lang} />

  <section class="block narrow">
    <div class="block-head"><h2>{t.servicesPage.faq}</h2></div>
    <div class="faq">
      {t.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
