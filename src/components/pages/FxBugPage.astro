---
import Base from '../../layouts/Base.astro';
import { lp, ui, type Lang } from '../../i18n';
import { fxUi, puzzles } from '../../data/fxbug';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = fxUi[lang];
// Chỉ gửi xuống trình duyệt phần của ngôn ngữ hiện tại
const data = puzzles.map((p) => ({ lv: p.lv, k: p.k, plain: !!p.plain, ctx: p.ctx[lang], code: p.code, bug: p.bug, fix: p.fix, why: p.why[lang] }));
const payload = { ui: g, data };
---
<Base lang={lang} title={g.title} description={g.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{gamesUi[lang].back}</a></p>
  <h1>{g.title}</h1>
  <p class="meta">{g.sub}</p>

  <div id="fxbug" data-contact={lp(lang, '/contact/')} data-contact-label={ui[lang].nav.contact}>
    <noscript><p>JavaScript is required to play.</p></noscript>
  </div>
  <script type="application/json" id="fxbug-data" set:html={JSON.stringify(payload)} />
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  type P = { lv: string; k: string; plain: boolean; ctx: string; code: string[]; bug: number | number[]; fix: string; why: string };
  const root = document.getElementById('fxbug') as HTMLElement;
  const raw = JSON.parse(document.getElementById('fxbug-data')!.textContent || '{}');
  const ui = raw.ui;
  const data: P[] = raw.data;
  const LEVELS = ['easy', 'medium', 'hard', 'mix'];
  const ROUND = 10;
  const muteHost = document.createElement('div'); muteHost.className = 'fx-mute-host'; root.before(muteHost); mountMute(muteHost);

  // Pháo giấy bằng CSS rơi trong khung kết quả
  function confetti(host: HTMLElement) {
    const colors = ['#f59e0b', '#16a34a', '#3b82f6', '#ec4899', '#a855f7', '#ef4444'];
    const wrap = document.createElement('div');
    wrap.className = 'fx-confetti';
    for (let i = 0; i < 46; i++) {
      const s = document.createElement('i');
      s.style.left = Math.random() * 100 + '%';
      s.style.background = colors[i % colors.length];
      s.style.animationDelay = Math.random() * 0.6 + 's';
      s.style.animationDuration = 1.6 + Math.random() * 1.4 + 's';
      s.style.setProperty('--dx', (Math.random() * 160 - 80) + 'px');
      s.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
      wrap.append(s);
    }
    host.append(wrap);
    setTimeout(() => wrap.remove(), 3600);
  }

  const bestKey = (lv: string) => 'fxbug-best-' + lv;
  const getBest = (lv: string): number | null => {
    try { const v = localStorage.getItem(bestKey(lv)); return v === null ? null : Number(v); } catch { return null; }
  };
  const setBest = (lv: string, n: number) => { try { localStorage.setItem(bestKey(lv), String(n)); } catch {} };
  const getStreak = (): number => { try { return Number(localStorage.getItem('fxbug-streak') || 0); } catch { return 0; } };
  const setStreak = (n: number) => { try { localStorage.setItem('fxbug-streak', String(n)); } catch {} };

  function shuffle<T>(arr: T[]): T[] {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }

  // Tô màu cú pháp rất đơn giản
  const TOKEN = /(\/\/.*$)|("(?:[^"]|"")*"|'[^']*')|(\b\d+(?:\.\d+)?\b)|([A-Za-z_][A-Za-z0-9_]*)(?=\s*\()|(\b(?:true|false|null)\b)|(&&|\|\||[=<>+\-*&!]+|\bin\b|\bAs\b)/g;
  function paint(text: string, plain: boolean): DocumentFragment {
    const frag = document.createDocumentFragment();
    if (plain) { frag.append(text); return frag; }
    let last = 0;
    for (const m of text.matchAll(TOKEN)) {
      const i = m.index || 0;
      if (i > last) frag.append(text.slice(last, i));
      const cls = m[1] ? 'c' : m[2] ? 's' : m[3] ? 'n' : m[4] ? 'f' : m[5] ? 'k' : 'o';
      const sp = el('span', 'fx-' + cls, m[0]);
      frag.append(sp);
      last = i + m[0].length;
    }
    if (last < text.length) frag.append(text.slice(last));
    return frag;
  }

  function menu() {
    root.replaceChildren();
    const grid = el('div', 'fx-levels');
    LEVELS.forEach((lv) => {
      const b = el('button', 'fx-level fx-' + lv) as HTMLButtonElement;
      b.type = 'button';
      b.append(el('b', '', ui.levels[lv]));
      if (ui.levelDesc[lv]) b.append(el('span', '', ui.levelDesc[lv]));
      const best = getBest(lv);
      if (best !== null) b.append(el('em', '', ui.best + ': ' + best + '/' + ROUND));
      b.addEventListener('click', () => play(lv));
      grid.append(b);
    });
    root.append(grid);
    const sk = getStreak();
    if (sk > 0) root.append(el('p', 'meta', ui.streak + ': ' + sk));
  }

  function play(lv: string) {
    const pool = lv === 'mix' ? data : data.filter((x) => x.lv === lv);
    const picked = shuffle(pool).slice(0, ROUND);
    let idx = 0, score = 0, run = 0, bestRun = 0;

    function show() {
      const cur = picked[idx];
      const bugs = Array.isArray(cur.bug) ? cur.bug : [cur.bug];
      root.replaceChildren();
      const head = el('div', 'qz-head fx-head');
      head.append(
        el('span', 'fx-tag fx-' + cur.lv, ui.levels[cur.lv]),
        el('span', 'fx-tag fx-kind', cur.k === 'pa' ? ui.pa : ui.fx),
        el('span', 'meta fx-count', ui.puzzle + ' ' + (idx + 1) + '/' + picked.length + (run > 1 ? ' · 🔥 ' + run : ''))
      );
      const bar = el('div', 'fx-bar');
      const fill = el('i');
      fill.style.width = (idx / picked.length) * 100 + '%';
      bar.append(fill);
      const q = el('p', 'fx-ctx', cur.ctx);
      const hint = el('p', 'meta', ui.pick);
      const box = el('div', 'fx-code');
      const fb = el('div', 'fx-fb');
      fb.setAttribute('aria-live', 'polite');
      const next = el('button', 'btn fx-next', idx === picked.length - 1 ? ui.finish : ui.next) as HTMLButtonElement;
      next.type = 'button';
      next.hidden = true;
      next.addEventListener('click', () => { idx++; idx < picked.length ? show() : result(); });

      const rows: HTMLButtonElement[] = cur.code.map((line, i) => {
        const r = el('button', 'fx-line') as HTMLButtonElement;
        r.type = 'button';
        r.setAttribute('aria-label', ui.line + ' ' + (i + 1));
        const code = el('code');
        code.append(paint(line, cur.plain));
        r.append(el('span', 'fx-ln', String(i + 1)), code);
        r.addEventListener('click', () => {
          const ok = bugs.includes(i);
          fill.style.width = ((idx + 1) / picked.length) * 100 + '%';
          rows.forEach((x, k) => {
            x.disabled = true;
            if (bugs.includes(k)) x.classList.add(ok ? 'ok' : 'bug');
          });
          if (ok) { score++; run++; if (run > bestRun) bestRun = run; fb.className = 'fx-fb ok'; fb.append(el('b', '', ui.right)); r.classList.add('pop'); sfx.play(run >= 3 ? 'combo' : 'correct'); }
          else { r.classList.add('miss', 'shake'); run = 0; sfx.play('wrong'); fb.className = 'fx-fb bad'; fb.append(el('b', '', ui.wrong)); }
          fb.append(el('p', '', cur.why));
          fb.append(el('p', 'fx-fixlabel', ui.fixed));
          const fixBox = el('pre', 'fx-fix');
          const fc = el('code');
          fc.append(paint(cur.fix, cur.plain && !/\(/.test(cur.fix)));
          fixBox.append(fc);
          fb.append(fixBox);
          next.hidden = false;
          next.focus();
        });
        return r;
      });
      box.append(...rows);
      root.append(head, bar, q, hint, box, fb, next);
    }

    function result() {
      const prev = getBest(lv);
      if (prev === null || score > prev) setBest(lv, score);
      if (bestRun > getStreak()) setStreak(bestRun);
      const ratio = score / picked.length;
      const grade = ui.grades[ratio < 0.4 ? 0 : ratio < 0.7 ? 1 : ratio < 0.9 ? 2 : 3];
      root.replaceChildren();
      sfx.play(ratio >= 0.7 ? 'win' : 'lose');
      const box = el('div', 'fx-result');
      box.append(el('p', 'meta', ui.score), el('div', 'fx-big', score + '/' + picked.length), el('p', '', grade), el('p', 'meta', ui.streakNow + ': ' + bestRun));
      const actions = el('div', 'fx-actions');
      const again = el('button', 'btn', ui.again) as HTMLButtonElement;
      again.type = 'button';
      again.addEventListener('click', () => play(lv));
      const change = el('button', 'btn ghost', ui.change) as HTMLButtonElement;
      change.type = 'button';
      change.addEventListener('click', menu);
      actions.append(again, change);
      const cta = el('div', 'fx-cta');
      const a1 = el('a', 'btn ghost', ui.ctaBtn) as HTMLAnchorElement;
      a1.href = root.dataset.contact || '/';
      cta.append(el('p', '', ui.cta), a1);
      box.append(actions, cta);
      root.append(box);
      if (ratio >= 0.7) setTimeout(() => confetti(box), 150);
      document.title = 'fxbug:' + score + '/' + picked.length;
    }

    show();
  }

  menu();
</script>

<style is:global>
  .sfx-btn { background: rgba(30, 35, 60, .88) !important; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
  .fx-levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-top: 22px; }
  .fx-level { text-align: left; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 16px; padding: 18px; cursor: pointer; display: flex; flex-direction: column; gap: 4px; font: inherit; border-top: 4px solid var(--accent); }
  .fx-level:hover { border-color: var(--accent); }
  .fx-level b { font-size: 1.15rem; }
  .fx-level span { color: var(--muted); font-size: .92rem; line-height: 1.4; }
  .fx-level em { font-style: normal; font-size: .85rem; color: var(--badge); font-weight: 600; margin-top: 4px; }
  .fx-level.fx-easy { border-top-color: #16a34a; }
  .fx-level.fx-medium { border-top-color: #f59e0b; }
  .fx-level.fx-hard { border-top-color: #dc2626; }
  .fx-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 18px 0 8px; }
  .fx-count { margin-left: auto; }
  .fx-tag { font-size: .8rem; font-weight: 700; padding: 2px 10px; border-radius: 99px; color: #fff; background: #16a34a; }
  .fx-tag.fx-medium { background: #d97706; }
  .fx-tag.fx-hard { background: #dc2626; }
  .fx-tag.fx-kind { background: var(--card); color: var(--fg); border: 1px solid var(--line); }
  .fx-bar { height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; }
.fx-bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), #22c55e); transition: width .55s cubic-bezier(.3, 1, .4, 1); border-radius: 99px; }
  .fx-ctx { margin: 20px 0 6px; font-size: 1.1rem; line-height: 1.5; }
  .fx-code { margin-top: 10px; background: #14161c; border: 1px solid var(--line); border-radius: 12px; padding: 6px 0; overflow-x: auto; }
  .fx-line { display: flex; width: 100%; min-width: max-content; gap: 14px; text-align: left; background: transparent; border: 0; border-left: 4px solid transparent; padding: 5px 14px 5px 8px; font: inherit; color: #e5e7eb; cursor: pointer; }
  .fx-line code, .fx-fix code { font-family: ui-monospace, SFMono-Regular, Consolas, Menlo, monospace; font-size: .92rem; white-space: pre; background: none; color: inherit; padding: 0; }
  .fx-line:hover:not(:disabled) { background: rgba(255, 255, 255, .08); border-left-color: var(--accent); }
  .fx-line { transition: background .2s, border-color .2s; }
  .fx-line:disabled { cursor: default; }
  .fx-line.pop { animation: fxPop .5s ease; }
  .fx-line.shake { animation: fxShake .4s ease; }
  .fx-ctx { animation: fxIn .35s ease both; }
  .fx-code { animation: fxIn .35s .05s ease both; }
  .fx-fb:not(:empty) { animation: fxIn .3s ease; }
  .fx-result { position: relative; overflow: hidden; animation: fxIn .4s ease; }
  .fx-big { animation: fxPop .7s ease; }
  .fx-mute-host { position: relative; height: 0; }
  .fx-mute-host .sfx-btn { top: -34px !important; right: 0 !important; }
  .fx-confetti { position: absolute; inset: 0; pointer-events: none; }
  .fx-confetti i { position: absolute; top: -12px; width: 9px; height: 14px; border-radius: 2px; animation: fxFall 2s linear forwards; }
  @keyframes fxPop { 0% { transform: scale(1); } 40% { transform: scale(1.03); } 100% { transform: scale(1); } }
  @keyframes fxShake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-7px); } 40% { transform: translateX(7px); } 60% { transform: translateX(-5px); } 80% { transform: translateX(4px); } }
  @keyframes fxIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes fxFall { 0% { transform: translate(0, 0) rotate(0); opacity: 1; } 100% { transform: translate(var(--dx), 420px) rotate(var(--rot)); opacity: 0; } }
  .fx-ln { color: #6b7280; width: 1.4em; text-align: right; flex: none; font-family: ui-monospace, Consolas, monospace; font-size: .85rem; line-height: 1.6; user-select: none; }
  .fx-line.ok { background: rgba(22, 163, 74, .25); border-left-color: #16a34a; }
  .fx-line.bug { background: rgba(220, 38, 38, .28); border-left-color: #dc2626; }
  .fx-line.miss { background: rgba(245, 158, 11, .18); border-left-color: #f59e0b; }
  .fx-c { color: #7c8a99; font-style: italic; }
  .fx-s { color: #f5a97f; }
  .fx-n { color: #b5e08c; }
  .fx-f { color: #7cc4ff; }
  .fx-k { color: #c792ea; }
  .fx-o { color: #9aa5b1; }
  .fx-fb { margin: 14px 0 4px; font-size: .95rem; line-height: 1.55; }
  .fx-fb.ok > b { color: #16a34a; }
  .fx-fb.bad > b { color: #dc2626; }
  .fx-fb p { margin: 6px 0; }
  .fx-fixlabel { color: var(--muted); font-size: .85rem; margin-top: 12px; }
  .fx-fix { margin: 4px 0 0; background: #14161c; color: #e5e7eb; border: 1px solid #16a34a; border-radius: 10px; padding: 10px 14px; overflow-x: auto; }
  .fx-next { margin-top: 12px; }
  .fx-result { text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 28px 18px; margin-top: 22px; }
  .fx-big { font-size: 3.2rem; font-weight: 800; color: var(--accent); line-height: 1.1; margin: 4px 0 8px; }
  .fx-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 18px 0; }
  .fx-cta { border-top: 1px solid var(--line); padding-top: 16px; color: var(--muted); }
</style>
