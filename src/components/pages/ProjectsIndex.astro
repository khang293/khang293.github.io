---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import CtaBand from '../CtaBand.astro';
import { ui, type Lang } from '../../i18n';
import { getProjects } from '../../lib';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
---
<Base wide lang={lang} title={t.projectsPage.title} description={t.projectsPage.sub}>
  <div class="page-head"><h1>{t.projectsPage.title}</h1><p>{t.projectsPage.sub}</p></div>
  <div class="grid">{projects.map((p) => <ProjectCard entry={p} lang={lang} />)}</div>
  <CtaBand lang={lang} />
</Base>
