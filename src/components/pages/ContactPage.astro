---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { ui, lp, type Lang } from '../../i18n';
import { getServices } from '../../lib';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contact;
const f = c.fieldNames;
const services = await getServices(lang);
const channels = [
  SITE.email && { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}` },
  SITE.zalo && { label: 'Zalo', value: t.zaloText, href: SITE.zalo.startsWith('http') ? SITE.zalo : `https://zalo.me/${SITE.zalo}` },
  SITE.telegram && { label: 'Telegram', value: `@${SITE.telegram}`, href: `https://t.me/${SITE.telegram}` },
  SITE.github && { label: 'GitHub', value: SITE.github.replace('https://', ''), href: SITE.github },
  SITE.linkedin && { label: 'LinkedIn', value: 'LinkedIn', href: SITE.linkedin },
].filter(Boolean) as { label: string; value: string; href: string }[];
const thanks = new URL(lp(lang, '/contact/?sent=1'), Astro.site).href;
---
<Base lang={lang} title={c.title} description={c.sub}>
  <h1>{c.title}</h1>
  <p class="meta">{c.sub}</p>

  <p id="sent" class="ok" hidden>✅ {lang === 'vi' ? 'Đã gửi! Mình sẽ phản hồi sớm.' : 'Sent! I will reply soon.'}</p>

  {SITE.formspree ? (
    <form id="contact-form" class="form" method="post" action={`https://formspree.io/f/${SITE.formspree}`} data-brand={SITE.brand} data-prefix={f.subjectPrefix}>
      <label>{c.name}<input name={f.name} required maxlength="80" autocomplete="name" /></label>
      <label>{c.email}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{c.service}
        <select name={f.service} id="cf-service">
          {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
          <option value={c.other}>{c.other}</option>
        </select>
      </label>
      <label>{c.budget}<input name={f.budget} maxlength="80" placeholder={c.budgetHint} /></label>
      <label>{c.timeline}
        <select name={f.timeline}>
          {c.timelineOpts.map((o) => <option value={o}>{o}</option>)}
        </select>
      </label>
      <label>{c.message}<textarea name={f.message} rows="6" required maxlength="3000"></textarea></label>
      <p class="consent">{c.consent} <a href={lp(lang, '/privacy/')}>{t.privacy}</a>.</p>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" />
      <input type="hidden" name="_subject" id="cf-subject" value={`[${SITE.brand}] ${f.subjectPrefix}`} />
      <input type="hidden" name={f.lang} value={f.langValue} />
      <input type="hidden" name={f.page} id="cf-page" value="" />
      <input type="hidden" name="_next" value={thanks} />
      <button class="btn" type="submit">{c.send}</button>
    </form>
  ) : (
    <p class="notice">{c.notConfigured}</p>
  )}

  {channels.length > 0 && (
    <section class="panel">
      <h2>{c.direct}</h2>
      <ul class="plain">
        {channels.map((ch) => <li><b>{ch.label}:</b> <a href={ch.href} rel="noopener">{ch.value}</a></li>)}
      </ul>
      {SITE.zalo && (
        <div class="qr">
          <img src="/zalo-qr.jpg" alt="Zalo QR" width="160" height="160" loading="lazy" />
          <p>{t.zaloQr}</p>
        </div>
      )}
    </section>
  )}

  <script is:inline>
    if (new URLSearchParams(location.search).has('sent')) document.getElementById('sent').hidden = false;

    // Tiêu đề email tự thêm tên người gửi và dịch vụ quan tâm; ghi lại trang gửi
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var page = document.getElementById('cf-page');
      if (page) page.value = location.href.split('?')[0];
      form.addEventListener('submit', function () {
        var first = form.querySelector('input:not([type=hidden])');
        var name = first ? first.value.trim().slice(0, 60) : '';
        var svc = document.getElementById('cf-service');
        var service = svc ? svc.value : '';
        var subject = '[' + form.dataset.brand + '] ' + form.dataset.prefix;
        if (name) subject += ': ' + name;
        if (service) subject += ' - ' + service;
        document.getElementById('cf-subject').value = subject;
      });
    })();
  </script>
</Base>
