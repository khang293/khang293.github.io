    g.fillStyle = 'rgba(0,0,0,.35)'; rr(x + 3, y + 6, C - 4, C - 4, maze ? 3 : 9); g.fill();
    const gr = g.createLinearGradient(x, y, x, y + C);
    gr.addColorStop(0, maze ? '#b4783a' : '#a8afb9'); gr.addColorStop(1, maze ? '#6b3a17' : '#4b5563');
    g.fillStyle = gr; rr(x + 2, y + 2, C - 4, C - 4, maze ? 3 : 9); g.fill();
    if (maze) {
      // đường vữa của gạch
      g.strokeStyle = 'rgba(40,18,6,.55)'; g.lineWidth = 1.4;
      g.beginPath(); g.moveTo(x + 2, y + C / 2); g.lineTo(x + C - 2, y + C / 2);
      const off = (r.x + r.y) % 2 ? 9 : 19;
      g.moveTo(x + off, y + 2); g.lineTo(x + off, y + C / 2); g.moveTo(x + C - off, y + C / 2); g.lineTo(x + C - off, y + C - 2); g.stroke();
      g.fillStyle = 'rgba(255,220,170,.28)'; g.fillRect(x + 3, y + 3, C - 7, 2);
    } else {
      g.fillStyle = 'rgba(255,255,255,.28)'; rr(x + 6, y + 5, C - 16, 5, 3); g.fill();
      g.strokeStyle = 'rgba(30,41,59,.45)'; g.lineWidth = 1.3;
      g.beginPath(); g.moveTo(x + 11, y + 14); g.lineTo(x + 15, y + 19); g.lineTo(x + 13, y + 25); g.stroke();
      g.fillStyle = 'rgba(74,222,128,.55)'; g.beginPath(); g.ellipse(x + C - 8, y + C - 8, 5, 3, -0.4, 0, 7); g.fill();
    }
  }
  function drawItem(it: Item) {
    const cx = px(it.x), cy = px(it.y) + Math.sin(it.age * 4) * 1.5;
    const blink = it.ttl > 0 && it.ttl < 2 && Math.floor(it.age * 8) % 2 === 0;
    if (blink) return;
    // vầng sáng nhịp thở quanh mồi
    {
      const col = it.t === 'apple' ? '248,113,113' : it.t === 'gold' ? '253,224,71' : it.t === 'magnet' ? '192,132,252' : '103,232,249';
      const pr = 17 + Math.sin(it.age * 3.5) * 3;
      const halo = g.createRadialGradient(cx, cy, 2, cx, cy, pr + 8);
      halo.addColorStop(0, `rgba(${col},.4)`); halo.addColorStop(1, `rgba(${col},0)`);
      g.fillStyle = halo; g.beginPath(); g.arc(cx, cy, pr + 8, 0, 7); g.fill();
    }
    if (it.t === 'apple') {
      g.fillStyle = 'rgba(0,0,0,.28)'; g.beginPath(); g.ellipse(cx, cy + 11, 9, 3.5, 0, 0, 7); g.fill();
      const gr = g.createRadialGradient(cx - 4, cy - 4, 2, cx, cy, 13);
      gr.addColorStop(0, '#fca5a5'); gr.addColorStop(0.5, '#ef4444'); gr.addColorStop(1, '#991b1b');
      g.fillStyle = gr; g.beginPath(); g.arc(cx, cy + 1, 11, 0, 7); g.fill();
      g.fillStyle = '#4ade80'; g.beginPath(); g.ellipse(cx + 4, cy - 10, 6, 3, -0.5, 0, 7); g.fill();
      g.strokeStyle = '#78350f'; g.lineWidth = 2; g.beginPath(); g.moveTo(cx, cy - 8); g.lineTo(cx + 1, cy - 13); g.stroke();
    } else if (it.t === 'gold') {
      const pulse = 1 + Math.sin(it.age * 6) * 0.1;
      g.save(); g.translate(cx, cy); g.rotate(it.age * 1.2); g.scale(pulse, pulse);
      g.shadowColor = '#facc15'; g.shadowBlur = 16; g.fillStyle = '#fde047';
