        k.fillStyle = ['rgba(253,224,71,.5)', 'rgba(251,207,232,.45)', 'rgba(255,255,255,.4)'][i % 3];
        k.beginPath(); k.arc(rnd2(SZ), rnd2(SZ), 1.6 + rnd2(1.4), 0, 7); k.fill();
      }
    } else if (mode === 1) {
      k.strokeStyle = 'rgba(103,232,249,.07)'; k.lineWidth = 1;
      for (let i = 1; i < N; i++) { k.beginPath(); k.moveTo(i * C, 0); k.lineTo(i * C, SZ); k.moveTo(0, i * C); k.lineTo(SZ, i * C); k.stroke(); }
      for (let i = 0; i < 90; i++) {
        k.fillStyle = `rgba(207,250,254,${0.15 + rnd2(0.55)})`;
        k.beginPath(); k.arc(rnd2(SZ), rnd2(SZ), 0.6 + rnd2(1.4), 0, 7); k.fill();
      }
    } else {
      // vết nứt trên nền đá
      for (let i = 0; i < 34; i++) {
        let x = rnd2(SZ), y = rnd2(SZ);
        k.strokeStyle = 'rgba(0,0,0,.22)'; k.lineWidth = 1.2; k.beginPath(); k.moveTo(x, y);
        for (let j = 0; j < 4; j++) { x += rnd2(14) - 7; y += rnd2(12); k.lineTo(x, y); }
        k.stroke();
