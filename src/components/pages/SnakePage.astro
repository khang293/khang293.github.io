    const vg = k.createRadialGradient(SZ / 2, SZ / 2, SZ * 0.35, SZ / 2, SZ / 2, SZ * 0.75);
    vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.45)');
    k.fillStyle = vg; k.fillRect(0, 0, SZ, SZ);
    if (mode === 1) {
      k.strokeStyle = 'rgba(103,232,249,.85)'; k.lineWidth = 4; k.setLineDash([10, 8]); k.shadowColor = '#22d3ee'; k.shadowBlur = 10;
      k.strokeRect(3, 3, SZ - 6, SZ - 6);
    } else if (mode === 2) {
      k.strokeStyle = '#78350f'; k.lineWidth = 9; k.shadowColor = '#fb923c'; k.shadowBlur = 10;
      k.strokeRect(4.5, 4.5, SZ - 9, SZ - 9);
      k.shadowBlur = 0; k.strokeStyle = 'rgba(0,0,0,.35)'; k.lineWidth = 1;
      for (let i = 0; i < SZ; i += 24) { k.beginPath(); k.moveTo(i, 1); k.lineTo(i, 8); k.moveTo(i, SZ - 8); k.lineTo(i, SZ - 1); k.moveTo(1, i); k.lineTo(8, i); k.moveTo(SZ - 8, i); k.lineTo(SZ - 1, i); k.stroke(); }
    } else {
