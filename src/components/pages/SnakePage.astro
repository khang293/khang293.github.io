  function bodyPts() {
    return snake.map((s, i) => {
      const o = old[Math.min(i, old.length - 1)] || s;
      const dx = s.x - o.x, dy = s.y - o.y;
      if (Math.abs(dx) > 1 || Math.abs(dy) > 1) return { x: px(s.x), y: px(s.y), jump: true };
