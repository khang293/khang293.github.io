    if (gone >= pts.length) return;
    pts = pts.slice(gone);
    const len = pts.length;
    const rad = (i: number) => C * (0.5 - 0.23 * (i / Math.max(1, len - 1)));
    const col = (i: number) => {
      const t = i / Math.max(1, len - 1);
