---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

// Chữ của game rắn (nằm cùng file, xóa game thì xóa file này và hai file route snake.astro)
const T = {
  vi: {
    title: 'Rắn Săn Mồi',
    sub: 'Rắn có kỹ năng: lướt nhanh, nam châm hút mồi và khiên đỡ một lần va chạm. Ăn mồi, lên cấp, né đá.',
    mode: 'Chế độ',
    modes: [
      { n: 'Cổ điển', d: 'Chạm tường là thua.' },
      { n: 'Xuyên tường', d: 'Đi qua mép sẽ ló ra phía đối diện, đá mọc nhiều hơn.' },
      { n: 'Mê cung', d: 'Tường dựng sẵn, chạm tường là thua.' },
    ],
    start: 'Bắt đầu', best: 'Kỷ lục', score: 'Điểm', level: 'Cấp', len: 'Dài',
    dash: 'Lướt', pause: 'Tạm dừng', resume: 'Tiếp tục', again: 'Chơi lại', menu: 'Menu',
    ready: 'Vuốt hoặc bấm phím mũi tên để bắt đầu', paused: 'Tạm dừng', over: 'Thua rồi!',
    overMsg: (s: number) => `Bạn được ${s} điểm.`, record: '🏆 Kỷ lục mới!',
    levelUp: 'CẤP', gold: 'Sao vàng!', shield: 'Khiên!', magnet: 'Nam châm!', shieldUsed: 'Khiên vỡ!',
    keys: 'Phím mũi tên hoặc WASD để đổi hướng, Cách (Space) để lướt nhanh, P hoặc Esc để tạm dừng. Trên điện thoại vuốt trên bàn hoặc dùng nút mũi tên. 🍎 +10 · ⭐ +50 (biến mất sau vài giây) · 🧲 hút mồi · 🛡️ đỡ một lần va chạm. Ăn liên tiếp để nhân điểm.',
  },
  en: {
    title: 'Power Snake',
    sub: 'A snake with skills: a speed dash, a food magnet and a shield that absorbs one crash. Eat, level up, dodge the rocks.',
    mode: 'Mode',
    modes: [
      { n: 'Classic', d: 'Hit a wall and you lose.' },
      { n: 'Wrap-around', d: 'Cross an edge to appear on the other side, more rocks appear.' },
      { n: 'Maze', d: 'Pre-built walls, touching a wall ends the run.' },
    ],
    start: 'Start', best: 'Best', score: 'Score', level: 'Level', len: 'Length',
    dash: 'Dash', pause: 'Pause', resume: 'Resume', again: 'Play again', menu: 'Menu',
    ready: 'Swipe or press an arrow key to start', paused: 'Paused', over: 'Game over!',
    overMsg: (s: number) => `You scored ${s}.`, record: '🏆 New record!',
    levelUp: 'LEVEL', gold: 'Golden star!', shield: 'Shield!', magnet: 'Magnet!', shieldUsed: 'Shield broke!',
    keys: 'Arrow keys or WASD to steer, Space to dash, P or Esc to pause. On a phone swipe on the board or use the arrow buttons. 🍎 +10 · ⭐ +50 (vanishes after a few seconds) · 🧲 pulls food · 🛡️ absorbs one crash. Eat quickly in a row for a score multiplier.',
  },
}[lang];
const ui = {
  ready: T.ready, paused: T.paused, over: T.over, record: T.record, levelUp: T.levelUp, gold: T.gold,
  shield: T.shield, magnet: T.magnet, shieldUsed: T.shieldUsed, resume: T.resume, pause: T.pause,
  overMsg: T.overMsg(0), modes: T.modes.map((m) => m.n),
};
---
<Base lang={lang} title={T.title} description={T.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="snake" data-ui={JSON.stringify(ui)} data-desc={JSON.stringify(T.modes.map((m) => m.d))}>
    <div id="sn-menu">
      <h2 class="bd-h">{T.mode}</h2>
      <div class="bd-row">
        {T.modes.map((m, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-mode={i}>{m.n}</button>)}
      </div>
      <p class="meta" id="sn-mdesc">{T.modes[0].d}</p>
      <p class="bd-stat" id="sn-stat"></p>
      <button class="btn" type="button" id="sn-start">▶ {T.start}</button>
      <p class="meta">{T.keys}</p>
    </div>

    <div id="sn-game" hidden>
      <div class="sn-hud" aria-live="off">
        <span>{T.score} <b id="sn-score">0</b></span>
        <span>{T.best} <b id="sn-best">0</b></span>
        <span>{T.level} <b id="sn-level">1</b></span>
        <span>{T.len} <b id="sn-len">4</b></span>
        <span id="sn-shield" class="sn-chip" hidden>🛡️</span>
        <span id="sn-magnet" class="sn-chip" hidden>🧲 <b id="sn-mt">0</b></span>
      </div>
      <div class="sn-wrap">
        <div class="sn-box" id="sn-box">
          <canvas id="sn-canvas" width="720" height="720" aria-label={T.title}></canvas>
        </div>
      </div>
      <p class="bd-status" id="sn-status" aria-live="polite"></p>
      <div class="sn-ctl">
        <div class="sn-pad" aria-hidden="true">
          <button type="button" data-d="up" class="u">▲</button>
          <button type="button" data-d="left" class="l">◀</button>
          <button type="button" data-d="right" class="r">▶</button>
          <button type="button" data-d="down" class="d">▼</button>
        </div>
        <button type="button" class="sn-dash" id="sn-dash"><span class="sn-fill"></span><span class="sn-lbl">⚡ {T.dash}</span></button>
      </div>
      <div class="bd-row bd-actions">
        <button type="button" class="btn ghost sm" id="sn-pause">⏸ {T.pause}</button>
        <button type="button" class="btn ghost sm" id="sn-new">{T.again}</button>
        <button type="button" class="btn ghost sm" id="sn-menu-btn">{T.menu}</button>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  #snake .sn-hud { display: flex; flex-wrap: wrap; gap: 6px 16px; justify-content: center; align-items: center; margin: 4px 0 10px; font-size: .98rem; color: var(--muted); }
  #snake .sn-hud b { color: var(--fg); font-variant-numeric: tabular-nums; }
  #snake .sn-chip { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; font-size: .9rem; }
  #snake .sn-wrap { display: flex; justify-content: center; }
  #snake .sn-box { position: relative; width: min(100%, 640px); }
  #sn-canvas { width: 100%; aspect-ratio: 1; height: auto; border-radius: 14px; border: 1px solid var(--line); background: #10261d; touch-action: none; display: block; cursor: pointer; box-shadow: 0 8px 30px rgba(0, 0, 0, .25); }
  #snake .sn-ctl { display: flex; align-items: center; justify-content: center; gap: 22px; margin: 10px 0 4px; flex-wrap: wrap; }
  #snake .sn-pad { display: none; grid-template-columns: repeat(3, 58px); grid-template-rows: repeat(2, 54px); gap: 6px; }
  #snake .sn-pad button { background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 12px; font-size: 1.2rem; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  #snake .sn-pad button:active { background: var(--accent); color: #fff; }
  #snake .sn-pad .u { grid-column: 2; grid-row: 1; }
  #snake .sn-pad .l { grid-column: 1; grid-row: 2; }
  #snake .sn-pad .d { grid-column: 2; grid-row: 2; }
  #snake .sn-pad .r { grid-column: 3; grid-row: 2; }
  @media (pointer: coarse), (max-width: 700px) { #snake .sn-pad { display: grid; } }
  #snake .sn-dash { position: relative; overflow: hidden; min-width: 120px; height: 54px; padding: 0 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--card); color: var(--fg); font-weight: 700; font-size: 1rem; touch-action: manipulation; -webkit-tap-highlight-color: transparent; cursor: pointer; }
  #snake .sn-dash .sn-fill { position: absolute; inset: 0 auto 0 0; width: 100%; background: linear-gradient(90deg, #22d3ee, #34d399); opacity: .55; transform-origin: left; transform: scaleX(var(--p, 1)); transition: transform .1s linear; }
  #snake .sn-dash .sn-lbl { position: relative; }
  #snake .sn-dash.cd { opacity: .75; }
</style>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  const root = document.getElementById('snake') as HTMLElement;
  mountMute(document.getElementById('sn-box'));
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('sn-menu') as HTMLElement;
  const gameEl = document.getElementById('sn-game') as HTMLElement;
  const canvas = document.getElementById('sn-canvas') as HTMLCanvasElement;
  const g = canvas.getContext('2d')!;
  const statusEl = document.getElementById('sn-status') as HTMLElement;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const N = 24, C = 30, SZ = N * C;
  const DIRV: Record<string, { x: number; y: number }> = { up: { x: 0, y: -1 }, down: { x: 0, y: 1 }, left: { x: -1, y: 0 }, right: { x: 1, y: 0 } };
  const DASH_TIME = 1.1, DASH_CD = 7, MAGNET_TIME = 8;
  const MODES = ['classic', 'wrap', 'maze'];
  const ROCKS_PER_LEVEL = [1, 2, 2];

  type P = { x: number; y: number };
  type Item = { x: number; y: number; t: 'apple' | 'gold' | 'magnet' | 'shield'; ttl: number; age: number };
  type Part = { x: number; y: number; vx: number; vy: number; life: number; max: number; color: string; size: number };
  type Txt = { x: number; y: number; t: number; txt: string; color: string };

  let mode = 0;
  let state: 'menu' | 'ready' | 'play' | 'paused' | 'over' = 'menu';
  let snake: P[] = [], old: P[] = [];
  let dir: P = DIRV.right, dirQ: P[] = [];
  let items: Item[] = [], rocks: P[] = [];
  let grow = 0, eaten = 0, score = 0, level = 1, gt = 0, acc = 0, alpha = 1;
  let dashT = 0, dashCd = 0, magnetT = 0, shield = false;
  let combo = 0, lastEat = -99;
  let shake = 0, flash = 0;
  let parts: Part[] = [], texts: Txt[] = [];
  let newRecord = false;
  let deathT = 0, deathShown = 0;
  const syncMusic = () => sfx.music(state === 'play' ? (level >= 4 ? 'action' : 'calm') : null);
  let best: Record<string, number> = { classic: 0, wrap: 0, maze: 0 };
  try { const s = JSON.parse(localStorage.getItem('snake-best') || 'null'); if (s) best = { ...best, ...s }; } catch {}
  const saveBest = () => { try { localStorage.setItem('snake-best', JSON.stringify(best)); } catch {} };
  const paintStat = () => {
    $('sn-stat').textContent = MODES.map((m, i) => `${ui.modes[i]}: ${best[m]}`).join('  ·  ');
  };
  paintStat();

  const rnd = (n: number) => Math.floor(Math.random() * n);
  const px = (v: number) => (v + 0.5) * C;
  const tickMs = () => Math.max(62, 150 - (level - 1) * 8) * (dashT > 0 ? 0.5 : 1);

  // ---------- Bản đồ ----------
  const rockAt = (x: number, y: number) => rocks.some((r) => r.x === x && r.y === y);
  const snakeAt = (x: number, y: number, skipTail = false) => {
    const end = skipTail ? snake.length - 1 : snake.length;
    for (let i = 0; i < end; i++) if (snake[i].x === x && snake[i].y === y) return true;
    return false;
  };
  const itemAt = (x: number, y: number) => items.find((i) => i.x === x && i.y === y);
  const isFree = (x: number, y: number) => x >= 0 && y >= 0 && x < N && y < N && !rockAt(x, y) && !snakeAt(x, y) && !itemAt(x, y);
  function randomFree(minDist = 0): P | null {
    const hx = snake[0].x, hy = snake[0].y;
    const list: P[] = [];
    for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
      if (!isFree(x, y)) continue;
      if (minDist && Math.abs(x - hx) + Math.abs(y - hy) < minDist) continue;
      list.push({ x, y });
    }
    return list.length ? list[rnd(list.length)] : null;
  }
  function addRocks(k: number) {
    for (let n = 0; n < k && rocks.length < (mode === 2 ? 48 : 0) + 34; n++) {
      for (let tries = 0; tries < 60; tries++) {
        const p = randomFree(5);
        if (!p) break;
        // không đặt ngay phía trước đầu rắn, và không dính vào đá khác (tránh dựng thành tường kín)
        const hx = snake[0].x, hy = snake[0].y;
        const ahead = (p.x === hx && Math.abs(p.y - hy) < 8 && Math.sign(p.y - hy) === dir.y) || (p.y === hy && Math.abs(p.x - hx) < 8 && Math.sign(p.x - hx) === dir.x);
        if (ahead) continue;
        if (rocks.some((r) => Math.abs(r.x - p.x) <= 1 && Math.abs(r.y - p.y) <= 1)) continue;
        if (p.x === 0 || p.y === 0 || p.x === N - 1 || p.y === N - 1) if (Math.random() < 0.6) continue;
        rocks.push(p);
        puff(px(p.x), px(p.y), '#9ca3af', 8, 90);
        break;
      }
    }
  }
  function mazeWalls(): P[] {
    const w: P[] = [];
    const bar = (x0: number, y0: number, len: number, horiz: boolean) => { for (let i = 0; i < len; i++) w.push({ x: x0 + (horiz ? i : 0), y: y0 + (horiz ? 0 : i) }); };
    bar(4, 6, 6, true); bar(14, 6, 6, true); bar(4, 17, 6, true); bar(14, 17, 6, true);
    bar(11, 2, 5, false); bar(12, 2, 5, false); bar(11, 17, 5, false); bar(12, 17, 5, false);
    bar(2, 9, 2, false); bar(21, 14, 2, false);
    return w;
  }

  // ---------- Hiệu ứng ----------
  function puff(x: number, y: number, color: string, n: number, speed: number) {
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2, s = speed * (0.3 + Math.random() * 0.9);
      parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0.5 + Math.random() * 0.4, max: 0.9, color, size: 2 + Math.random() * 3.5 });
    }
  }
  const floatText = (x: number, y: number, txt: string, color = '#fff') => texts.push({ x, y, t: 0, txt, color });

  // ---------- Bắt đầu ván ----------
  function newGame() {
    snake = [{ x: 6, y: 12 }, { x: 5, y: 12 }, { x: 4, y: 12 }, { x: 3, y: 12 }];
    old = snake.map((s) => ({ ...s }));
    dir = DIRV.right; dirQ = [];
    items = []; rocks = mode === 2 ? mazeWalls() : [];
    grow = 0; eaten = 0; score = 0; level = 1; gt = 0; acc = 0; alpha = 1;
    dashT = 0; dashCd = 0; magnetT = 0; shield = false; combo = 0; lastEat = -99;
    shake = 0; flash = 0; parts = []; texts = []; newRecord = false; deathT = 0; deathShown = 0;
    spawnItem('apple');
    state = 'ready';
    syncMusic();
    statusEl.textContent = '';
    ($('sn-pause') as HTMLElement).textContent = '⏸ ' + (ui.pause);
    bgCache = makeBg();
    updateHud(true);
  }
  function spawnItem(t: Item['t']) {
    const p = randomFree(t === 'apple' ? 0 : 3);
    if (!p) return;
    items.push({ x: p.x, y: p.y, t, ttl: t === 'gold' ? 7 : t === 'apple' ? 0 : 10, age: 0 });
  }

  // ---------- Nhịp game ----------
  function die() {
    state = 'over';
    shake = 14; flash = 0.4; deathT = 0; deathShown = 0;
    syncMusic();
    sfx.play('explode');
    setTimeout(() => { if (state === 'over') sfx.play('lose'); }, 650);
    puff(px(snake[0].x), px(snake[0].y), '#f87171', 36, 220);
    const m = MODES[mode];
    if (score > best[m]) { best[m] = score; newRecord = true; saveBest(); paintStat(); }
    statusEl.textContent = `${ui.over} ${ui.overMsg.replace(/\d+/, String(score))} ${newRecord ? ui.record : ''}`;
    updateHud(true);
  }
  const blocked = (x: number, y: number) => {
    if (mode === 1) { x = (x + N) % N; y = (y + N) % N; }
    return x < 0 || y < 0 || x >= N || y >= N || rockAt(x, y) || snakeAt(x, y, grow === 0);
  };

  function tick() {
    if (dirQ.length) { dir = dirQ.shift()!; sfx.tone(dashT > 0 ? 900 : 640, 0.03, 'triangle', 0.05); }
    const h = snake[0];
    let nx = h.x + dir.x, ny = h.y + dir.y;
    if (mode === 1) { nx = (nx + N) % N; ny = (ny + N) % N; }
    let hit = '';
    if (nx < 0 || ny < 0 || nx >= N || ny >= N) hit = 'wall';
    else if (rockAt(nx, ny)) hit = 'rock';
    else if (snakeAt(nx, ny, grow === 0)) hit = 'self';
    if (hit) {
      if (!shield) { die(); return; }
      shield = false;
      shake = 9; flash = 0.25;
      sfx.play('boom'); sfx.play('hurt');
      floatText(px(h.x), px(h.y) - 18, ui.shieldUsed, '#67e8f9');
      puff(px(h.x), px(h.y), '#67e8f9', 22, 170);
      if (hit === 'rock') {
        rocks = rocks.filter((r) => !(r.x === nx && r.y === ny));
        puff(px(nx), px(ny), '#9ca3af', 16, 150);
      } else {
        // rẽ sang hướng còn trống, hết đường thì thua
        const turns = [{ x: -dir.y, y: dir.x }, { x: dir.y, y: -dir.x }].sort(() => Math.random() - 0.5);
        const ok = turns.find((t) => !blocked(h.x + t.x, h.y + t.y));
        if (!ok) { die(); return; }
        dir = ok; dirQ = [];
        nx = h.x + dir.x; ny = h.y + dir.y;
        if (mode === 1) { nx = (nx + N) % N; ny = (ny + N) % N; }
      }
    }

    // nam châm: kéo mồi lại gần đầu rắn
    if (magnetT > 0) {
      for (const it of items) {
        if (it.t !== 'apple' && it.t !== 'gold') continue;
        const dx = h.x - it.x, dy = h.y - it.y;
        if (Math.abs(dx) + Math.abs(dy) > 7) continue;
        const stepX = Math.abs(dx) >= Math.abs(dy);
        const tx = it.x + (stepX ? Math.sign(dx) : 0), ty = it.y + (stepX ? 0 : Math.sign(dy));
        if (tx >= 0 && ty >= 0 && tx < N && ty < N && !rockAt(tx, ty) && !snakeAt(tx, ty) && !itemAt(tx, ty)) { it.x = tx; it.y = ty; }
      }
    }

    old = snake.map((s) => ({ ...s }));
    snake.unshift({ x: nx, y: ny });
    if (grow > 0) grow--; else snake.pop();
    alpha = 0;

    const it = itemAt(nx, ny);
    if (it) eat(it);
    if (dashT > 0) puff(px(snake[snake.length - 1].x), px(snake[snake.length - 1].y), '#67e8f9', 2, 40);
  }

  function eat(it: Item) {
    items = items.filter((i) => i !== it);
    const cx = px(it.x), cy = px(it.y);
    if (it.t === 'apple' || it.t === 'gold') {
      combo = gt - lastEat < 3.2 ? Math.min(combo + 1, 5) : 1;
      lastEat = gt;
      const base = it.t === 'gold' ? 50 : 10;
      const pts = Math.round(base * (1 + 0.25 * (combo - 1)));
      score += pts;
      grow += it.t === 'gold' ? 2 : 1;
      eaten++;
      puff(cx, cy, it.t === 'gold' ? '#fde047' : '#f87171', it.t === 'gold' ? 26 : 14, 170);
      floatText(cx, cy - 10, `+${pts}${combo > 1 ? ' x' + combo : ''}`, it.t === 'gold' ? '#fde047' : '#fff');
      if (it.t === 'gold') { floatText(cx, cy - 34, ui.gold, '#fde047'); shake = 4; sfx.play('coin'); }
      else { sfx.tone(420 + combo * 70, 0.07, 'square', 0.13, 640 + combo * 90); }
      if (it.t === 'apple') spawnItem('apple');
      if (!items.some((i) => i.t === 'apple')) spawnItem('apple');
      // mồi đặc biệt xuất hiện thỉnh thoảng
      if (!items.some((i) => i.t === 'gold') && Math.random() < 0.22) spawnItem('gold');
      if (!items.some((i) => i.t === 'magnet' || i.t === 'shield') && Math.random() < 0.14) spawnItem(Math.random() < 0.5 ? 'magnet' : 'shield');
      const nl = 1 + Math.floor(eaten / 5);
      if (nl > level) {
        level = nl;
        addRocks(ROCKS_PER_LEVEL[mode]);
        floatText(SZ / 2, SZ / 2 - 30, `${ui.levelUp} ${level}`, '#a7f3d0');
        flash = 0.2;
        sfx.play('levelup');
        if (level === 4) syncMusic();
      }
    } else if (it.t === 'magnet') {
      magnetT = MAGNET_TIME;
      puff(cx, cy, '#c084fc', 22, 170);
      floatText(cx, cy - 10, ui.magnet, '#c084fc');
      sfx.play('power');
    } else {
      shield = true;
      sfx.play('power');
      puff(cx, cy, '#67e8f9', 22, 170);
      floatText(cx, cy - 10, ui.shield, '#67e8f9');
    }
  }

  function update(dt: number) {
    for (const p of parts) { p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= 0.96; p.vy *= 0.96; p.life -= dt; }
    parts = parts.filter((p) => p.life > 0);
    for (const t of texts) t.t += dt;
    texts = texts.filter((t) => t.t < 1.2);
    shake = Math.max(0, shake - dt * 30);
    flash = Math.max(0, flash - dt);
    if (state === 'over' || state === 'play') alpha = state === 'over' ? 1 : alpha;
    // rắn nổ dần từ đầu đến đuôi khi thua
    if (state === 'over') {
      deathT += dt;
      const k = Math.min(snake.length, Math.floor(deathT * 26));
      while (deathShown < k) {
        const s = snake[deathShown];
        puff(px(s.x), px(s.y), deathShown % 2 ? '#f87171' : '#fbbf24', 7, 120);
        if (deathShown % 3 === 0) sfx.tone(300 - deathShown * 6, 0.05, 'square', 0.07);
        deathShown++;
      }
    }
    // vệt gió khi đang lướt
