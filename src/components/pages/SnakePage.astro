  const rr = (x: number, y: number, w: number, h: number, r: number) => { g.beginPath(); g.roundRect ? g.roundRect(x, y, w, h, r) : g.rect(x, y, w, h); };

  function drawRock(r: P) {
    const x = r.x * C, y = r.y * C;
