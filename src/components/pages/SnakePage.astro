  $('sn-new').addEventListener('click', newGame);
  $('sn-menu-btn').addEventListener('click', () => { state = 'menu'; gameEl.hidden = true; menu.hidden = false; paintStat(); syncMusic(); });

  // ---------- Vòng lặp ----------
  let last = performance.now();
