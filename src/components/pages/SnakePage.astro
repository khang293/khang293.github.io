    else if (state === 'paused') { state = 'play'; ($('sn-pause') as HTMLElement).textContent = '⏸ ' + ui.pause; sfx.play('click'); }
    syncMusic();
  }

  const KEYS: Record<string, string> = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right', w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right' };
