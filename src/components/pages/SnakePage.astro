      get state() { return state; }, get snake() { return snake; }, get items() { return items; }, get rocks() { return rocks; },
      get score() { return score; }, get level() { return level; }, get shield() { return shield; }, get magnet() { return magnetT; },
      start(m = 0) { mode = m; showGame(); }, setDir, doDash, tick, togglePause,
      give(t: Item['t']) { const h = snake[0]; const p = { x: h.x + dir.x, y: h.y + dir.y }; items.push({ x: p.x, y: p.y, t, ttl: 10, age: 0 }); },
      setEaten(n: number) { eaten = n; },
      key(k: string) { document.dispatchEvent(new KeyboardEvent('keydown', { key: k })); },
    };
  }
</script>
