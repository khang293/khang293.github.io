---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const T = {
  vi: {
    title: 'Lật Hình', sub: 'Lật hai thẻ mỗi lượt, tìm hết các cặp hình giống nhau với ít lượt và ít thời gian nhất.',
    sizes: ['4×4 (8 cặp)', '6×6 (18 cặp)'], again: 'Ván mới', moves: 'Lượt', best: 'Kỷ lục',
    win: 'Tìm đủ các cặp!', newBest: 'Kỷ lục mới!', keys: 'Bấm vào thẻ để lật. Hai thẻ giống nhau thì được giữ lại.',
  },
  en: {
    title: 'Memory Match', sub: 'Flip two cards a turn and find all the matching pairs using as few moves and as little time as you can.',
    sizes: ['4×4 (8 pairs)', '6×6 (18 pairs)'], again: 'New game', moves: 'Moves', best: 'Best',
    win: 'All pairs found!', newBest: 'New best!', keys: 'Tap a card to flip it. Two equal cards stay face up.',
  },
}[lang];

// 18 hình vẽ bằng SVG (không dùng emoji), tọa độ trong khung 24x24
const ICONS: { c: string; d: string; stroke?: boolean }[] = [
  { c: '#ef4444', d: '<circle cx="12" cy="12" r="8.5"/>' },
  { c: '#f97316', d: '<rect x="4" y="4" width="16" height="16" rx="3.5"/>' },
  { c: '#eab308', d: '<path d="M12 3L22 20H2z"/>' },
  { c: '#f59e0b', d: '<path d="M12 2l3 7 7 .6-5.4 4.6 1.8 7.3L12 17.6 5.6 21.5l1.8-7.3L2 9.6 9 9z"/>' },
  { c: '#ec4899', d: '<path d="M12 21C3 14 2 9 5 6c3-3 6-1 7 2 1-3 4-5 7-2 3 3 2 8-7 15z"/>' },
  { c: '#22c55e', d: '<path d="M12 2l10 10-10 10L2 12z"/>' },
  { c: '#14b8a6', d: '<path d="M12 2l9 5v10l-9 5-9-5V7z"/>' },
  { c: '#06b6d4', d: '<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>' },
  { c: '#3b82f6', d: '<path d="M20 14A9 9 0 1 1 10 4a7 7 0 0 0 10 10z"/>' },
  { c: '#6366f1', d: '<path d="M12 2s-7 8-7 13a7 7 0 0 0 14 0c0-5-7-13-7-13z"/>' },
  { c: '#8b5cf6', d: '<path d="M13 2L4 14h6l-1 8 9-12h-6z"/>' },
  { c: '#a855f7', d: '<circle cx="12" cy="12" r="7.5" fill="none" stroke-width="4"/>', stroke: true },
  { c: '#d946ef', d: '<path d="M5 5l14 14M19 5L5 19" fill="none" stroke-width="4.2" stroke-linecap="round"/>', stroke: true },
  { c: '#f43f5e', d: '<path d="M12 2l10 7.5L18 21H6L2 9.5z"/>' },
  { c: '#65a30d', d: '<path d="M4 20C4 9 10 4 20 4c0 10-5 16-16 16z"/>' },
  { c: '#0ea5e9', d: '<path d="M3 10h10V4l8 8-8 8v-6H3z"/>' },
  { c: '#fb7185', d: '<g><circle cx="12" cy="6" r="4"/><circle cx="18" cy="12" r="4"/><circle cx="12" cy="18" r="4"/><circle cx="6" cy="12" r="4"/><circle cx="12" cy="12" r="3" fill="#fde68a"/></g>' },
  { c: '#10b981', d: '<path d="M2 19a10 10 0 0 1 20 0z"/><path d="M12 2v4M4 8l2.5 2.5M20 8l-2.5 2.5" fill="none" stroke-width="2" stroke-linecap="round"/>' },
];
const icons = ICONS.map((x) => `<symbol id="mm-i${ICONS.indexOf(x)}" viewBox="0 0 24 24" fill="${x.c}" stroke="${x.c}" stroke-linejoin="round" stroke-width="1">${x.d}</symbol>`).join('');
---
<Base lang={lang} title={T.title} description={T.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="mm" data-ui={JSON.stringify(T)}>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs set:html={icons}></defs></svg>
    <div class="bd-row">
      {T.sizes.map((s, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-s={i}>{s}</button>)}
    </div>
    <div class="mm-bar">
      <span class="mm-pill">{T.moves}: <b id="mm-moves">0</b></span>
      <span class="mm-pill">⏱ <b id="mm-time">0</b>s</span>
      <span class="mm-pill" id="mm-best"></span>
      <button type="button" class="btn sm" id="mm-new">{T.again}</button>
    </div>
    <p class="bd-status" id="mm-status" aria-live="polite"></p>
    <div class="mm-board" id="mm-board"></div>
    <p class="meta">{T.keys}</p>
  </div>
</Base>

<style is:global>
  #mm { max-width: 560px; }
  .mm-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 16px 0 4px; }
  .mm-pill { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 5px 14px; font-size: .95rem; }
  .mm-pill:empty { display: none; }
  .mm-board { --n: 4; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: clamp(5px, 1.6vw, 10px); width: 100%; perspective: 900px; }
  .mm-card { position: relative; aspect-ratio: 1; padding: 0; border: 0; background: none; cursor: pointer; transform-style: preserve-3d; transition: transform .38s cubic-bezier(.3, .8, .3, 1); -webkit-tap-highlight-color: transparent; }
  .mm-card.up { transform: rotateY(180deg); }
  .mm-face { position: absolute; inset: 0; border-radius: 12%; backface-visibility: hidden; -webkit-backface-visibility: hidden; display: grid; place-items: center; }
  .mm-back { background: linear-gradient(145deg, var(--accent), var(--accent2)); box-shadow: inset 0 0 0 3px rgba(255,255,255,.22), 0 3px 8px rgba(0,0,0,.18); }
  .mm-back::after { content: ""; width: 34%; aspect-ratio: 1; border: 3px solid rgba(255,255,255,.55); border-radius: 30%; transform: rotate(45deg); }
  .mm-card:hover:not(.up):not(.done) .mm-back { filter: brightness(1.1); }
  .mm-front { transform: rotateY(180deg); background: var(--card); border: 2px solid var(--line); box-shadow: 0 3px 8px rgba(0,0,0,.12); }
  .mm-front svg { width: 62%; height: 62%; }
  .mm-card.done .mm-front { border-color: #22c55e; background: color-mix(in srgb, #22c55e 14%, var(--card)); animation: mmOk .45s ease-out; }
  .mm-card.bad .mm-front { border-color: #ef4444; }
  @keyframes mmOk { 40% { transform: rotateY(180deg) scale(1.12); } }
</style>

<script>
  // <logic>
  // Tạo bộ bài: `pairs` cặp, xáo trộn (Fisher-Yates). rnd trả về [0,1)
  function makeDeck(pairs, rnd) {
    const d = [];
    for (let i = 0; i < pairs; i++) d.push(i, i);
    for (let i = d.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [d[i], d[j]] = [d[j], d[i]]; }
    return d;
  }
  // </logic>

  const root = document.getElementById('mm') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const boardEl = document.getElementById('mm-board') as HTMLElement;
  const movesEl = document.getElementById('mm-moves') as HTMLElement;
  const timeEl = document.getElementById('mm-time') as HTMLElement;
  const bestEl = document.getElementById('mm-best') as HTMLElement;
  const statusEl = document.getElementById('mm-status') as HTMLElement;

  const SIZES = [{ n: 4, pairs: 8 }, { n: 6, pairs: 18 }];
  let si = 0, deck: number[] = [], cards: HTMLElement[] = [];
  let up: number[] = [], matched = 0, moves = 0, lock = false, t0 = 0, timer = 0, ended = false;
  const bestKey = () => 'memory-best' + si;
  const getBest = (): { m: number; t: number } | null => { try { return JSON.parse(localStorage.getItem(bestKey()) || 'null'); } catch { return null; } };
  const paintBest = () => { const b = getBest(); bestEl.textContent = b ? `${ui.best}: ${b.m} / ${b.t}s` : ''; };

  function newGame(s?: number) {
    if (s !== undefined) si = s;
    const { n, pairs } = SIZES[si];
    clearInterval(timer); timer = 0; t0 = 0; up = []; matched = 0; moves = 0; lock = false; ended = false;
    movesEl.textContent = '0'; timeEl.textContent = '0'; statusEl.textContent = ''; statusEl.className = 'bd-status';
    deck = makeDeck(pairs, Math.random);
    boardEl.style.setProperty('--n', String(n)); boardEl.innerHTML = ''; cards = [];
    deck.forEach((k, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'mm-card'; b.dataset.i = String(i);
      b.setAttribute('aria-label', `${i + 1}`);
      b.innerHTML = `<span class="mm-face mm-back"></span><span class="mm-face mm-front"><svg viewBox="0 0 24 24"><use href="#mm-i${k}"/></svg></span>`;
      boardEl.appendChild(b); cards.push(b);
    });
    paintBest();
  }

  function flip(i: number) {
    if (lock || ended || up.includes(i) || cards[i].classList.contains('done')) return;
    if (!t0) { t0 = Date.now(); timer = window.setInterval(() => { timeEl.textContent = String(Math.floor((Date.now() - t0) / 1000)); }, 250); }
    cards[i].classList.add('up'); up.push(i);
    if (up.length < 2) return;
    moves++; movesEl.textContent = String(moves);
    const [a, b] = up;
    if (deck[a] === deck[b]) {
      setTimeout(() => { cards[a].classList.add('done'); cards[b].classList.add('done'); }, 300);
      up = []; matched++;
      if (matched === SIZES[si].pairs) setTimeout(finish, 600);
    } else {
      lock = true;
      setTimeout(() => cards[a].classList.add('bad'), 380);
      setTimeout(() => cards[b].classList.add('bad'), 380);
      setTimeout(() => {
        for (const k of [a, b]) { cards[k].classList.remove('up', 'bad'); }
        up = []; lock = false;
      }, 900);
    }
  }
  function finish() {
    ended = true; clearInterval(timer);
    const secs = Math.max(1, Math.round((Date.now() - t0) / 1000));
    timeEl.textContent = String(secs);
    let msg = `${ui.win} ${moves} / ${secs}s`;
    const b = getBest();
    if (!b || moves < b.m || (moves === b.m && secs < b.t)) { try { localStorage.setItem(bestKey(), JSON.stringify({ m: moves, t: secs })); } catch {} msg += ' ' + ui.newBest; paintBest(); }
    statusEl.textContent = msg; statusEl.className = 'bd-status done';
  }

  boardEl.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('.mm-card') as HTMLElement | null;
    if (t) flip(+(t.dataset.i || 0));
  });
  document.getElementById('mm-new')!.addEventListener('click', () => newGame());
  root.querySelectorAll<HTMLButtonElement>('[data-s]').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('[data-s]').forEach((x) => x.classList.remove('sel'));
    b.classList.add('sel'); newGame(+(b.dataset.s || 0));
  }));

  newGame(0);
  if (location.hash.includes('debug')) (window as any).__mm = { makeDeck, get deck() { return deck; }, flip, get state() { return { matched, moves, ended }; } };
</script>
