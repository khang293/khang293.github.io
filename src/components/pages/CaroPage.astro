---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';
import { boardUi } from '../../data/board';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const c = boardUi[lang].caro;
const ui = {
  turnX: c.turnOf('X'), turnO: c.turnOf('O'), yourTurn: c.yourTurn, thinking: c.thinking,
  win: c.win, lose: c.lose, winX: c.winOf('X'), winO: c.winOf('O'), draw: c.draw,
};
---
<Base lang={lang} title={c.title} description={c.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{c.title}</h1>
  <p class="meta">{c.sub}</p>

  <div id="caro" data-ui={JSON.stringify(ui)}>
    <div id="cr-menu">
      <div class="bd-row">
        <button type="button" class="bd-opt sel" data-mode="bot">{c.modeBot}</button>
        <button type="button" class="bd-opt" data-mode="two">{c.modeTwo}</button>
      </div>
      <h2 class="bd-h">{c.size}</h2>
      <div class="bd-row">
        {c.sizes.map((l, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-size={[15, 19, 25][i]}>{l}</button>)}
      </div>
      <div id="cr-botopts">
        <h2 class="bd-h">{c.level}</h2>
        <div class="bd-row">
          {c.levels.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-level={i + 1}>{l}</button>)}
        </div>
        <h2 class="bd-h">{c.side}</h2>
        <div class="bd-row">
          {c.sides.map((l, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-side={i + 1}>{l}</button>)}
        </div>
      </div>
      <p class="bd-stat" id="cr-stat"></p>
      <button class="btn" type="button" id="cr-start">▶ {c.start}</button>
      <p class="meta">{c.keys}</p>
    </div>

    <div id="cr-game" hidden>
      <p class="bd-status" id="cr-status" aria-live="polite"></p>
      <div id="cr-scroll"><canvas id="cr-canvas" width="1040" height="1040" aria-label={c.title}></canvas></div>
      <div class="bd-row bd-actions">
        <button type="button" class="btn ghost sm" id="cr-undo">↶ {c.undo}</button>
        <button type="button" class="btn ghost sm" id="cr-new">{c.again}</button>
        <button type="button" class="btn ghost sm" id="cr-menu-btn">{c.menu}</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';

  import { insaneMove } from '../../data/caroEngine';
  const root = document.getElementById('caro') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('cr-menu') as HTMLElement;
  const gameEl = document.getElementById('cr-game') as HTMLElement;
  const canvas = document.getElementById('cr-canvas') as HTMLCanvasElement;
  const g = canvas.getContext('2d')!;
  const statusEl = document.getElementById('cr-status') as HTMLElement;

  let N = 15, size = 15;
  const CELL = 68; // đơn vị vẽ cố định, bàn lớn hơn thì canvas lớn hơn và được thu nhỏ khi hiển thị
  const DIRS = [[0, 1], [1, 0], [1, 1], [1, -1]];
  let mode = 'bot', level = 2, humanSide = 1; // 1 = X đi trước, 2 = O đi sau
  let human = 1;
  let b = new Int8Array(N * N);
  let moves: number[] = [];
  let turn = 1;
  let over = '';
  let winLine: number[] = [];
  let thinking = false;
  let stats = { w: 0, d: 0, l: 0 };
  try { const s = JSON.parse(localStorage.getItem('caro-stats') || 'null'); if (s) stats = { ...stats, ...s }; } catch {}
  const paintStat = () => { (document.getElementById('cr-stat') as HTMLElement).textContent = stats.w + stats.d + stats.l ? `${stats.w} / ${stats.d} / ${stats.l}` : ''; };

  const at = (r: number, c: number) => (r < 0 || r >= N || c < 0 || c >= N ? -1 : b[r * N + c]);

  // ---------- Luật thắng ----------
  function winCells(idx: number): number[] {
    const r = Math.floor(idx / N), c = idx % N, me = b[idx];
    for (const [dr, dc] of DIRS) {
      const cells = [idx];
      for (const s of [1, -1]) {
        let k = 1;
        while (at(r + s * dr * k, c + s * dc * k) === me) { cells.push((r + s * dr * k) * N + c + s * dc * k); k++; }
      }
      if (cells.length >= 5) return cells;
    }
    return [];
  }

  // ---------- Máy chơi ----------
  // Điểm của một đường đi qua ô (r,c) nếu quân me đặt vào đó
  function lineScore(r: number, c: number, dr: number, dc: number, me: number) {
    let n = 1, open = 0, split = 0;
    for (const s of [1, -1]) {
      let k = 1;
      while (at(r + s * dr * k, c + s * dc * k) === me) { n++; k++; }
      if (at(r + s * dr * k, c + s * dc * k) === 0) {
        open++;
        let k2 = k + 1, extra = 0;
        if (at(r + s * dr * k2, c + s * dc * k2) === me) {
          while (at(r + s * dr * k2, c + s * dc * k2) === me) { extra++; k2++; }
          n += extra; split = 1;
        }
      }
    }
    if (n >= 5 && !split) return 1e6;
    if (n >= 5) return 5000;
    if (n === 4) return open === 2 && !split ? 1e5 : open ? 5000 : 0;
    if (n === 3) return open === 2 ? (split ? 3000 : 4000) : open ? 300 : 0;
    if (n === 2) return open === 2 ? 200 : open ? 20 : 0;
    return open === 2 ? 5 : 1;
  }
  function cellScore(r: number, c: number, me: number) {
    let sum = 0, threats = 0;
    for (const [dr, dc] of DIRS) { const v = lineScore(r, c, dr, dc, me); sum += v; if (v >= 3000 && v < 1e6) threats++; }
    if (threats >= 2) sum += 20000;
    return sum;
  }
  function candidates(): number[] {
    const out: number[] = [];
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
      if (b[r * N + c]) continue;
      let near = false;
      for (let dr = -2; dr <= 2 && !near; dr++) for (let dc = -2; dc <= 2; dc++) if (at(r + dr, c + dc) > 0) { near = true; break; }
      if (near) out.push(r * N + c);
    }
    return out;
  }
  function aiMove(me: number): number {
    if (level === 4) return insaneMove(b, me, 1500, N); // tìm kiếm sâu + chuỗi ép thắng, xem src/data/caroEngine.ts
    const foe = 3 - me;
    if (!moves.length) return (N >> 1) * N + (N >> 1);
    const cand = candidates();
    if (!cand.length) return -1;
    const A = 1, D = level === 1 ? 0.45 : level === 2 ? 0.9 : 1;
    let scored = cand.map((i) => {
      const r = Math.floor(i / N), c = i % N;
      return { i, s: cellScore(r, c, me) * A + cellScore(r, c, foe) * D + Math.random() * (level === 1 ? 60 : 4) };
    }).sort((x, y) => y.s - x.s);
    if (level === 3) { // nhìn trước một nước: trừ bớt điểm nếu đối thủ có đòn trả lời mạnh
      const top = scored.slice(0, 10);
      for (const t of top) {
        b[t.i] = me;
        let reply = 0;
        for (const j of candidates()) { const v = cellScore(Math.floor(j / N), j % N, foe); if (v > reply) reply = v; }
        b[t.i] = 0;
        t.s -= reply * 0.55;
      }
      scored = top.sort((x, y) => y.s - x.s);
    }
    if (level === 1) {
      if (Math.random() < 0.2) return cand[(Math.random() * cand.length) | 0];
      return scored[(Math.random() * Math.min(4, scored.length)) | 0].i;
    }
    return scored[0].i;
  }

  // ---------- Vẽ ----------
  const PAD = 44;
  let SZ = PAD * 2 + CELL * (N - 1);
  const px = (i: number) => PAD + (i % N) * CELL, py = (i: number) => PAD + Math.floor(i / N) * CELL;
  let hover = -1, animStart = 0, winStart = 0, raf = 0;
  mountMute(gameEl);

  // Mặt bàn gỗ vẽ một lần rồi tái sử dụng
  const bg = document.createElement('canvas');
  function buildBg() {
    SZ = PAD * 2 + CELL * (N - 1);
    bg.width = SZ; bg.height = SZ; canvas.width = SZ; canvas.height = SZ;
    const k = bg.getContext('2d')!;
    const wood = k.createLinearGradient(0, 0, SZ, SZ);
    wood.addColorStop(0, '#efd29a'); wood.addColorStop(0.5, '#e3bd7a'); wood.addColorStop(1, '#d6a85e');
    k.fillStyle = wood; k.fillRect(0, 0, SZ, SZ);
    let seed = 7;
    const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
    for (let i = 0; i < 160; i++) { // vân gỗ
      const y = rnd() * SZ, len = 80 + rnd() * 380, x = rnd() * SZ;
      k.strokeStyle = `rgba(110,70,20,${0.03 + rnd() * 0.06})`; k.lineWidth = 1 + rnd() * 2;
      k.beginPath(); k.moveTo(x, y); k.bezierCurveTo(x + len * 0.3, y + rnd() * 6 - 3, x + len * 0.7, y + rnd() * 6 - 3, x + len, y + rnd() * 4 - 2); k.stroke();
    }
    const inner = PAD - 14;
    k.strokeStyle = 'rgba(90,55,15,.55)'; k.lineWidth = 2; k.strokeRect(inner, inner, SZ - inner * 2, SZ - inner * 2);
    k.strokeStyle = 'rgba(70,45,15,.85)'; k.lineWidth = 1.4;
    k.beginPath();
    for (let i = 0; i < N; i++) {
      const p = PAD + i * CELL;
      k.moveTo(PAD, p); k.lineTo(SZ - PAD, p); k.moveTo(p, PAD); k.lineTo(p, SZ - PAD);
    }
    k.stroke();
    k.fillStyle = 'rgba(70,45,15,.9)';
    const sp = N === 15 ? [3, 7, 11] : [3, (N - 1) / 2, N - 4];
    const stars = N === 15 ? [[3, 3], [3, 11], [7, 7], [11, 3], [11, 11]] : sp.flatMap((r) => sp.map((c) => [r, c]));
    for (const [r, c] of stars) { k.beginPath(); k.arc(PAD + c * CELL, PAD + r * CELL, 5, 0, Math.PI * 2); k.fill(); }
    k.font = `700 15px system-ui, sans-serif`; k.fillStyle = 'rgba(70,45,15,.85)'; k.textAlign = 'center'; k.textBaseline = 'middle';
    for (let i = 0; i < N; i++) {
      const p = PAD + i * CELL, ch = String.fromCharCode(65 + i);
      k.fillText(ch, p, 17); k.fillText(ch, p, SZ - 17);
      k.fillText(String(i + 1), 17, p); k.fillText(String(i + 1), SZ - 17, p);
    }
  }
  buildBg();
  // Bàn lớn hơn 15 thì cuộn ngang trên màn hình hẹp để ô không quá nhỏ
  function fitCanvas() { canvas.style.width = size === 15 ? '' : ('max(min(100%, 1040px), ' + (N * 26) + 'px)'); }

  function mark(who: number, x: number, y: number, scale = 1, alpha = 1) {
    g.save(); g.translate(x, y); g.scale(scale, scale); g.globalAlpha = alpha; g.lineCap = 'round';
    g.shadowColor = 'rgba(0,0,0,.35)'; g.shadowBlur = 6; g.shadowOffsetX = 2; g.shadowOffsetY = 3;
    if (who === 1) {
      const k = g.createLinearGradient(-15, -15, 15, 15); k.addColorStop(0, '#f87171'); k.addColorStop(1, '#b91c1c');
      g.strokeStyle = k; g.lineWidth = 8;
      g.beginPath(); g.moveTo(-14, -14); g.lineTo(14, 14); g.moveTo(14, -14); g.lineTo(-14, 14); g.stroke();
    } else {
      const k = g.createLinearGradient(-16, -16, 16, 16); k.addColorStop(0, '#60a5fa'); k.addColorStop(1, '#1e3a8a');
      g.strokeStyle = k; g.lineWidth = 8;
      g.beginPath(); g.arc(0, 0, 14.5, 0, Math.PI * 2); g.stroke();
    }
    g.restore();
  }

  function draw() {
    g.drawImage(bg, 0, 0);
    const now = performance.now();
    let animating = false;
    if (moves.length) { // vệt sáng ở nước đi cuối
      const l = moves[moves.length - 1];
      const glow = g.createRadialGradient(px(l), py(l), 4, px(l), py(l), 30);
      glow.addColorStop(0, 'rgba(250,204,21,.7)'); glow.addColorStop(1, 'rgba(250,204,21,0)');
      g.fillStyle = glow; g.beginPath(); g.arc(px(l), py(l), 30, 0, Math.PI * 2); g.fill();
    }
    if (winLine.length) {
      for (const i of winLine) {
        const glow = g.createRadialGradient(px(i), py(i), 4, px(i), py(i), 30);
        glow.addColorStop(0, 'rgba(34,197,94,.65)'); glow.addColorStop(1, 'rgba(34,197,94,0)');
        g.fillStyle = glow; g.beginPath(); g.arc(px(i), py(i), 30, 0, Math.PI * 2); g.fill();
      }
    }
    const lastIdx = moves.length ? moves[moves.length - 1] : -1;
    for (let i = 0; i < N * N; i++) {
      if (!b[i]) continue;
      // bóng đổ mềm dưới mỗi quân
      let e = 1, dy = 0, s = 1, al = 1;
      if (i === lastIdx) {
        const t = Math.min(1, (now - animStart) / 300);
        if (t < 1) { animating = true; e = 1 - Math.pow(1 - t, 3); dy = -(1 - e) * 40; s = 1 + (1 - e) * 0.3; al = Math.min(1, t * 4); }
        // gợn sóng khi quân chạm bàn
        const rt = (now - animStart - 260) / 420;
        if (rt > 0 && rt < 1) { animating = true; g.save(); g.strokeStyle = `rgba(120,80,30,${0.45 * (1 - rt)})`; g.lineWidth = 3 * (1 - rt) + 0.5; g.beginPath(); g.arc(px(i), py(i), 12 + rt * 26, 0, Math.PI * 2); g.stroke(); g.restore(); }
      }
      g.save(); g.fillStyle = `rgba(40,20,0,${0.2 * e * al})`; g.beginPath();
      g.ellipse(px(i) + 2, py(i) + 7, 17 * (0.55 + 0.45 * e), 7 * (0.55 + 0.45 * e), 0, 0, Math.PI * 2); g.fill(); g.restore();
      mark(b[i], px(i), py(i) + dy, s, al);
    }
    if (winLine.length) {
      const pts = winLine.map((i) => [px(i), py(i)]).sort((a, c) => a[0] - c[0] || a[1] - c[1]);
      const grow = Math.min(1, (now - winStart) / 450);
      const ex = pts[0][0] + (pts[pts.length - 1][0] - pts[0][0]) * grow, ey = pts[0][1] + (pts[pts.length - 1][1] - pts[0][1]) * grow;
      const pulse = 0.75 + 0.25 * Math.sin(now / 160);
      g.save(); g.lineCap = 'round'; g.strokeStyle = `rgba(22,163,74,${0.9 * pulse})`; g.lineWidth = 6;
      g.shadowColor = 'rgba(34,197,94,.9)'; g.shadowBlur = 14;
      g.beginPath(); g.moveTo(pts[0][0], pts[0][1]); g.lineTo(ex, ey); g.stroke();
      g.restore();
      // các tia sáng lấp lánh quanh dòng thắng
      g.save(); g.shadowColor = 'rgba(255,240,140,.9)'; g.shadowBlur = 8;
      for (let k = 0; k < pts.length * 3; k++) {
        const ph = (now / 700 + k * 0.37) % 1, base = pts[k % pts.length];
        const ang = k * 2.4 + now / 900, rad = 10 + ph * 30;
        const x = base[0] + Math.cos(ang) * rad, y = base[1] + Math.sin(ang) * rad - ph * 10, sz = (1 - ph) * 5;
        g.fillStyle = `rgba(255,236,120,${1 - ph})`;
        g.beginPath(); g.moveTo(x, y - sz); g.lineTo(x + sz * 0.3, y - sz * 0.3); g.lineTo(x + sz, y); g.lineTo(x + sz * 0.3, y + sz * 0.3);
        g.lineTo(x, y + sz); g.lineTo(x - sz * 0.3, y + sz * 0.3); g.lineTo(x - sz, y); g.lineTo(x - sz * 0.3, y - sz * 0.3); g.closePath(); g.fill();
      }
      g.restore();
      animating = true;
    }
    if (hover >= 0 && !b[hover] && !over && !thinking && (mode !== 'bot' || turn === human)) mark(turn, px(hover), py(hover), 1, 0.35);
    let text = over;
    if (!over) text = thinking ? ui.thinking : mode === 'bot' ? ui.yourTurn : (turn === 1 ? ui.turnX : ui.turnO);
    statusEl.textContent = text;
    statusEl.className = 'bd-status' + (over ? ' done' : '');
    if (animating && !raf) raf = requestAnimationFrame(() => { raf = 0; draw(); });
  }

  // ---------- Điều khiển ----------
  function place(idx: number) {
    b[idx] = turn; moves.push(idx);
    const w = winCells(idx);
    if (w.length) {
      winLine = w;
      over = mode === 'bot' ? (turn === human ? ui.win : ui.lose) : (turn === 1 ? ui.winX : ui.winO);
      if (mode === 'bot') { if (turn === human) stats.w++; else stats.l++; }
    } else if (moves.length >= N * N) {
      over = ui.draw;
      if (mode === 'bot') stats.d++;
    }
    if (over && mode === 'bot') { try { localStorage.setItem('caro-stats', JSON.stringify(stats)); } catch {} }
    const who = turn;
    turn = 3 - turn;
    animStart = performance.now();
    if (winLine.length) winStart = animStart + 300;
    // tiếng đặt quân: X trầm hơn O
    setTimeout(() => { sfx.tone(who === 1 ? 190 : 250, 0.1, 'triangle', 0.3, who === 1 ? 120 : 165); sfx.noise(0.04, 0.12, 2200); }, 200);
    if (over) setTimeout(() => {
      if (winLine.length) sfx.play(mode === 'bot' && who !== human ? 'lose' : 'win');
      else sfx.tone(330, 0.5, 'triangle', 0.2, 240);
    }, 520);
    draw();
    if (!over && mode === 'bot' && turn !== human) botTurn();
  }
  function botTurn() {
    thinking = true; draw();
    setTimeout(() => {
      thinking = false;
      const i = aiMove(turn);
      if (i >= 0) place(i); else draw();
    }, 120);
  }
  // Đổi toạ độ chuột sang giao điểm gần nhất, -1 nếu bấm quá xa bàn cờ
  function cellAt(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect(), k = SZ / rect.width;
    const c = Math.round(((e.clientX - rect.left) * k - PAD) / CELL), r = Math.round(((e.clientY - rect.top) * k - PAD) / CELL);
    return r < 0 || r >= N || c < 0 || c >= N ? -1 : r * N + c;
  }
  canvas.addEventListener('pointerup', (e) => {
    if (over || thinking || (mode === 'bot' && turn !== human)) return;
    const i = cellAt(e);
    if (i < 0 || b[i]) return;
    hover = -1;
    place(i);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const i = cellAt(e);
    if (i !== hover) { hover = i; draw(); }
  });
  canvas.addEventListener('pointerleave', () => { if (hover >= 0) { hover = -1; draw(); } });
  function newGame() {
    if (N !== size) { N = size; buildBg(); }
    fitCanvas();
    b = new Int8Array(N * N); moves = []; turn = 1; over = ''; winLine = []; thinking = false;
    human = humanSide;
    draw();
    if (mode === 'bot' && turn !== human) botTurn();
  }
  document.getElementById('cr-undo')!.addEventListener('click', () => {
    if (thinking || !moves.length) return;
    sfx.play('swoosh');
    do { const i = moves.pop()!; b[i] = 0; turn = 3 - turn; } while (moves.length && mode === 'bot' && turn !== human);
    over = ''; winLine = [];
    if (over === '' && mode === 'bot' && turn !== human) { botTurn(); return; }
    draw();
  });
  document.getElementById('cr-new')!.addEventListener('click', () => { if (!thinking) newGame(); });
  document.getElementById('cr-menu-btn')!.addEventListener('click', () => { if (thinking) return; gameEl.hidden = true; menu.hidden = false; paintStat(); });
  document.getElementById('cr-start')!.addEventListener('click', () => { menu.hidden = true; gameEl.hidden = false; newGame(); });

  function pick(attr: string, set: (v: string) => void) {
    document.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((el) => el.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((o) => o.classList.toggle('sel', o === el));
      set(el.dataset[attr] || '');
    }));
  }
  pick('mode', (v) => { mode = v; (document.getElementById('cr-botopts') as HTMLElement).hidden = v !== 'bot'; });
  pick('level', (v) => { level = Number(v); });
  pick('side', (v) => { humanSide = Number(v); });
  pick('size', (v) => { size = Number(v); });
  paintStat();

  if (location.hash === '#debug') (window as any).__cr = { board: () => b, moves: () => moves, over: () => over };
</script>

<style is:global>
  .sfx-btn { background: rgba(30, 35, 60, .88) !important; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
  #cr-menu[hidden], #cr-game[hidden], #cr-botopts[hidden] { display: none; }
  #cr-game { position: relative; }
  #cr-scroll { overflow-x: auto; overflow-y: hidden; }
  #cr-scroll #cr-canvas { margin: 0 auto; }
  #cr-game .sfx-btn { top: -4px !important; right: 4px !important; }
  #cr-canvas { width: min(100%, 1040px); height: auto; aspect-ratio: 1; display: block; border-radius: 10px; border: 4px solid #4a3220; box-shadow: 0 14px 36px rgba(0,0,0,.35), inset 0 0 0 2px rgba(255,255,255,.15); touch-action: manipulation; cursor: pointer; }</style>
