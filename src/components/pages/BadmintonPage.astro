---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

// Chữ hiển thị của game Cầu Lông Người Que (/game/badminton/). Xóa game thì xóa luôn file này.
const TXT = {
  vi: {
    title: 'Cầu Lông Người Que',
    sub: 'Đánh cầu lông với người que: chạy, nhảy, đập cầu và bỏ nhỏ. Đấu với máy 3 mức hoặc hai người một máy. Thắng 2 ván, mỗi ván đến 11 điểm.',
    pickMode: 'Chế độ',
    modes: ['Chơi với máy', 'Hai người một máy'],
    pickLevel: 'Độ khó của máy',
    levels: ['Dễ', 'Thường', 'Khó'],
    start: 'Bắt đầu',
    rules: 'Luật: mỗi lần cầu rơi xuống đất là một điểm. Cầu rơi trong sân của ai thì người kia ghi điểm. Cầu ra ngoài vạch hoặc vướng lưới thì người đánh bị mất điểm. Ván đấu đến 11 điểm và phải hơn 2 điểm (tối đa 15). Người thắng điểm sẽ giao cầu. Thắng 2 ván là thắng trận.',
    keysBot: 'Bạn là người bên trái. A D hoặc mũi tên để chạy, W hoặc mũi tên lên để nhảy, F hoặc Cách (Space) để vung vợt. Giữ S hoặc mũi tên xuống khi đánh để bỏ nhỏ sát lưới. Nhảy lên rồi đánh khi cầu ở cao để đập cầu. Đánh sớm thì cầu ngắn, đánh muộn thì cầu dài. Khi giao cầu hãy bấm đánh, giữ S để giao ngắn.',
    keysTwo: 'Người 1 (bên trái): A D chạy, W nhảy, F hoặc Cách đánh, S + đánh để bỏ nhỏ. Người 2 (bên phải): mũi tên chạy và nhảy, Enter hoặc 0 để đánh, mũi tên xuống + đánh để bỏ nhỏ. P hoặc Esc để tạm dừng.',
    keysTouch: 'Trên điện thoại dùng các nút bên dưới hoặc chạm vào sân để đánh.',
    you: 'Bạn', cpu: 'Máy', p1: 'Người 1', p2: 'Người 2',
    serveHint: '{n} giao cầu: bấm Đánh', pointFor: '{n} ghi điểm!', outBall: 'Cầu ra ngoài!', netBall: 'Vướng lưới!',
    gamePoint: 'Điểm quyết định ván', matchPoint: 'Điểm quyết định trận', gameN: 'Ván {n}',
    gameWin: '{n} thắng ván {g}', matchWin: '{n} thắng trận!',
    winYou: 'Bạn thắng trận! 🏆', loseYou: 'Bạn thua trận.', winOf: '{n} thắng trận! 🏆',
    gamesLine: 'Tỉ số ván', again: 'Đấu lại', change: 'Đổi chế độ', paused: 'Tạm dừng', resume: 'Tiếp tục',
    left: 'Trái', right: 'Phải', jump: 'Nhảy', hit: 'Đánh', drop: 'Bỏ nhỏ',
    stats: 'Thắng / Thua', lv: ['Dễ', 'Thường', 'Khó'],
  },
  en: {
    title: 'Stickman Badminton',
    sub: 'Badminton with stick figures: run, jump, smash and drop shots. Play the computer on 3 levels or a friend on one device. Win 2 games, each to 11 points.',
    pickMode: 'Mode',
    modes: ['Play the computer', 'Two players, one device'],
    pickLevel: 'Computer level',
    levels: ['Easy', 'Normal', 'Hard'],
    start: 'Start',
    rules: 'Rules: every time the shuttle lands is a point. If it lands inside your side, your opponent scores. If it lands outside the lines or hits the net, the player who hit it loses the point. A game goes to 11 points and must be won by 2 (cap at 15). The point winner serves. Win 2 games to win the match.',
    keysBot: 'You play the left side. A D or the arrow keys to run, W or Up to jump, F or Space to swing. Hold S or Down while hitting for a drop shot at the net. Jump and hit when the shuttle is high to smash. Swing early for a short shot, late for a long one. To serve press hit, and hold S for a short serve.',
    keysTwo: 'Player 1 (left): A D run, W jump, F or Space hit, S + hit for a drop shot. Player 2 (right): arrow keys to run and jump, Enter or 0 to hit, Down + hit for a drop shot. P or Esc to pause.',
    keysTouch: 'On a phone use the buttons below, or tap the court to swing.',
    you: 'You', cpu: 'CPU', p1: 'Player 1', p2: 'Player 2',
    serveHint: '{n} to serve: press Hit', pointFor: '{n} scores!', outBall: 'Out!', netBall: 'Net!',
    gamePoint: 'Game point', matchPoint: 'Match point', gameN: 'Game {n}',
    gameWin: '{n} wins game {g}', matchWin: '{n} wins the match!',
    winYou: 'You win the match! 🏆', loseYou: 'You lost the match.', winOf: '{n} wins the match! 🏆',
    gamesLine: 'Game scores', again: 'Rematch', change: 'Change mode', paused: 'Paused', resume: 'Resume',
    left: 'Left', right: 'Right', jump: 'Jump', hit: 'Hit', drop: 'Drop',
    stats: 'Wins / Losses', lv: ['Easy', 'Normal', 'Hard'],
  },
};
const t = TXT[lang];
const ui = { ...t };
---
<Base lang={lang} title={t.title} description={t.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{t.title}</h1>
  <p class="meta">{t.sub}</p>

  <div id="bmint" data-ui={JSON.stringify(ui)}>
    <div id="bm-menu">
      <h2 class="bd-h">{t.pickMode}</h2>
      <div class="bd-row">
        {t.modes.map((m, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-mode={i}>{m}</button>)}
      </div>
      <div id="bm-lvbox">
        <h2 class="bd-h">{t.pickLevel}</h2>
        <div class="bd-row">
          {t.levels.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-level={i}>{l}</button>)}
        </div>
      </div>
      <p class="bd-stat" id="bm-stat"></p>
      <button class="btn" type="button" id="bm-start">▶ {t.start}</button>
      <p class="meta" id="bm-keys"></p>
      <p class="meta">{t.rules}</p>
    </div>

    <div id="bm-game" hidden>
      <div class="bm-stage" id="bm-stage">
        <canvas id="bm-canvas" width="900" height="450" aria-label={t.title}></canvas>
        <div class="bm-ov" id="bm-pause" hidden>
          <h2>{t.paused}</h2>
          <button class="btn" type="button" id="bm-resume">{t.resume}</button>
        </div>
        <div class="bm-ov" id="bm-result" hidden>
          <div class="bm-big" id="bm-msg"></div>
          <p class="bm-sum" id="bm-sum"></p>
          <div class="bm-actions">
            <button type="button" class="btn" id="bm-again">{t.again}</button>
            <button type="button" class="btn ghost" id="bm-change">{t.change}</button>
          </div>
        </div>
      </div>
      <div class="bm-pad" id="bm-pad">
        <div class="bm-grp">
          <button type="button" id="bm-l" aria-label={t.left}>◀</button>
          <button type="button" id="bm-r" aria-label={t.right}>▶</button>
        </div>
        <button type="button" class="bm-small" id="bm-pausebtn" aria-label={t.paused}>⏸</button>
        <div class="bm-grp">
          <button type="button" id="bm-d">{t.drop}</button>
          <button type="button" id="bm-j">{t.jump}</button>
          <button type="button" id="bm-h" class="go">{t.hit}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';

  const root = document.getElementById('bmint') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('bm-menu') as HTMLElement;
  const gameEl = document.getElementById('bm-game') as HTMLElement;
  const stage = document.getElementById('bm-stage') as HTMLElement;
  const canvas = document.getElementById('bm-canvas') as HTMLCanvasElement;
  const g = canvas.getContext('2d')!;
  const pauseOv = document.getElementById('bm-pause') as HTMLElement;
  const resultOv = document.getElementById('bm-result') as HTMLElement;
  const DEBUG = location.hash.includes('debug');

  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
  const wrapA = (a: number) => { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; };
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const TAU = Math.PI * 2;

  // ---------- Hằng số sân và vật lý ----------
  const W = 900, H = 450;
  const GROUND = 385, NETX = 450, NETTOP = GROUND - 105, COURTL = 60, COURTR = 840;
  const STEP = 1 / 120;
  const GRAV = 1000, KD = 0.00434;        // trọng lực và hệ số cản: tốc độ rơi tối đa khoảng 480 px/s
  const SPEED = 265, PJUMP = 560, PGRAV = 1600;
  const SWING = 0.27, RACKET_R = 56, HIT_RAD = 40;

  let simMode = false;
  const snd = (name: string) => { if (!simMode) sfx.play(name); };
  const sndT: Record<string, number> = {};
  const sndGap = (name: string, gap: number) => { const n = performance.now(); if (n - (sndT[name] || 0) < gap * 1000) return; sndT[name] = n; sfx.play(name); };

  // ---------- Vật lý cầu ----------
  type Sh = { x: number; y: number; vx: number; vy: number };
  function integrate(s: Sh, dt: number) {
    const sp = Math.hypot(s.vx, s.vy);
    s.vx += -KD * sp * s.vx * dt;
    s.vy += (GRAV - KD * sp * s.vy) * dt;
    s.x += s.vx * dt; s.y += s.vy * dt;
  }
  // Mô phỏng quả cầu bay tới khi chạm đất: trả về điểm rơi, thời gian bay và việc có qua lưới được không
  function simulate(x: number, y: number, vx: number, vy: number) {
    const s = { x, y, vx, vy }; let t = 0, netOk = true;
    for (let i = 0; i < 720; i++) {
      const px = s.x;
      integrate(s, STEP * 1);
      if ((px - NETX) * (s.x - NETX) < 0 && s.y > NETTOP - 8) netOk = false;
      t += STEP;
      if (s.y >= GROUND - 4) break;
    }
    return { x: s.x, t, netOk };
  }
  // Tìm vận tốc đánh để cầu rơi đúng điểm mong muốn (d = +1 đánh sang phải, -1 sang trái)
  function solveShot(x0: number, y0: number, d: number, angles: number[], targets: number[], maxV: number, minV = 140) {
    for (const tgt of targets) {
      const tx = NETX + d * tgt;
      for (const ang of angles) {
        const a = ang * Math.PI / 180, ux = d * Math.cos(a), uy = -Math.sin(a);
        let lo = minV, hi = maxV;
        let r = simulate(x0, y0, ux * hi, uy * hi);
        if (d * (r.x - tx) < -30) continue;
        r = simulate(x0, y0, ux * lo, uy * lo);
        if (d * (r.x - tx) > 30) continue;
        for (let i = 0; i < 13; i++) { const m = (lo + hi) / 2; r = simulate(x0, y0, ux * m, uy * m); if (d * (r.x - tx) > 0) hi = m; else lo = m; }
        const v = (lo + hi) / 2; r = simulate(x0, y0, ux * v, uy * v);
        if (!r.netOk || Math.abs(r.x - tx) > 35) continue;
        return { vx: ux * v, vy: uy * v, land: r.x, v };
      }
    }
    return null;
  }

  // ---------- Người chơi ----------
  type Inp = { l: boolean; r: boolean; jump: boolean; down: boolean };
  interface Pl {
    side: number; x: number; h: number; vx: number; vh: number; ph: number; lean: number;
    swing: null | { t: number; dur: number; done: boolean }; cool: number; hitReq: boolean; inp: Inp; ai: number; col: string; col2: string; name: string;
    planHit: number; aiSmash: boolean; aiNx: number; aiNt: number;
    aiT: number; aiX: number; aiHas: boolean; aiHitT: number; aiJump: boolean; aiJumped: boolean; aiMiss: boolean; aiTerr: number; aiServeT: number; aiHitH: number;
    flash: number;
  }
  const mkPl = (side: number, col: string, col2: string): Pl => ({
    side, x: 0, h: 0, vx: 0, vh: 0, ph: 0, lean: 0, swing: null, cool: 0, hitReq: false, inp: { l: false, r: false, jump: false, down: false }, ai: -1, col, col2, name: '',
    planHit: -1, aiSmash: false, aiNx: 0, aiNt: 0,
    aiT: 0, aiX: 0, aiHas: false, aiHitT: 0, aiJump: false, aiJumped: false, aiMiss: false, aiTerr: 0, aiServeT: 0, aiHitH: 105, flash: 0,
  });
  const P: Pl[] = [mkPl(0, '#3b82f6', '#93c5fd'), mkPl(1, '#ef4444', '#fca5a5')];
  const dirOf = (p: Pl) => (p.side === 0 ? 1 : -1);
  const shoulderY = (p: Pl) => GROUND - p.h - 51;

  // Cấu hình máy theo mức: thời gian phản ứng, tốc độ, sai số vị trí và nhịp, tỉ lệ đánh hụt, đập cầu, bỏ nhỏ
  const LV = [
    { react: 0.42, speed: 0.62, err: 60, terr: 0.07, miss: 0.16, smash: 0, drop: 0, chase: 0.5 },
    { react: 0.22, speed: 0.85, err: 28, terr: 0.035, miss: 0.05, smash: 0.35, drop: 0.12, chase: 0.1 },
    { react: 0.09, speed: 1.0, err: 10, terr: 0.015, miss: 0.01, smash: 0.6, drop: 0.28, chase: 0 },
  ];

  // ---------- Trạng thái trận ----------
  let mode = 0, level = 1;
  let state: 'menu' | 'serve' | 'rally' | 'point' | 'gameend' | 'matchend' = 'menu';
  let running = false, paused = false;
  const pts = [0, 0], games = [0, 0], gameLog: string[] = [];
  let server = 0, gameNo = 1, stT = 0, clock = 0, lastHitter = -1, hitsInRally = 0, rallyT = 0;
  let serveBusy = false, serveT = 0, serveDown = false, matchDone = false;
  const SH = { x: 0, y: 0, vx: 0, vy: 0, ang: 0, landed: false, tr: [] as { x: number; y: number }[], trN: 0 };
  let timeScale = 1, shake = 0, netShake = 0, netHit = false;
  let banner: null | { txt: string; sub: string; t: number; max: number; col: string } = null;
  const popT = [0, 0];
  let lastReason = '';
  let stats = { w: [0, 0, 0], l: [0, 0, 0] };
  try { const s = JSON.parse(localStorage.getItem('bd-stats') || 'null'); if (s && s.w && s.l) stats = s; } catch {}
  const saveStats = () => { try { localStorage.setItem('bd-stats', JSON.stringify(stats)); } catch {} };
  // thống kê cho mô phỏng
  const sim = { rallies: [] as number[], timeouts: 0, why: {} as Record<string, number> };
  const bump = (k: string) => { sim.why[k] = (sim.why[k] || 0) + 1; };

  const target = () => (gameNo >= 3 ? 15 : 11);
  function gameWinner() {
    const a = pts[0], b = pts[1];
    if ((a >= 11 || b >= 11) && Math.abs(a - b) >= 2) return a > b ? 0 : 1;
    if (a >= 15) return 0;
    if (b >= 15) return 1;
    return -1;
  }
  function wouldWin(s: number) {
    const a = pts[s] + 1, b = pts[1 - s];
    return (a >= 11 && a - b >= 2) || a >= 15;
  }

  // ---------- Hiệu ứng ----------
  type Fx = { k: string; x: number; y: number; vx: number; vy: number; life: number; max: number; col: string; s: number; rot: number; vr: number };
  let fx: Fx[] = [];
  const spr: Record<string, HTMLCanvasElement> = {};
  function glowSprite(col: string) {
    let s = spr[col];
    if (s) return s;
    s = document.createElement('canvas'); s.width = s.height = 64;
    const c = s.getContext('2d')!, gr = c.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, col); gr.addColorStop(1, 'rgba(255,255,255,0)');
    c.fillStyle = gr; c.fillRect(0, 0, 64, 64);
    spr[col] = s;
    return s;
  }
  const addFx = (o: Partial<Fx> & { k: string; x: number; y: number }) => {
    if (simMode) return;
    fx.push({ vx: 0, vy: 0, life: 0.5, max: 0.5, col: '#fff', s: 4, rot: 0, vr: 0, ...o } as Fx);
    if (fx.length > 240) fx.splice(0, fx.length - 240);
  };
  function impact(x: number, y: number, big: boolean) {
    addFx({ k: 'glow', x, y, life: 0.22, max: 0.22, col: big ? '#ffd27a' : '#ffffff', s: big ? 60 : 36 });
    addFx({ k: 'ring', x, y, life: 0.3, max: 0.3, col: big ? '#ffb347' : '#ffffff', s: big ? 54 : 28 });
    const n = big ? 14 : 6;
    for (let i = 0; i < n; i++) { const a = Math.random() * TAU, sp = rnd(60, big ? 260 : 140); addFx({ k: 'dot', x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 0.35, max: 0.35, col: big ? '#ffe9a0' : '#ffffff', s: 2.5 }); }
  }
  function dust(x: number, n: number) {
    for (let i = 0; i < n; i++) addFx({ k: 'dust', x: x + rnd(-8, 8), y: GROUND - 2, vx: rnd(-50, 50), vy: -rnd(10, 50), life: 0.4, max: 0.4, col: 'rgba(210,190,150,.8)', s: rnd(2, 4) });
  }
  function confetti() {
    const cols = ['#f87171', '#fbbf24', '#34d399', '#60a5fa', '#c084fc', '#f472b6'];
    for (let i = 0; i < 110; i++) addFx({ k: 'conf', x: rnd(0, W), y: rnd(-60, 0), vx: rnd(-40, 40), vy: rnd(60, 180), life: rnd(2, 3.4), max: 3.4, col: cols[i % cols.length], s: rnd(4, 8), rot: rnd(0, TAU), vr: rnd(-8, 8) });
  }
  function updateFx(dt: number) {
    for (const p of fx) {
      p.life -= dt;
      if (p.k === 'conf') { p.x += p.vx * dt + Math.sin(p.life * 4 + p.rot) * 20 * dt; p.y += p.vy * dt; p.rot += p.vr * dt; }
      else if (p.k !== 'ring') { p.x += p.vx * dt; p.y += p.vy * dt; if (p.k === 'dot') p.vy += 500 * dt; p.vx *= 0.95; }
    }
    fx = fx.filter((p) => p.life > 0);
    if (shake > 0) shake = Math.max(0, shake - dt * 2.2);
    if (netShake > 0) netShake = Math.max(0, netShake - dt * 2.5);
    for (let i = 0; i < 2; i++) if (popT[i] > 0) popT[i] = Math.max(0, popT[i] - dt * 3);
    if (banner) { banner.t -= dt; if (banner.t <= 0) banner = null; }
    for (const p of P) if (p.flash > 0) p.flash = Math.max(0, p.flash - dt * 4);
  }
  // Tiếng khán giả: nhiều nhịp vỗ tay ngắn nối nhau
  function crowd(strength: number) {
    if (simMode) return;
    for (let i = 0; i < 16; i++) sfx.noise(0.07, 0.07 * strength, 3200 + Math.random() * 2200, 900, i * 0.07 + Math.random() * 0.05);
    if (strength > 1) sfx.tone(520, 0.4, 'triangle', 0.08, 780, 0.05);
  }

  // ---------- Vị trí vợt ----------
  function racketHead(p: Pl, prog: number) {
    const d = dirOf(p), a = -0.7 + prog * 3.1, sx = p.x, sy = shoulderY(p);
    return { x: sx + d * Math.sin(a) * RACKET_R, y: sy - Math.cos(a) * RACKET_R, a };
  }

  // ---------- Điều khiển ----------
  const keys: Record<string, boolean> = {};
  const touch = { l: false, r: false, j: false, d: false };
  function readInput(p: Pl) {
    const k = keys;
    if (mode === 0) {
      p.inp.l = !!(k['a'] || k['arrowleft'] || touch.l); p.inp.r = !!(k['d'] || k['arrowright'] || touch.r);
      p.inp.jump = !!(k['w'] || k['arrowup'] || touch.j); p.inp.down = !!(k['s'] || k['arrowdown'] || touch.d);
    } else if (p.side === 0) {
      p.inp.l = !!k['a']; p.inp.r = !!k['d']; p.inp.jump = !!k['w']; p.inp.down = !!k['s'];
    } else {
      p.inp.l = !!k['arrowleft']; p.inp.r = !!k['arrowright']; p.inp.jump = !!k['arrowup']; p.inp.down = !!k['arrowdown'];
    }
  }
  const HITKEYS0 = new Set(['f', ' ', 'space']);
  const HITKEYS1 = new Set(['enter', '0']);
  window.addEventListener('keydown', (e) => {
    if (!running || gameEl.hidden) return;
    const tg = e.target as HTMLElement;
    if (tg && /input|textarea|select/i.test(tg.tagName)) return;
    const key = e.key.toLowerCase();
    if (['arrowleft', 'arrowright', 'arrowup', 'arrowdown', ' '].includes(key)) e.preventDefault();
    if (key === 'p' || key === 'escape') { if (!e.repeat) togglePause(); return; }
    if (e.repeat) { keys[key] = true; return; }
    keys[key] = true;
    if (paused || state === 'menu') return;
    if (mode === 0) { if (HITKEYS0.has(key) || key === 'enter') P[0].hitReq = true; }
    else { if (HITKEYS0.has(key)) P[0].hitReq = true; if (HITKEYS1.has(key)) P[1].hitReq = true; }
  });
  window.addEventListener('keyup', (e) => { keys[e.key.toLowerCase()] = false; });
  window.addEventListener('blur', () => { for (const k in keys) keys[k] = false; touch.l = touch.r = touch.j = touch.d = false; });

  // ---------- Máy chơi ----------
  const home = (p: Pl) => (p.side === 0 ? NETX - 190 : NETX + 190);
  function aiPlan(p: Pl) {
    const o = LV[clamp(p.ai, 0, 2)], d = dirOf(p), opp = P[1 - p.side];
    p.aiHas = false; p.aiJump = false;
    if (state !== 'rally' || lastHitter === p.side) { p.aiX = home(p) + rnd(-30, 30); return; }
    // dự đoán đường bay để tìm điểm gặp cầu ở độ cao định đánh
    // các quyết định ngẫu nhiên chỉ chốt một lần cho mỗi cú đánh của đối thủ, tránh đổi ý liên tục
    if (p.planHit !== hitsInRally) {
      p.planHit = hitsInRally; p.aiJumped = false;
      p.aiSmash = o.smash > 0 && Math.random() < o.smash;
      p.aiHitH = p.aiSmash ? 170 : rnd(92, 112);
      p.aiNx = rnd(-o.err, o.err); p.aiNt = rnd(-o.terr, o.terr);
      p.aiMiss = Math.random() < o.miss;
    }
    const wantSmash = p.aiSmash;
    const s = { x: SH.x, y: SH.y, vx: SH.vx, vy: SH.vy };
    let t = 0, found: null | { x: number; y: number; t: number; low: boolean } = null;
    for (let i = 0; i < 720; i++) {
      integrate(s, STEP); t += STEP;
      if (d * (NETX - s.x) <= 0) { if (s.y >= GROUND - 4) break; continue; }
      if (s.vy > 0 && s.y >= GROUND - p.aiHitH) { found = { x: s.x, y: s.y, t, low: false }; break; }
      if (s.y >= GROUND - 4) { found = { x: s.x, y: s.y, t, low: true }; break; }
    }
    if (!found) { p.aiX = home(p); return; }
    const outside = found.x < COURTL - 14 || found.x > COURTR + 14;
    if (outside && Math.random() > o.chase) { p.aiX = home(p); return; }
    p.aiHas = true;
    p.aiX = found.x - d * 40 + p.aiNx;
    p.aiHitT = clock + found.t + p.aiNt;
    p.aiJump = wantSmash && !found.low && p.aiHitH > 145;
    void opp;
  }
  function aiControl(p: Pl, dt: number) {
    const o = LV[clamp(p.ai, 0, 2)], d = dirOf(p), opp = P[1 - p.side];
    p.inp.l = p.inp.r = p.inp.jump = false;
    if (state === 'serve') {
      if (server === p.side && !serveBusy) {
        p.aiServeT += dt;
        if (p.aiServeT > rnd(0.7, 1.3)) { p.aiServeT = 0; serveDown = Math.random() < (p.ai === 2 ? 0.35 : p.ai === 1 ? 0.2 : 0.1); p.inp.down = serveDown; p.hitReq = true; }
      }
      return;
    }
    if (state !== 'rally') return;
    p.aiT -= dt;
    if (p.aiT <= 0) { p.aiT = o.react * rnd(0.7, 1.3); aiPlan(p); }
    const dx = p.aiX - p.x;
    if (Math.abs(dx) > 7) { if (dx > 0) p.inp.r = true; else p.inp.l = true; }
    p.inp.down = p.swing ? p.inp.down : false;
    if (p.aiHas && !p.aiMiss) {
      const tr = p.aiHitT - clock;
      if (p.aiJump && !p.aiJumped && tr <= 0.38 && p.h === 0) { p.inp.jump = true; p.aiJumped = true; }
      const lead = SWING * 0.45;
      const near = Math.abs(SH.x - (p.x + d * 36)) < 95;
      if (!p.swing && p.cool <= 0 && tr <= lead + 0.01 && tr > -0.2 && near && (!p.aiJump || p.h > 40 || tr < 0.04)) {
        p.hitReq = true;
        p.inp.down = !p.aiJump && Math.abs(opp.x - NETX) > 190 && Math.random() < o.drop;
        p.aiHas = false;
      }
    }
    // tự bỏ qua cầu đã sang sân đối thủ
    if (lastHitter === p.side) p.aiHas = false;
    // chạy tốc độ theo mức độ
    if (p.inp.l || p.inp.r) p.vx = clamp(p.vx, -SPEED * o.speed, SPEED * o.speed);
  }

  // ---------- Người chơi di chuyển, nhảy, vung vợt ----------
  function movePlayer(p: Pl) {
    const live = state === 'serve' || state === 'rally';
    if (live) { if (p.ai >= 0) aiControl(p, STEP); else readInput(p); }
    else { p.inp.l = p.inp.r = p.inp.jump = p.inp.down = false; }
    const maxV = SPEED * (p.ai >= 0 ? LV[clamp(p.ai, 0, 2)].speed : 1) * (p.swing ? 0.75 : 1) * (p.h > 0 ? 0.9 : 1);
    const want = ((p.inp.r ? 1 : 0) - (p.inp.l ? 1 : 0)) * maxV;
    const acc = 2600 * STEP;
    if (p.vx < want) p.vx = Math.min(want, p.vx + acc); else if (p.vx > want) p.vx = Math.max(want, p.vx - acc);
    p.x += p.vx * STEP;
    const lo = p.side === 0 ? 34 : NETX + 22, hi = p.side === 0 ? NETX - 22 : W - 34;
    p.x = clamp(p.x, lo, hi);
    if (p.x === lo || p.x === hi) p.vx = 0;
    // nhảy
    if (p.h === 0 && p.inp.jump && live && !p.swing) { p.vh = PJUMP; snd('jump'); dust(p.x, 4); }
    else if (p.h === 0 && p.inp.jump && live) { p.vh = PJUMP * 0.9; dust(p.x, 3); }
    if (p.h > 0 || p.vh > 0) {
      p.vh -= PGRAV * STEP; p.h += p.vh * STEP;
      if (p.h <= 0) { p.h = 0; if (p.vh < -200) { dust(p.x, 5); if (!simMode) sndGap('land', 0.12); } p.vh = 0; }
    }
    p.ph += Math.abs(p.vx) * STEP * 0.055;
    p.lean += (clamp(p.vx / 300, -1, 1) * 5 - p.lean) * Math.min(1, STEP * 12);
    if (p.cool > 0) p.cool -= STEP;
    // đánh
    if (p.hitReq) {
      p.hitReq = false;
      if (state === 'serve' && server === p.side && !serveBusy) startServe(p);
      else if (state === 'rally' && !p.swing && p.cool <= 0) { p.swing = { t: 0, dur: SWING, done: false }; if (!simMode) sfx.tone(420, 0.1, 'sine', 0.05, 220); }
    }
    if (p.swing) {
      p.swing.t += STEP;
      if (state === 'rally') tryHit(p);
      if (p.swing.t >= p.swing.dur) { if (!p.swing.done && state === 'rally') bump('whiff' + p.side); p.swing = null; p.cool = 0.1; }
    }
  }

  // ---------- Giao cầu ----------
  function resetServe() {
    state = 'serve'; stT = 0; serveBusy = false; serveT = 0; lastHitter = -1; hitsInRally = 0; rallyT = 0; netHit = false; lastReason = '';
    for (const p of P) { p.vx = 0; p.vh = 0; p.h = 0; p.swing = null; p.cool = 0; p.aiHas = false; p.aiT = 0; p.aiServeT = 0; p.hitReq = false; p.planHit = -1; p.aiJumped = false; }
    const sv = P[server], rc = P[1 - server];
    sv.x = server === 0 ? NETX - 200 : NETX + 200;
    rc.x = server === 0 ? NETX + 230 : NETX - 230;
    SH.landed = false; SH.vx = SH.vy = 0; SH.tr.length = 0; SH.trN = 0;
    placeHeld();
    SH.ang = dirOf(sv) > 0 ? -1.2 : Math.PI + 1.2;
  }
  function placeHeld() {
    const p = P[server], d = dirOf(p);
    SH.x = p.x + d * 20; SH.y = GROUND - p.h - 92;
  }
  function startServe(p: Pl) {
    serveBusy = true; serveT = 0; serveDown = p.inp.down;
    SH.vx = 0; SH.vy = -270;
  }
  function launchServe() {
    const p = P[server], d = dirOf(p);
    const short = serveDown;
    const tgt = short ? 105 + rnd(-15, 15) : 290 + rnd(-20, 20);
    const targets = short ? [tgt, tgt + 40, tgt + 90] : [tgt, tgt - 40, tgt - 90, tgt - 140];
    const sol = solveShot(SH.x, SH.y, d, short ? [40, 28, 16, 4, -8] : [62, 56, 50, 44], targets, short ? 520 : 1150);
    if (sol) { SH.vx = sol.vx; SH.vy = sol.vy; } else { SH.vx = d * 500; SH.vy = -520; }
    state = 'rally'; stT = 0; rallyT = 0; lastHitter = server; hitsInRally = 1; serveBusy = false;
    if (!simMode) { impact(SH.x, SH.y, false); snd('pop'); sfx.tone(900, 0.06, 'triangle', 0.1, 500); }
  }

  // ---------- Đánh cầu ----------
  function tryHit(p: Pl) {
    const sw = p.swing!;
    if (sw.done || lastHitter === p.side) return;
    const prog = sw.t / sw.dur;
    if (prog < 0.1 || prog > 0.9) return;
    const d = dirOf(p);
    if (d * (SH.x - NETX) > 30) return;
    const head = racketHead(p, prog);
    if (Math.hypot(SH.x - head.x, SH.y - head.y) > HIT_RAD) return;
    sw.done = true;
    executeHit(p, prog);
  }
  function executeHit(p: Pl, prog: number) {
    const d = dirOf(p), opp = P[1 - p.side];
    const airborne = p.h > 20, high = SH.y < shoulderY(p) - 5;
    const behind = d * (SH.x - p.x) < -10;
    let type = 'clear';
    if (p.inp.down) type = 'drop'; else if (airborne && high && !behind) type = 'smash';
    const off = clamp((prog - 0.45) * 2 * 150, -120, 120);
    let base = type === 'drop' ? 70 : type === 'smash' ? 200 : 300;
    if (p.ai >= 0) {
      if (type === 'clear') base = Math.abs(opp.x - NETX) < 200 ? rnd(300, 340) : rnd(180, 260);
      if (type === 'smash') base = rnd(130, 300);
      if (type === 'drop') base = rnd(50, 100);
    }
    if (p.ai === 0 && Math.random() < 0.14) base += Math.random() < 0.5 ? 120 : -180; // máy mức Dễ hay đánh hỏng
    if (behind) base -= 70;
    const tg = Math.max(20, base + off);
    const targets = [tg, tg - 45, tg - 90, tg - 140, 120];
    const hx = SH.x, hy = SH.y;
    let sol: ReturnType<typeof solveShot> = null;
    if (type === 'smash') sol = solveShot(hx, hy, d, [-32, -24, -16, -8, 0, 8], targets, 1500);
    else if (type === 'drop') sol = solveShot(hx, hy, d, [45, 30, 15, 0, -15, -30], targets.map((x) => Math.min(x, 120)), 400);
    if (!sol) { if (type === 'smash') type = 'clear'; sol = solveShot(hx, hy, d, [58, 50, 42, 34, 26, 18], targets, 1350); }
    if (!sol) sol = { vx: d * 520, vy: -680, land: 0, v: 800 };
    SH.vx = sol.vx; SH.vy = sol.vy;
    lastHitter = p.side; hitsInRally++; bump('p' + p.side + type);
    p.flash = 1;
    if (!simMode) {
      const big = type === 'smash';
      impact(hx, hy, big);
      if (big) { shake = 0.35; addFx({ k: 'ring', x: hx, y: hy, life: 0.45, max: 0.45, col: '#ff9a3c', s: 90 }); snd('boom'); sfx.tone(160, 0.12, 'square', 0.14, 70); }
      else if (type === 'drop') { sfx.tone(700, 0.08, 'sine', 0.12, 500); sfx.noise(0.03, 0.06, 2500); }
      else { snd('pop'); sfx.tone(780, 0.07, 'triangle', 0.14, 480); }
    }
  }

  // ---------- Cầu bay ----------
  function stepShuttle() {
    const s = SH;
    if (state === 'serve' && !serveBusy) { placeHeld(); return; }
    if (s.landed) return;
    const px = s.x;
    integrate(s, STEP);
    // lưới
    if ((px - NETX) * (s.x - NETX) < 0 && s.y > NETTOP - 6 && s.y < GROUND) {
      s.x = px; s.vx = -s.vx * 0.15; s.vy = Math.abs(s.vy) * 0.2;
      if (!netHit && state === 'rally') { netHit = true; netShake = 1; if (!simMode) { snd('error'); sfx.noise(0.08, 0.1, 1800); } }
    }
    // cầu xoay đầu nặng về phía bay
    const ta = Math.atan2(s.vy, s.vx), diff = wrapA(ta - s.ang);
    s.ang += clamp(diff, -15 * STEP, 15 * STEP);
    if (!simMode && ((s.trN++) & 1) === 0) { s.tr.push({ x: s.x, y: s.y }); if (s.tr.length > 9) s.tr.shift(); }
    if (s.y >= GROUND - 4) {
      s.y = GROUND - 4; s.landed = true; s.vx = s.vy = 0;
      if (state === 'rally') onLand();
      else if (!simMode) sfx.tone(240, 0.06, 'triangle', 0.1, 150);
    }
  }
  function onLand() {
    const x = SH.x;
    const inside = x >= COURTL - 5 && x <= COURTR + 5;
    const landSide = x < NETX ? 0 : 1;
    let winner: number;
    if (!inside) { winner = 1 - lastHitter; lastReason = ui.outBall; }
    else { winner = 1 - landSide; lastReason = netHit ? ui.netBall : ''; }
    if (!simMode) { snd('land'); dust(x, 6); }
    awardPoint(winner);
  }

  // ---------- Điểm số ----------
  function nameOf(s: number) { return P[s].name; }
  function awardPoint(w: number) {
    sim.rallies.push(hitsInRally);
    bump('lose' + (1 - w) + (lastReason === ui.outBall ? '-out' : netHit ? '-net' : '-in'));
    pts[w]++; popT[w] = 1; server = w;
    state = 'point'; stT = 0;
    const win = gameWinner();
    if (!simMode) {
      banner = { txt: ui.pointFor.replace('{n}', nameOf(w)), sub: lastReason, t: 1.6, max: 1.6, col: w === 0 ? P[0].col2 : P[1].col2 };
      crowd(w === 0 || mode === 1 ? 1 : 0.6);
      snd(w === 0 || mode === 1 ? 'coin' : 'click');
    }
    if (win >= 0) {
      games[win]++; gameLog.push(`${pts[0]}–${pts[1]}`);
      if (games[win] >= 2) { state = 'matchend'; stT = 0; onMatchEnd(win); }
      else {
        state = 'gameend'; stT = 0;
        if (!simMode) { banner = { txt: ui.gameWin.replace('{n}', nameOf(win)).replace('{g}', String(gameNo)), sub: `${pts[0]} – ${pts[1]}`, t: 2.4, max: 2.4, col: '#fde68a' }; crowd(1.5); snd('levelup'); }
        server = win;
      }
    } else if (!simMode) {
      const a = pts[0], b = pts[1];
      void a; void b;
    }
  }
  let matchWinner = -1;
  function onMatchEnd(w: number) {
    matchWinner = w; matchDone = true;
    if (simMode) return;
    timeScale = 0.3;
    confetti(); crowd(2.2); snd('win'); sfx.music(null);
    banner = { txt: ui.matchWin.replace('{n}', nameOf(w)), sub: '', t: 3, max: 3, col: '#fde68a' };
    if (mode === 0) { if (w === 0) stats.w[level]++; else stats.l[level]++; saveStats(); }
  }
  function startGameNo(n: number) {
    gameNo = n; pts[0] = pts[1] = 0; timeScale = 1;
    if (!simMode) banner = { txt: ui.gameN.replace('{n}', String(n)), sub: '', t: 1.2, max: 1.2, col: '#ffffff' };
    resetServe();
  }
  function newMatch() {
    P[0].ai = -1; P[1].ai = mode === 0 ? level : -1;
    P[0].name = mode === 0 ? ui.you : ui.p1; P[1].name = mode === 0 ? ui.cpu : ui.p2;
    games[0] = games[1] = 0; gameLog.length = 0; matchDone = false; matchWinner = -1; timeScale = 1;
    server = Math.random() < 0.5 ? 0 : 1; clock = 0; fx = []; banner = null;
    resultOv.hidden = true; pauseOv.hidden = true; paused = false;
    startGameNo(1);
  }

  // ---------- Vòng lặp mô phỏng ----------
  function step() {
    clock += STEP; stT += STEP;
    for (const p of P) movePlayer(p);
    if (state === 'serve') {
      if (serveBusy) {
        serveT += STEP;
        const sv = P[server];
        if (serveT >= 0.14 && !sv.swing) sv.swing = { t: 0, dur: SWING, done: true };
        stepShuttle();
        if (serveT >= 0.26) launchServe();
      } else stepShuttle();
    } else if (state === 'rally') {
      rallyT += STEP;
      stepShuttle();
      if (rallyT > 28 && state === 'rally') { sim.timeouts++; lastReason = ''; awardPoint(1 - lastHitter < 0 ? 0 : 1 - lastHitter); }
    } else if (state === 'point') {
      stepShuttle();
      if (stT >= (simMode ? 0.1 : 1.7)) resetServe();
    } else if (state === 'gameend') {
      stepShuttle();
      if (stT >= (simMode ? 0.1 : 2.6)) startGameNo(gameNo + 1);
    } else if (state === 'matchend') {
      stepShuttle();
      if (!simMode && stT > 0.6) timeScale = 1;
      if (!simMode && stT >= 1.6 && resultOv.hidden) showResult();
    }
  }

  function showResult() {
    const w = matchWinner;
    const msg = mode === 0 ? (w === 0 ? ui.winYou : ui.loseYou) : ui.winOf.replace('{n}', nameOf(w));
    (document.getElementById('bm-msg') as HTMLElement).textContent = msg;
    (document.getElementById('bm-sum') as HTMLElement).innerHTML = `${ui.gamesLine}: <b>${games[0]} – ${games[1]}</b><br>${gameLog.join(' · ')}`;
    resultOv.hidden = false;
  }

  // ---------- Vẽ nền ----------
  const bg = document.createElement('canvas'); bg.width = W; bg.height = H;
  (function buildBg() {
    const k = bg.getContext('2d')!;
    const wall = k.createLinearGradient(0, 0, 0, GROUND);
    wall.addColorStop(0, '#26304f'); wall.addColorStop(1, '#3b4a78');
    k.fillStyle = wall; k.fillRect(0, 0, W, GROUND);
    // đèn trần
    k.fillStyle = 'rgba(255,245,200,.12)';
    for (let i = 0; i < 6; i++) { const x = 70 + i * 150; k.beginPath(); k.moveTo(x - 14, 0); k.lineTo(x + 14, 0); k.lineTo(x + 70, GROUND); k.lineTo(x - 70, GROUND); k.closePath(); k.fill(); }
    k.fillStyle = '#fff6c9'; for (let i = 0; i < 6; i++) k.fillRect(56 + i * 150, 4, 28, 5);
    // băng rôn
    const bn = ['#ef4444', '#f59e0b', '#22c55e', '#3b82f6', '#a855f7'];
    for (let i = 0; i < 5; i++) { k.fillStyle = bn[i]; k.fillRect(30 + i * 170, 112, 150, 24); k.fillStyle = 'rgba(255,255,255,.8)'; k.fillRect(30 + i * 170, 121, 150, 3); }
    // khán giả hai hàng
    let seed = 11; const r = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
    const hc = ['#f5c6a0', '#e0a97a', '#c68642', '#8d5524', '#f1d3b3'];
    const sh = ['#ef4444', '#3b82f6', '#22c55e', '#f59e0b', '#a855f7', '#ec4899', '#64748b', '#14b8a6'];
    for (let row = 0; row < 2; row++) {
      const y0 = 205 + row * 42;
      k.fillStyle = row ? 'rgba(20,24,44,.55)' : 'rgba(20,24,44,.35)'; k.fillRect(0, y0 + 14, W, 60);
      for (let x = 14 + (row ? 14 : 0); x < W; x += 30) {
        const y = y0 + r() * 6;
        k.fillStyle = sh[(r() * sh.length) | 0]; k.beginPath(); k.arc(x, y + 24, 14, Math.PI, TAU); k.fill();
        k.fillStyle = hc[(r() * hc.length) | 0]; k.beginPath(); k.arc(x, y + 6, 8.5, 0, TAU); k.fill();
      }
    }
    // sàn gỗ
    const fl = k.createLinearGradient(0, GROUND - 10, 0, H);
    fl.addColorStop(0, '#d6a45f'); fl.addColorStop(1, '#a8743a');
    k.fillStyle = fl; k.fillRect(0, GROUND - 10, W, H - GROUND + 10);
    k.fillStyle = 'rgba(0,0,0,.18)'; k.fillRect(0, GROUND - 10, W, 3);
    k.strokeStyle = 'rgba(90,55,20,.28)'; k.lineWidth = 1;
    for (let x = 0; x < W; x += 52) { k.beginPath(); k.moveTo(x, GROUND - 7); k.lineTo(x - 20, H); k.stroke(); }
    // vạch sân
    k.strokeStyle = 'rgba(255,255,255,.9)'; k.lineWidth = 4; k.lineCap = 'butt';
    for (const lx of [COURTL, COURTR]) { k.beginPath(); k.moveTo(lx, GROUND - 6); k.lineTo(lx, GROUND + 22); k.stroke(); }
    k.lineWidth = 3;
    k.beginPath(); k.moveTo(COURTL, GROUND + 10); k.lineTo(COURTR, GROUND + 10); k.stroke();
    k.strokeStyle = 'rgba(255,255,255,.65)'; k.lineWidth = 3;
    for (const lx of [NETX - 130, NETX + 130]) { k.beginPath(); k.moveTo(lx, GROUND - 4); k.lineTo(lx, GROUND + 22); k.stroke(); }
  })();

  // ---------- Vẽ người que ----------
  function drawPlayer(p: Pl) {
    const d = dirOf(p), fx0 = p.x, fy = GROUND - p.h;
    g.save();
    g.lineCap = 'round'; g.lineJoin = 'round';
    // bóng dưới chân
    g.fillStyle = 'rgba(0,0,0,.28)'; const sw = 20 * (1 - Math.min(0.5, p.h / 200));
    g.beginPath(); g.ellipse(fx0, GROUND + 3, sw, 5, 0, 0, TAU); g.fill();
    const air = p.h > 4;
    const hipY = fy - 30, lean = p.lean * d * 0.4 + p.lean * 0.6;
    const neck = { x: fx0 + lean, y: fy - 54 }, hip = { x: fx0 - lean * 0.3, y: hipY };
    g.strokeStyle = p.col; g.lineWidth = 4.2;
    // chân
    const legs: [number, number, number, number][] = [];
    if (air) {
      const tuck = p.vh > 0 ? 0.35 : 0.1;
      legs.push([hip.x + d * 4, hip.y, fx0 + d * (12 + 6 * tuck), fy - 4], [hip.x - d * 2, hip.y, fx0 - d * (10 + 8 * tuck), fy - 8 - 6 * tuck]);
    } else {
      const sp = Math.min(1, Math.abs(p.vx) / 200), sn = Math.sin(p.ph) * 16 * sp, lf = Math.max(0, Math.cos(p.ph)) * 7 * sp, lb = Math.max(0, -Math.cos(p.ph)) * 7 * sp;
      legs.push([hip.x, hip.y, fx0 + sn + d * 8 * (1 - sp), fy - lf], [hip.x, hip.y, fx0 - sn - d * 8 * (1 - sp), fy - lb]);
    }
    for (const [x1, y1, x2, y2] of legs) {
      const mx = (x1 + x2) / 2 + d * 5, my = (y1 + y2) / 2;
      g.beginPath(); g.moveTo(x1, y1); g.lineTo(mx, my); g.lineTo(x2, y2); g.stroke();
    }
    // thân
    g.lineWidth = 4.6; g.beginPath(); g.moveTo(hip.x, hip.y); g.lineTo(neck.x, neck.y); g.stroke();
    // đầu
    g.fillStyle = '#ffffff'; g.lineWidth = 3.6;
    g.beginPath(); g.arc(neck.x + d * 2, neck.y - 10, 9, 0, TAU); g.fill(); g.stroke();
    g.fillStyle = p.col; g.beginPath(); g.arc(neck.x + d * 5, neck.y - 11, 1.6, 0, TAU); g.fill();
    // băng đô
    g.strokeStyle = p.col2; g.lineWidth = 2.4; g.beginPath(); g.arc(neck.x + d * 2, neck.y - 10, 9, Math.PI * 1.1, Math.PI * 1.9); g.stroke();
    g.strokeStyle = p.col; g.lineWidth = 4;
    const shx = neck.x, shy = neck.y + 3;
    // tay không cầm vợt
    const sw2 = Math.sin(p.ph + Math.PI) * 10 * Math.min(1, Math.abs(p.vx) / 200);
    g.beginPath(); g.moveTo(shx, shy); g.lineTo(shx - d * (8 - sw2 * 0.3), shy + 12); g.lineTo(shx - d * (12 - sw2), shy + 22 - (air ? 8 : 0)); g.stroke();
    // tay và vợt
    let a: number;
    if (p.swing) a = -0.7 + (p.swing.t / p.swing.dur) * 3.1;
    else a = 0.95 + Math.sin(clock * 5 + p.side) * 0.05 - (air ? 0.25 : 0);
    const ux = d * Math.sin(a), uy = -Math.cos(a);
    const hand = { x: shx + ux * 24, y: shy + uy * 24 };
    const elbow = { x: shx + ux * 12 - uy * d * 3, y: shy + uy * 12 + ux * d * 3 };
    g.beginPath(); g.moveTo(shx, shy); g.lineTo(elbow.x, elbow.y); g.lineTo(hand.x, hand.y); g.stroke();
    // vệt vung vợt
    if (p.swing) {
      const prog = p.swing.t / p.swing.dur;
      g.strokeStyle = 'rgba(255,255,255,.35)'; g.lineWidth = 6;
      g.beginPath();
      const a0 = -0.7, steps = 8;
      for (let i = 0; i <= steps; i++) { const aa = a0 + (a - a0) * i / steps; const x = shx + d * Math.sin(aa) * RACKET_R, y = shy - Math.cos(aa) * RACKET_R; if (i) g.lineTo(x, y); else g.moveTo(x, y); }
      g.stroke();
      void prog;
    }
    // vợt
    g.strokeStyle = '#2d2d33'; g.lineWidth = 3;
    const h1 = { x: hand.x + ux * 18, y: hand.y + uy * 18 }, hc = { x: hand.x + ux * 31, y: hand.y + uy * 31 };
    g.beginPath(); g.moveTo(hand.x, hand.y); g.lineTo(h1.x, h1.y); g.stroke();
    g.save(); g.translate(hc.x, hc.y); g.rotate(Math.atan2(uy, ux) + Math.PI / 2);
    g.fillStyle = 'rgba(255,255,255,.28)'; g.strokeStyle = p.flash > 0 ? '#fde68a' : '#e5e7eb'; g.lineWidth = 3;
    g.beginPath(); g.ellipse(0, 0, 8, 13, 0, 0, TAU); g.fill(); g.stroke();
    g.strokeStyle = 'rgba(255,255,255,.5)'; g.lineWidth = 1;
    g.beginPath(); g.moveTo(-6, 0); g.lineTo(6, 0); g.moveTo(0, -11); g.lineTo(0, 11); g.stroke();
    g.restore();
    g.restore();
  }

  function drawShuttle() {
    const s = SH;
    // bóng
    g.fillStyle = 'rgba(0,0,0,.25)'; const k = clamp(1 - (GROUND - s.y) / 400, 0.3, 1);
    g.beginPath(); g.ellipse(s.x, GROUND + 4, 9 * k, 3 * k, 0, 0, TAU); g.fill();
    // vệt đuôi
    if (s.tr.length > 1 && !s.landed) {
      g.lineCap = 'round';
      for (let i = 1; i < s.tr.length; i++) { const a = i / s.tr.length; g.strokeStyle = `rgba(255,255,255,${a * 0.4})`; g.lineWidth = 1 + a * 3; g.beginPath(); g.moveTo(s.tr[i - 1].x, s.tr[i - 1].y); g.lineTo(s.tr[i].x, s.tr[i].y); g.stroke(); }
    }
    g.save(); g.translate(s.x, s.y); g.rotate(s.ang);
    // váy lông phía sau
    g.fillStyle = 'rgba(255,255,255,.92)'; g.strokeStyle = 'rgba(160,170,190,.9)'; g.lineWidth = 1;
    g.beginPath(); g.moveTo(-2, -3); g.lineTo(-17, -9); g.lineTo(-17, 9); g.lineTo(-2, 3); g.closePath(); g.fill(); g.stroke();
    g.beginPath(); g.moveTo(-6, -5); g.lineTo(-6, 5); g.moveTo(-11, -7); g.lineTo(-11, 7); g.stroke();
    // đầu nút bần
    g.fillStyle = '#f4d9a1'; g.strokeStyle = '#b4883f'; g.lineWidth = 1.2;
    g.beginPath(); g.arc(1.5, 0, 4.3, 0, TAU); g.fill(); g.stroke();
    g.restore();
  }

  function drawNet() {
    const wob = Math.sin(clock * 30) * netShake * 3;
    g.fillStyle = '#d9dce6'; g.fillRect(NETX - 4 + wob * 0.2, NETTOP - 10, 8, GROUND - NETTOP + 10);
    g.fillStyle = 'rgba(40,44,60,.55)'; g.fillRect(NETX - 3 + wob * 0.4, NETTOP, 6, GROUND - NETTOP - 4);
    g.strokeStyle = 'rgba(255,255,255,.55)'; g.lineWidth = 1;
    g.beginPath();
    for (let y = NETTOP + 6; y < GROUND - 4; y += 8) { g.moveTo(NETX - 3 + wob * 0.4, y); g.lineTo(NETX + 3 + wob * 0.4, y + 4); g.moveTo(NETX + 3 + wob * 0.4, y); g.lineTo(NETX - 3 + wob * 0.4, y + 4); }
    g.stroke();
    g.fillStyle = '#ffffff'; g.fillRect(NETX - 10 + wob * 0.3, NETTOP - 4, 20, 5);
    g.fillStyle = '#7b8194'; g.fillRect(NETX - 6, GROUND - 4, 12, 6);
  }

  function drawFx() {
    for (const p of fx) {
      const a = p.life / p.max;
      if (p.k === 'ring') { g.strokeStyle = p.col; g.globalAlpha = a; g.lineWidth = 3; g.beginPath(); g.arc(p.x, p.y, p.s * (1 - a * 0.75), 0, TAU); g.stroke(); g.globalAlpha = 1; }
      else if (p.k === 'glow') { const rad = p.s * (0.5 + (1 - a) * 0.6); g.globalAlpha = a; g.drawImage(glowSprite(p.col), p.x - rad, p.y - rad, rad * 2, rad * 2); g.globalAlpha = 1; }
      else if (p.k === 'conf') { g.save(); g.translate(p.x, p.y); g.rotate(p.rot); g.fillStyle = p.col; g.fillRect(-p.s / 2, -p.s / 4, p.s, p.s / 2); g.restore(); }
      else { g.globalAlpha = Math.min(1, a * 1.4); g.fillStyle = p.col; g.beginPath(); g.arc(p.x, p.y, p.s * (p.k === 'dust' ? (1.6 - a * 0.6) : 1), 0, TAU); g.fill(); g.globalAlpha = 1; }
    }
  }

  function txt(s: string, x: number, y: number, size: number, col: string, weight = 800, stroke = 'rgba(0,0,0,.55)') {
    g.font = `${weight} ${size}px system-ui, sans-serif`; g.textAlign = 'center'; g.textBaseline = 'middle';
    g.lineWidth = Math.max(3, size / 7); g.strokeStyle = stroke; g.strokeText(s, x, y); g.fillStyle = col; g.fillText(s, x, y);
  }

  function drawHud() {
    // bảng điểm
    g.save();
    g.fillStyle = 'rgba(10,14,30,.7)'; g.beginPath(); (g as any).roundRect ? (g as any).roundRect(W / 2 - 190, 10, 380, 58, 14) : g.rect(W / 2 - 190, 10, 380, 58); g.fill();
    for (let i = 0; i < 2; i++) {
      const cx = W / 2 + (i === 0 ? -105 : 105), pop = 1 + popT[i] * 0.45;
      g.font = '700 13px system-ui, sans-serif'; g.textAlign = 'center'; g.fillStyle = P[i].col2; g.fillText(P[i].name, cx, 24);
      g.save(); g.translate(cx, 49); g.scale(pop, pop); txt(String(pts[i]), 0, 0, 28, '#fff', 800); g.restore();
      // số ván thắng
      for (let k = 0; k < 2; k++) { g.fillStyle = k < games[i] ? '#fde68a' : 'rgba(255,255,255,.22)'; g.beginPath(); g.arc(cx + (i === 0 ? -48 : 48) + (k - 0.5) * (i === 0 ? 12 : -12), 40, 4, 0, TAU); g.fill(); }
      // chấm báo người giao cầu
      if (server === i && (state === 'serve' || state === 'rally')) { g.fillStyle = '#fde68a'; g.globalAlpha = 0.7 + 0.3 * Math.sin(clock * 6); g.beginPath(); g.arc(cx + (i === 0 ? 46 : -46), 49, 5, 0, TAU); g.fill(); g.globalAlpha = 1; }
    }
    txt(`${ui.gameN.replace('{n}', String(gameNo))}`, W / 2, 27, 12, 'rgba(255,255,255,.7)', 600, 'rgba(0,0,0,0)');
    txt('–', W / 2, 49, 22, 'rgba(255,255,255,.55)', 700, 'rgba(0,0,0,0)');
    g.restore();
    // gợi ý giao cầu
    if (state === 'serve' && !serveBusy) {
      const sv = P[server];
      const human = sv.ai < 0;
      const bob = Math.sin(clock * 5) * 4;
      g.fillStyle = '#fde68a'; g.beginPath(); const ax = sv.x, ay = GROUND - 150 + bob; g.moveTo(ax - 8, ay); g.lineTo(ax + 8, ay); g.lineTo(ax, ay + 12); g.closePath(); g.fill();
      if (human) txt(ui.serveHint.replace('{n}', sv.name), W / 2, 104, 17, '#ffffff', 700);
    }
    // điểm quyết định
    if (state === 'rally' || state === 'serve') {
      for (let s = 0; s < 2; s++) if (wouldWin(s)) { const m = games[s] === 1; txt(m ? ui.matchPoint : ui.gamePoint, W / 2, 86, 13, m ? '#fca5a5' : '#fde68a', 700); break; }
    }
    // thông báo giữa sân
    if (banner) {
      const b = banner, p = 1 - b.t / b.max, k = Math.min(1, p / 0.12, (1 - p) / 0.14), e = k * k * (3 - 2 * k);
      g.save(); g.globalAlpha = e; g.translate(W / 2, 160); g.scale(0.85 + 0.15 * e, 0.85 + 0.15 * e);
      g.fillStyle = 'rgba(10,14,30,.55)'; g.fillRect(-260, -30, 520, b.sub ? 68 : 54);
      txt(b.txt, 0, -4, 28, b.col, 800);
      if (b.sub) txt(b.sub, 0, 24, 15, '#ffffff', 600);
      g.restore();
    }
  }

  function draw() {
    g.save();
    if (shake > 0) g.translate((Math.random() - 0.5) * shake * 12, (Math.random() - 0.5) * shake * 12);
    g.drawImage(bg, 0, 0);
    drawNet();
    for (const p of P) drawPlayer(p);
    drawShuttle();
    drawFx();
    g.restore();
    drawHud();
  }

  // ---------- Vòng lặp chính ----------
  let last = performance.now(), acc = 0;
  function frame(now: number) {
    requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    if (!running || paused || simMode) return;
    acc += dt * timeScale;
    let n = 0;
    while (acc >= STEP && n < 24) { step(); acc -= STEP; n++; }
    if (acc > 0.1) acc = 0;
    updateFx(dt * timeScale);
    draw();
  }
  requestAnimationFrame(frame);

  // ---------- Menu, tạm dừng ----------
  function togglePause() {
    if (!running || state === 'menu' || !resultOv.hidden) return;
    paused = !paused; pauseOv.hidden = !paused;
    if (paused) sfx.music(null); else sfx.music('calm');
    if (paused) for (const k in keys) keys[k] = false;
  }
  document.getElementById('bm-resume')!.addEventListener('click', () => { if (paused) togglePause(); });
  document.getElementById('bm-pausebtn')!.addEventListener('click', () => togglePause());
  document.addEventListener('visibilitychange', () => { if (document.hidden && running && !paused && resultOv.hidden) togglePause(); });

  function toMenu() {
    running = false; paused = false; state = 'menu'; sfx.music(null);
    gameEl.hidden = true; menu.hidden = false; resultOv.hidden = true; pauseOv.hidden = true;
    paintMenu();
  }
  function startMatch() {
    menu.hidden = true; gameEl.hidden = false; running = true; acc = 0; last = performance.now();
    newMatch(); sfx.music('calm'); sfx.play('click');
    draw();
  }
  document.getElementById('bm-start')!.addEventListener('click', startMatch);
  document.getElementById('bm-again')!.addEventListener('click', () => { startMatch(); });
  document.getElementById('bm-change')!.addEventListener('click', () => { sfx.play('click'); toMenu(); });

  function pick(attr: string, set: (v: number) => void) {
    document.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((el) => el.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((o) => o.classList.toggle('sel', o === el));
      set(Number(el.dataset[attr])); sfx.play('click'); paintMenu();
    }));
  }
  pick('mode', (v) => { mode = v; });
  pick('level', (v) => { level = v; });
  function paintMenu() {
    (document.getElementById('bm-lvbox') as HTMLElement).hidden = mode !== 0;
    const coarse = matchMedia('(pointer: coarse)').matches;
    (document.getElementById('bm-keys') as HTMLElement).textContent = (mode === 0 ? ui.keysBot : ui.keysTwo) + (coarse && mode === 0 ? ' ' + ui.keysTouch : '');
    const tot = stats.w.reduce((a, b) => a + b, 0) + stats.l.reduce((a, b) => a + b, 0);
    (document.getElementById('bm-stat') as HTMLElement).textContent = tot ? ui.lv.map((n: string, i: number) => `${n}: ${stats.w[i]} / ${stats.l[i]}`).join(' · ') : '';
  }
  paintMenu();

  // ---------- Nút cảm ứng ----------
  function hold(id: string, on: () => void, off: () => void) {
    const b = document.getElementById(id) as HTMLElement;
    const up = (e: Event) => { b.classList.remove('on'); off(); void e; };
    b.addEventListener('pointerdown', (e) => { e.preventDefault(); b.setPointerCapture?.((e as PointerEvent).pointerId); b.classList.add('on'); on(); });
    b.addEventListener('pointerup', up); b.addEventListener('pointercancel', up); b.addEventListener('lostpointercapture', up);
    b.addEventListener('contextmenu', (e) => e.preventDefault());
  }
  hold('bm-l', () => (touch.l = true), () => (touch.l = false));
  hold('bm-r', () => (touch.r = true), () => (touch.r = false));
  hold('bm-j', () => (touch.j = true), () => (touch.j = false));
  hold('bm-d', () => (touch.d = true), () => (touch.d = false));
  hold('bm-h', () => { if (!paused) P[0].hitReq = true; }, () => {});
  canvas.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' && running && !paused && mode === 0) P[0].hitReq = true; });
  mountMute(stage);

  // ---------- Debug (chỉ khi URL có #debug) ----------
  if (DEBUG) {
    (window as any).__bd = {
      state: () => ({ state, pts: pts.slice(), games: games.slice(), server, clock: Math.round(clock * 10) / 10, lastHitter, hits: hitsInRally, shuttle: { x: Math.round(SH.x), y: Math.round(SH.y) }, p: P.map((p) => ({ x: Math.round(p.x), h: Math.round(p.h) })) }),
      // Máy đấu máy: chạy nhiều trận không cần vẽ, trả về thống kê
      sim: (la: number, lb: number, n: number) => {
        const out: any = { matches: n, wins: [0, 0], ends: 0, rallies: 0, avgHits: 0, maxHits: 0, timeouts: 0, avgPts: 0, gamesPlayed: 0, stuck: 0, totalPts: 0, minPtsGame: 99 };
        const wasRunning = running, wasMode = mode;
        simMode = true; sim.rallies = []; sim.timeouts = 0; sim.why = {};
        for (let m = 0; m < n; m++) {
          newMatch(); P[0].ai = la; P[1].ai = lb; matchDone = false;
          let steps = 0; const cap = 120 * 60 * 25;
          while (!matchDone && steps < cap) { step(); steps++; }
          if (!matchDone) out.stuck++; else { out.ends++; out.wins[matchWinner]++; out.gamesPlayed += games[0] + games[1]; out.totalPts += gameLog.reduce((a, s) => a + s.split('–').map(Number).reduce((x, y) => x + y, 0), 0); }
        }
        simMode = false; running = wasRunning; mode = wasMode;
        const r = sim.rallies; out.rallies = r.length; out.avgHits = Math.round(r.reduce((a, b) => a + b, 0) / Math.max(1, r.length) * 10) / 10; out.maxHits = Math.max(0, ...r); out.timeouts = sim.timeouts;
        out.why = sim.why; sim.why = {};
        out.avgPtsPerGame = Math.round(out.totalPts / Math.max(1, out.gamesPlayed) * 10) / 10;
        sim.rallies = []; toMenu();
        return out;
      },
      // Bắt đầu trận ở chế độ máy-đấu-máy để chụp ảnh giữa trận
      watch: (la: number, lb: number) => {
        menu.hidden = true; gameEl.hidden = false; running = true; paused = false; acc = 0;
        newMatch(); P[0].ai = la; P[1].ai = lb; draw();
      },
      step: (sec: number) => { const n = Math.round(sec * 120); for (let i = 0; i < n; i++) step(); updateFx(sec); draw(); },
      stepUntil: (st: string, max = 60) => { let i = 0; while (state !== st && i < max * 120) { step(); i++; } updateFx(0.5); draw(); return state === st; },
      swing: (side: number) => { P[side].hitReq = true; },
      // Đặt cầu bay với vận tốc cho trước để kiểm tra luật tính điểm (rơi trong sân, ra ngoài, vướng lưới)
      shoot: (x: number, y: number, vx: number, vy: number, hitter: number) => {
        simMode = true; running = true; server = hitter; resetServe(); state = 'rally'; lastHitter = hitter; hitsInRally = 1;
        SH.x = x; SH.y = y; SH.vx = vx; SH.vy = vy; SH.landed = false; P[0].ai = -1; P[1].ai = -1;
        let i = 0; const before = pts.slice(); while (state === 'rally' && i < 120 * 12) { step(); i++; }
        const r = { before, after: pts.slice(), landX: Math.round(SH.x), reason: lastReason, net: netHit };
        simMode = false; pts[0] = pts[1] = 0; toMenu(); return r;
      },
      lastReason: () => lastReason,
    };
  }
</script>

<style is:global>
  #bm-menu[hidden], #bm-game[hidden], #bm-lvbox[hidden] { display: none; }
  .bm-stage { position: relative; width: min(100%, 960px); margin: 12px auto 0; }
  #bm-canvas { width: 100%; height: auto; aspect-ratio: 2 / 1; display: block; border-radius: 14px; border: 3px solid #1f2a4a; box-shadow: 0 12px 32px rgba(0,0,0,.3); touch-action: none; background: #26304f; }
  .bm-stage .sfx-btn { top: 12px !important; right: 12px !important; }
  .bm-ov { position: absolute; inset: 3px; border-radius: 12px; background: rgba(5, 8, 20, .78); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 12px; text-align: center; }
  .bm-ov[hidden] { display: none; }
  .bm-ov h2 { margin: 0; font-size: 1.3rem; color: #fde68a; }
  .bm-big { font-size: 1.8rem; font-weight: 800; color: #fde68a; }
  .bm-sum { margin: 0; line-height: 1.7; }
  .bm-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .bm-ov .btn.ghost { color: #fff; border-color: rgba(255,255,255,.55); background: transparent; }
  .bm-pad { display: none; width: min(100%, 960px); margin: 10px auto 0; justify-content: space-between; align-items: flex-end; gap: 10px; user-select: none; -webkit-user-select: none; }
  .bm-grp { display: flex; gap: 10px; }
  .bm-pad button { min-width: 74px; height: 70px; border-radius: 18px; border: 2px solid var(--line); background: var(--card); color: var(--fg); font-size: 1.15rem; font-weight: 700; touch-action: none; -webkit-touch-callout: none; padding: 0 10px; }
  .bm-pad button.go { background: var(--accent); color: #fff; border-color: transparent; min-width: 92px; }
  .bm-pad button.on { transform: scale(.93); filter: brightness(1.2); border-color: var(--accent); }
  .bm-pad button.bm-small { min-width: 46px; height: 46px; font-size: 1rem; border-radius: 50%; }
  @media (pointer: coarse), (max-width: 760px) { .bm-pad { display: flex; } }
  @media (max-width: 640px) {
    .bm-ov { position: fixed; inset: 0; z-index: 60; border-radius: 0; background: rgba(5, 8, 20, .9); }
    .bm-pad { gap: 6px; }
    .bm-grp { gap: 6px; }
    .bm-pad button { min-width: 48px; height: 58px; font-size: .88rem; padding: 0 5px; border-radius: 14px; }
    .bm-pad button.go { min-width: 66px; }
    .bm-pad button.bm-small { min-width: 40px; height: 40px; }
  }
</style>
