---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

const S = {
  vi: {
    title: 'Bắn Bi',
    sub: 'Bắn bi cùng màu để nổ chuỗi bi đang lăn theo đường xoắn. Đừng để chuỗi bi rơi vào hố!',
    pick: 'Chọn màn chơi',
    lvNames: ['Đồng cỏ xoắn', 'Đường rắn uốn', 'Mê cung vuông', 'Băng giá xoáy', 'Dung nham sóng'],
    keys: 'Di chuột (hoặc kéo ngón tay) để ngắm, bấm chuột (hoặc nhấc tay) để bắn. Chuột phải, phím Cách hoặc nút Đổi bi để đổi viên bi. Phím ← → để ngắm, ↑ hoặc Enter để bắn, P để tạm dừng.',
    legend: 'Bi có biểu tượng đặc biệt khi nổ sẽ kích hoạt: đồng hồ làm chậm chuỗi bi, mũi tên đẩy chuỗi lùi lại, bom nổ lan các bi xung quanh, tia sét xóa những bi gần hố nhất.',
    score: 'Điểm', level: 'Màn', best: 'Cao nhất', left: 'Còn lại',
    swap: 'Đổi bi', pause: 'Tạm dừng', resume: 'Tiếp tục', menu: 'Chọn màn', retry: 'Chơi lại', next: 'Màn tiếp',
    win: 'Thắng rồi!', lose: 'Bi đã rơi vào hố', paused: 'Tạm dừng', newBest: '🏆 Điểm cao mới!',
    locked: 'Qua màn trước để mở', combo: 'Combo',
    pw: ['', 'Chậm!', 'Lùi lại!', 'Bom!', 'Sét!'],
    start: 'Chơi',
  },
  en: {
    title: 'Marble Blast',
    sub: 'Shoot matching marbles to pop the chain rolling along a spiral path. Do not let the chain fall into the hole!',
    pick: 'Choose a level',
    lvNames: ['Meadow Spiral', 'Serpent Road', 'Square Maze', 'Frozen Whirl', 'Lava Waves'],
    keys: 'Move the mouse (or drag a finger) to aim, click (or lift your finger) to shoot. Right click, Space or the Swap button swaps your marble. Arrow keys ← → aim, ↑ or Enter shoots, P pauses.',
    legend: 'Marbles with a special icon trigger a power-up when popped: a clock slows the chain, an arrow pushes it back, a bomb blasts nearby marbles and a bolt wipes the marbles closest to the hole.',
    score: 'Score', level: 'Level', best: 'Best', left: 'Left',
    swap: 'Swap', pause: 'Pause', resume: 'Resume', menu: 'Levels', retry: 'Retry', next: 'Next level',
    win: 'You win!', lose: 'The chain fell into the hole', paused: 'Paused', newBest: '🏆 New best score!',
    locked: 'Clear the previous level to unlock', combo: 'Combo',
    pw: ['', 'Slow!', 'Rewind!', 'Bomb!', 'Bolt!'],
    start: 'Play',
  },
};
const t = S[lang];
---
<Base lang={lang} title={t.title} description={t.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{t.title}</h1>
  <p class="meta">{t.sub}</p>

  <div id="mb" data-ui={JSON.stringify(t)}>
    <div id="mb-menu">
      <h2 class="bd-h">{t.pick}</h2>
      <div class="mb-levels" id="mb-levels"></div>
      <p class="meta">{t.keys}</p>
      <p class="meta">{t.legend}</p>
    </div>

    <div id="mb-game" hidden>
      <div class="mb-hud">
        <span>{t.level} <b id="mb-lvn">1</b></span>
        <span>{t.score} <b id="mb-score">0</b></span>
        <span>{t.best} <b id="mb-best">0</b></span>
        <span>{t.left} <b id="mb-left">0</b></span>
      </div>
      <div class="mb-bar"><i id="mb-prog"></i></div>
      <div class="mb-stage" id="mb-stage">
        <canvas id="mb-canvas" width="900" height="640" aria-label={t.title}></canvas>
        <div class="mb-ov" id="mb-ov" hidden></div>
      </div>
      <div class="bd-row bd-actions">
        <button type="button" class="btn ghost sm" id="mb-swap">⇄ {t.swap}</button>
        <button type="button" class="btn ghost sm" id="mb-pause">❚❚ {t.pause}</button>
        <button type="button" class="btn ghost sm" id="mb-menu-btn">{t.menu}</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';

  type Pt = [number, number];
  interface M { s: number; c: number; pw: number; vo: number; ox: number; oy: number; }
  interface Ball { x: number; y: number; vx: number; vy: number; c: number; }
  interface Part { x: number; y: number; vx: number; vy: number; life: number; max: number; col: string; size: number; kind: number; }
  interface Pop { x: number; y: number; text: string; life: number; col: string; big: boolean; }

  const root = document.getElementById('mb') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const menuEl = $('mb-menu'), gameEl = $('mb-game'), stage = $('mb-stage'), ov = $('mb-ov');
  const canvas = $('mb-canvas') as HTMLCanvasElement;
  const g = canvas.getContext('2d')!;
  mountMute(stage);

  const W = 900, H = 640, R = 16, D = 32, TAU = Math.PI * 2, STEP = 2;
  const CX = 450, CY = 320;
  const SX = CX, SY = CY;
  const BALL_V = 900;
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

  // ---------- Màu bi ----------
  const PAL = [
    ['#ffb0b0', '#e84545', '#7a1111'],
    ['#a8c8ff', '#3b78e6', '#12337a'],
    ['#a6f5b8', '#2fbf55', '#0d5a25'],
    ['#fff3a0', '#f0c419', '#8a6a00'],
    ['#e2b8ff', '#9b4de0', '#44167a'],
    ['#9ef0f6', '#22b8c8', '#0b5a66'],
  ];
  const sprites: HTMLCanvasElement[] = PAL.map(([light, base, dark]) => {
    const sz = (R + 4) * 2, c = document.createElement('canvas');
    c.width = c.height = sz * 2;
    const x = c.getContext('2d')!;
    x.scale(2, 2);
    const m = sz / 2;
    const gr = x.createRadialGradient(m - R * 0.35, m - R * 0.42, R * 0.08, m, m, R);
    gr.addColorStop(0, light); gr.addColorStop(0.38, base); gr.addColorStop(1, dark);
    x.fillStyle = gr; x.beginPath(); x.arc(m, m, R, 0, TAU); x.fill();
    x.strokeStyle = 'rgba(0,0,0,.4)'; x.lineWidth = 1.2; x.stroke();
    x.save(); x.translate(m - R * 0.36, m - R * 0.46); x.rotate(-0.6);
    x.fillStyle = 'rgba(255,255,255,.8)'; x.beginPath(); x.ellipse(0, 0, R * 0.3, R * 0.17, 0, 0, TAU); x.fill(); x.restore();
    x.fillStyle = 'rgba(255,255,255,.18)'; x.beginPath(); x.ellipse(m + R * 0.35, m + R * 0.5, R * 0.3, R * 0.12, -0.5, 0, TAU); x.fill();
    return c;
  });
  const SPR = (R + 4) * 2;

  // ---------- Đường đi ----------
  function rounded(v: Pt[], r: number): Pt[] {
    const out: Pt[] = [v[0]];
    for (let i = 1; i < v.length - 1; i++) {
      const p0 = v[i - 1], p1 = v[i], p2 = v[i + 1];
      const d1 = Math.hypot(p0[0] - p1[0], p0[1] - p1[1]), d2 = Math.hypot(p2[0] - p1[0], p2[1] - p1[1]);
      const rr = Math.min(r, d1 / 2, d2 / 2);
      const a: Pt = [p1[0] + (p0[0] - p1[0]) / d1 * rr, p1[1] + (p0[1] - p1[1]) / d1 * rr];
      const b: Pt = [p1[0] + (p2[0] - p1[0]) / d2 * rr, p1[1] + (p2[1] - p1[1]) / d2 * rr];
      out.push(a);
      for (let k = 1; k < 14; k++) { const tt = k / 14, u = 1 - tt; out.push([u * u * a[0] + 2 * u * tt * p1[0] + tt * tt * b[0], u * u * a[1] + 2 * u * tt * p1[1] + tt * tt * b[1]]); }
      out.push(b);
    }
    out.push(v[v.length - 1]);
    return out;
  }
  function spiral(r0: number, r1: number, turns: number, start: number, dir: number, wob = 0, freq = 0): Pt[] {
    const n = Math.round(turns * 200), pts: Pt[] = [];
    for (let i = 0; i <= n; i++) {
      const tt = i / n, th = start + dir * turns * TAU * tt;
      const rr = r0 + (r1 - r0) * tt + wob * Math.sin(freq * th) * Math.min(1, tt * 10);
      pts.push([CX + rr * Math.cos(th), CY + rr * Math.sin(th)]);
    }
    return pts;
  }
  function resample(pts: Pt[], step: number) {
    const xs: number[] = [], ys: number[] = [];
    let px = pts[0][0], py = pts[0][1]; xs.push(px); ys.push(py);
    let need = step;
    for (let i = 1; i < pts.length; i++) {
      const x = pts[i][0], y = pts[i][1];
      let dx = x - px, dy = y - py, len = Math.hypot(dx, dy);
      while (len >= need) {
        const f = need / len; px += dx * f; py += dy * f; xs.push(px); ys.push(py);
        dx = x - px; dy = y - py; len = Math.hypot(dx, dy); need = step;
      }
      need -= len; px = x; py = y;
    }
    return { xs, ys };
  }

  const LV = [
    { n: 36, colors: 4, speed: 24, theme: 0, pts: (): Pt[] => [[-60, CY - 285], ...spiral(285, 150, 1.8, -Math.PI / 2, 1)] },
    { n: 46, colors: 4, speed: 27, theme: 1, pts: (): Pt[] => rounded([[-60, 70], [840, 70], [840, 185], [60, 185], [60, 455], [840, 455], [840, 570], [220, 570]], 52) },
    { n: 56, colors: 5, speed: 30, theme: 2, pts: (): Pt[] => rounded([[-60, 60], [850, 60], [850, 580], [50, 580], [50, 150], [760, 150], [760, 490], [140, 490], [140, 240], [670, 240], [670, 400], [240, 400]], 44) },
    { n: 66, colors: 5, speed: 32, theme: 3, pts: (): Pt[] => [[W + 60, CY + 270], ...spiral(270, 105, 2.8, Math.PI / 2, 1)] },
    { n: 76, colors: 6, speed: 34, theme: 4, pts: (): Pt[] => [[W + 60, CY - 280], ...spiral(280, 140, 2, -Math.PI / 2, -1, 11, 9)] },
  ];
  const THEMES = [
    { a: '#3f9a4a', b: '#1d5a2a', groove: '#6b4a2a', edge: '#3a2812', deco: 0 },
    { a: '#e2b468', b: '#b27a38', groove: '#8a5a2a', edge: '#5a3a18', deco: 1 },
    { a: '#2e2370', b: '#0f0a2e', groove: '#3a3a78', edge: '#14123a', deco: 2 },
    { a: '#9ed4ee', b: '#3a86b8', groove: '#6aa0c8', edge: '#2a5a85', deco: 3 },
    { a: '#5a1414', b: '#180404', groove: '#7a3a22', edge: '#2a0a06', deco: 4 },
  ];

  let lvl = 0;
  let PX: number[] = [], PY: number[] = [], PA: number[] = [], L = 0;
  let bg: HTMLCanvasElement | null = null;

  function buildPath(i: number) {
    const { xs, ys } = resample(LV[i].pts(), STEP);
    PX = xs; PY = ys; PA = [];
    for (let k = 0; k < xs.length; k++) {
      const a = Math.max(0, k - 3), b = Math.min(xs.length - 1, k + 3);
      PA.push(Math.atan2(ys[b] - ys[a], xs[b] - xs[a]));
    }
    L = (xs.length - 1) * STEP;
  }
  function posAt(s: number): [number, number, number] {
    if (s <= 0) return [PX[0] + Math.cos(PA[0]) * s, PY[0] + Math.sin(PA[0]) * s, PA[0]];
    const f0 = s / STEP, i0 = Math.min(PX.length - 2, Math.floor(f0)), f = Math.min(1, f0 - i0);
    return [PX[i0] * (1 - f) + PX[i0 + 1] * f, PY[i0] * (1 - f) + PY[i0 + 1] * f, PA[i0]];
  }
  function rng(seed: number) { let a = seed; return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }

  function strokePath(x: CanvasRenderingContext2D, width: number, style: string, dash?: number[]) {
    x.beginPath(); x.moveTo(PX[0], PY[0]);
    for (let k = 4; k < PX.length; k += 4) x.lineTo(PX[k], PY[k]);
    x.lineTo(PX[PX.length - 1], PY[PY.length - 1]);
    x.lineJoin = 'round'; x.lineCap = 'round'; x.lineWidth = width; x.strokeStyle = style;
    x.setLineDash(dash || []); x.stroke(); x.setLineDash([]);
  }
  function makeBg(i: number, w = W, h = H): HTMLCanvasElement {
    const c = document.createElement('canvas'); c.width = W; c.height = H;
    const x = c.getContext('2d')!;
    const th = THEMES[LV[i].theme], r = rng(1000 + i * 77);
    const gr = x.createRadialGradient(CX, CY, 60, CX, CY, 560);
    gr.addColorStop(0, th.a); gr.addColorStop(1, th.b);
    x.fillStyle = gr; x.fillRect(0, 0, W, H);
    // trang trí theo chủ đề
    for (let k = 0; k < 140; k++) {
      const px = r() * W, py = r() * H, sz = 1 + r() * 3;
      if (th.deco === 0) { x.fillStyle = r() < 0.5 ? 'rgba(20,80,30,.35)' : 'rgba(150,230,120,.22)'; x.beginPath(); x.ellipse(px, py, sz * 2, sz, 0, 0, TAU); x.fill(); if (r() < 0.12) { x.fillStyle = ['#ffd1e8', '#fff', '#ffe27a'][Math.floor(r() * 3)]; x.beginPath(); x.arc(px, py, 2.4, 0, TAU); x.fill(); } }
      else if (th.deco === 1) { x.fillStyle = r() < 0.5 ? 'rgba(120,70,20,.22)' : 'rgba(255,230,170,.2)'; x.beginPath(); x.ellipse(px, py, sz * 3, sz * 1.2, r() * 3, 0, TAU); x.fill(); }
      else if (th.deco === 2) { x.fillStyle = `rgba(255,255,255,${0.2 + r() * 0.6})`; x.beginPath(); x.arc(px, py, sz * 0.5, 0, TAU); x.fill(); }
      else if (th.deco === 3) { x.strokeStyle = 'rgba(255,255,255,.35)'; x.lineWidth = 1; x.beginPath(); x.moveTo(px - sz * 2, py); x.lineTo(px + sz * 2, py); x.moveTo(px, py - sz * 2); x.lineTo(px, py + sz * 2); x.stroke(); }
      else { x.fillStyle = `rgba(255,${100 + Math.floor(r() * 100)},30,${0.15 + r() * 0.4})`; x.beginPath(); x.arc(px, py, sz * 0.7, 0, TAU); x.fill(); }
    }
    if (th.deco === 2) { x.fillStyle = 'rgba(255,240,200,.12)'; x.beginPath(); x.arc(780, 90, 46, 0, TAU); x.fill(); x.fillStyle = 'rgba(255,240,200,.08)'; x.beginPath(); x.arc(764, 80, 12, 0, TAU); x.fill(); }
    // rãnh đường đi
    strokePath(x, 2 * R + 16, th.edge);
    strokePath(x, 2 * R + 10, th.groove);
    strokePath(x, 2 * R + 2, 'rgba(0,0,0,.28)');
    strokePath(x, 2 * R - 6, 'rgba(0,0,0,.12)');
    strokePath(x, 2, 'rgba(255,255,255,.12)', [2, 16]);
    // vầng tối quanh bàn
    const vg = x.createRadialGradient(CX, CY, 260, CX, CY, 620);
    vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.4)');
    x.fillStyle = vg; x.fillRect(0, 0, W, H);
    void w; void h;
    return c;
  }

  // ---------- Lưu ----------
  let save = { stars: [0, 0, 0, 0, 0], best: [0, 0, 0, 0, 0] };
  try { const s = JSON.parse(localStorage.getItem('mb-save') || 'null'); if (s) save = { stars: s.stars || save.stars, best: s.best || save.best }; } catch {}
  const persist = () => { try { localStorage.setItem('mb-save', JSON.stringify(save)); } catch {} };

  // ---------- Trạng thái ----------
  let phase = 'menu'; // menu | play | pause | winwait | win | lose
  let ch: M[] = [];
  let balls: Ball[] = [];
  let parts: Part[] = [];
  let pops: Pop[] = [];
  let MX: number[] = [], MY: number[] = [];
  let T = 0, score = 0, combo = 0, lastPop = -99, cool = 0, recoil = 0, slowT = 0, revT = 0, rush = true;
  let cur = 0, nxt = 0, aim = -Math.PI / 2, shake = 0, flash = 0, flashCol = '#fff';
  let winT = 0, loseT = 0, total = 1, tickT = 0, ovShown = false, keyAim = 0, started = 0, rawLost = false;
  let last = 0, raf = 0;
  const dbg: any = { bot: false };

  function present(): number[] { const s = new Set<number>(); for (const m of ch) s.add(m.c); return s.size ? [...s] : [0]; }
  function pick(): number { const p = present(); return p[Math.floor(Math.random() * p.length)]; }
  function ensureColors() { const p = present(); if (!p.includes(cur)) cur = pick(); if (!p.includes(nxt)) nxt = pick(); }

  function startLevel(i: number) {
    lvl = i; buildPath(i); bg = makeBg(i);
    const def = LV[i];
    const r = rng(Date.now() & 0xffff);
    ch = []; const cols: number[] = [];
    for (let k = 0; k < def.n; k++) {
      let c = Math.floor(r() * def.colors);
      if (k > 0 && r() < 0.35) c = cols[k - 1];
      if (k > 1 && cols[k - 1] === cols[k - 2] && c === cols[k - 1]) c = (c + 1 + Math.floor(r() * (def.colors - 1))) % def.colors;
      cols.push(c);
      ch.push({ s: -40 - k * D, c, pw: k > 8 && r() < 0.06 ? 1 + Math.floor(r() * 4) : 0, vo: 0, ox: 0, oy: 0 });
    }
    total = def.n; balls = []; parts = []; pops = [];
    score = 0; combo = 0; lastPop = -99; cool = 0; recoil = 0; slowT = 0; revT = 0; rush = true; shake = 0; flash = 0; winT = 0; loseT = 0; ovShown = false; started = T;
    cur = pick(); nxt = pick();
    ov.hidden = true; menuEl.hidden = true; gameEl.hidden = false;
    phase = 'play';
    $('mb-lvn').textContent = String(i + 1);
    $('mb-best').textContent = String(save.best[i] || 0);
    hud();
    sfx.play('go'); sfx.music('calm');
    if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
  }
  function hud() {
    $('mb-score').textContent = String(score);
    $('mb-left').textContent = String(ch.length);
    ($('mb-prog') as HTMLElement).style.width = `${(1 - ch.length / total) * 100}%`;
  }

  // ---------- Hiệu ứng ----------
  function burst(x: number, y: number, c: number, n = 9) {
    for (let k = 0; k < n && parts.length < 420; k++) {
      const a = Math.random() * TAU, sp = 60 + Math.random() * 190;
      parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 30, life: 0.5 + Math.random() * 0.4, max: 0.9, col: PAL[c][1], size: 2 + Math.random() * 3, kind: 0 });
    }
    parts.push({ x, y, vx: 0, vy: 0, life: 0.35, max: 0.35, col: PAL[c][0], size: R, kind: 1 });
  }
  function ringFx(x: number, y: number, col: string, size: number) { parts.push({ x, y, vx: 0, vy: 0, life: 0.5, max: 0.5, col, size, kind: 1 }); }
  function popText(x: number, y: number, text: string, col = '#fff', big = false) { pops.push({ x: clamp(x, 70, W - 70), y: clamp(y, 30, H - 20), text, life: 1.1, col, big }); }
  function updateFx(dt: number) {
    for (let i = parts.length - 1; i >= 0; i--) {
      const p = parts[i]; p.life -= dt;
      if (p.life <= 0) { parts.splice(i, 1); continue; }
      p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= 0.97; p.vy = p.vy * 0.97 + 260 * dt * (p.kind === 2 ? -0.2 : 1);
    }
    for (let i = pops.length - 1; i >= 0; i--) { const p = pops[i]; p.life -= dt; p.y -= 34 * dt; if (p.life <= 0) pops.splice(i, 1); }
    shake = Math.max(0, shake - dt * 30); flash = Math.max(0, flash - dt * 2.4);
  }

  // ---------- Dãy bi ----------
  const contiguous = (j: number) => ch[j].s - ch[j + 1].s <= D + 1;
  function runAround(i: number): number[] {
    let lo = i, hi = i;
    while (lo > 0 && contiguous(lo - 1) && ch[lo - 1].c === ch[i].c) lo--;
    while (hi < ch.length - 1 && contiguous(hi) && ch[hi + 1].c === ch[i].c) hi++;
    const out: number[] = []; for (let k = lo; k <= hi; k++) out.push(k); return out;
  }
  function updatePos() { MX = []; MY = []; for (const m of ch) { const p = posAt(m.s); MX.push(p[0]); MY.push(p[1]); } }

  function popRun(idxs: number[]) {
    const set = new Set(idxs);
    const q = [...idxs];
    let sound = '';
    while (q.length) {
      const i = q.pop()!; const m = ch[i];
      if (!m.pw) continue;
      const pw = m.pw; m.pw = 0;
      const [x, y] = posAt(m.s);
      popText(x, y - 20, ui.pw[pw], '#ffe27a', true);
      if (pw === 1) { slowT = 6; sound = 'power'; ringFx(x, y, '#9ef0f6', 50); }
      else if (pw === 2) { revT = 2.2; sound = 'power'; ringFx(x, y, '#e2b8ff', 50); }
      else if (pw === 3) {
        sound = 'boom'; shake = 9; flash = 0.5; flashCol = '#ffb060'; ringFx(x, y, '#ffb060', 120);
        for (let j = 0; j < ch.length; j++) if (!set.has(j) && Math.hypot(MX[j] - x, MY[j] - y) < 112) { set.add(j); q.push(j); }
      } else if (pw === 4) {
        sound = 'zap'; flash = 0.6; flashCol = '#fff6a0';
        let c = 0; for (let j = 0; j < ch.length && c < 6; j++) if (ch[j].s > 0 && !set.has(j)) { set.add(j); q.push(j); c++; const p2 = posAt(ch[j].s); parts.push({ x: p2[0], y: p2[1], vx: 0, vy: 0, life: 0.3, max: 0.3, col: '#fff6a0', size: 22, kind: 1 }); }
      }
    }
    const len = set.size;
    combo++; lastPop = T;
    const mult = Math.min(combo, 8);
    const pts = len * 10 * mult + Math.max(0, len - 3) * 25;
    score += pts;
    let ax = 0, ay = 0;
    for (const i of set) { const p = posAt(ch[i].s); ax += p[0]; ay += p[1]; burst(p[0], p[1], ch[i].c); }
    ax /= len; ay /= len;
    popText(ax, ay, `+${pts}`, '#fff', len >= 5);
    if (combo >= 2) popText(ax, ay + 24, `${ui.combo} x${mult}`, '#ffd24a', true);
    if (len >= 5) shake = Math.max(shake, 4);
    const f = 420 * Math.pow(1.09, Math.min(combo, 10));
    sfx.tone(f, 0.11, 'triangle', 0.22, f * 1.7); sfx.noise(0.05, 0.08, 6000, 2000);
    if (sound) sfx.play(sound);
    ch = ch.filter((_, i) => !set.has(i));
    ensureColors(); updatePos(); hud();
  }

  function processTouch(a: M, b: M) {
    const ia = ch.indexOf(a), ib = ch.indexOf(b);
    if (ia < 0 || ib < 0 || ib !== ia + 1 || a.c !== b.c) return;
    const run = runAround(ia);
    if (run.length >= 3) popRun(run);
  }

  function stepChain(dt: number) {
    const n = ch.length; if (!n) return;
    if (rush && ch[0].s >= 90) rush = false;
    const starts = [0];
    for (let i = 0; i < n - 1; i++) if (ch[i].s - ch[i + 1].s > D + 0.8) starts.push(i + 1);
    const ends = starts.map((st, k) => (k + 1 < starts.length ? starts[k + 1] - 1 : n - 1));
    const touch: [M, M][] = [];
    if (revT > 0) {
      if (ch[n - 1].s > -3 * D) for (const m of ch) m.s -= 170 * dt;
    } else {
      const base = (rush ? 260 : LV[lvl].speed) * (slowT > 0 ? 0.28 : 1);
      for (let k = 0; k < starts.length; k++) {
        let sp: number;
        if (starts.length === 1) sp = base;
        else if (k === 0) sp = ch[ends[0]].c === ch[starts[1]].c ? -150 : 0;
        else sp = 320 * (1 + 0.12 * (k - 1));
        if (sp) for (let i = starts[k]; i <= ends[k]; i++) ch[i].s += sp * dt;
      }
      for (let k = 1; k < starts.length; k++) {
        const a = ch[ends[k - 1]], b = ch[starts[k]];
        const d = a.s - b.s;
        if (d < D) { const sh = d - D; for (let i = starts[k]; i <= ends[k]; i++) ch[i].s += sh; touch.push([a, b]); }
      }
    }
    for (const [a, b] of touch) processTouch(a, b);
  }

  function insertAt(ref: number, ahead: boolean, c: number): number {
    const r = ch[ref]; let idx: number, sNew: number;
    if (ahead) { idx = ref; sNew = r.s + D; }
    else {
      idx = ref + 1; const b = ch[ref + 1];
      sNew = b && b.s > r.s - 2 * D + 0.5 ? b.s + D : r.s - D;
    }
    ch.splice(idx, 0, { s: sNew, c, pw: 0, vo: 0, ox: 0, oy: 0 });
    for (let k = idx - 1; k >= 0; k--) {
      const need = ch[k + 1].s + D;
      if (ch[k].s < need - 0.01) { ch[k].vo -= need - ch[k].s; ch[k].s = need; } else break;
    }
    return idx;
  }

  function hitBall(b: Ball, hi: number) {
    const r = ch[hi], p = posAt(r.s);
    const ahead = (b.x - p[0]) * Math.cos(p[2]) + (b.y - p[1]) * Math.sin(p[2]) > 0;
    const idx = insertAt(hi, ahead, b.c);
    const np = posAt(ch[idx].s);
    ch[idx].ox = b.x - np[0]; ch[idx].oy = b.y - np[1];
    sfx.play('place');
    updatePos();
    const run = runAround(idx);
    if (run.length >= 3) popRun(run);
    else { ensureColors(); hud(); }
  }

  function updateBalls(dt: number) {
    updatePos();
    for (let bi = balls.length - 1; bi >= 0; bi--) {
      const b = balls[bi];
      const steps = Math.max(1, Math.ceil(BALL_V * dt / 6));
      let done = false;
      for (let st = 0; st < steps && !done; st++) {
        b.x += b.vx * dt / steps; b.y += b.vy * dt / steps;
        let hi = -1, hd = (R * 1.85) * (R * 1.85);
        for (let i = 0; i < ch.length; i++) {
          if (ch[i].s < -R || ch[i].s > L) continue;
          const dx = MX[i] - b.x, dy = MY[i] - b.y, d2 = dx * dx + dy * dy;
          if (d2 < hd) { hd = d2; hi = i; }
        }
        if (hi >= 0) { hitBall(b, hi); balls.splice(bi, 1); done = true; updatePos(); }
        else if (b.x < -30 || b.x > W + 30 || b.y < -30 || b.y > H + 30) { balls.splice(bi, 1); done = true; }
      }
    }
  }

  function fire() {
    if (phase !== 'play' || cool > 0) return;
    balls.push({ x: SX + Math.cos(aim) * 52, y: SY + Math.sin(aim) * 52, vx: Math.cos(aim) * BALL_V, vy: Math.sin(aim) * BALL_V, c: cur });
    cur = nxt; nxt = pick(); ensureColors();
    cool = 0.2; recoil = 1;
    sfx.tone(560, 0.07, 'triangle', 0.16, 300);
  }
  function swap() { if (phase !== 'play') return; const t = cur; cur = nxt; nxt = t; sfx.play('select'); }

  function stepGame(dt: number) {
    T += dt;
    updateFx(dt);
    if (phase === 'lose') {
      loseT += dt; for (const m of ch) m.s += 620 * dt;
      if (loseT > 1.5 && !ovShown) { ovShown = true; showOv('lose'); }
      return;
    }
    if (phase === 'winwait') { winT -= dt; if (winT <= 0) finishWin(); return; }
    if (phase !== 'play') return;
    cool -= dt; recoil = Math.max(0, recoil - dt * 5);
    slowT = Math.max(0, slowT - dt); revT = Math.max(0, revT - dt);
    if (T - lastPop > 3.2) combo = 0;
    if (keyAim) aim += keyAim * 2.2 * dt;
    const dk = Math.exp(-14 * dt);
    for (const m of ch) { m.vo *= dk; m.ox *= dk; m.oy *= dk; }
    updateBalls(dt);
    stepChain(dt);
    if (!ch.length) {
      phase = 'winwait'; winT = 0.9; sfx.music(null); sfx.play('win'); flash = 0.7; flashCol = '#fff6c0';
      for (let k = 0; k < 90; k++) parts.push({ x: Math.random() * W, y: -10, vx: (Math.random() - 0.5) * 120, vy: 60 + Math.random() * 160, life: 2, max: 2, col: PAL[k % 6][1], size: 3 + Math.random() * 3, kind: 0 });
      return;
    }
    if (ch[0].s >= L - 4) {
      phase = 'lose'; loseT = 0; shake = 14; sfx.music(null); sfx.play('lose'); return;
    }
    const dng = clamp((ch[0].s - (L - 380)) / 380, 0, 1);
    if (dng > 0.2) { tickT -= dt; if (tickT <= 0) { tickT = 0.55 - dng * 0.3; sfx.play('tick'); } }
  }

  function finishWin() {
    phase = 'win';
    const n = LV[lvl].n;
    const st = score >= n * 80 ? 3 : score >= n * 40 ? 2 : 1;
    const newBest = score > (save.best[lvl] || 0);
    if (newBest) save.best[lvl] = score;
    if (st > (save.stars[lvl] || 0)) save.stars[lvl] = st;
    persist();
    showOv('win', st, newBest);
  }

  function showOv(kind: string, stars = 0, newBest = false) {
    const last = lvl >= LV.length - 1;
    let html = '';
    if (kind === 'win') {
      html = `<div class="mb-card"><h2>${ui.win}</h2><div class="mb-stars">${[1, 2, 3].map((k) => `<span class="${k <= stars ? 'on' : ''}" style="animation-delay:${k * 0.18}s">★</span>`).join('')}</div><p>${ui.score}: <b>${score}</b></p>${newBest ? `<p class="mb-nb">${ui.newBest}</p>` : ''}<div class="bd-row">${last ? '' : `<button class="btn" data-act="next">${ui.next}</button>`}<button class="btn ghost" data-act="retry">${ui.retry}</button><button class="btn ghost" data-act="menu">${ui.menu}</button></div></div>`;
    } else if (kind === 'lose') {
      html = `<div class="mb-card"><h2>${ui.lose}</h2><p>${ui.score}: <b>${score}</b></p><div class="bd-row"><button class="btn" data-act="retry">${ui.retry}</button><button class="btn ghost" data-act="menu">${ui.menu}</button></div></div>`;
    } else {
      html = `<div class="mb-card"><h2>${ui.paused}</h2><div class="bd-row"><button class="btn" data-act="resume">${ui.resume}</button><button class="btn ghost" data-act="retry">${ui.retry}</button><button class="btn ghost" data-act="menu">${ui.menu}</button></div></div>`;
    }
    ov.innerHTML = html; ov.hidden = false;
  }
  ov.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null; if (!b) return;
    const act = b.dataset.act; sfx.play('click');
    if (act === 'next') startLevel(lvl + 1);
    else if (act === 'retry') startLevel(lvl);
    else if (act === 'resume') { ov.hidden = true; phase = 'play'; sfx.music('calm'); last = performance.now(); }
    else if (act === 'menu') toMenu();
  });
  function toMenu() { phase = 'menu'; sfx.music(null); ov.hidden = true; gameEl.hidden = true; menuEl.hidden = false; buildMenu(); }
  function pauseGame() { if (phase !== 'play') return; phase = 'pause'; sfx.music(null); showOv('pause'); }

  // ---------- Vẽ ----------
  function rr(x: CanvasRenderingContext2D, px: number, py: number, w: number, h: number, r: number) {
    x.beginPath(); x.moveTo(px + r, py); x.arcTo(px + w, py, px + w, py + h, r); x.arcTo(px + w, py + h, px, py + h, r); x.arcTo(px, py + h, px, py, r); x.arcTo(px, py, px + w, py, r); x.closePath();
  }
  function drawIcon(x: number, y: number, pw: number) {
    g.save(); g.translate(x, y);
    g.fillStyle = 'rgba(0,0,0,.35)'; g.beginPath(); g.arc(0, 0, 8.5, 0, TAU); g.fill();
    g.strokeStyle = '#fff'; g.fillStyle = '#fff'; g.lineWidth = 1.8; g.lineCap = 'round'; g.lineJoin = 'round';
    if (pw === 1) { g.beginPath(); g.arc(0, 0, 5.5, 0, TAU); g.stroke(); g.beginPath(); g.moveTo(0, -3.5); g.lineTo(0, 0); g.lineTo(3, 1.5); g.stroke(); }
    else if (pw === 2) { g.beginPath(); g.moveTo(1, -5); g.lineTo(-3, 0); g.lineTo(1, 5); g.moveTo(5, -5); g.lineTo(1, 0); g.lineTo(5, 5); g.stroke(); }
    else if (pw === 3) { g.fillStyle = '#222'; g.beginPath(); g.arc(0, 1.5, 5, 0, TAU); g.fill(); g.strokeStyle = '#ffd24a'; g.beginPath(); g.moveTo(2, -2); g.lineTo(4, -5); g.stroke(); g.fillStyle = '#ff7a30'; g.beginPath(); g.arc(4.5, -5.5, 1.6, 0, TAU); g.fill(); }
    else { g.fillStyle = '#fff6a0'; g.beginPath(); g.moveTo(2, -6); g.lineTo(-3.5, 1); g.lineTo(0, 1); g.lineTo(-2, 6); g.lineTo(4, -2); g.lineTo(0.5, -2); g.closePath(); g.fill(); }
    g.restore();
  }
  function drawMarble(x: number, y: number, c: number, scale: number, roll: number, pw: number) {
    g.fillStyle = 'rgba(0,0,0,.28)'; g.beginPath(); g.ellipse(x + 2 * scale, y + 4 * scale, R * scale * 0.95, R * scale * 0.7, 0, 0, TAU); g.fill();
    const sz = SPR * scale; g.drawImage(sprites[c], x - sz / 2, y - sz / 2, sz, sz);
    // đốm lăn
    g.fillStyle = 'rgba(255,255,255,.35)'; g.beginPath(); g.arc(x + R * 0.58 * scale * Math.cos(roll), y + R * 0.58 * scale * Math.sin(roll) * 0.55, 2.4 * scale, 0, TAU); g.fill();
    g.fillStyle = 'rgba(0,0,0,.22)'; g.beginPath(); g.arc(x - R * 0.58 * scale * Math.cos(roll), y - R * 0.58 * scale * Math.sin(roll) * 0.55, 2.4 * scale, 0, TAU); g.fill();
    if (pw) {
      const pl = 0.5 + 0.5 * Math.sin(T * 5);
      g.strokeStyle = `rgba(255,240,160,${0.45 + pl * 0.5})`; g.lineWidth = 2; g.beginPath(); g.arc(x, y, R * scale + 1 + pl * 1.5, 0, TAU); g.stroke();
      drawIcon(x, y, pw);
    }
  }
  function drawHole() {
    const hx = PX[PX.length - 1], hy = PY[PY.length - 1];
    const gr = g.createRadialGradient(hx, hy, 2, hx, hy, 30);
    gr.addColorStop(0, '#000'); gr.addColorStop(0.7, '#150a22'); gr.addColorStop(1, 'rgba(40,10,60,0)');
    g.fillStyle = gr; g.beginPath(); g.arc(hx, hy, 30, 0, TAU); g.fill();
    g.strokeStyle = 'rgba(190,150,255,.4)'; g.lineWidth = 2.5;
    for (let k = 0; k < 3; k++) { g.beginPath(); g.arc(hx, hy, 14 + k * 5, T * (2 - k * 0.5) + k * 2, T * (2 - k * 0.5) + k * 2 + 1.7); g.stroke(); }
  }
  function drawShooter() {
    g.save(); g.translate(SX, SY);
    g.fillStyle = 'rgba(0,0,0,.35)'; g.beginPath(); g.ellipse(0, 10, 52, 40, 0, 0, TAU); g.fill();
    // nền có vòng rune
    const pg = g.createRadialGradient(0, -8, 6, 0, 0, 48);
    pg.addColorStop(0, '#6f8aa8'); pg.addColorStop(1, '#24344a');
    g.fillStyle = pg; g.beginPath(); g.arc(0, 0, 46, 0, TAU); g.fill();
    g.strokeStyle = 'rgba(255,255,255,.28)'; g.lineWidth = 2; g.beginPath(); g.arc(0, 0, 41, 0, TAU); g.stroke();
    g.strokeStyle = 'rgba(160,230,255,.55)'; g.lineWidth = 3;
    for (let k = 0; k < 8; k++) { const a = T * 0.4 + k * TAU / 8; g.beginPath(); g.arc(0, 0, 36, a, a + 0.3); g.stroke(); }
    // nòng
    g.save(); g.rotate(aim);
    const kick = recoil * 6;
    const bg2 = g.createLinearGradient(0, -12, 0, 12); bg2.addColorStop(0, '#9fb6cc'); bg2.addColorStop(0.5, '#5a748f'); bg2.addColorStop(1, '#2e4258');
    g.fillStyle = bg2; rr(g, 8 - kick, -12, 44, 24, 8); g.fill();
    g.strokeStyle = 'rgba(0,0,0,.35)'; g.lineWidth = 1.5; g.stroke();
    g.fillStyle = '#d7e6f5'; rr(g, 46 - kick, -14, 8, 28, 4); g.fill();
    g.restore();
    // viên bi sẵn sàng ở miệng nòng
    const mx = Math.cos(aim) * (36 - recoil * 6), my = Math.sin(aim) * (36 - recoil * 6);
    g.drawImage(sprites[cur], mx - SPR * 0.5 * 0.9, my - SPR * 0.5 * 0.9, SPR * 0.9, SPR * 0.9);
    // mặt: hai mắt nhìn theo hướng ngắm
    const ex = Math.cos(aim) * 2.5, ey = Math.sin(aim) * 2.5;
    for (const sx of [-11, 11]) {
      const px = -Math.sin(aim) * sx * 0.55 - Math.cos(aim) * 8, py = Math.cos(aim) * sx * 0.55 - Math.sin(aim) * 8;
      g.fillStyle = '#fff'; g.beginPath(); g.arc(px, py, 6, 0, TAU); g.fill();
      g.fillStyle = '#10202e'; g.beginPath(); g.arc(px + ex, py + ey, 3, 0, TAU); g.fill();
    }
    // viên bi kế tiếp ở "túi" phía sau
    const bx = -Math.cos(aim) * 28, by = -Math.sin(aim) * 28;
    g.fillStyle = 'rgba(0,0,0,.35)'; g.beginPath(); g.arc(bx, by, 11, 0, TAU); g.fill();
    g.drawImage(sprites[nxt], bx - SPR * 0.32, by - SPR * 0.32, SPR * 0.64, SPR * 0.64);
    g.restore();
    // đường ngắm chấm chấm
    g.save(); g.fillStyle = 'rgba(255,255,255,.4)';
    for (let k = 0; k < 9; k++) { const d = 70 + k * 18; g.globalAlpha = 0.5 - k * 0.05; g.beginPath(); g.arc(SX + Math.cos(aim) * d, SY + Math.sin(aim) * d, 2.2, 0, TAU); g.fill(); }
    g.restore();
  }

  function draw() {
    g.save();
    if (shake > 0) g.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
    if (bg) g.drawImage(bg, 0, 0);
    if (phase === 'menu') { g.restore(); return; }
    drawHole();
    // bi (vẽ từ cuối chuỗi tới đầu để bi phía trước đè lên)
    for (let i = ch.length - 1; i >= 0; i--) {
      const m = ch[i];
      const sv = m.s + m.vo;
      if (sv < -R || sv > L + R) continue;
      const p = posAt(sv);
      const x = p[0] + m.ox, y = p[1] + m.oy;
      if (x < -R || x > W + R || y < -R || y > H + R) continue;
      const scale = sv > L - 40 ? clamp((L - sv) / 40, 0.25, 1) : 1;
      drawMarble(x, y, m.c, scale, sv / R, m.pw);
    }
    for (const b of balls) drawMarble(b.x, b.y, b.c, 1, T * 14, 0);
    drawShooter();
    // hạt
    for (const p of parts) {
      const k = p.life / p.max;
      if (p.kind === 1) { g.strokeStyle = p.col; g.globalAlpha = k * 0.9; g.lineWidth = 3 * k + 1; g.beginPath(); g.arc(p.x, p.y, p.size * (1.6 - k * 0.9), 0, TAU); g.stroke(); }
      else { g.fillStyle = p.col; g.globalAlpha = Math.min(1, k * 1.6); g.beginPath(); g.arc(p.x, p.y, p.size * (0.5 + k * 0.6), 0, TAU); g.fill(); }
    }
    g.globalAlpha = 1;
    // chữ nổi
    g.textAlign = 'center'; g.lineJoin = 'round';
    for (const p of pops) {
      g.globalAlpha = Math.min(1, p.life * 1.5);
      g.font = `800 ${p.big ? 22 : 17}px system-ui, sans-serif`;
      g.lineWidth = 4; g.strokeStyle = 'rgba(0,0,0,.6)'; g.strokeText(p.text, p.x, p.y);
      g.fillStyle = p.col; g.fillText(p.text, p.x, p.y);
    }
    g.globalAlpha = 1;
    // trạng thái đồ chơi đặc biệt
    let ty = H - 18;
    g.font = '700 14px system-ui, sans-serif'; g.textAlign = 'left';
    const tags: string[] = [];
    if (slowT > 0) tags.push(`${ui.pw[1]} ${slowT.toFixed(0)}s`);
    if (revT > 0) tags.push(`${ui.pw[2]} ${revT.toFixed(0)}s`);
    for (const tg of tags) { g.fillStyle = 'rgba(0,0,0,.5)'; g.fillRect(10, ty - 14, 96, 20); g.fillStyle = '#fff'; g.fillText(tg, 16, ty); ty -= 24; }
    // cảnh báo gần hố
    if (ch.length && phase === 'play') {
      const dng = clamp((ch[0].s - (L - 380)) / 380, 0, 1);
      if (dng > 0) {
        const pl = 0.5 + 0.5 * Math.sin(T * (4 + dng * 6));
        const hx = PX[PX.length - 1], hy = PY[PY.length - 1];
        const rg = g.createRadialGradient(hx, hy, 10, hx, hy, 110);
        rg.addColorStop(0, `rgba(255,40,40,${dng * (0.35 + pl * 0.35)})`); rg.addColorStop(1, 'rgba(255,40,40,0)');
        g.fillStyle = rg; g.beginPath(); g.arc(hx, hy, 110, 0, TAU); g.fill();
        const vg = g.createRadialGradient(CX, CY, 300, CX, CY, 560);
        vg.addColorStop(0, 'rgba(255,0,0,0)'); vg.addColorStop(1, `rgba(255,0,0,${dng * 0.28 * (0.5 + pl * 0.5)})`);
        g.fillStyle = vg; g.fillRect(0, 0, W, H);
      }
    }
    if (flash > 0) { g.globalAlpha = Math.min(0.5, flash * 0.5); g.fillStyle = flashCol; g.fillRect(0, 0, W, H); g.globalAlpha = 1; }
    g.restore();
  }

  function frame(now: number) {
    raf = requestAnimationFrame(frame);
    const dt = Math.min(0.033, (now - last) / 1000); last = now;
    if (document.hidden && phase === 'play') pauseGame();
    if (dbg.bot) botTick(dt);
    stepGame(dt);
    draw();
  }

  // ---------- Điều khiển ----------
  function toCanvas(e: PointerEvent): [number, number] {
    const r = canvas.getBoundingClientRect();
    return [(e.clientX - r.left) * W / r.width, (e.clientY - r.top) * H / r.height];
  }
  function aimAt(e: PointerEvent) { const [x, y] = toCanvas(e); aim = Math.atan2(y - SY, x - SX); }
  canvas.addEventListener('pointermove', (e) => { if (phase === 'play') aimAt(e); });
  canvas.addEventListener('pointerdown', (e) => {
    if (phase !== 'play') return;
    aimAt(e);
    if (e.pointerType === 'mouse') { if (e.button === 2) swap(); else if (e.button === 0) fire(); }
    else { try { canvas.setPointerCapture(e.pointerId); } catch {} }
  });
  canvas.addEventListener('pointerup', (e) => { if (e.pointerType !== 'mouse' && phase === 'play') { aimAt(e); fire(); } });
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());
  window.addEventListener('keydown', (e) => {
    if (menuEl.hidden === false) return;
    const k = e.key;
    if (k === 'ArrowLeft') { keyAim = -1; e.preventDefault(); }
    else if (k === 'ArrowRight') { keyAim = 1; e.preventDefault(); }
    else if (k === 'ArrowUp' || k === 'Enter') { fire(); e.preventDefault(); }
    else if (k === ' ') { swap(); e.preventDefault(); }
    else if (k === 'p' || k === 'P' || k === 'Escape') { if (phase === 'play') pauseGame(); else if (phase === 'pause') { ov.hidden = true; phase = 'play'; sfx.music('calm'); last = performance.now(); } }
  });
  window.addEventListener('keyup', (e) => { if (e.key === 'ArrowLeft' && keyAim < 0) keyAim = 0; if (e.key === 'ArrowRight' && keyAim > 0) keyAim = 0; });
  $('mb-swap').addEventListener('click', swap);
  $('mb-pause').addEventListener('click', () => { if (phase === 'play') pauseGame(); });
  $('mb-menu-btn').addEventListener('click', () => { sfx.play('click'); toMenu(); });

  // ---------- Menu chọn màn ----------
  function buildMenu() {
    const box = $('mb-levels'); box.innerHTML = '';
    for (let i = 0; i < LV.length; i++) {
      const unlocked = i === 0 || (save.stars[i - 1] || 0) >= 1;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'mb-lvbtn' + (unlocked ? '' : ' lock'); b.disabled = !unlocked;
      const th = document.createElement('canvas'); th.width = 180; th.height = 128;
      buildPath(i);
      const bgc = makeBg(i); th.getContext('2d')!.drawImage(bgc, 0, 0, 180, 128);
      b.appendChild(th);
      const st = save.stars[i] || 0;
      const info = document.createElement('span');
      info.innerHTML = `<b>${i + 1}. ${ui.lvNames[i]}</b><em>${[1, 2, 3].map((k) => (k <= st ? '★' : '☆')).join('')}</em><small>${unlocked ? (save.best[i] ? `${ui.best}: ${save.best[i]}` : ui.start) : '🔒 ' + ui.locked}</small>`;
      b.appendChild(info);
      b.addEventListener('click', () => { sfx.play('select'); startLevel(i); });
      box.appendChild(b);
    }
  }
  buildPath(0); bg = makeBg(0);
  buildMenu();

  // ---------- Bot thử nghiệm (chỉ khi có #debug) ----------
  let botT = 0;
  function rayFirst(a: number): number {
    for (let d = 40; d < 900; d += 7) {
      const x = SX + Math.cos(a) * d, y = SY + Math.sin(a) * d;
      if (x < -20 || x > W + 20 || y < -20 || y > H + 20) return -1;
      let bi = -1, bd = (R * 1.85) * (R * 1.85);
      for (let i = 0; i < ch.length; i++) { if (ch[i].s < 10 || ch[i].s > L) continue; const dx = MX[i] - x, dy = MY[i] - y, d2 = dx * dx + dy * dy; if (d2 < bd) { bd = d2; bi = i; } }
      if (bi >= 0) return bi;
    }
    return -1;
  }
  function botPlan(col: number): { a: number; score: number } | null {
    let best: { a: number; score: number } | null = null;
    for (let i = 0; i < ch.length; i++) {
      if (ch[i].c !== col || ch[i].s < 20 || ch[i].s > L - 20) continue;
      const a = Math.atan2(MY[i] - SY, MX[i] - SX);
      const f = rayFirst(a);
      if (f < 0 || ch[f].c !== col) continue;
      const run = runAround(f).length;
      const sc = run * 100 + (ch.length - f) * 0.2 + (run >= 2 ? 1000 : 0);
      if (!best || sc > best.score) best = { a, score: sc };
    }
    return best;
  }
  function botTick(dt: number) {
    botT -= dt; if (botT > 0 || phase !== 'play') return; botT = dbg.interval || 0.16;
    updatePos();
    let plan = botPlan(cur); const p2 = botPlan(nxt);
    if (p2 && (!plan || p2.score > plan.score + 50)) { swap(); plan = p2; }
    if (plan) aim = plan.a; else if (ch.length) { aim = Math.atan2(MY[0] - SY, MX[0] - SX); }
    aim += (Math.random() - 0.5) * 2 * (dbg.err || 0);
    fire();
  }
  if (location.hash.includes('debug')) {
    Object.assign(dbg, {
      start: startLevel,
      sim(sec: number) { for (let t = 0; t < sec; t += 1 / 60) { if (dbg.bot) botTick(1 / 60); stepGame(1 / 60); if (phase === 'win' || phase === 'lose') break; } },
      draw,
    });
    Object.defineProperty(dbg, 'state', { get: () => ({ phase, lvl, score, n: ch.length, front: ch[0] ? Math.round(ch[0].s) : null, L: Math.round(L), combo, t: Math.round(T) }) });
    (window as any).__mb = dbg;
  }
  void rawLost; void started;
</script>

