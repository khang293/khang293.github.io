---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

// Chữ của game chạy vô tận (nằm cùng file, xóa game thì xóa file này và hai file route runner.astro)
const T = {
  vi: {
    title: 'Chạy Vô Tận',
    sub: 'Chạy, nhảy, trượt, né chướng ngại và nhặt xu. Cứ mỗi 1000 m phong cảnh lại đổi, tốc độ càng lúc càng cao.',
    pick: 'Chọn nhân vật',
    heroes: [
      { n: 'Cáo Nhí', d: 'Nhảy cao hơn một chút.' },
      { n: 'Rô-bốt Bu-lông', d: 'Bắt đầu mỗi lượt với một khiên.' },
      { n: 'Mèo Mây', d: 'Nam châm mạnh hơn, trượt được lâu hơn.' },
    ],
    start: 'Chạy!', best: 'Kỷ lục', bestLine: (s: number, m: number, c: number) => `Kỷ lục: ${s} điểm · xa nhất ${m} m · tổng xu ${c}`,
    score: 'Điểm', pause: 'Tạm dừng', resume: 'Tiếp tục', again: 'Chạy lại', menu: 'Menu', paused: 'Tạm dừng', over: 'Vấp rồi!',
    overMsg: (m: number, c: number, s: number) => `Bạn chạy ${m} m, nhặt ${c} xu, được ${s} điểm.`, record: '🏆 Kỷ lục mới!',
    jump: 'Nhảy', slide: 'Trượt',
    themes: ['Rừng xanh', 'Sa mạc', 'Thành phố đêm', 'Vùng tuyết'],
    pu: { shield: 'Khiên', magnet: 'Nam châm', boots: 'Nhảy đôi', slow: 'Chậm thời gian' },
    shieldBreak: 'Khiên vỡ!',
    keys: 'Cách (Space) hoặc mũi tên lên để nhảy, giữ lâu thì nhảy cao hơn. Mũi tên xuống để trượt dưới rào và chim. P hoặc Esc để tạm dừng. Trên điện thoại chạm nửa trái để nhảy, nửa phải để trượt, hoặc vuốt lên hoặc xuống, hoặc dùng hai nút bên dưới. 🛡️ đỡ một lần va chạm · 🧲 hút xu · 👟 nhảy đôi · ⏳ làm chậm thời gian.',
  },
  en: {
    title: 'Endless Runner',
    sub: 'Run, jump, slide, dodge obstacles and collect coins. The scenery changes every 1000 m and the pace keeps rising.',
    pick: 'Choose a runner',
    heroes: [
      { n: 'Fox Kid', d: 'Jumps a little higher.' },
      { n: 'Bolt Bot', d: 'Starts every run with a shield.' },
      { n: 'Cloud Cat', d: 'Stronger magnet and a longer slide.' },
    ],
    start: 'Run!', best: 'Best', bestLine: (s: number, m: number, c: number) => `Best: ${s} points · farthest ${m} m · total coins ${c}`,
    score: 'Score', pause: 'Pause', resume: 'Resume', again: 'Run again', menu: 'Menu', paused: 'Paused', over: 'Tripped!',
    overMsg: (m: number, c: number, s: number) => `You ran ${m} m, grabbed ${c} coin${c === 1 ? '' : 's'} and scored ${s}.`, record: '🏆 New record!',
    jump: 'Jump', slide: 'Slide',
    themes: ['Green forest', 'Desert', 'Night city', 'Snowland'],
    pu: { shield: 'Shield', magnet: 'Magnet', boots: 'Double jump', slow: 'Slow time' },
    shieldBreak: 'Shield broke!',
    keys: 'Space or Up arrow to jump, hold for a higher jump. Down arrow to slide under barriers and birds. P or Esc to pause. On a phone tap the left half to jump and the right half to slide, or swipe up or down, or use the two buttons below. 🛡️ absorbs one hit · 🧲 pulls coins · 👟 double jump · ⏳ slows time.',
  },
}[lang];
const ui = {
  paused: T.paused, over: T.over, record: T.record, resume: T.resume, again: T.again, themes: T.themes, pu: T.pu,
  shieldBreak: T.shieldBreak, score: T.score, best: T.best,
  overTpl: T.overMsg(1234567, 7654321, 99999999),
  lang,
};
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="runner" data-ui={JSON.stringify(ui)}>
    <div id="rn-menu">
      <h2 class="bd-h">{T.pick}</h2>
      <div class="rn-heroes">
        {T.heroes.map((h, i) => (
          <button type="button" class={`rn-hero${i === 0 ? ' sel' : ''}`} data-hero={i}>
            <canvas width="120" height="110" aria-hidden="true"></canvas>
            <b>{h.n}</b>
            <span>{h.d}</span>
          </button>
        ))}
      </div>
      <p class="bd-stat" id="rn-stat"></p>
      <button class="btn" type="button" id="rn-start">▶ {T.start}</button>
      <p class="meta">{T.keys}</p>
    </div>

    <div id="rn-game" hidden>
      <div class="rn-box" id="rn-box">
        <canvas id="rn-canvas" width="960" height="432" aria-label={T.title}></canvas>
        <button type="button" id="rn-pausebtn" class="rn-pause" aria-label={T.pause}>⏸</button>
        <div class="rn-ov" id="rn-ov" hidden>
          <h2 id="rn-ov-title"></h2>
          <p id="rn-ov-msg"></p>
          <p class="rn-rec" id="rn-ov-rec"></p>
          <div class="rn-ov-btns">
            <button type="button" class="btn" id="rn-ov-main"></button>
            <button type="button" class="btn ghost" id="rn-ov-menu">{T.menu}</button>
          </div>
        </div>
      </div>
      <div class="rn-ctl">
        <button type="button" class="rn-btn" id="rn-bslide">⬇ {T.slide}</button>
        <button type="button" class="rn-btn" id="rn-bjump">⬆ {T.jump}</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';

  const root = document.getElementById('runner') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menuEl = document.getElementById('rn-menu') as HTMLElement;
  const gameEl = document.getElementById('rn-game') as HTMLElement;
  const boxEl = document.getElementById('rn-box') as HTMLElement;
  const cv = document.getElementById('rn-canvas') as HTMLCanvasElement;
  const g = cv.getContext('2d')!;
  const ov = document.getElementById('rn-ov') as HTMLElement;

  const W = 960, H = 432, GROUND = 340, PX = 170;
  const V0 = 330, VMAX = 780;
  const JV = 820, JV2 = 740;
  const TAU = Math.PI * 2;
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const rnd = () => Math.random();
  const fract = (x: number) => x - Math.floor(x);
  const hash = (n: number) => fract(Math.sin(n * 127.1 + 311.7) * 43758.5453);
  const speedAt = (dd: number) => Math.min(VMAX, V0 + dd * 0.0042);

  // ---------- Nhân vật ----------
  const HEROES = [
    { body: '#f08a2c', belly: '#fff0dc', dark: '#7a3d10', jump: 1.07, shield: false, mag: 1, slide: 0.85, kind: 'fox' },
    { body: '#4f9cf0', belly: '#cfe6ff', dark: '#1d3f78', jump: 1, shield: true, mag: 1, slide: 0.85, kind: 'bot' },
    { body: '#8a7bd8', belly: '#e9e4ff', dark: '#40377a', jump: 1, shield: false, mag: 1.5, slide: 1.3, kind: 'cat' },
  ];
  let heroIdx = 0;
  let best = { score: 0, dist: 0, coins: 0, runs: 0 };
  try {
    const s = JSON.parse(localStorage.getItem('runner-best') || 'null'); if (s) best = { ...best, ...s };
    const h = parseInt(localStorage.getItem('runner-hero') || '0', 10); if (h >= 0 && h < 3) heroIdx = h;
  } catch {}
  const saveBest = () => { try { localStorage.setItem('runner-best', JSON.stringify(best)); } catch {} };

  function rr(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r);
    c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath();
  }

  // Vẽ nhân vật. Gốc toạ độ ở hông, đầu hướng lên (-y), nhìn sang phải.
  function drawRunner(c: CanvasRenderingContext2D, hi: number, x: number, gy: number, o: { y: number; slide: boolean; air: boolean; ph: number; rot?: number }, t: number, alpha = 1) {
    const ch = HEROES[hi];
    c.save();
    c.globalAlpha = alpha;
    if (o.rot) { c.translate(x, gy - o.y - 30); c.rotate(o.rot); c.translate(0, 8); }
    else if (o.slide) { c.translate(x - 6, gy - o.y - 15); c.rotate(1.35); }
    else c.translate(x, gy - o.y - 22);
    const sw = o.air ? 0 : Math.sin(o.ph), sw2 = o.air ? 0 : Math.sin(o.ph + Math.PI);
    c.lineCap = 'round'; c.lineJoin = 'round';
    // bóng dưới đất được vẽ ở ngoài, ở đây chỉ vẽ nhân vật
    // đuôi, khăn
    if (ch.kind === 'fox') {
      c.fillStyle = ch.body; c.beginPath(); c.moveTo(-9, -10);
      c.quadraticCurveTo(-30 + sw * 3, -4, -34 + sw * 3, -26 + (o.air ? -4 : 0)); c.quadraticCurveTo(-18, -22, -9, -22); c.closePath(); c.fill();
      c.fillStyle = '#fff'; c.beginPath(); c.arc(-33 + sw * 3, -25, 5, 0, TAU); c.fill();
    } else if (ch.kind === 'cat') {
      c.strokeStyle = ch.body; c.lineWidth = 6; c.beginPath(); c.moveTo(-9, -8);
      c.quadraticCurveTo(-28, -6 + sw * 3, -26, -26); c.stroke();
      c.strokeStyle = '#ff7aa8'; c.lineWidth = 7; c.beginPath(); c.moveTo(-3, -31);
      for (let i = 1; i <= 5; i++) c.lineTo(-3 - i * 7, -31 + Math.sin(t * 9 - i * 1.1) * 4 + (o.air ? 3 : 0));
      c.stroke();
    }
    // chân
    const leg = (off: number, sv: number, col: string) => {
      c.strokeStyle = col; c.lineWidth = ch.kind === 'bot' ? 6 : 7;
      c.beginPath(); c.moveTo(off, 0);
      if (o.air) c.lineTo(off + (off < 0 ? -7 : 8), 14); else c.lineTo(off + sv * 11, 22 - Math.max(0, -sv) * 7);
      c.stroke();
      c.fillStyle = col; const fx = o.air ? off + (off < 0 ? -7 : 8) : off + sv * 11, fy = o.air ? 14 : 22 - Math.max(0, -sv) * 7;
      c.beginPath(); c.arc(fx + 2, fy, 4.5, 0, TAU); c.fill();
    };
    const legCol = ch.kind === 'bot' ? '#8fa3b8' : ch.dark;
    leg(-4, sw2, legCol);
    // thân
    c.fillStyle = ch.body;
    if (ch.kind === 'bot') { rr(c, -12, -30, 24, 30, 5); c.fill(); c.fillStyle = ch.dark; c.fillRect(-12, -14, 24, 3); c.fillStyle = '#ffd54a'; c.beginPath(); c.arc(0, -22, 3.2, 0, TAU); c.fill(); }
    else {
      rr(c, -11, -30, 22, 30, 10); c.fill();
      c.fillStyle = ch.belly; c.beginPath(); c.ellipse(3, -14, 6, 11, 0, 0, TAU); c.fill();
    }
    leg(5, sw, legCol);
    // tay
    c.strokeStyle = ch.kind === 'bot' ? '#8fa3b8' : ch.dark; c.lineWidth = 5;
    c.beginPath(); c.moveTo(2, -24); c.lineTo(o.air ? 12 : 4 + sw2 * 10, o.air ? -34 : -13); c.stroke();
    // đầu
    if (ch.kind === 'bot') {
      c.strokeStyle = '#8fa3b8'; c.lineWidth = 2.5; c.beginPath(); c.moveTo(3, -52); c.lineTo(3, -62); c.stroke();
      c.fillStyle = Math.sin(t * 8) > 0 ? '#ff5a5a' : '#ffb0b0'; c.beginPath(); c.arc(3, -63, 3.4, 0, TAU); c.fill();
      c.fillStyle = ch.belly; rr(c, -9, -54, 24, 22, 6); c.fill();
      c.fillStyle = '#12304f'; rr(c, -3, -48, 17, 9, 4); c.fill();
      c.fillStyle = '#5cf0ff'; c.beginPath(); c.arc(8, -43.5, 3, 0, TAU); c.fill();
    } else {
      c.fillStyle = ch.body; c.beginPath(); c.arc(3, -43, 13, 0, TAU); c.fill();
      // tai
      c.beginPath(); c.moveTo(-6, -50); c.lineTo(-7, -64); c.lineTo(3, -54); c.closePath(); c.fill();
      c.beginPath(); c.moveTo(4, -54); c.lineTo(12, -64); c.lineTo(13, -49); c.closePath(); c.fill();
      c.fillStyle = ch.kind === 'fox' ? ch.dark : '#c9b8ff';
      c.beginPath(); c.moveTo(-5, -53); c.lineTo(-5.5, -60); c.lineTo(0, -55); c.closePath(); c.fill();
      c.beginPath(); c.moveTo(6, -55); c.lineTo(11, -60.5); c.lineTo(11, -52); c.closePath(); c.fill();
      c.fillStyle = ch.belly; c.beginPath(); c.ellipse(9, -39, 7, 5.5, 0, 0, TAU); c.fill();
      c.fillStyle = '#222'; c.beginPath(); c.arc(12, -40.5, 2, 0, TAU); c.fill();
      c.fillStyle = '#222'; c.beginPath(); c.arc(8, -46, 2.6, 0, TAU); c.fill();
      c.fillStyle = '#fff'; c.beginPath(); c.arc(8.8, -46.8, 0.9, 0, TAU); c.fill();
    }
    c.restore();
  }

  // ---------- Chủ đề phong cảnh ----------
  const THEMES = [
    { sky: ['#7cc8ff', '#e9f8ff'], far: '#9ccfa6', mid: '#58a468', near: '#2f7d48', gTop: '#62c25f', gBot: '#6b4a2b', acc: '#a6e7a0' },
    { sky: ['#ff9d5c', '#ffe6b0'], far: '#e6a96d', mid: '#cf8650', near: '#ad6532', gTop: '#ecc96e', gBot: '#b98a48', acc: '#f6e19c' },
    { sky: ['#0a0f33', '#3b2d70'], far: '#1e2152', mid: '#151841', near: '#0d102c', gTop: '#3d4270', gBot: '#1b1d3c', acc: '#7be0ff' },
    { sky: ['#a9d2f0', '#f6fcff'], far: '#cddeeb', mid: '#a3bbd1', near: '#84a0b9', gTop: '#f8fcff', gBot: '#c3d6e6', acc: '#ffffff' },
  ];
  const hex = (s: string) => [parseInt(s.slice(1, 3), 16), parseInt(s.slice(3, 5), 16), parseInt(s.slice(5, 7), 16)];
  const lerpC = (a: string, b: string, f: number) => { const x = hex(a), y = hex(b); return `rgb(${Math.round(x[0] + (y[0] - x[0]) * f)},${Math.round(x[1] + (y[1] - x[1]) * f)},${Math.round(x[2] + (y[2] - x[2]) * f)})`; };

  function drawTheme(ti: number, a: number, cam: number, t: number) {
    const th = THEMES[ti];
    g.save(); g.globalAlpha = a;
    const sg = g.createLinearGradient(0, 0, 0, GROUND); sg.addColorStop(0, th.sky[0]); sg.addColorStop(1, th.sky[1]);
    g.fillStyle = sg; g.fillRect(0, 0, W, GROUND + 2);
    // thiên thể
    if (ti === 0) { g.fillStyle = 'rgba(255,244,176,.95)'; g.beginPath(); g.arc(780, 86, 38, 0, TAU); g.fill(); g.fillStyle = 'rgba(255,244,176,.25)'; g.beginPath(); g.arc(780, 86, 62, 0, TAU); g.fill(); }
    else if (ti === 1) { g.fillStyle = 'rgba(255,236,170,.95)'; g.beginPath(); g.arc(700, 190, 58, 0, TAU); g.fill(); g.fillStyle = 'rgba(255,236,170,.25)'; g.beginPath(); g.arc(700, 190, 92, 0, TAU); g.fill(); }
    else if (ti === 2) {
      for (let k = 0; k < 70; k++) { const sx = hash(k) * W, sy = hash(k + 99) * 210, tw = 0.5 + 0.5 * Math.sin(t * 2 + k); g.fillStyle = `rgba(255,255,255,${0.25 + 0.6 * tw})`; g.fillRect(sx, sy, 1.6, 1.6); }
      g.fillStyle = '#fff6d8'; g.beginPath(); g.arc(790, 80, 30, 0, TAU); g.fill(); g.fillStyle = th.sky[0]; g.beginPath(); g.arc(802, 74, 26, 0, TAU); g.fill();
      g.fillStyle = 'rgba(255,246,216,.12)'; g.beginPath(); g.arc(790, 80, 58, 0, TAU); g.fill();
    } else { g.fillStyle = 'rgba(255,255,255,.85)'; g.beginPath(); g.arc(740, 92, 30, 0, TAU); g.fill(); }
    // lớp xa
    const farCam = cam * 0.08;
    g.fillStyle = th.far; g.beginPath(); g.moveTo(0, GROUND);
    for (let x = 0; x <= W; x += 6) {
      const wx = x + farCam; let y: number;
      if (ti === 0) y = GROUND - 90 - Math.sin(wx * 0.006) * 36 - Math.sin(wx * 0.0141 + 1) * 20;
      else if (ti === 1) y = GROUND - 60 - Math.sin(wx * 0.005) * 34 - Math.sin(wx * 0.011) * 12;
      else if (ti === 2) { const cell = Math.floor(wx / 64); y = GROUND - 70 - hash(cell + 5) * 120; }
      else y = GROUND - 80 - Math.abs(Math.sin(wx * 0.0045)) * 120 - Math.sin(wx * 0.02) * 6;
      g.lineTo(x, y);
    }
    g.lineTo(W, GROUND); g.closePath(); g.fill();
    if (ti === 2) { // cửa sổ sáng
      for (let k = 0; k < 22; k++) { const cx0 = Math.floor((farCam) / 64) + k; const sx = cx0 * 64 - farCam; const hh = 70 + hash(cx0 + 5) * 120;
        for (let r = 0; r < 4; r++) if (hash(cx0 * 7 + r) > 0.55) { g.fillStyle = 'rgba(255,220,120,.55)'; g.fillRect(sx + 10 + (r % 2) * 22, GROUND - hh + 14 + Math.floor(r / 2) * 22, 8, 10); } }
    }
    // lớp giữa
    const midCam = cam * 0.25, cell = 96;
    g.fillStyle = th.mid;
    for (let i = Math.floor(midCam / cell) - 1; i < Math.floor(midCam / cell) + W / cell + 3; i++) {
      const sx = i * cell - midCam + hash(i) * 40, hh = 46 + hash(i + 3) * 50;
      if (hash(i + 9) < 0.28) continue;
      if (ti === 0 || ti === 3) {
        g.beginPath(); g.moveTo(sx - 22, GROUND); g.lineTo(sx, GROUND - hh - 40); g.lineTo(sx + 22, GROUND); g.closePath(); g.fill();
        g.beginPath(); g.moveTo(sx - 18, GROUND - hh * 0.4); g.lineTo(sx, GROUND - hh - 60); g.lineTo(sx + 18, GROUND - hh * 0.4); g.closePath(); g.fill();
        if (ti === 3) { g.fillStyle = 'rgba(255,255,255,.9)'; g.beginPath(); g.moveTo(sx - 10, GROUND - hh - 36); g.lineTo(sx, GROUND - hh - 60); g.lineTo(sx + 10, GROUND - hh - 36); g.closePath(); g.fill(); g.fillStyle = th.mid; }
      } else if (ti === 1) {
        if (hash(i + 2) < 0.5) { rr(g, sx - 36, GROUND - hh - 10, 72, hh + 10, 8); g.fill(); g.fillStyle = 'rgba(0,0,0,.1)'; g.fillRect(sx - 36, GROUND - hh + 8, 72, 4); g.fillStyle = th.mid; }
        else { rr(g, sx - 6, GROUND - hh, 12, hh, 6); g.fill(); rr(g, sx - 20, GROUND - hh * 0.7, 10, hh * 0.4, 5); g.fill(); rr(g, sx + 10, GROUND - hh * 0.8, 10, hh * 0.45, 5); g.fill(); }
      } else {
        rr(g, sx - 30, GROUND - hh - 40, 60, hh + 40, 3); g.fill();
        for (let r = 0; r < 6; r++) if (hash(i * 11 + r) > 0.5) { g.fillStyle = 'rgba(255,210,110,.7)'; g.fillRect(sx - 22 + (r % 3) * 16, GROUND - hh - 30 + Math.floor(r / 3) * 22, 8, 10); }
        g.fillStyle = th.mid;
      }
    }
    // lớp gần
    const nearCam = cam * 0.55, c2 = 150;
    for (let i = Math.floor(nearCam / c2) - 1; i < Math.floor(nearCam / c2) + W / c2 + 3; i++) {
      const sx = i * c2 - nearCam + hash(i + 40) * 80;
      if (hash(i + 50) < 0.3) continue;
      g.fillStyle = th.near;
      if (ti === 0) { g.beginPath(); g.ellipse(sx, GROUND, 34, 20, 0, Math.PI, 0); g.fill(); g.beginPath(); g.ellipse(sx + 26, GROUND, 24, 14, 0, Math.PI, 0); g.fill(); }
      else if (ti === 1) { g.beginPath(); g.moveTo(sx - 26, GROUND); g.quadraticCurveTo(sx, GROUND - 34, sx + 30, GROUND); g.closePath(); g.fill(); }
      else if (ti === 2) { g.fillStyle = '#2a2e57'; g.fillRect(sx - 2, GROUND - 78, 4, 78); g.fillRect(sx - 2, GROUND - 78, 18, 4); g.fillStyle = 'rgba(255,230,150,.9)'; g.beginPath(); g.arc(sx + 15, GROUND - 70, 5, 0, TAU); g.fill(); g.fillStyle = 'rgba(255,230,150,.12)'; g.beginPath(); g.arc(sx + 15, GROUND - 70, 26, 0, TAU); g.fill(); }
      else { g.beginPath(); g.ellipse(sx, GROUND, 42, 17, 0, Math.PI, 0); g.fill(); g.fillStyle = 'rgba(255,255,255,.7)'; g.beginPath(); g.ellipse(sx + 4, GROUND - 4, 32, 11, 0, Math.PI, 0); g.fill(); }
    }
    if (ti === 3) { // tuyết rơi
      g.fillStyle = 'rgba(255,255,255,.85)';
      for (let k = 0; k < 70; k++) { const sx = (hash(k) * W + Math.sin(t + k) * 14 - cam * 0.2 + W * 4) % W, sy = (hash(k + 7) * H + t * (40 + hash(k + 3) * 40)) % GROUND; g.beginPath(); g.arc(sx, sy, 1.5 + hash(k + 11) * 1.5, 0, TAU); g.fill(); }
    }
    g.restore();
  }

  // ---------- Thế giới và bộ sinh chướng ngại ----------
  type Obs = { t: 'rock' | 'pit' | 'bar' | 'bird'; x: number; w: number; h: number; dead?: boolean; seed: number };
  type Coin = { x: number; y: number; got?: boolean; fly?: boolean };
  type Pup = { x: number; y: number; k: 'shield' | 'magnet' | 'boots' | 'slow'; got?: boolean };
  type World = { obs: Obs[]; coins: Coin[]; pups: Pup[]; genX: number; lastEnd: number };
  const newWorld = (): World => ({ obs: [], coins: [], pups: [], genX: 900, lastEnd: 400 });
  const PUK: Pup['k'][] = ['shield', 'magnet', 'boots', 'slow'];

  // Luật công bằng: mọi chướng ngại chỉ cần một cú nhảy (đá cao ≤ 52, hố ≤ 0,3 × tốc độ) hoặc một cú trượt,
  // và khoảng cách giữa hai chướng ngại luôn ≥ 0,95 × tốc độ + 140 px (hơn một giây phản ứng).
  function gen(w: World, upTo: number) {
    while (w.genX < upTo) {
      const m = w.genX / 40;
      const v = speedAt(w.genX) * 1.04;
      const gapMin = v * 0.95 + 140;
      const extra = Math.max(0, 520 - m * 0.22) * rnd();
      const x = Math.max(w.genX, w.lastEnd + gapMin + extra);
      const pool: Obs['t'][] = ['rock', 'rock', 'pit'];
      if (m > 120) pool.push('bar', 'bird');
      if (m > 400) pool.push('rock', 'pit', 'bar', 'bird');
      const kind = pool[Math.floor(rnd() * pool.length)];
      let o: Obs;
      if (kind === 'rock') o = { t: 'rock', x, w: 36 + rnd() * 20, h: 34 + rnd() * 18, seed: rnd() };
      else if (kind === 'pit') o = { t: 'pit', x, w: clamp((0.17 + rnd() * 0.13) * v, 80, 230), h: 0, seed: rnd() };
      else if (kind === 'bar') o = { t: 'bar', x, w: 64, h: 34, seed: rnd() };
      else o = { t: 'bird', x, w: 44, h: 38, seed: rnd() };
      // xu ở khoảng trống phía trước
      const prevEnd = w.lastEnd;
      const cs = prevEnd + v * 0.55 + 40, ce = x - v * 0.35;
      if (ce - cs > 130 && rnd() < 0.6) { const n = Math.floor((ce - cs) / 46); const cy = rnd() < 0.5 ? 26 : 26 + rnd() * 40; for (let i = 0; i < n; i++) w.coins.push({ x: cs + i * 46, y: cy + Math.sin(i * 0.7) * (cy > 30 ? 10 : 0) }); }
      if (m > 100 && ce - cs > 100 && rnd() < 0.07) w.pups.push({ x: (cs + ce) / 2, y: 44, k: PUK[Math.floor(rnd() * 4)] });
      // vòng cung xu qua chướng ngại
      if ((o.t === 'rock' || o.t === 'pit') && rnd() < 0.55) {
        const base = o.t === 'rock' ? o.h + 34 : 50, span = Math.max(140, o.w + 90), n = 5, cx0 = o.x + o.w / 2;
        for (let i = 0; i < n; i++) { const u = i / (n - 1); w.coins.push({ x: cx0 - span / 2 + u * span, y: base + 60 * (1 - Math.pow(2 * u - 1, 2)) }); }
      } else if (o.t === 'bar' || o.t === 'bird') {
        for (let i = 0; i < 3; i++) w.coins.push({ x: o.x + 4 + i * 20, y: 20 });
      }
      w.obs.push(o);
      w.lastEnd = o.x + o.w; w.genX = w.lastEnd;
    }
  }
  function groundAt(w: World, wx: number) {
    for (const o of w.obs) if (o.t === 'pit' && wx > o.x + 4 && wx < o.x + o.w - 4) return false;
    return true;
  }
  function verifyWorld(meters: number) {
    const w = newWorld(); gen(w, meters * 40 + 2000);
    const arr = w.obs.slice().sort((a, b) => a.x - b.x); const viol: string[] = [];
    for (let i = 0; i < arr.length; i++) {
      const o = arr[i], v = speedAt(o.x);
      if (o.t === 'pit' && o.w > 0.31 * v) viol.push(`pit ${o.w.toFixed(0)} > ${(0.31 * v).toFixed(0)} @${(o.x / 40).toFixed(0)}m`);
      if (o.t === 'rock' && o.h > 52.5) viol.push('rock too tall');
      if (i > 0) { const p = arr[i - 1]; const gap = o.x - (p.x + p.w), need = 0.95 * speedAt(p.x) + 120; if (gap < need) viol.push(`gap ${gap.toFixed(0)} < ${need.toFixed(0)} @${(o.x / 40).toFixed(0)}m`); }
    }
    return { n: arr.length, viol: viol.length, ex: viol.slice(0, 3) };
  }

  // ---------- Trạng thái ván chơi ----------
  let mode: 'menu' | 'play' | 'pause' | 'dead' = 'menu';
  let wd = newWorld();
  let d = 0, v = V0, coinN = 0, t = 0, shake = 0, flash = 0, deadT = 0, deadHit = false, themeIdx = 0, banner = '', bannerT = 0;
  const P = { y: 0, vy: 0, ph: 0, slide: false, onG: true, jumps: 0, cut: false, coyote: 0, buf: 0, slT: 0, inv: 0, shield: false, boots: 0, mag: 0, slow: 0, dustT: 0, ground: true };
  let jumpHeld = false, slideHeld = false;
  let botOn = false, botHold = 0, botJumped: Obs | null = null;
  const parts: { x: number; y: number; vx: number; vy: number; life: number; max: number; s: number; col: string; g: number }[] = [];
  const pops: { text: string; x: number; y: number; life: number }[] = [];
  let lastCoinSfx = 0, lastLand = 0;
  const hero = () => HEROES[heroIdx];

  function spawn(x: number, y: number, n: number, col: string, spd = 120, life = 0.5, s = 3, grav = 300) {
    for (let i = 0; i < n && parts.length < 320; i++) {
      const a = rnd() * TAU, sp = spd * (0.3 + rnd() * 0.7);
      parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - spd * 0.2, life: life * (0.6 + rnd() * 0.6), max: life, s: s * (0.6 + rnd() * 0.7), col, g: grav });
    }
  }
  const footScreen = () => ({ x: PX, y: GROUND - P.y });

  function resetRun() {
    wd = newWorld(); d = 0; v = V0; coinN = 0; t = 0; shake = 0; flash = 0; deadT = 0; deadHit = false; themeIdx = 0; banner = ''; bannerT = 0;
    Object.assign(P, { y: 0, vy: 0, ph: 0, slide: false, onG: true, jumps: 0, cut: false, coyote: 0, buf: 0, slT: 0, inv: 0, shield: hero().shield, boots: 0, mag: 0, slow: 0, dustT: 0, ground: true });
    parts.length = 0; pops.length = 0; botHold = 0; botJumped = null; jumpHeld = false; slideHeld = false;
    gen(wd, d + W + 600);
  }

  function startRun() {
    resetRun();
    mode = 'play';
    menuEl.hidden = true; gameEl.hidden = false; ov.hidden = true;
    best.runs++; saveBest();
    sfx.play('go'); sfx.music('action');
  }

  function showOverlay(kind: 'pause' | 'dead') {
    const title = document.getElementById('rn-ov-title') as HTMLElement, msg = document.getElementById('rn-ov-msg') as HTMLElement;
    const rec = document.getElementById('rn-ov-rec') as HTMLElement, main = document.getElementById('rn-ov-main') as HTMLElement;
    ov.hidden = false;
    if (kind === 'pause') { title.textContent = ui.paused; msg.textContent = ''; rec.textContent = ''; main.textContent = '▶ ' + ui.resume; main.dataset.act = 'resume'; }
    else {
      title.textContent = ui.over;
      const m = Math.floor(d / 40), sc = m + coinN * 5;
      msg.textContent = ui.lang === 'vi' ? `Bạn chạy ${m} m, nhặt ${coinN} xu, được ${sc} điểm.` : `You ran ${m} m, grabbed ${coinN} coin${coinN === 1 ? '' : 's'} and scored ${sc}.`;
      rec.textContent = newRecord ? ui.record : '';
      main.textContent = '↻ ' + ui.again; main.dataset.act = 'again';
    }
  }
  let newRecord = false;
  let deathInfo = '';

  function die(hit: boolean) {
    if (mode !== 'play') return;
    if (location.hash.includes('debug')) {
      const cx0 = d + PX; let n: Obs | null = null;
      for (const q of wd.obs) if (!q.dead && q.x + q.w > cx0 - 40 && (!n || q.x < n.x)) n = q;
      deathInfo = n ? `${hit ? 'hit' : 'fall'} ${n.t} w${Math.round(n.w)} dx${Math.round(n.x - cx0)} v${Math.round(v)} onG${P.onG} y${Math.round(P.y)} m${Math.floor(d / 40)}` : 'none';
    }
    mode = 'dead'; deadT = 0; deadHit = hit; shake = 16; flash = 1;
    const f = footScreen(); spawn(f.x, f.y - 30, 26, '#ffd36b', 260, 0.7, 4); spawn(f.x, f.y - 30, 14, '#ffffff', 180, 0.5, 3);
    if (hit) P.vy = 520;
    sfx.music(null); sfx.play('hit'); sfx.play('lose');
    const m = Math.floor(d / 40), sc = m + coinN * 5;
    newRecord = sc > best.score;
    if (newRecord) best.score = sc; if (m > best.dist) best.dist = m; best.coins += coinN; saveBest();
    paintStat();
  }

  // ---------- Điều khiển ----------
  function tryJump() {
    if (P.onG || P.coyote > 0) {
      P.vy = JV * hero().jump; P.jumps = 1; P.cut = false; P.onG = false; P.coyote = 0; P.buf = 0; P.slide = false;
      sfx.play('jump'); const f = footScreen(); spawn(f.x, f.y, 6, 'rgba(255,255,255,.7)', 70, 0.35, 3, 80);
    } else if (P.boots > 0 && P.jumps < 2 && P.y > -10) {
      P.vy = JV2 * hero().jump; P.jumps = 2; P.cut = false; P.buf = 0;
      sfx.play('swoosh'); const f = footScreen(); spawn(f.x, f.y, 12, '#9fe8ff', 110, 0.4, 3, 40);
    } else P.buf = 0.12;
  }
  function pressJump() { if (jumpHeld) return; jumpHeld = true; if (mode === 'play') tryJump(); }
  function releaseJump() { jumpHeld = false; }
  function pressSlide() { slideHeld = true; }
  function releaseSlide() { slideHeld = false; }

  // ---------- Cập nhật ----------
  function botThink() {
    const cx = d + PX;
    let o: Obs | null = null;
    for (const q of wd.obs) { if (q.dead) continue; if (q.x + q.w > cx - 20) { if (!o || q.x < o.x) o = q; } }
    if (botHold > 0) { botHold -= 1 / 60; if (botHold <= 0) { releaseJump(); } }
    if (!o) { releaseSlide(); return; }
    const dx = o.x - (cx + 14);
    const spd = v * (P.slow > 0 ? 1 : 1);
    if (o.t === 'bar' || o.t === 'bird') {
      if (dx < 0.2 * spd + 20 && dx + o.w + 30 > 0) pressSlide(); else releaseSlide();
    } else {
      releaseSlide();
      if (o.t === 'rock' && dx < 0.27 * spd && dx > -o.w && botJumped !== o && P.onG) { botJumped = o; pressJump(); botHold = 0.55; }
      if (o.t === 'pit' && dx < 0.15 * spd && dx > -o.w * 0.5 && botJumped !== o && P.onG) { botJumped = o; pressJump(); botHold = 0.6; }
    }
  }

  function update(dt: number) {
    t += dt;
    for (let i = parts.length - 1; i >= 0; i--) { const q = parts[i]; q.life -= dt; if (q.life <= 0) { parts.splice(i, 1); continue; } q.x += q.vx * dt; q.y += q.vy * dt; q.vy += q.g * dt; }
    for (let i = pops.length - 1; i >= 0; i--) { pops[i].life -= dt; pops[i].y -= 30 * dt; if (pops[i].life <= 0) pops.splice(i, 1); }
    shake = Math.max(0, shake - dt * 30); flash = Math.max(0, flash - dt * 2.2); bannerT = Math.max(0, bannerT - dt);
    if (mode === 'dead') {
      deadT += dt;
      if (deadHit) { P.vy -= 2700 * dt; P.y += P.vy * dt; if (P.y < 0) { P.y = 0; P.vy = 0; } } else { P.vy -= 2700 * dt; P.y += P.vy * dt; }
      if (deadT > 0.75 && ov.hidden) showOverlay('dead');
      return;
    }
    if (mode !== 'play') return;

    const ts = P.slow > 0 ? 0.6 : 1, dw = dt * ts;
    P.slow -= dt; P.boots -= dt; P.mag -= dt; P.inv -= dt; P.coyote -= dw; P.buf -= dw;
    if (botOn) botThink();
    v = speedAt(d);
    d += v * dw;
    gen(wd, d + W + 600);
    const cx = d + PX;
    const m = d / 40;

    // chủ đề
    const seg = m / 1000, ti = Math.floor(seg) % 4;
    if (ti !== themeIdx) { themeIdx = ti; banner = ui.themes[ti]; bannerT = 2.2; sfx.play('levelup'); }

    // trượt
    if (slideHeld && P.onG && P.slT < hero().slide) { if (!P.slide) { P.slide = true; sfx.play('swoosh'); } P.slT += dw; }
    else { P.slide = false; if (!slideHeld) P.slT = 0; }
    if (slideHeld && !P.onG) P.vy -= 3500 * dw;
    // vật lý
    const gv = P.vy > 0 && jumpHeld ? 1900 : 2700;
    P.vy -= gv * dw;
    if (P.vy > 0 && !jumpHeld && !P.cut) { P.vy *= 0.45; P.cut = true; }
    const prevVy = P.vy, prevY = P.y;
    P.y += P.vy * dw;
    P.ph += v * dw * 0.05;
    const gr = groundAt(wd, cx - 9) || groundAt(wd, cx + 9);
    P.ground = gr;
    // prevY >= 0: đang ở trên mặt đất ở khung hình trước, nên dù rơi nhanh qua mặt đất vẫn phải đáp xuống (tránh xuyên qua)
    if (P.vy <= 0 && P.y <= 0 && (P.y > -14 || prevY >= 0) && gr) {
      if (!P.onG && prevVy < -350 && t - lastLand > 0.1) { lastLand = t; sfx.play('land'); const f = footScreen(); spawn(f.x, GROUND, 8, 'rgba(255,255,255,.6)', 90, 0.35, 3, 60); }
      P.y = 0; P.vy = 0; P.onG = true; P.jumps = 0;
      if (P.buf > 0) { P.buf = 0; tryJump(); }
    } else if (P.y > 0.5 || !gr) {
      if (P.onG) { P.onG = false; P.coyote = 0.09; }
    }
    if (!gr && P.y < -40) { die(false); return; }
    // bụi chạy
    P.dustT -= dw;
    if (P.onG && P.dustT <= 0) { P.dustT = 0.07; spawn(PX - 10, GROUND, 1, 'rgba(255,255,255,.55)', 40, 0.4, 3, -20); }

    // va chạm
    const ph = P.slide ? 28 : 58, hw = P.slide ? 18 : 12;
    const pL = cx - hw, pR = cx + hw, pB = P.y, pT = P.y + ph;
    for (const o of wd.obs) {
      if (o.t === 'pit' || o.dead) continue;
      const x0 = o.x + 5, x1 = o.x + o.w - 5;
      if (x1 < pL || x0 > pR) continue;
      let hb = 0, ht = o.h;
      if (o.t === 'bar') { hb = 34; ht = 999; }
      else if (o.t === 'bird') { hb = 38 + Math.sin(t * 5 + o.seed * 9) * 4; ht = hb + 26; }
      if (pT > hb + 3 && pB < ht - 3) {
        if (P.inv > 0) continue;
        if (P.shield) { P.shield = false; P.inv = 1.1; o.dead = true; shake = 8; flash = 0.5; sfx.play('hurt'); sfx.play('explode'); banner = ui.shieldBreak; bannerT = 1.2; const f = footScreen(); spawn(f.x, f.y - 30, 20, '#7fd8ff', 220, 0.5, 3); }
        else { die(true); return; }
      }
    }
    // xu, vật phẩm
    const pc = P.y + ph / 2, magR = (P.mag > 0 ? 210 : 0) * hero().mag;
    for (const c of wd.coins) {
      if (c.got) continue;
      const dx = c.x - cx, dy = c.y - pc, dist = Math.hypot(dx, dy);
      if (magR && dist < magR) { c.fly = true; }
      if (c.fly) { const s = 900 * dt, k = Math.min(1, s / Math.max(1, dist)); c.x -= dx * k; c.y -= dy * k; }
      if (dist < 28) {
        c.got = true; coinN++;
        spawn(PX + (c.x - cx), GROUND - c.y, 6, '#ffe066', 110, 0.4, 2.6, 120);
        if (t - lastCoinSfx > 0.04) { lastCoinSfx = t; sfx.play('coin'); }
      }
    }
    for (const u of wd.pups) {
      if (u.got) continue;
      const dx = u.x - cx, dy = u.y - pc;
      if (Math.hypot(dx, dy) < 34) {
        u.got = true; sfx.play('power');
        if (u.k === 'shield') P.shield = true; else if (u.k === 'magnet') P.mag = 8; else if (u.k === 'boots') P.boots = 9; else P.slow = 4.5;
        banner = ui.pu[u.k]; bannerT = 1.3; spawn(PX, GROUND - P.y - 30, 18, '#ffffff', 200, 0.6, 3);
      }
    }
    // dọn
    if (wd.obs.length > 40) wd.obs = wd.obs.filter((o) => o.x + o.w > d - 200);
    if (wd.coins.length > 200) wd.coins = wd.coins.filter((c) => !c.got && c.x > d - 100);
    if (wd.pups.length > 20) wd.pups = wd.pups.filter((u) => !u.got && u.x > d - 100);
    if (wd.coins.length > 0 && wd.coins[0].x < d - 300) wd.coins = wd.coins.filter((c) => c.x > d - 300);
  }

  // ---------- Vẽ ----------
  function drawObs(o: Obs, th: typeof THEMES[0]) {
    const sx = o.x - d;
    if (sx > W + 80 || sx + o.w < -80) return;
    if (o.t === 'rock') {
      g.fillStyle = 'rgba(0,0,0,.22)'; g.beginPath(); g.ellipse(sx + o.w / 2, GROUND + 2, o.w * 0.62, 6, 0, 0, TAU); g.fill();
      const col = themeIdx === 3 ? '#8d9db0' : themeIdx === 1 ? '#a27a52' : '#7d8794';
      g.fillStyle = col; g.beginPath(); g.moveTo(sx, GROUND); g.lineTo(sx + o.w * 0.12, GROUND - o.h * 0.7); g.lineTo(sx + o.w * 0.4, GROUND - o.h); g.lineTo(sx + o.w * 0.8, GROUND - o.h * 0.8); g.lineTo(sx + o.w, GROUND); g.closePath(); g.fill();
      g.fillStyle = 'rgba(255,255,255,.22)'; g.beginPath(); g.moveTo(sx + o.w * 0.12, GROUND - o.h * 0.7); g.lineTo(sx + o.w * 0.4, GROUND - o.h); g.lineTo(sx + o.w * 0.55, GROUND - o.h * 0.6); g.closePath(); g.fill();
      g.fillStyle = 'rgba(0,0,0,.18)'; g.beginPath(); g.moveTo(sx + o.w * 0.8, GROUND - o.h * 0.8); g.lineTo(sx + o.w, GROUND); g.lineTo(sx + o.w * 0.55, GROUND); g.closePath(); g.fill();
      if (themeIdx === 3) { g.fillStyle = '#fff'; g.beginPath(); g.moveTo(sx + o.w * 0.12, GROUND - o.h * 0.7); g.lineTo(sx + o.w * 0.4, GROUND - o.h); g.lineTo(sx + o.w * 0.8, GROUND - o.h * 0.8); g.lineTo(sx + o.w * 0.5, GROUND - o.h * 0.68); g.closePath(); g.fill(); }
    } else if (o.t === 'pit') {
      const gg = g.createLinearGradient(0, GROUND, 0, H); gg.addColorStop(0, '#05060f'); gg.addColorStop(1, '#14172c');
      g.fillStyle = gg; g.fillRect(sx, GROUND - 1, o.w, H - GROUND + 1);
      g.fillStyle = th.gTop; g.fillRect(sx - 6, GROUND, 6, 10); g.fillRect(sx + o.w, GROUND, 6, 10);
      g.fillStyle = 'rgba(255,255,255,.06)'; for (let i = 0; i < o.w; i += 22) g.fillRect(sx + i + 4, GROUND + 18 + (i % 44), 2, 10);
    } else if (o.t === 'bar') {
      g.strokeStyle = '#5b3a1e'; g.lineWidth = 4; g.beginPath(); g.moveTo(sx + 8, 0); g.lineTo(sx + 8, GROUND - 60); g.moveTo(sx + o.w - 8, 0); g.lineTo(sx + o.w - 8, GROUND - 60); g.stroke();
      const by = GROUND - 62;
      g.fillStyle = '#ffc531'; rr(g, sx, by, o.w, 28, 5); g.fill();
      g.save(); rr(g, sx, by, o.w, 28, 5); g.clip(); g.fillStyle = '#262626';
      for (let i = -2; i < 8; i++) { g.beginPath(); g.moveTo(sx + i * 16, by + 28); g.lineTo(sx + i * 16 + 8, by + 28); g.lineTo(sx + i * 16 + 20, by); g.lineTo(sx + i * 16 + 12, by); g.closePath(); g.fill(); }
      g.restore(); g.strokeStyle = 'rgba(0,0,0,.35)'; g.lineWidth = 2; rr(g, sx, by, o.w, 28, 5); g.stroke();
    } else {
      const bob = Math.sin(t * 5 + o.seed * 9) * 4, cyy = GROUND - (38 + 13 + bob), cxx = sx + o.w / 2, fl = Math.sin(t * 16 + o.seed * 7);
      g.fillStyle = 'rgba(0,0,0,.15)'; g.beginPath(); g.ellipse(cxx, GROUND + 2, 18, 4, 0, 0, TAU); g.fill();
      g.fillStyle = '#e8584f'; g.beginPath(); g.ellipse(cxx, cyy, 19, 12, 0, 0, TAU); g.fill();
      g.fillStyle = '#c63f3a'; g.beginPath(); g.moveTo(cxx - 4, cyy - 2); g.lineTo(cxx + 12, cyy - 16 * fl - 2); g.lineTo(cxx + 16, cyy + 2); g.closePath(); g.fill();
      g.fillStyle = '#e8584f'; g.beginPath(); g.moveTo(cxx + 16, cyy - 4); g.lineTo(cxx + 30, cyy - 3 * fl); g.lineTo(cxx + 16, cyy + 4); g.closePath(); g.fill();
      g.fillStyle = '#ffd34a'; g.beginPath(); g.moveTo(cxx - 17, cyy - 4); g.lineTo(cxx - 30, cyy); g.lineTo(cxx - 17, cyy + 4); g.closePath(); g.fill();
      g.fillStyle = '#fff'; g.beginPath(); g.arc(cxx - 9, cyy - 3, 3.4, 0, TAU); g.fill(); g.fillStyle = '#111'; g.beginPath(); g.arc(cxx - 10, cyy - 3, 1.6, 0, TAU); g.fill();
    }
  }

  function drawPup(u: Pup) {
    const sx = u.x - d, sy = GROUND - u.y + Math.sin(t * 4 + u.x) * 4;
    if (sx < -40 || sx > W + 40) return;
    const col = { shield: '#5cc8ff', magnet: '#ff6b6b', boots: '#7be08a', slow: '#c79bff' }[u.k];
    g.fillStyle = col + '44'; g.beginPath(); g.arc(sx, sy, 28, 0, TAU); g.fill();
    g.fillStyle = col; g.beginPath(); g.arc(sx, sy, 19, 0, TAU); g.fill();
    g.strokeStyle = '#fff'; g.lineWidth = 2.5; g.beginPath(); g.arc(sx, sy, 19, 0, TAU); g.stroke();
    g.font = '19px system-ui, "Segoe UI Emoji", sans-serif'; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillStyle = '#fff';
    g.fillText({ shield: '🛡️', magnet: '🧲', boots: '👟', slow: '⏳' }[u.k], sx, sy + 1);
  }

  function render() {
    const cam = d;
    const seg = d / 40 / 1000, idx = Math.floor(seg) % 4, fr = seg - Math.floor(seg), nx = (idx + 1) % 4;
    const f = fr > 0.9 ? (fr - 0.9) / 0.1 : 0;
    g.save();
    if (shake > 0) g.translate((rnd() - 0.5) * shake, (rnd() - 0.5) * shake);
    drawTheme(idx, 1, cam, t);
    if (f > 0) drawTheme(nx, f, cam, t);
    const th = THEMES[idx], th2 = THEMES[nx];
    // mặt đất
    const gt = f > 0 ? lerpC(th.gTop, th2.gTop, f) : th.gTop, gb = f > 0 ? lerpC(th.gBot, th2.gBot, f) : th.gBot;
    const gg = g.createLinearGradient(0, GROUND, 0, H); gg.addColorStop(0, gb); gg.addColorStop(1, 'rgba(0,0,0,.55)');
    g.fillStyle = gb; g.fillRect(-10, GROUND, W + 20, H - GROUND + 10);
    g.fillStyle = gg; g.fillRect(-10, GROUND, W + 20, H - GROUND + 10);
    g.fillStyle = gt; g.fillRect(-10, GROUND, W + 20, 14);
    g.fillStyle = 'rgba(0,0,0,.12)'; for (let i = -1; i < W / 64 + 2; i++) { const sx = i * 64 - (d % 64); g.fillRect(sx, GROUND + 28 + (i & 1) * 14, 30, 4); g.fillRect(sx + 20, GROUND + 56, 20, 4); }
    g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(-10, GROUND, W + 20, 3);
    // vật cản và vật phẩm
    for (const o of wd.obs) if (!o.dead) drawObs(o, th);
    for (const c of wd.coins) {
      if (c.got) continue; const sx = c.x - d; if (sx < -20 || sx > W + 20) continue;
      const sy = GROUND - c.y, sc = Math.abs(Math.cos(t * 5 + c.x * 0.02));
      g.fillStyle = '#ffd23f'; g.beginPath(); g.ellipse(sx, sy, 3 + 8 * sc, 11, 0, 0, TAU); g.fill();
      g.strokeStyle = '#c98a00'; g.lineWidth = 2; g.beginPath(); g.ellipse(sx, sy, 3 + 8 * sc, 11, 0, 0, TAU); g.stroke();
      g.fillStyle = 'rgba(255,255,255,.7)'; g.beginPath(); g.ellipse(sx - 2 * sc, sy - 4, 1.2 + 2 * sc, 4, 0, 0, TAU); g.fill();
    }
    for (const u of wd.pups) if (!u.got) drawPup(u);
    // bóng nhân vật
    const sh = clamp(1 - P.y / 220, 0.25, 1);
    if (P.ground) { g.fillStyle = `rgba(0,0,0,${0.25 * sh})`; g.beginPath(); g.ellipse(PX, GROUND + 2, (P.slide ? 30 : 16) * sh, 5, 0, 0, TAU); g.fill(); }
    // nhân vật
    const blink = P.inv > 0 && Math.floor(t * 18) % 2 === 0;
    const rot = mode === 'dead' ? (deadHit ? Math.min(deadT * 9, 1.9) : Math.min(deadT * 4, 1)) : 0;
    drawRunner(g, heroIdx, PX, GROUND, { y: P.y, slide: P.slide, air: !P.onG, ph: P.ph, rot }, t, blink ? 0.4 : 1);
    if (P.shield && mode !== 'dead') { const sy = GROUND - P.y - (P.slide ? 16 : 30); g.strokeStyle = `rgba(110,210,255,${0.6 + 0.3 * Math.sin(t * 6)})`; g.lineWidth = 3; g.fillStyle = 'rgba(110,210,255,.14)'; g.beginPath(); g.arc(PX, sy, 40, 0, TAU); g.fill(); g.stroke(); }
    if (P.mag > 0 && mode !== 'dead') { g.strokeStyle = `rgba(255,120,120,${0.25 + 0.2 * Math.sin(t * 7)})`; g.lineWidth = 2; g.beginPath(); g.arc(PX, GROUND - P.y - 30, (30 + (t * 90) % 60), 0, TAU); g.stroke(); }
    // hạt
    for (const q of parts) { g.globalAlpha = clamp(q.life / q.max, 0, 1); g.fillStyle = q.col; g.beginPath(); g.arc(q.x, q.y, q.s, 0, TAU); g.fill(); }
    g.globalAlpha = 1;
    // vệt tốc độ
    if (v > 520 && mode === 'play') {
      g.strokeStyle = 'rgba(255,255,255,.18)'; g.lineWidth = 2;
      for (let k = 0; k < 9; k++) { const sx = W - ((t * 1500 + k * 211) % (W + 240)) + 120, sy = 30 + ((k * 61) % 280), len = 60 + (k % 3) * 30; g.beginPath(); g.moveTo(sx, sy); g.lineTo(sx + len, sy); g.stroke(); }
    }
    g.restore();
    // chớp
    if (flash > 0) { g.fillStyle = `rgba(255,255,255,${flash * 0.5})`; g.fillRect(0, 0, W, H); }
    // HUD
    const m = Math.floor(d / 40), sc = m + coinN * 5;
    g.textAlign = 'left'; g.textBaseline = 'alphabetic';
    g.font = '800 34px system-ui, sans-serif'; g.fillStyle = 'rgba(0,0,0,.35)'; g.fillText(`${m} m`, 22, 50); g.fillStyle = '#fff'; g.fillText(`${m} m`, 20, 48);
    g.font = '700 18px system-ui, sans-serif'; g.fillStyle = '#ffe27a'; g.fillText(`🪙 ${coinN}`, 20, 76);
    g.fillStyle = '#fff'; g.fillText(`${ui.score}: ${sc}`, 20, 100);
    g.font = '600 14px system-ui, sans-serif'; g.fillStyle = 'rgba(255,255,255,.75)'; g.fillText(`${ui.best}: ${best.score}`, 20, 120);
    // trạng thái vật phẩm
    let hy = 140;
    const chip = (ic: string, sec: number, max: number, col: string) => { g.fillStyle = 'rgba(0,0,0,.4)'; rr(g, 18, hy, 96, 22, 11); g.fill(); g.fillStyle = col; rr(g, 18, hy, Math.max(8, 96 * clamp(sec / max, 0, 1)), 22, 11); g.fill(); g.font = '14px system-ui, "Segoe UI Emoji", sans-serif'; g.fillStyle = '#fff'; g.fillText(ic, 26, hy + 16); hy += 28; };
    if (P.shield) chip('🛡️', 1, 1, 'rgba(92,200,255,.85)');
    if (P.mag > 0) chip('🧲', P.mag, 8, 'rgba(255,107,107,.85)');
    if (P.boots > 0) chip('👟', P.boots, 9, 'rgba(123,224,138,.85)');
    if (P.slow > 0) chip('⏳', P.slow, 4.5, 'rgba(199,155,255,.85)');
    if (bannerT > 0 && banner) {
      const a = clamp(bannerT / 0.4, 0, 1) * clamp((2.2 - (2.2 - bannerT)) / 0.2 + 0.0, 0, 1);
      g.globalAlpha = Math.min(1, bannerT * 2); g.font = '800 30px system-ui, sans-serif'; g.textAlign = 'center'; g.fillStyle = 'rgba(0,0,0,.4)'; g.fillText(banner, W / 2 + 2, 92); g.fillStyle = '#fff'; g.fillText(banner, W / 2, 90); g.globalAlpha = 1; void a;
    }
    // vị trí tương đối của hố, hiệu ứng chuyển cảnh nhẹ
    if (mode === 'pause') { g.fillStyle = 'rgba(0,0,0,.25)'; g.fillRect(0, 0, W, H); }
  }

  // ---------- Menu ----------
  const previews = Array.from(document.querySelectorAll('.rn-hero canvas')) as HTMLCanvasElement[];
  function drawPreviews() {
    previews.forEach((cvp, i) => {
      const c = cvp.getContext('2d')!; c.clearRect(0, 0, cvp.width, cvp.height);
      const gr = c.createLinearGradient(0, 0, 0, cvp.height); gr.addColorStop(0, 'rgba(120,180,255,.25)'); gr.addColorStop(1, 'rgba(120,180,255,.05)');
      c.fillStyle = gr; c.fillRect(0, 0, cvp.width, cvp.height);
      c.fillStyle = 'rgba(0,0,0,.2)'; c.fillRect(0, 96, cvp.width, 14);
      drawRunner(c, i, 60, 98, { y: Math.max(0, Math.sin(t * 3 + i) * 6), slide: false, air: false, ph: t * 8 + i, }, t);
    });
  }
  const paintStat = () => { (document.getElementById('rn-stat') as HTMLElement).textContent = best.runs ? (ui.lang === 'vi' ? `Kỷ lục: ${best.score} điểm · xa nhất ${best.dist} m · tổng xu ${best.coins}` : `Best: ${best.score} points · farthest ${best.dist} m · total coins ${best.coins}`) : ''; };
  document.querySelectorAll('.rn-hero').forEach((b) => b.addEventListener('click', () => {
    heroIdx = parseInt((b as HTMLElement).dataset.hero || '0', 10);
    document.querySelectorAll('.rn-hero').forEach((x) => x.classList.toggle('sel', x === b));
    try { localStorage.setItem('runner-hero', String(heroIdx)); } catch {}
    sfx.play('select');
  }));
  document.querySelectorAll('.rn-hero').forEach((b, i) => b.classList.toggle('sel', i === heroIdx));
  paintStat();
  document.getElementById('rn-start')!.addEventListener('click', () => { sfx.play('click'); startRun(); });

  function pause() { if (mode !== 'play') return; mode = 'pause'; sfx.music(null); jumpHeld = false; slideHeld = false; showOverlay('pause'); }
  function resume() { if (mode !== 'pause') return; mode = 'play'; ov.hidden = true; sfx.music('action'); }
  function toMenu() { mode = 'menu'; sfx.music(null); ov.hidden = true; gameEl.hidden = true; menuEl.hidden = false; jumpHeld = false; slideHeld = false; paintStat(); }
  document.getElementById('rn-ov-main')!.addEventListener('click', (e) => { sfx.play('click'); (e.currentTarget as HTMLElement).dataset.act === 'resume' ? resume() : startRun(); });
  document.getElementById('rn-ov-menu')!.addEventListener('click', () => { sfx.play('click'); toMenu(); });
  document.getElementById('rn-pausebtn')!.addEventListener('click', () => { mode === 'pause' ? resume() : pause(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });

  // bàn phím
  window.addEventListener('keydown', (e) => {
    if (gameEl.hidden) return;
    const k = e.key;
    if (k === ' ' || k === 'ArrowUp' || k === 'w' || k === 'W') { e.preventDefault(); if (!e.repeat) pressJump(); }
    else if (k === 'ArrowDown' || k === 's' || k === 'S') { e.preventDefault(); pressSlide(); }
    else if (k === 'p' || k === 'P' || k === 'Escape') { mode === 'pause' ? resume() : pause(); }
  });
  window.addEventListener('keyup', (e) => {
    const k = e.key;
    if (k === ' ' || k === 'ArrowUp' || k === 'w' || k === 'W') releaseJump();
    else if (k === 'ArrowDown' || k === 's' || k === 'S') releaseSlide();
  });
  // chạm trên canvas: nửa trái nhảy, nửa phải trượt, vuốt lên hoặc xuống đổi hành động
  const ptr = new Map<number, { y: number; act: string }>();
  cv.addEventListener('pointerdown', (e) => {
    if (mode !== 'play') return;
    e.preventDefault(); cv.setPointerCapture(e.pointerId);
    const r = cv.getBoundingClientRect(), act = e.clientX - r.left < r.width / 2 ? 'jump' : 'slide';
    ptr.set(e.pointerId, { y: e.clientY, act });
    if (act === 'jump') pressJump(); else pressSlide();
  });
  cv.addEventListener('pointermove', (e) => {
    const p = ptr.get(e.pointerId); if (!p) return;
    const dy = e.clientY - p.y;
    if (dy < -40 && p.act !== 'jump') { releaseSlide(); p.act = 'jump'; pressJump(); }
    else if (dy > 40 && p.act !== 'slide') { releaseJump(); p.act = 'slide'; pressSlide(); }
  });
  const endPtr = (e: PointerEvent) => { const p = ptr.get(e.pointerId); if (!p) return; ptr.delete(e.pointerId); if (p.act === 'jump') releaseJump(); else releaseSlide(); };
  cv.addEventListener('pointerup', endPtr); cv.addEventListener('pointercancel', endPtr);
  const hold = (id: string, down: () => void, up: () => void) => {
    const b = document.getElementById(id)!;
    b.addEventListener('pointerdown', (e) => { e.preventDefault(); b.setPointerCapture(e.pointerId); if (mode === 'play') down(); });
    b.addEventListener('pointerup', up); b.addEventListener('pointercancel', up); b.addEventListener('lostpointercapture', up);
  };
  hold('rn-bjump', pressJump, releaseJump); hold('rn-bslide', pressSlide, releaseSlide);

  mountMute(boxEl);
  // nút tắt tiếng nằm cạnh nút tạm dừng
  const mb = boxEl.querySelector('.sfx-btn') as HTMLElement | null; if (mb) { mb.style.right = '52px'; }

  // ---------- Vòng lặp ----------
  let last = performance.now();
  function frame(now: number) {
    const dt = Math.min(0.033, (now - last) / 1000); last = now;
    if (mode === 'menu') { t += dt; drawPreviews(); }
    else { update(dt); render(); }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // ---------- Debug ----------
  if (location.hash.includes('debug')) {
    const hookObj = {
      start: (h = 0) => { heroIdx = h; startRun(); },
      step: (sec: number) => { const n = Math.round(sec * 60); for (let i = 0; i < n && mode === 'play'; i++) update(1 / 60); },
      stepAny: (sec: number) => { const n = Math.round(sec * 60); for (let i = 0; i < n; i++) update(1 / 60); },
      tp: (meters: number) => { d = meters * 40; wd = newWorld(); wd.genX = d + 900; wd.lastEnd = d + 400; P.y = 0; P.vy = 0; P.onG = true; gen(wd, d + W + 600); themeIdx = Math.floor(meters / 1000) % 4; },
      bot: (on: boolean) => { botOn = on; },
      verify: verifyWorld,
      draw: () => render(),
      press: (k: string) => { if (k === 'jump') pressJump(); else if (k === 'slide') pressSlide(); },
      release: (k: string) => { if (k === 'jump') releaseJump(); else releaseSlide(); },
      give: (k: string) => { if (k === 'shield') P.shield = true; if (k === 'magnet') P.mag = 8; if (k === 'boots') P.boots = 9; if (k === 'slow') P.slow = 4.5; },
      trace: () => { const cx0 = d + PX; let n: Obs | null = null; for (const q of wd.obs) if (!q.dead && q.x + q.w > cx0 - 20 && (!n || q.x < n.x)) n = q; return `${n ? n.t + ' dx' + Math.round(n.x - cx0 - 14) + ' w' + Math.round(n.w) : '-'} y${Math.round(P.y)} vy${Math.round(P.vy)} g${P.onG ? 1 : 0} jh${jumpHeld ? 1 : 0} bh${botHold.toFixed(2)} bj${botJumped ? 1 : 0}`; },
      state: () => ({ death: deathInfo, mode, m: Math.floor(d / 40), coins: coinN, v: Math.round(v), y: Math.round(P.y), shield: P.shield, theme: themeIdx, obs: wd.obs.length }),
    };
    (window as any).__rn = hookObj;
  }
</script>

<style>
  #runner { max-width: 960px; margin: 0 auto; }
  .rn-heroes { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 8px 0 14px; }
  .rn-hero { display: flex; flex-direction: column; align-items: center; gap: 4px; background: var(--card); border: 2px solid var(--line); border-radius: 14px; padding: 10px; color: var(--fg); cursor: pointer; font: inherit; text-align: center; }
  .rn-hero:hover { border-color: var(--accent); }
  .rn-hero.sel { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .rn-hero canvas { width: 120px; height: 110px; border-radius: 10px; }
  .rn-hero span { color: var(--muted); font-size: .85rem; line-height: 1.4; }
  .rn-box { position: relative; border-radius: 14px; overflow: hidden; background: #0b1020; box-shadow: 0 8px 30px rgba(0, 0, 0, .28); user-select: none; -webkit-user-select: none; }
  .rn-box canvas { display: block; width: 100%; height: auto; touch-action: none; }
  .rn-pause { position: absolute; top: 8px; right: 8px; z-index: 5; width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .25); background: rgba(10, 14, 30, .55); color: #fff; font-size: 15px; cursor: pointer; padding: 0; line-height: 1; }
  .rn-ov { position: absolute; inset: 0; z-index: 6; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(180deg, rgba(8, 12, 30, .78), rgba(20, 14, 50, .82)); backdrop-filter: blur(3px); color: #fff; text-align: center; padding: 16px; animation: rnfade .3s ease; }
  .rn-ov[hidden] { display: none; }
  .rn-ov h2 { margin: 0; font-size: 2rem; }
  .rn-ov p { margin: 0; color: #e8ecff; }
  .rn-rec { color: #ffe27a !important; font-weight: 700; }
  .rn-ov-btns { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .rn-ov .btn.ghost { color: #fff; border-color: rgba(255, 255, 255, .5); }
  @keyframes rnfade { from { opacity: 0; } to { opacity: 1; } }
  .rn-ctl { display: none; gap: 12px; margin-top: 12px; }
  .rn-btn { flex: 1; padding: 18px 10px; font-size: 1.1rem; font-weight: 700; border-radius: 14px; border: 2px solid var(--line); background: var(--card); color: var(--fg); touch-action: none; user-select: none; -webkit-user-select: none; }
  .rn-btn:active { background: var(--accent); color: #fff; }
  @media (pointer: coarse), (max-width: 760px) { .rn-ctl { display: flex; } }
  @media (max-width: 640px) { .rn-ov { position: fixed; inset: 0; z-index: 60; border-radius: 0; background: rgba(5, 8, 20, .9); } }
</style>
