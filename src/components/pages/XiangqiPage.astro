---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';
import { boardUi } from '../../data/board';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const c = boardUi[lang].xiangqi;
// Chỉ gửi chuỗi thường sang trình duyệt (hàm không chuyển được)
const ui = {
  turnR: c.turnOf(c.red), turnB: c.turnOf(c.black), check: c.check, thinking: c.thinking,
  mateWin: c.mateWin, mateLose: c.mateLose, mateR: c.mateOf(c.red), mateB: c.mateOf(c.black),
  repeat: c.repeat, noProgress: c.noProgress, yourTurn: c.yourTurn,
  red: c.red, black: c.black, you: c.you, bot: c.bot,
};
// Dấu chữ thập nhỏ ở các điểm đặt pháo và tốt
const MARK_PTS: [number, number][] = [[2, 1], [2, 7], [7, 1], [7, 7], ...[0, 2, 4, 6, 8].flatMap((c) => [[3, c], [6, c]] as [number, number][])];
let marks = '';
for (const [r, c] of MARK_PTS) {
  const x = c + 0.5, y = r + 0.5, d = 0.09, l = 0.2;
  for (const sx of [-1, 1]) for (const sy of [-1, 1]) {
    if (c === 0 && sx < 0) continue;
    if (c === 8 && sx > 0) continue;
    marks += `<path d="M${x + sx * (d + l)} ${y + sy * d}H${x + sx * d}V${y + sy * (d + l)}"/>`;
  }
}
---
<Base lang={lang} title={c.title} description={c.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{c.title}</h1>
  <p class="meta">{c.sub}</p>

  <div id="xq" data-ui={JSON.stringify(ui)}>
    <div id="xq-menu">
      <div class="bd-row">
        <button type="button" class="bd-opt sel" data-mode="bot">{c.modeBot}</button>
        <button type="button" class="bd-opt" data-mode="two">{c.modeTwo}</button>
      </div>
      <div id="xq-botopts">
        <h2 class="bd-h">{c.level}</h2>
        <div class="bd-row">
          {c.levels.map((l, i) => <button type="button" class={`bd-opt${i === 1 ? ' sel' : ''}`} data-level={i + 1}>{l}</button>)}
        </div>
        <h2 class="bd-h">{c.side}</h2>
        <div class="bd-row">
          {c.sides.map((l, i) => <button type="button" class={`bd-opt${i === 0 ? ' sel' : ''}`} data-side={[1, -1][i]}>{l}</button>)}
        </div>
      </div>
      <p class="bd-stat" id="xq-stat"></p>
      <button class="btn" type="button" id="xq-start">▶ {c.start}</button>
      <p class="meta">{c.keys}</p>
    </div>

    <div id="xq-game" hidden>
      <div class="xq-wrap">
        <p class="bd-status" id="xq-status" aria-live="polite"></p>
        <div class="xq-coords b" id="xq-ctop" aria-hidden="true"></div>
        <div id="xq-board" class="xq-board" role="grid">
          <svg class="xq-grid" viewBox="0 0 9 10" preserveAspectRatio="none" aria-hidden="true">
            <g stroke="#5a3a1b" stroke-width="0.035" fill="none" stroke-linecap="square">
              {Array.from({ length: 10 }, (_, r) => <line x1="0.5" y1={r + 0.5} x2="8.5" y2={r + 0.5}></line>)}
              <line x1="0.5" y1="0.5" x2="0.5" y2="9.5"></line>
              <line x1="8.5" y1="0.5" x2="8.5" y2="9.5"></line>
              {Array.from({ length: 7 }, (_, i) => <><line x1={i + 1.5} y1="0.5" x2={i + 1.5} y2="4.5"></line><line x1={i + 1.5} y1="5.5" x2={i + 1.5} y2="9.5"></line></>)}
              <Fragment set:html={marks} />
              <line x1="3.5" y1="0.5" x2="5.5" y2="2.5"></line><line x1="5.5" y1="0.5" x2="3.5" y2="2.5"></line>
              <line x1="3.5" y1="7.5" x2="5.5" y2="9.5"></line><line x1="5.5" y1="7.5" x2="3.5" y2="9.5"></line>
            </g>
          </svg>
          <div class="xq-river" aria-hidden="true"><span>楚 河</span><span>漢 界</span></div>
          <div id="xq-layer" class="xq-layer"></div>
          <div id="xq-over" class="xq-over" aria-hidden="true"></div>
        </div>
        <div class="xq-coords r" id="xq-cbot" aria-hidden="true"></div>
        <div class="bd-row bd-actions">
          <button type="button" class="btn ghost sm" id="xq-undo">↶ {c.undo}</button>
          <button type="button" class="btn ghost sm" id="xq-new">{c.again}</button>
          <button type="button" class="btn ghost sm" id="xq-menu-btn">{c.menu}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { startBoard, legalMoves, make, inCheck, kingSq, mvFrom, mvTo, botMove } from '../../data/xiangqiEngine';
  import { sfx, mountMute } from '../../data/sfx';

  const root = document.getElementById('xq') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('xq-menu') as HTMLElement;
  const gameEl = document.getElementById('xq-game') as HTMLElement;
  const boardEl = document.getElementById('xq-board') as HTMLElement;
  const layer = document.getElementById('xq-layer') as HTMLElement;
  const statusEl = document.getElementById('xq-status') as HTMLElement;
  mountMute(document.querySelector('.xq-wrap') as HTMLElement);

  const CH: Record<number, string> = { 1: '帥', 2: '仕', 3: '相', 4: '傌', 5: '俥', 6: '炮', 7: '兵', [-1]: '將', [-2]: '士', [-3]: '象', [-4]: '馬', [-5]: '車', [-6]: '砲', [-7]: '卒' };

  let mode = 'bot', level = 2, sideSel = 1;
  let human = 1; // 1 = Đỏ (đi trước), -1 = Đen
  let b = startBoard();
  let turn = 1;
  let hist: { b: Int8Array; turn: number; last: number; since: number }[] = [];
  let seen = new Map<string, number>();
  let last = -1;
  let since = 0; // số nửa nước từ lần ăn quân gần nhất
  let sel = -1;
  let targets: number[] = [];
  let over = '';
  let gid = 0; // đánh dấu ván để bỏ kết quả của máy nghĩ cho ván cũ
  let thinking = false;
  let stats = { w: 0, d: 0, l: 0 };
  try { const s = JSON.parse(localStorage.getItem('xq-stats') || 'null'); if (s) stats = { ...stats, ...s }; } catch {}

  function paintStat() {
    (document.getElementById('xq-stat') as HTMLElement).textContent = stats.w + stats.d + stats.l ? `${stats.w} / ${stats.d} / ${stats.l}` : '';
  }
  function saveStats() { try { localStorage.setItem('xq-stats', JSON.stringify(stats)); } catch {} }
  const keyOf = () => b.join('') + turn;

  let worker: Worker | null = null;
  try { worker = new Worker(new URL('../../data/xiangqiWorker.ts', import.meta.url), { type: 'module' }); } catch { worker = null; }
  function askBot(): Promise<number> {
    return new Promise((resolve) => {
      const fallback = () => setTimeout(() => resolve(botMove(b, turn, level)), 30);
      if (!worker) return fallback();
      const w = worker;
      w.onmessage = (e) => resolve(e.data.mv);
      w.onerror = () => { worker = null; fallback(); };
      w.postMessage({ b, side: turn, level });
    });
  }

  const overEl = document.getElementById('xq-over') as HTMLElement;
  const topC = document.getElementById('xq-ctop') as HTMLElement;
  const botC = document.getElementById('xq-cbot') as HTMLElement;
  const RED = ['九', '八', '七', '六', '五', '四', '三', '二', '一'];
  function renderCoords(f: boolean) {
    const red = RED.map((x) => `<span>${x}</span>`).join('');
    const blk = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((x) => `<span>${x}</span>`).join('');
    const redRow = f ? RED.slice().reverse().map((x) => `<span>${x}</span>`).join('') : red;
    const blkRow = f ? [9, 8, 7, 6, 5, 4, 3, 2, 1].map((x) => `<span>${x}</span>`).join('') : blk;
    topC.className = 'xq-coords ' + (f ? 'r' : 'b'); botC.className = 'xq-coords ' + (f ? 'b' : 'r');
    topC.innerHTML = f ? redRow : blkRow; botC.innerHTML = f ? blkRow : redRow;
  }
  const flip = () => mode === 'bot' && human === -1;
  function render(anim?: { from: number; to: number; cap: number }) {
    const f = flip();
    const chk = !over && inCheck(b, turn);
    const ksq = chk ? kingSq(b, turn) : -1;
    let html = '';
    const pos = (sq: number) => {
      let r = (sq / 9) | 0, c = sq % 9;
      if (f) { r = 9 - r; c = 8 - c; }
      return `left:${((c + 0.5) / 9) * 100}%;top:${((r + 0.5) / 10) * 100}%`;
    };
    if (last >= 0) {
      html += `<i class="xq-mark" style="${pos(mvFrom(last))}"></i><i class="xq-mark" style="${pos(mvTo(last))}"></i>`;
    }
    for (let sq = 0; sq < 90; sq++) {
      const p = b[sq];
      if (!p) continue;
      let cls = 'xq-p ' + (p > 0 ? 'r' : 'b');
      if (sq === sel) cls += ' sel';
      if (sq === ksq) cls += ' chk';
      if (targets.includes(sq)) cls += ' cap';
      let st = pos(sq);
      if (anim && sq === anim.to) { cls += ' mv'; const [fl, ft] = pos(anim.from).split(';'); st += `;--fl:${fl.slice(5)};--ft:${ft.slice(4)}`; }
      html += `<span class="${cls}" style="${st}">${CH[p]}</span>`;
    }
    if (anim && anim.cap) html += `<span class="xq-p xq-ghost ${anim.cap > 0 ? 'r' : 'b'}" style="${pos(anim.to)}">${CH[anim.cap]}</span>`;
    for (const t of targets) if (!b[t]) html += `<i class="xq-dot" style="${pos(t)}"></i>`;
    layer.innerHTML = html;
    renderCoords(f);
    overEl.textContent = over;
    overEl.classList.toggle('show', !!over);

    if (over) { statusEl.textContent = over; statusEl.classList.add('done'); }
    else {
      statusEl.classList.remove('done');
      let t = thinking ? ui.thinking : (turn === 1 ? ui.turnR : ui.turnB);
      if (mode === 'bot' && !thinking && turn === human) t = ui.yourTurn + ' · ' + (turn === 1 ? ui.red : ui.black);
      statusEl.textContent = chk ? `${ui.check} ${t}` : t;
    }
    (document.getElementById('xq-undo') as HTMLButtonElement).disabled = thinking || hist.length === 0;
  }

  function finish(msg: string, result: 'w' | 'd' | 'l' | '') {
    over = msg;
    if (mode === 'bot' && result) { stats[result]++; saveStats(); paintStat(); }
    sfx.play(result === 'w' ? 'win' : result === 'l' ? 'lose' : 'pop');
  }

  function afterMove(captured: boolean) {
    const k = keyOf();
    seen.set(k, (seen.get(k) || 0) + 1);
    since = captured ? 0 : since + 1;
    if (legalMoves(b, turn).length === 0) {
      const winner = -turn;
      if (mode === 'bot') finish(winner === human ? ui.mateWin : ui.mateLose, winner === human ? 'w' : 'l');
      else finish(winner === 1 ? ui.mateR : ui.mateB, '');
      return;
    }
    if ((seen.get(k) || 0) >= 3) { finish(ui.repeat, 'd'); return; }
    if (since >= 120) { finish(ui.noProgress, 'd'); return; }
    if (inCheck(b, turn)) sfx.play('check');
  }

  function play(m: number) {
    hist.push({ b: b.slice() as Int8Array, turn, last, since });
    const cap = make(b, m);
    last = m; turn = -turn; sel = -1; targets = [];
    sfx.play(cap ? 'capture' : 'move');
    afterMove(cap !== 0);
    render({ from: mvFrom(m), to: mvTo(m), cap });
    maybeBot();
  }

  async function maybeBot() {
    if (over || mode !== 'bot' || turn === human || thinking) return;
    thinking = true; render();
    const id = gid;
    const t0 = Date.now();
    const m = await askBot();
    const wait = Math.max(0, 350 - (Date.now() - t0));
    if (wait) await new Promise((r) => setTimeout(r, wait));
    if (id !== gid) return;
    thinking = false;
    if (m < 0 || over) { render(); return; }
    play(m);
  }

  boardEl.addEventListener('pointerdown', (e) => {
    if (over || thinking || (mode === 'bot' && turn !== human)) return;
    const rect = boardEl.getBoundingClientRect();
    let c = Math.floor(((e.clientX - rect.left) / rect.width) * 9);
    let r = Math.floor(((e.clientY - rect.top) / rect.height) * 10);
    if (c < 0 || c > 8 || r < 0 || r > 9) return;
    if (flip()) { r = 9 - r; c = 8 - c; }
    const sq = r * 9 + c;
    if (sel >= 0 && targets.includes(sq)) { play((sel << 7) | sq); return; }
    if (b[sq] * turn > 0) {
      sel = sq;
      targets = legalMoves(b, turn).filter((m) => mvFrom(m) === sq).map(mvTo);
      sfx.play('select');
    } else { sel = -1; targets = []; }
    render();
  });

  function newGame() {
    gid++;
    b = startBoard(); turn = 1; hist = []; seen = new Map(); last = -1; since = 0;
    sel = -1; targets = []; over = ''; thinking = false;
    seen.set(keyOf(), 1);
    render();
    maybeBot();
  }
  function showMenu() {
    gid++; thinking = false;
    gameEl.hidden = true; menu.hidden = false; paintStat();
  }

  function pick(attr: string, cb: (v: string) => void) {
    document.querySelectorAll<HTMLElement>(`#xq-menu [data-${attr}]`).forEach((btn) => btn.addEventListener('click', () => {
      document.querySelectorAll(`#xq-menu [data-${attr}]`).forEach((x) => x.classList.remove('sel'));
      btn.classList.add('sel');
      cb(btn.dataset[attr] as string);
    }));
  }
  pick('mode', (v) => { mode = v; (document.getElementById('xq-botopts') as HTMLElement).hidden = v !== 'bot'; });
  pick('level', (v) => { level = Number(v); });
  pick('side', (v) => { sideSel = Number(v); });

  document.getElementById('xq-start')!.addEventListener('click', () => {
    human = sideSel;
    menu.hidden = true; gameEl.hidden = false;
    newGame();
  });
  document.getElementById('xq-new')!.addEventListener('click', newGame);
  document.getElementById('xq-menu-btn')!.addEventListener('click', showMenu);
  document.getElementById('xq-undo')!.addEventListener('click', () => {
    if (thinking || !hist.length) return;
    gid++;
    // Đấu với máy: lùi về lượt của người chơi
    let s = hist.pop()!;
    if (mode === 'bot') while (s.turn !== human && hist.length) s = hist.pop()!;
    b = s.b; turn = s.turn; last = s.last; since = s.since;
    seen = new Map();
    seen.set(keyOf(), 1);
    over = ''; sel = -1; targets = [];
    render();
    maybeBot();
  });

  paintStat();
  if (location.hash === '#debug') (window as any).__xq = { get b() { return b; }, get turn() { return turn; }, get st() { return JSON.stringify({ human, thinking, sel, over, mode, level, sideSel }); }, play, newGame, legalMoves: () => legalMoves(b, turn) };
</script>

<style is:global>
  #xq .bd-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .xq-wrap { position: relative; width: min(100%, 560px); margin: 0 auto; }
  .xq-wrap .sfx-btn { top: -2px !important; right: 0 !important; }
  .xq-board {
    position: relative; width: 100%; aspect-ratio: 9 / 10; border-radius: 14px; touch-action: manipulation; user-select: none;
    background:
      repeating-linear-gradient(92deg, rgba(120, 70, 20, .07) 0 2px, rgba(255, 255, 255, 0) 2px 7px, rgba(120, 70, 20, .05) 7px 9px, rgba(255, 255, 255, 0) 9px 16px),
      radial-gradient(130% 110% at 28% 18%, #f6dca3 0%, #e6bd74 55%, #d3a05a 100%);
    box-shadow: 0 10px 28px rgba(60, 35, 10, .35), 0 0 0 5px #8b5a24, 0 0 0 7px #c99a55, inset 0 0 22px rgba(120, 70, 20, .35);
  }
  .xq-grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .xq-grid line { stroke: #6a4118; }
  .xq-grid g { stroke: #6a4118; }
  .xq-river { position: absolute; left: 0; right: 0; top: 45%; height: 10%; display: flex; justify-content: space-around; align-items: center; padding: 0 11%; color: #7a4d1e; font-size: clamp(15px, 4.6vw, 28px); font-weight: 800; letter-spacing: .2em; pointer-events: none; font-family: 'KaiTi', 'STKaiti', 'Noto Serif CJK SC', serif; text-shadow: 0 1px 0 rgba(255, 240, 200, .7); }
  .xq-layer { position: absolute; inset: 0; }
  .xq-coords { display: flex; width: 100%; padding: 0 5.5%; box-sizing: border-box; margin: 10px 0; font-size: 13px; font-weight: 700; opacity: .8; }
  .xq-coords span { flex: 1; text-align: center; }
  .xq-coords.r { color: #c0261b; }
  .xq-coords.b { color: var(--muted, #667); }
  .xq-p {
    position: absolute; width: 10.8%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: clamp(17px, 5.8vw, 33px); line-height: 1;
    font-family: 'KaiTi', 'STKaiti', 'Noto Serif CJK SC', 'Songti SC', serif;
    background: radial-gradient(circle at 34% 28%, #fffdf6 0%, #f6e6c0 38%, #e2c58a 78%, #cfa966 100%);
    border: 2px solid #7c4d1c;
    box-shadow: 0 4px 6px rgba(50, 25, 5, .45), inset 0 -3px 5px rgba(120, 70, 20, .35), inset 0 2px 3px rgba(255, 255, 255, .8);
    pointer-events: none; transition: transform .12s, box-shadow .12s;
  }
  .xq-p::before { content: ''; position: absolute; inset: 8%; border-radius: 50%; border: 1.6px solid currentColor; opacity: .6; }
  .xq-p.r { color: #c0261b; text-shadow: 0 1px 0 rgba(255, 255, 255, .55); }
  .xq-p.b { color: #14161c; text-shadow: 0 1px 0 rgba(255, 255, 255, .55); }
  .xq-p.sel { box-shadow: 0 0 0 4px rgba(47, 158, 68, .85), 0 9px 12px rgba(50, 25, 5, .5); transform: translate(-50%, -58%) scale(1.06); z-index: 3; }
  .xq-p.cap { box-shadow: 0 0 0 4px rgba(224, 49, 49, .85), 0 4px 6px rgba(50, 25, 5, .45); animation: xq-pulse 1s ease-in-out infinite; }
  .xq-p.chk { box-shadow: 0 0 0 4px #ff6b6b, 0 0 20px #ff4d4d; animation: xq-pulse .8s ease-in-out infinite; }
  .xq-p.mv { animation: xq-slide .22s cubic-bezier(.3, .8, .4, 1); z-index: 2; }
  .xq-ghost { z-index: 1; animation: xq-ghost .35s ease-out forwards; }
  .xq-dot { position: absolute; width: 4.2%; aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, #43b95e, #2b8a3e); box-shadow: 0 0 0 3px rgba(67, 185, 94, .3); pointer-events: none; animation: xq-pop .18s ease-out; }
  .xq-mark { position: absolute; width: 12%; aspect-ratio: 1; transform: translate(-50%, -50%); pointer-events: none; border-radius: 8px; background: rgba(60, 120, 220, .16); box-shadow: inset 0 0 0 2px rgba(43, 108, 207, .75); }
  .xq-over { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 8%; border-radius: 14px; background: rgba(20, 12, 4, .55); color: #fff3d6; font-size: clamp(22px, 6.4vw, 38px); font-weight: 800; text-shadow: 0 3px 14px rgba(0, 0, 0, .6); opacity: 0; pointer-events: none; transition: opacity .4s; z-index: 5; }
  .xq-over.show { opacity: 1; }
  @keyframes xq-slide { from { left: var(--fl); top: var(--ft); } }
  @keyframes xq-pulse { 50% { filter: brightness(1.12); } }
  @keyframes xq-pop { from { transform: translate(-50%, -50%) scale(.2); } }
  @keyframes xq-ghost { to { opacity: 0; transform: translate(-50%, -50%) scale(1.5); } }
  @media (prefers-reduced-motion: reduce) { .xq-p, .xq-dot, .xq-ghost { animation: none !important; } }
  main.is-fs .xq-wrap { max-width: calc((100vh - 300px) * 0.9) !important; margin-left: auto !important; margin-right: auto !important; }
</style>
