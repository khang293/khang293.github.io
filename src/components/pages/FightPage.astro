---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const b = g.fight;
const levels = ['easy', 'normal', 'hard'] as const;
---
<Base lang={lang} title={b.title} description={b.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{b.title}</h1>
  <p class="meta">{b.sub}</p>

  <div id="fight" data-ui={JSON.stringify(b)}>
    <div id="fg-menu">
      <h2 class="fg-h">{b.pickHero}</h2>
      <div class="fg-heroes">
        {b.heroes.map((h, i) => (
          <button class="fg-hero" type="button" data-hero={i} aria-pressed="false">
            <canvas width="96" height="100" aria-hidden="true"></canvas>
            <b>{h.name}</b><span>{h.style}</span>
            <small>⚡ {h.special.name}: {h.special.desc}</small>
          </button>
        ))}
      </div>
      <h2 class="fg-h">{b.pickLevel}</h2>
      <div class="fg-levels">
        {levels.map((lv) => (
          <button class={`fg-level fg-${lv}`} type="button" data-level={lv}>
            <b>{b.levels[lv]}</b><span>{b.levelDesc[lv]}</span>
            <em class="fg-stat" data-stat={lv}></em>
          </button>
        ))}
      </div>
      <p class="meta">{b.keys}</p>
    </div>

    <div id="fg-game" hidden>
      <canvas id="fg-canvas" width="800" height="450" aria-label={b.title}></canvas>
      <div class="fg-pad">
        <div class="fg-dpad">
          <button type="button" data-hold="left" aria-label="Left">◀</button>
          <button type="button" data-hold="right" aria-label="Right">▶</button>
          <button type="button" data-hold="jump" aria-label="Jump">▲</button>
          <button type="button" data-hold="block" aria-label="Block">🛡</button>
        </div>
        <div class="fg-acts">
          <button type="button" data-press="light">👊 {b.light}</button>
          <button type="button" data-press="heavy">💥 {b.heavy}</button>
          <button type="button" data-press="special" class="sp">⚡ {b.special}</button>
        </div>
      </div>
      <div id="fg-result" class="fg-result" hidden>
        <div class="fg-big" id="fg-msg"></div>
        <p id="fg-rec" class="meta"></p>
        <div class="fg-actions">
          <button type="button" class="btn" id="fg-again">{b.again}</button>
          <button type="button" class="btn ghost" id="fg-change">{b.change}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { paintHero } from '../../data/heroArt';

  const root = document.getElementById('fight') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('fg-menu') as HTMLElement;
  const gameEl = document.getElementById('fg-game') as HTMLElement;
  const canvas = document.getElementById('fg-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const resultEl = document.getElementById('fg-result') as HTMLElement;

  const W = 800, H = 450, GY = 388, S = 2.5;
  const FONT = 'system-ui, "Segoe UI Emoji", "Apple Color Emoji", sans-serif';
  const COST = 35;
  const ATK = {
    light: { pre: 0.09, act: 0.11, post: 0.15, reach: 66, kb: 170, stun: 0.22, lunge: 34 },
    heavy: { pre: 0.26, act: 0.12, post: 0.32, reach: 88, kb: 380, stun: 0.42, lunge: 64 },
  };
  // Chỉ số từng võ sĩ: Hiệp sĩ, Pháp sư, Cung thủ, Nhẫn giả. haste < 1 là ra đòn nhanh hơn.
  const HEROES = [
    { speed: 215, light: 6, heavy: 14, jump: 830, haste: 1 },
    { speed: 240, light: 5, heavy: 11, jump: 830, haste: 1 },
    { speed: 285, light: 6, heavy: 11, jump: 900, haste: 1 },
    { speed: 262, light: 7, heavy: 12, jump: 850, haste: 0.82 },
  ];
  const COLORS = ['#e2e8f0', '#c4b5fd', '#86efac', '#f87171'];
  // react: giây giữa hai lần máy suy nghĩ, aggr: hay tấn công, block: hay đỡ, special: hay dùng chiêu
  const DIFF: Record<string, { react: number; aggr: number; block: number; special: number; speed: number }> = {
    easy: { react: 0.5, aggr: 0.35, block: 0.15, special: 0.25, speed: 0.85 },
    normal: { react: 0.28, aggr: 0.6, block: 0.45, special: 0.55, speed: 1 },
    hard: { react: 0.12, aggr: 0.85, block: 0.75, special: 0.9, speed: 1.1 },
  };

  type Kind = '' | 'light' | 'heavy';
  interface F {
    skin: number; human: boolean;
    x: number; y: number; vx: number; vy: number; face: number;
    hp: number; shown: number; energy: number;
    state: string; st: number; kind: Kind; hit: boolean; stun: number; cast: number;
    grounded: boolean; flash: number; ko: boolean; inv: number; vis: number;
    ai: { t: number; mt: number; cool: number; mode: string; saw: boolean };
  }
  interface Inp { left: boolean; right: boolean; jump: boolean; block: boolean; light: boolean; heavy: boolean; special: boolean }
  interface Proj { x: number; y: number; vx: number; dmg: number; kb: number; stun: number; kind: string; owner: F; r: number }
  interface Particle { x: number; y: number; vx: number; vy: number; g: number; life: number; max: number; size: number; color: string }

  let level = 'normal';
  let hero = 0;
  try { const h = Number(localStorage.getItem('fight-hero')); if (h >= 0 && h < 4) hero = h; } catch {}
  let foeSkin = 1;
  let p: F, c: F;
  let projs: Proj[] = [];
  let particles: Particle[] = [];
  let shake = 0;
  let clock = 0;
  let timer = 60;
  let round = 1;
  let wins = [0, 0];
  let phase = 'intro';
  let phaseT = 0;
  let koText = '';
  let running = false;
  let last = 0;
  let raf = 0;
  const held = { left: false, right: false, jump: false, block: false };
  const press = { light: false, heavy: false, special: false };

  const blank = (): Inp => ({ left: false, right: false, jump: false, block: false, light: false, heavy: false, special: false });
  const clampX = (x: number) => Math.max(40, Math.min(W - 40, x));

  function makeF(skin: number, x: number, face: number, human: boolean): F {
    return {
      skin, human, x, y: GY, vx: 0, vy: 0, face, hp: 100, shown: 100, energy: 20,
      state: 'idle', st: 0, kind: '', hit: false, stun: 0, cast: 0,
      grounded: true, flash: 0, ko: false, inv: 0, vis: 1,
      ai: { t: 0.4, mt: 0, cool: 0.6, mode: 'idle', saw: false },
    };
  }

  function spark(x: number, y: number, n: number, colors: string[], speed: number, g = 0) {
    for (let i = 0; i < n; i++) {
      const ang = Math.random() * Math.PI * 2, v = speed * (0.4 + Math.random() * 0.8);
      const life = 0.25 + Math.random() * 0.35;
      particles.push({ x, y, vx: Math.cos(ang) * v, vy: Math.sin(ang) * v, g, life, max: life, size: 3 + Math.random() * 4, color: colors[Math.floor(Math.random() * colors.length)] });
    }
  }

  // ---------- Trận đấu ----------
  function startMatch(lv: string) {
    level = lv;
    wins = [0, 0];
    round = 1;
    const others = [0, 1, 2, 3].filter((i) => i !== hero);
    foeSkin = others[Math.floor(Math.random() * others.length)];
    resultEl.hidden = true;
    menu.hidden = true;
    gameEl.hidden = false;
    newRound();
    running = true;
    last = performance.now();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(frame);
  }

  function newRound() {
    p = makeF(hero, 210, 1, true);
    c = makeF(foeSkin, W - 210, -1, false);
    projs = []; particles = [];
    timer = 60; phase = 'intro'; phaseT = 1.9; koText = '';
    held.left = held.right = held.jump = held.block = false;
    press.light = press.heavy = press.special = false;
  }

  function endRound(reason: string) {
    if (phase !== 'fight') return;
    phase = 'ko';
    phaseT = 2.4;
    let winner = -1;
    if (p.hp <= 0 && c.hp <= 0) winner = -1;
    else if (p.hp <= 0) winner = 1;
    else if (c.hp <= 0) winner = 0;
    else if (p.hp > c.hp) winner = 0;
    else if (c.hp > p.hp) winner = 1;
    koText = reason === 'time' ? ui.timeUp : winner < 0 ? ui.drawRound : ui.ko;
    if (winner >= 0) wins[winner]++;
  }

  function nextRound() {
    if (wins[0] >= 2 || wins[1] >= 2 || round >= 5) { finishMatch(); return; }
    round++;
    newRound();
  }

  // ---------- Thành tích ----------
  interface Stat { played: number; won: number; streak: number; bestStreak: number }
  const EMPTY: Stat = { played: 0, won: 0, streak: 0, bestStreak: 0 };
  const loadStats = (): Record<string, Stat> => { try { return JSON.parse(localStorage.getItem('fight-stats') || '{}'); } catch { return {}; } };
  const statOf = (lv: string): Stat => ({ ...EMPTY, ...loadStats()[lv] });
  function recordResult(lv: string, won: boolean): Stat {
    const all = loadStats();
    const s = { ...EMPTY, ...all[lv] };
    s.played++;
    if (won) { s.won++; s.streak++; s.bestStreak = Math.max(s.bestStreak, s.streak); } else s.streak = 0;
    all[lv] = s;
    try { localStorage.setItem('fight-stats', JSON.stringify(all)); } catch {}
    return s;
  }
  const statLine = (s: Stat) => (s.played ? ui.statWins + ' ' + s.won + '/' + s.played + ' · ' + ui.statStreak + ' ' + s.streak + ' (' + ui.statBest + ' ' + s.bestStreak + ')' : '');
  function renderStats() {
    document.querySelectorAll<HTMLElement>('.fg-stat').forEach((el) => { el.textContent = statLine(statOf(el.dataset.stat || '')); });
  }

  function finishMatch() {
    running = false;
    const won = wins[0] > wins[1];
    const before = statOf(level);
    const s = recordResult(level, won);
    resultEl.hidden = false;
    const msg = document.getElementById('fg-msg')!;
    msg.textContent = won ? ui.win : ui.lose;
    msg.className = 'fg-big ' + (won ? 'win' : 'lose');
    const parts = [wins[0] + ' - ' + wins[1], statLine(s)];
    if (won && s.streak > 1 && s.streak > before.bestStreak) parts.push(ui.statNew);
    document.getElementById('fg-rec')!.textContent = parts.join(' · ');
  }

  // ---------- Chiến đấu ----------
  function meleeHit(f: F, e: F, reach: number): boolean {
    const x0 = f.face > 0 ? f.x + 14 : f.x - 14 - reach;
    const x1 = x0 + reach;
    const y0 = f.y - 115, y1 = f.y - 5;
    return e.x + 26 > x0 && e.x - 26 < x1 && e.y > y0 && e.y - 105 < y1;
  }

  function hurt(def: F, from: { face: number }, dmg: number, kb: number, stun: number, owner?: F) {
    if (def.ko || def.inv > 0 || phase !== 'fight') return;
    const blocked = def.state === 'block' && def.grounded;
    if (blocked) {
      def.hp -= Math.max(1, dmg * 0.2);
      def.vx = from.face * kb * 0.3;
      def.energy = Math.min(100, def.energy + 2);
      spark(def.x - from.face * 24, def.y - 60, 6, ['#93c5fd', '#ffffff'], 160);
      shake = Math.max(shake, 0.05);
    } else {
      def.hp -= dmg;
      def.state = 'hit'; def.st = 0; def.stun = stun; def.kind = ''; def.vis = 1;
      def.vx = from.face * kb;
      if (!def.grounded || dmg >= 11) { def.vy = -260; def.grounded = false; }
      def.flash = 0.25;
      if (owner) owner.energy = Math.min(100, owner.energy + 8);
      def.energy = Math.min(100, def.energy + 5);
      spark(def.x, def.y - 65, dmg >= 11 ? 16 : 9, ['#fde047', '#fb923c', '#ffffff'], 260);
      shake = Math.max(shake, dmg >= 11 ? 0.25 : 0.12);
    }
    if (def.hp <= 0) {
      def.hp = 0; def.ko = true; def.state = 'ko'; def.st = 0;
      def.vy = -420; def.vx = from.face * 340; def.grounded = false;
      shake = 0.4;
      endRound('ko');
    }
  }

  function shoot(f: F, kind: string) {
    const fire = kind === 'fire';
    projs.push({ x: f.x + f.face * 54, y: f.y - 62, vx: f.face * (fire ? 480 : 1000), dmg: fire ? 14 : 9, kb: fire ? 330 : 200, stun: 0.3, kind, owner: f, r: fire ? 20 : 9 });
    spark(f.x + f.face * 54, f.y - 62, 8, fire ? ['#fb923c', '#fde047'] : ['#86efac', '#ffffff'], 140);
  }

  function endAct(f: F) { f.state = 'idle'; f.st = 0; f.vx = 0; f.vis = 1; f.kind = ''; }

  function startAttack(f: F, kind: Kind) {
    f.state = 'attack'; f.kind = kind; f.st = 0; f.hit = false;
    if (f.grounded) f.vx = 0;
  }
  function startSpecial(f: F) {
    f.energy -= COST;
    f.state = 'special'; f.st = 0; f.hit = false; f.cast = 0;
    if (f.grounded) f.vx = 0;
  }

  function updateAttack(f: F, e: F) {
    const a = ATK[f.kind as 'light'], k = HEROES[f.skin].haste;
    const pre = a.pre * k, post = a.post * k;
    if (f.grounded) f.vx = f.st >= pre && f.st < pre + a.act ? (f.face * a.lunge) / a.act * 0.6 : 0;
    if (!f.hit && f.st >= pre && f.st < pre + a.act) {
      const dmg = f.kind === 'light' ? HEROES[f.skin].light : HEROES[f.skin].heavy;
      if (meleeHit(f, e, a.reach)) { f.hit = true; hurt(e, f, dmg, a.kb, a.stun, f); }
    }
    if (f.st >= pre + a.act + post) endAct(f);
  }

  function updateSpecial(f: F, e: F) {
    const t = f.st;
    if (f.skin === 0) { // Xung phong
      f.vx = t > 0.08 && t < 0.4 ? f.face * 600 : 0;
      if (!f.hit && t > 0.08 && t < 0.42 && meleeHit(f, e, 50)) { f.hit = true; hurt(e, f, 16, 430, 0.45, f); }
      if (t >= 0.58) endAct(f);
    } else if (f.skin === 1) { // Cầu lửa
      f.vx = 0;
      if (!f.cast && t >= 0.22) { f.cast = 1; shoot(f, 'fire'); }
      if (t >= 0.55) endAct(f);
    } else if (f.skin === 2) { // Xạ tiễn
      f.vx = 0;
      if (f.cast === 0 && t >= 0.18) { f.cast = 1; shoot(f, 'arrow'); }
      if (f.cast === 1 && t >= 0.36) { f.cast = 2; shoot(f, 'arrow'); }
      if (t >= 0.62) endAct(f);
    } else { // Thuấn bộ
      if (t < 0.14) { f.vis = 1 - t / 0.14; f.inv = 0.2; } else f.vis = Math.min(1, (t - 0.14) / 0.08);
      if (f.cast === 0 && t >= 0.14) {
        f.cast = 1;
        spark(f.x, f.y - 55, 12, ['#475569', '#cbd5e1', '#ffffff'], 150);
        f.x = clampX(e.x - e.face * 78);
        f.face = e.x >= f.x ? 1 : -1;
        spark(f.x, f.y - 55, 12, ['#475569', '#cbd5e1', '#ffffff'], 150);
      }
      if (!f.hit && t >= 0.26 && t < 0.42 && meleeHit(f, e, 78)) { f.hit = true; hurt(e, f, 15, 320, 0.4, f); }
      if (t >= 0.62) endAct(f);
    }
  }

  function stepFighter(f: F, e: F, inp: Inp, dt: number) {
    f.st += dt;
    f.flash = Math.max(0, f.flash - dt);
    f.inv = Math.max(0, f.inv - dt);
    f.energy = Math.min(100, f.energy + 4 * dt);
    if (f.shown > f.hp) f.shown = Math.max(f.hp, f.shown - 30 * dt);
    const H0 = HEROES[f.skin];
    const free = f.state === 'idle' || f.state === 'walk' || f.state === 'block';
    if (free && f.grounded && !e.ko) f.face = e.x >= f.x ? 1 : -1;

    if (f.state === 'ko') {
      f.vx *= Math.pow(0.02, dt);
    } else if (f.state === 'hit') {
      f.stun -= dt;
      f.vx *= Math.pow(0.01, dt);
      if (f.stun <= 0 && f.grounded) { f.state = 'idle'; f.st = 0; }
    } else if (f.state === 'attack') {
      updateAttack(f, e);
    } else if (f.state === 'special') {
      updateSpecial(f, e);
    } else {
      if (inp.block && f.grounded) {
        f.state = 'block'; f.vx = 0;
      } else {
        const dir = (inp.right ? 1 : 0) - (inp.left ? 1 : 0);
        const sp = H0.speed * (f.human ? 1 : DIFF[level].speed) * (f.grounded ? 1 : 0.75);
        if (f.grounded) { f.vx = dir * sp; f.state = dir ? 'walk' : 'idle'; } else f.vx = dir * sp;
        if (inp.jump && f.grounded) { f.vy = -H0.jump; f.grounded = false; }
        if (inp.light) startAttack(f, 'light');
        else if (inp.heavy) startAttack(f, 'heavy');
        else if (inp.special && f.energy >= COST) startSpecial(f);
      }
    }

    // Vật lý
    if (!f.grounded) f.vy += 2300 * dt;
    f.x += f.vx * dt;
    f.y += f.vy * dt;
    if (f.y >= GY) {
      f.y = GY; f.vy = 0;
      if (!f.grounded) { f.grounded = true; spark(f.x, GY, 4, ['#94a3b8', '#cbd5e1'], 90); }
    }
    f.x = clampX(f.x);
  }

  // ---------- Máy điều khiển ----------
  function canSpecial(f: F, dist: number): boolean {
    if (f.skin === 0) return dist > 120 && dist < 340;
    if (f.skin === 1) return dist > 160;
    if (f.skin === 2) return dist > 180;
    return dist > 110;
  }

  function aiInput(f: F, e: F, dt: number): Inp {
    const cfg = DIFF[level], ai = f.ai;
    ai.t -= dt; ai.mt -= dt; ai.cool -= dt;
    const inp = blank();
    if (f.ko || f.state === 'attack' || f.state === 'special' || f.state === 'hit') return inp;
    const dist = Math.abs(e.x - f.x);
    const dir = e.x > f.x ? 1 : -1;
    // Thấy đối thủ vừa ra đòn gần mình thì quyết định đỡ ngay (mỗi đòn chỉ quyết định một lần)
    const attacking = e.state === 'attack' || e.state === 'special';
    if (attacking && !ai.saw && dist < 190) {
      ai.saw = true;
      if (Math.random() < cfg.block) { ai.mode = 'block'; ai.mt = 0.45; ai.t = 0.45; }
    }
    if (!attacking) ai.saw = false;
    if (ai.t <= 0) {
      ai.t = cfg.react * (0.6 + Math.random() * 0.8);
      if (e.state === 'hit' && dist < 110 && ai.mt <= 0 && Math.random() < 0.85) {
        // Đối thủ đang choáng: tung đòn nối
        ai.mode = Math.random() < 0.5 ? 'light' : 'heavy'; ai.mt = 0.05; ai.cool = 0.25;
      } else if (ai.mt <= 0) {
        if (f.energy >= COST && canSpecial(f, dist) && Math.random() < cfg.special) { ai.mode = 'special'; ai.mt = 0.05; }
        else if (dist > 95) { ai.mode = Math.random() < 0.08 ? 'jumpin' : 'approach'; ai.mt = 0.25 + Math.random() * 0.3; }
        else if (ai.cool <= 0 && Math.random() < cfg.aggr) { ai.mode = Math.random() < 0.6 ? 'light' : 'heavy'; ai.mt = 0.05; ai.cool = 0.3 + Math.random() * 0.5 * (1.2 - cfg.aggr); }
        else { ai.mode = Math.random() < 0.35 ? 'retreat' : 'idle'; ai.mt = 0.3; }
      }
    }
    if (ai.mt > 0) {
      switch (ai.mode) {
        case 'block': inp.block = true; break;
        case 'approach': if (dist > 70) { inp.left = dir < 0; inp.right = dir > 0; } break;
        case 'jumpin': inp.jump = f.grounded; inp.left = dir < 0; inp.right = dir > 0; break;
        case 'retreat': inp.left = dir > 0; inp.right = dir < 0; break;
        case 'light': inp.light = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'heavy': inp.heavy = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'special': inp.special = true; ai.mt = 0; ai.mode = 'idle'; break;
      }
    }
    return inp;
  }

  function humanInput(): Inp {
    const i: Inp = { ...held, ...press };
    press.light = press.heavy = press.special = false;
    return i;
  }

  function updateProjs(dt: number) {
    for (const q of projs) {
      q.x += q.vx * dt;
      spark(q.x, q.y, 1, q.kind === 'fire' ? ['#fb923c', '#fde047'] : ['#86efac'], 30);
      const tgt = q.owner === p ? c : p;
      if (!tgt.ko && Math.abs(q.x - tgt.x) < 26 + q.r && q.y > tgt.y - 105 - q.r && q.y < tgt.y + q.r) {
        hurt(tgt, { face: Math.sign(q.vx) }, q.dmg, q.kb, q.stun, q.owner);
        q.r = -1;
      }
    }
    projs = projs.filter((q) => q.r > 0 && q.x > -60 && q.x < W + 60);
  }

  function update(dt: number) {
    clock += dt;
    shake = Math.max(0, shake - dt);
    for (const q of particles) { q.life -= dt; q.x += q.vx * dt; q.y += q.vy * dt; q.vy += q.g * dt; }
    particles = particles.filter((q) => q.life > 0);

    if (phase === 'intro') {
      stepFighter(p, c, blank(), dt); stepFighter(c, p, blank(), dt);
      phaseT -= dt;
      if (phaseT <= 0) phase = 'fight';
    } else if (phase === 'fight') {
      timer -= dt;
      stepFighter(p, c, humanInput(), dt);
      stepFighter(c, p, aiInput(c, p, dt), dt);
      updateProjs(dt);
      if (timer <= 0) { timer = 0; endRound('time'); }
    } else {
      stepFighter(p, c, blank(), dt); stepFighter(c, p, blank(), dt);
      updateProjs(dt);
      phaseT -= dt;
      if (phaseT <= 0) nextRound();
    }
    // Không cho hai võ sĩ chồng lên nhau khi cùng đứng trên mặt đất
    const dx = c.x - p.x;
    if (p.grounded && c.grounded && Math.abs(dx) < 46 && !p.ko && !c.ko) {
      const push = (46 - Math.abs(dx)) / 2 * (dx >= 0 ? 1 : -1);
      p.x = clampX(p.x - push); c.x = clampX(c.x + push);
    }
  }

  // ---------- Vẽ ----------
  const bg = document.createElement('canvas');
  bg.width = W; bg.height = H;
  (function buildBg() {
    const g = bg.getContext('2d')!;
    const sky = g.createLinearGradient(0, 0, 0, GY);
    sky.addColorStop(0, '#1e1b4b'); sky.addColorStop(0.55, '#6d28d9'); sky.addColorStop(1, '#f97316');
    g.fillStyle = sky; g.fillRect(0, 0, W, H);
    g.fillStyle = 'rgba(255,255,255,.7)';
    for (let i = 0; i < 70; i++) {
      const x = (i * 137) % W, y = (i * 53) % 210;
      g.globalAlpha = 0.35 + ((i * 7) % 5) / 10;
      g.beginPath(); g.arc(x, y, 0.6 + (i % 3) * 0.5, 0, Math.PI * 2); g.fill();
    }
    g.globalAlpha = 1;
    const moon = g.createRadialGradient(620, 110, 10, 620, 110, 120);
    moon.addColorStop(0, 'rgba(254,243,199,.9)'); moon.addColorStop(0.4, 'rgba(254,243,199,.25)'); moon.addColorStop(1, 'rgba(254,243,199,0)');
    g.fillStyle = moon; g.fillRect(480, 0, 280, 260);
    g.fillStyle = '#fef3c7'; g.beginPath(); g.arc(620, 110, 44, 0, Math.PI * 2); g.fill();
    g.fillStyle = '#3b1d6e';
    g.beginPath(); g.moveTo(0, GY - 40); g.lineTo(90, 250); g.lineTo(170, 310); g.lineTo(280, 215); g.lineTo(390, 300); g.lineTo(500, 240); g.lineTo(620, 300); g.lineTo(720, 230); g.lineTo(800, 290); g.lineTo(800, GY); g.lineTo(0, GY); g.closePath(); g.fill();
    g.fillStyle = '#2a1450';
    g.beginPath(); g.moveTo(0, GY); g.lineTo(0, 320); g.lineTo(120, 300); g.lineTo(230, 335); g.lineTo(360, 310); g.lineTo(480, 340); g.lineTo(600, 312); g.lineTo(720, 335); g.lineTo(800, 318); g.lineTo(800, GY); g.closePath(); g.fill();
    // Chùa
    g.fillStyle = '#160b30';
    g.fillRect(80, 270, 110, 118);
    for (const [w, y] of [[150, 262], [124, 232], [98, 204]] as [number, number][]) {
      g.beginPath(); g.moveTo(135 - w / 2 - 10, y + 14); g.lineTo(135, y - 16); g.lineTo(135 + w / 2 + 10, y + 14); g.closePath(); g.fill();
    }
    g.fillRect(132, 168, 6, 34);
    // Cổng torii
    g.fillStyle = '#b91c1c';
    g.fillRect(640, 270, 14, 118); g.fillRect(726, 270, 14, 118);
    g.fillRect(622, 262, 136, 14); g.fillRect(634, 290, 112, 9);
    g.fillStyle = '#7f1d1d'; g.fillRect(622, 276, 136, 3);
    // Sàn
    const floor = g.createLinearGradient(0, GY - 6, 0, H);
    floor.addColorStop(0, '#7c4a2a'); floor.addColorStop(1, '#2b170c');
    g.fillStyle = floor; g.fillRect(0, GY - 6, W, H - GY + 6);
    g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(0, GY - 6, W, 3);
    g.strokeStyle = 'rgba(0,0,0,.28)'; g.lineWidth = 2;
    for (let x = -40; x < W + 80; x += 66) { g.beginPath(); g.moveTo(x + 10, GY - 3); g.lineTo(x - 30, H); g.stroke(); }
    g.beginPath(); g.moveTo(0, GY + 28); g.lineTo(W, GY + 28); g.stroke();
  })();

  function drawFighter(f: F) {
    const air = Math.max(0, GY - f.y);
    ctx.fillStyle = 'rgba(0,0,0,.38)';
    ctx.beginPath(); ctx.ellipse(f.x, GY + 2, Math.max(12, 38 - air / 9), 8, 0, 0, Math.PI * 2); ctx.fill();

    let ox = 0, rot = 0, sy = 1, alpha = 1;
    if (f.state === 'attack') {
      const a = ATK[f.kind as 'light'], pre = a.pre * HEROES[f.skin].haste;
      if (f.st >= pre && f.st < pre + a.act) ox = f.face * a.lunge * 0.5;
      rot = f.face * (f.st < pre ? -0.08 : 0.14);
    } else if (f.state === 'hit') {
      rot = -f.face * 0.2;
      if (Math.floor(clock * 30) % 2) alpha = 0.6;
    } else if (f.state === 'block') sy = 0.93;
    else if (f.state === 'special') {
      if (f.skin === 0) rot = f.face * 0.3; else if (f.skin === 1) rot = -f.face * 0.1;
    }
    ctx.save();
    ctx.globalAlpha = alpha * (f.skin === 3 ? f.vis : 1);
    ctx.translate(f.x + ox, f.y - (f.ko ? 30 : 0));
    ctx.rotate(f.ko ? -f.face * 1.5 : rot);
    ctx.translate(0, -52);
    ctx.scale(f.face * S, S * sy);
    paintHero(ctx, f.skin, { fx: 1, fy: 0, moving: f.state === 'walk' && f.grounded, s: 1, human: false }, clock);
    ctx.restore();

    // Hiệu ứng đòn đánh
    if (f.state === 'attack') {
      const a = ATK[f.kind as 'light'], pre = a.pre * HEROES[f.skin].haste, dur = a.act * 1.8;
      if (f.st >= pre && f.st < pre + dur) {
        const pr = (f.st - pre) / dur;
        ctx.save();
        ctx.translate(f.x + f.face * (30 + a.reach * 0.3), f.y - 62);
        ctx.scale(f.face, 1);
        ctx.strokeStyle = COLORS[f.skin];
        ctx.globalAlpha = 1 - pr;
        ctx.lineWidth = (f.kind === 'heavy' ? 14 : 8) * (1 - pr * 0.5);
        ctx.lineCap = 'round';
        ctx.beginPath(); ctx.arc(-10, 0, a.reach * 0.55, -1.15 + pr * 0.4, 1.15 + pr * 0.4); ctx.stroke();
        ctx.restore();
      }
    }
    if (f.state === 'special' && f.skin === 0 && f.st > 0.08 && f.st < 0.42) {
      ctx.save();
      ctx.strokeStyle = 'rgba(226,232,240,.7)'; ctx.lineWidth = 4; ctx.lineCap = 'round';
      for (let i = 0; i < 4; i++) {
        const yy = f.y - 30 - i * 22;
        ctx.beginPath(); ctx.moveTo(f.x - f.face * 40, yy); ctx.lineTo(f.x - f.face * (110 + i * 12), yy); ctx.stroke();
      }
      ctx.restore();
    }
    if (f.state === 'block') {
      ctx.save();
      ctx.strokeStyle = 'rgba(147,197,253,.85)'; ctx.lineWidth = 6;
      ctx.beginPath();
      if (f.face > 0) ctx.arc(f.x + 8, f.y - 60, 62, -1.1, 1.1); else ctx.arc(f.x - 8, f.y - 60, 62, Math.PI - 1.1, Math.PI + 1.1);
      ctx.stroke();
      ctx.restore();
    }
  }

  function drawProj(q: Proj) {
    if (q.kind === 'fire') {
      const g = ctx.createRadialGradient(q.x, q.y, 2, q.x, q.y, q.r * 1.8);
      g.addColorStop(0, '#ffffff'); g.addColorStop(0.35, '#fde047'); g.addColorStop(0.7, '#f97316'); g.addColorStop(1, 'rgba(220,38,38,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(q.x, q.y, q.r * 1.8, 0, Math.PI * 2); ctx.fill();
    } else {
      const d = Math.sign(q.vx);
      ctx.save();
      ctx.lineCap = 'round';
      ctx.strokeStyle = 'rgba(134,239,172,.6)'; ctx.lineWidth = 8;
      ctx.beginPath(); ctx.moveTo(q.x - d * 50, q.y); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(q.x - d * 50, q.y); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.moveTo(q.x + d * 12, q.y); ctx.lineTo(q.x, q.y - 6); ctx.lineTo(q.x, q.y + 6); ctx.closePath(); ctx.fill();
      ctx.restore();
    }
  }

  function rrect(x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
  }

  function drawBar(f: F, x: number, flip: boolean) {
    const w = 340, h = 22, y = 18;
    ctx.fillStyle = 'rgba(15,23,42,.85)'; rrect(x - 3, y - 3, w + 6, h + 6, 10); ctx.fill();
    const fillW = (pct: number) => (w * Math.max(0, pct)) / 100;
    const draw = (pct: number, color: string | CanvasGradient) => {
      const fw = fillW(pct);
      ctx.fillStyle = color;
      rrect(flip ? x + w - fw : x, y, fw, h, 7); ctx.fill();
    };
    draw(f.shown, '#fde68a');
    const col = f.hp > 50 ? '#22c55e' : f.hp > 25 ? '#eab308' : '#ef4444';
    draw(f.hp, col);
    // Thanh nộ
    const ready = f.energy >= COST;
    const ew = 170, eh = 9, ey = y + h + 8, ex = flip ? x + w - ew : x;
    ctx.fillStyle = 'rgba(15,23,42,.85)'; rrect(ex - 2, ey - 2, ew + 4, eh + 4, 6); ctx.fill();
    ctx.fillStyle = ready ? (Math.floor(clock * 6) % 2 ? '#7dd3fc' : '#38bdf8') : '#0ea5e9';
    const efw = (ew * f.energy) / 100;
    rrect(flip ? ex + ew - efw : ex, ey, efw, eh, 4); ctx.fill();
    // Tên
    ctx.fillStyle = '#fff'; ctx.font = 'bold 15px ' + FONT; ctx.textBaseline = 'top';
    ctx.textAlign = flip ? 'right' : 'left';
    ctx.fillText(ui.heroes[f.skin].name + (ready ? '  ⚡' : ''), flip ? x + w : x, ey + 16);
  }

  function drawHud() {
    drawBar(p, 24, false);
    drawBar(c, W - 24 - 340, true);
    ctx.fillStyle = 'rgba(15,23,42,.85)'; rrect(W / 2 - 32, 14, 64, 42, 10); ctx.fill();
    ctx.fillStyle = timer < 10 ? '#fca5a5' : '#fff'; ctx.font = 'bold 26px ' + FONT;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(String(Math.ceil(timer)), W / 2, 36);
    for (let i = 0; i < 2; i++) {
      ctx.fillStyle = wins[0] > i ? '#fde047' : 'rgba(15,23,42,.7)';
      ctx.strokeStyle = '#fde047'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(W / 2 - 26 - i * 18, 72, 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = wins[1] > i ? '#fde047' : 'rgba(15,23,42,.7)';
      ctx.beginPath(); ctx.arc(W / 2 + 26 + i * 18, 72, 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    }
    let text = '', age = 0;
    if (phase === 'intro') { text = phaseT > 0.8 ? ui.round + ' ' + round : ui.go; age = phaseT > 0.8 ? 1.9 - phaseT : 0.8 - phaseT; }
    else if (phase === 'ko') { text = koText; age = 2.4 - phaseT; }
    if (text) {
      const sc = 1 + Math.max(0, 0.25 - age) * 2;
      ctx.save();
      ctx.translate(W / 2, 190); ctx.scale(sc, sc);
      ctx.font = 'bold 68px ' + FONT; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.lineWidth = 9; ctx.strokeStyle = 'rgba(15,23,42,.9)'; ctx.strokeText(text, 0, 0);
      ctx.fillStyle = phase === 'ko' ? '#fca5a5' : '#fde047'; ctx.fillText(text, 0, 0);
      ctx.restore();
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    if (shake > 0) ctx.translate((Math.random() - 0.5) * shake * 30, (Math.random() - 0.5) * shake * 30);
    ctx.drawImage(bg, 0, 0);
    // Võ sĩ đang ra đòn được vẽ sau để nằm trên
    const order = c.state === 'attack' || c.state === 'special' ? [p, c] : [c, p];
    order.forEach(drawFighter);
    projs.forEach(drawProj);
    for (const q of particles) {
      ctx.globalAlpha = Math.max(0, q.life / q.max);
      ctx.fillStyle = q.color;
      ctx.fillRect(q.x - q.size / 2, q.y - q.size / 2, q.size, q.size);
    }
    ctx.globalAlpha = 1;
    ctx.restore();
    drawHud();
  }

  function frame(now: number) {
    if (!running) { draw(); return; }
    const dt = Math.max(0, Math.min(0.05, (now - last) / 1000));
    last = now;
    update(dt);
    draw();
    raf = requestAnimationFrame(frame);
  }

  // ---------- Điều khiển ----------
  const KEY_HOLD: Record<string, keyof typeof held> = {
    ArrowLeft: 'left', a: 'left', A: 'left', ArrowRight: 'right', d: 'right', D: 'right',
    ArrowUp: 'jump', w: 'jump', W: 'jump', ArrowDown: 'block', s: 'block', S: 'block',
  };
  const KEY_PRESS: Record<string, keyof typeof press> = {
    j: 'light', J: 'light', z: 'light', Z: 'light',
    k: 'heavy', K: 'heavy', x: 'heavy', X: 'heavy',
    l: 'special', L: 'special', c: 'special', C: 'special',
  };
  window.addEventListener('keydown', (e) => {
    if (!running || e.ctrlKey || e.metaKey || e.altKey) return;
    const h = KEY_HOLD[e.key], pr = KEY_PRESS[e.key];
    if (h) { e.preventDefault(); held[h] = true; }
    else if (pr) { e.preventDefault(); if (!e.repeat) press[pr] = true; }
    else if (e.key === ' ') e.preventDefault();
  });
  window.addEventListener('keyup', (e) => {
    const h = KEY_HOLD[e.key];
    if (h) held[h] = false;
  });
  window.addEventListener('blur', () => { held.left = held.right = held.jump = held.block = false; });

  document.querySelectorAll<HTMLButtonElement>('[data-hold]').forEach((btn) => {
    const k = btn.dataset.hold as keyof typeof held;
    btn.addEventListener('pointerdown', (e) => { e.preventDefault(); held[k] = true; });
    ['pointerup', 'pointerleave', 'pointercancel'].forEach((ev) => btn.addEventListener(ev, () => { held[k] = false; }));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-press]').forEach((btn) => {
    const k = btn.dataset.press as keyof typeof press;
    btn.addEventListener('pointerdown', (e) => { e.preventDefault(); press[k] = true; });
  });

  // ---------- Menu ----------
  const heroBtns = document.querySelectorAll<HTMLButtonElement>('.fg-hero');
  function markHero() {
    heroBtns.forEach((btn, i) => {
      btn.classList.toggle('sel', i === hero);
      btn.setAttribute('aria-pressed', String(i === hero));
    });
  }
  heroBtns.forEach((btn, i) => {
    const g = btn.querySelector('canvas')!.getContext('2d')!;
    g.translate(48, 58); g.scale(1.6, 1.6);
    paintHero(g, i, { fx: 1, fy: 0, moving: false, s: 1, human: false }, 0);
    btn.addEventListener('click', () => {
      hero = i;
      try { localStorage.setItem('fight-hero', String(i)); } catch {}
      markHero();
    });
  });
  markHero();
  renderStats();

  document.querySelectorAll<HTMLButtonElement>('.fg-level').forEach((btn) => {
    btn.addEventListener('click', () => startMatch(btn.dataset.level || 'normal'));
  });
  document.getElementById('fg-again')!.addEventListener('click', () => startMatch(level));
  document.getElementById('fg-change')!.addEventListener('click', () => {
    running = false;
    cancelAnimationFrame(raf);
    gameEl.hidden = true;
    menu.hidden = false;
    renderStats();
  });
</script>

<style is:global>
  #fg-menu[hidden], #fg-game[hidden], #fg-result[hidden] { display: none; }
  .fg-h { font-size: 1.05rem; margin: 22px 0 8px; }
  .fg-heroes { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .fg-hero { background: var(--card); color: var(--fg); border: 2px solid var(--line); border-radius: 16px; padding: 10px 8px 12px; cursor: pointer; font: inherit; display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; }
  .fg-hero:hover { border-color: var(--accent); }
  .fg-hero.sel { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent); }
  .fg-hero canvas { width: 96px; height: 100px; background: linear-gradient(#312e81, #7c3aed 60%, #f97316); border-radius: 12px; margin-bottom: 4px; }
  .fg-hero span { color: var(--muted); font-size: .82rem; line-height: 1.35; }
  .fg-hero small { color: var(--accent); font-size: .76rem; line-height: 1.35; margin-top: 4px; }
  .fg-levels { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin: 6px 0 14px; }
  .fg-level { text-align: left; background: var(--card); color: var(--fg); border: 1px solid var(--line); border-top: 4px solid #16a34a; border-radius: 16px; padding: 16px 18px; cursor: pointer; font: inherit; display: flex; flex-direction: column; gap: 2px; }
  .fg-level:hover { border-color: var(--accent); }
  .fg-level b { font-size: 1.15rem; }
  .fg-level span { color: var(--muted); font-size: .9rem; }
  .fg-level.fg-normal { border-top-color: #f59e0b; }
  .fg-level.fg-hard { border-top-color: #dc2626; }
  .fg-stat { font-style: normal; font-size: .8rem; color: var(--badge); font-weight: 600; margin-top: 4px; min-height: 1.2em; }
  #fg-canvas { width: 100%; height: auto; display: block; border-radius: 16px; border: 3px solid #1e1b4b; background: #1e1b4b; box-shadow: 0 10px 30px rgba(0,0,0,.3); touch-action: none; margin-top: 18px; }
  .fg-pad { display: none; justify-content: space-between; align-items: center; margin-top: 14px; gap: 10px; user-select: none; -webkit-user-select: none; }
  @media (pointer: coarse) { .fg-pad { display: flex; } }
  .fg-dpad { display: grid; grid-template-columns: repeat(2, 64px); grid-template-rows: repeat(2, 56px); gap: 6px; }
  .fg-dpad button, .fg-acts button { background: var(--card); color: var(--fg); border: 1px solid var(--line); border-radius: 14px; font: inherit; font-size: 1.1rem; touch-action: none; }
  .fg-dpad button:active, .fg-acts button:active { background: var(--accent); color: var(--on-accent); }
  .fg-acts { display: grid; grid-template-columns: repeat(2, 84px); grid-template-rows: repeat(2, 56px); gap: 6px; }
  .fg-acts button { font-size: .9rem; font-weight: 700; }
  .fg-acts .sp { grid-column: 1 / span 2; border-color: #f59e0b; background: color-mix(in srgb, #f59e0b 22%, var(--card)); }
  .fg-result { text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 22px 16px; margin-top: 16px; }
  .fg-big { font-size: 2rem; font-weight: 800; }
  .fg-big.win { color: #16a34a; }
  .fg-big.lose { color: #dc2626; }
  .fg-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 12px; }
</style>
