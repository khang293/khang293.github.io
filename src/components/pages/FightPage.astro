  const bgs: Record<string, HTMLCanvasElement> = { temple: buildBg('temple'), spirit: buildBg('spirit') };

  function drawFighter(f: F) {
    const air = Math.max(0, GY - f.y);
    ctx.fillStyle = 'rgba(0,0,0,.38)';
    ctx.beginPath(); ctx.ellipse(f.x, GY + 2, Math.max(12, 38 - air / 9), 8, 0, 0, Math.PI * 2); ctx.fill();

    let ox = 0, rot = 0, sy = 1, alpha = 1;
    if (f.state === 'attack') {
      const a = ATK[f.kind as 'light'], pre = a.pre * HEROES[f.skin].haste;
      if (f.st >= pre && f.st < pre + a.act) ox = f.face * a.lunge * 0.5;
      rot = f.face * (f.st < pre ? -0.08 : 0.14);
    } else if (f.state === 'hit') {
      rot = -f.face * 0.2;
      if (Math.floor(clock * 30) % 2) alpha = 0.6;
    } else if (f.state === 'block') sy = 0.93;
    else if (f.state === 'special') {
      if (f.move === 'dash' || (f.move === 'sig' && f.skin === 0)) rot = f.face * 0.3;
      else if (f.move === 'ult') rot = f.st < 0.3 ? -f.face * 0.12 : f.face * 0.2;
      else rot = -f.face * 0.1;
    }
    // Hào quang khi gồng tuyệt kỹ
    if (f.state === 'special' && f.move === 'ult' && f.st < 0.4) {
      const k = ctx.createRadialGradient(f.x, f.y - 55, 6, f.x, f.y - 55, 78);
      k.addColorStop(0, 'rgba(255,255,255,.55)'); k.addColorStop(0.5, COLORS[f.skin] + '88'); k.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = k; ctx.beginPath(); ctx.arc(f.x, f.y - 55, 78, 0, Math.PI * 2); ctx.fill();
    }
    ctx.save();
    ctx.globalAlpha = alpha * (f.skin === 3 ? f.vis : 1);
    ctx.translate(f.x + ox, f.y - (f.ko ? 30 : 0));
    ctx.rotate(f.ko ? -f.face * 1.5 : rot);
    ctx.translate(0, -52);
    ctx.scale(f.face * S, S * sy);
    paint(ctx, f.skin, { fx: 1, fy: 0, moving: f.state === 'walk' && f.grounded, s: 1, human: false }, clock);
    ctx.restore();

    // Hiệu ứng đòn đánh
    if (f.state === 'attack') {
      const a = ATK[f.kind as 'light'], pre = a.pre * HEROES[f.skin].haste, dur = a.act * 1.8;
      if (f.st >= pre && f.st < pre + dur) {
        const pr = (f.st - pre) / dur;
        ctx.save();
        ctx.translate(f.x + f.face * (30 + a.reach * 0.3), f.y - 62);
        ctx.scale(f.face, 1);
        ctx.strokeStyle = COLORS[f.skin];
        ctx.globalAlpha = 1 - pr;
        ctx.lineWidth = (f.kind === 'heavy' ? 14 : 8) * (1 - pr * 0.5);
        ctx.lineCap = 'round';
        ctx.beginPath(); ctx.arc(-10, 0, a.reach * 0.55, -1.15 + pr * 0.4, 1.15 + pr * 0.4); ctx.stroke();
        ctx.restore();
      }
    }
    if (f.state === 'special' && (f.move === 'dash' || (f.move === 'sig' && f.skin === 0)) && f.st > 0.06 && f.st < 0.42) {
      ctx.save();
      ctx.strokeStyle = 'rgba(226,232,240,.7)'; ctx.lineWidth = 4; ctx.lineCap = 'round';
      for (let i = 0; i < 4; i++) {
        const yy = f.y - 30 - i * 22;
        ctx.beginPath(); ctx.moveTo(f.x - f.face * 40, yy); ctx.lineTo(f.x - f.face * (110 + i * 12), yy); ctx.stroke();
      }
      ctx.restore();
    }
    if (f.state === 'block') {
      ctx.save();
      ctx.strokeStyle = 'rgba(147,197,253,.85)'; ctx.lineWidth = 6;
      ctx.beginPath();
      if (f.face > 0) ctx.arc(f.x + 8, f.y - 60, 62, -1.1, 1.1); else ctx.arc(f.x - 8, f.y - 60, 62, Math.PI - 1.1, Math.PI + 1.1);
      ctx.stroke();
      ctx.restore();
    }
  }

  function drawProj(q: Proj) {
    const d = Math.sign(q.vx) || 1;
    const glow = (r: number, c0: string, c1: string, c2: string) => {
      const g = ctx.createRadialGradient(q.x, q.y, 2, q.x, q.y, r);
      g.addColorStop(0, c0); g.addColorStop(0.4, c1); g.addColorStop(1, c2);
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(q.x, q.y, r, 0, Math.PI * 2); ctx.fill();
    };
    if (q.kind === 'fire') glow(q.r * 1.8, '#ffffff', '#fde047', 'rgba(220,38,38,0)');
    else if (q.kind === 'dragon') {
      for (let i = 0; i < 5; i++) {
        const xx = q.x - d * i * 26, rr = q.r * (1 - i * 0.14);
        const g = ctx.createRadialGradient(xx, q.y, 2, xx, q.y, rr * 1.6);
        g.addColorStop(0, '#ffffff'); g.addColorStop(0.35, '#fde047'); g.addColorStop(0.7, '#f97316'); g.addColorStop(1, 'rgba(220,38,38,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(xx, q.y, rr * 1.6, 0, Math.PI * 2); ctx.fill();
      }
    } else if (q.kind === 'meteor') {
      ctx.save(); ctx.strokeStyle = 'rgba(251,146,60,.7)'; ctx.lineWidth = 14; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(q.x, q.y - 70); ctx.lineTo(q.x, q.y); ctx.stroke(); ctx.restore();
      glow(q.r * 1.7, '#ffffff', '#fde047', 'rgba(249,115,22,0)');
    } else if (q.kind === 'orb' || q.kind === 'seal') {
      glow(q.r * 1.8, '#ffffff', '#7dd3fc', 'rgba(56,189,248,0)');
      if (q.kind === 'seal') {
        ctx.strokeStyle = '#fde047'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(q.x, q.y, q.r * 1.1, clock * 4, clock * 4 + 4.2); ctx.stroke();
      }
    } else if (q.kind === 'wind' || q.kind === 'moon') {
      const big = q.kind === 'moon';
      ctx.save(); ctx.translate(q.x, q.y); ctx.scale(d, 1);
      ctx.lineCap = 'round';
      ctx.strokeStyle = big ? 'rgba(224,242,254,.55)' : 'rgba(94,234,212,.55)'; ctx.lineWidth = q.r * 0.9;
      ctx.beginPath(); ctx.arc(-q.r * 0.6, 0, q.r * 1.8, -1.0, 1.0); ctx.stroke();
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = q.r * 0.28;
      ctx.beginPath(); ctx.arc(-q.r * 0.6, 0, q.r * 1.8, -1.0, 1.0); ctx.stroke();
      ctx.restore();
    } else if (q.kind === 'tornado') {
      ctx.save(); ctx.translate(q.x, q.y + 30);
      for (let i = 0; i < 6; i++) {
        const yy = -i * 22, w = q.r * (0.45 + i * 0.13);
        ctx.strokeStyle = `rgba(94,234,212,${0.85 - i * 0.1})`; ctx.lineWidth = 5; ctx.lineCap = 'round';
        ctx.beginPath(); ctx.ellipse(Math.sin(clock * 12 + i) * 5, yy, w, 8, 0, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.restore();
    } else if (q.kind === 'rain') {
      ctx.save(); ctx.lineCap = 'round';
      ctx.strokeStyle = 'rgba(134,239,172,.6)'; ctx.lineWidth = 8;
      ctx.beginPath(); ctx.moveTo(q.x, q.y - 46); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(q.x, q.y - 46); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.restore();
    } else { // arrow
      ctx.save();
      ctx.lineCap = 'round';
      ctx.strokeStyle = 'rgba(134,239,172,.6)'; ctx.lineWidth = 8;
      ctx.beginPath(); ctx.moveTo(q.x - d * 50, q.y); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(q.x - d * 50, q.y); ctx.lineTo(q.x, q.y); ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.moveTo(q.x + d * 12, q.y); ctx.lineTo(q.x, q.y - 6); ctx.lineTo(q.x, q.y + 6); ctx.closePath(); ctx.fill();
      ctx.restore();
    }
  }

  function rrect(x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
  }

  function drawBar(f: F, x: number, flip: boolean) {
    const w = 340, h = 22, y = 18;
    // khung
    ctx.fillStyle = 'rgba(8,12,28,.9)'; rrect(x - 4, y - 4, w + 8, h + 8, 11); ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,.2)'; ctx.lineWidth = 1.5; rrect(x - 4, y - 4, w + 8, h + 8, 11); ctx.stroke();
    ctx.fillStyle = 'rgba(255,255,255,.07)'; rrect(x, y, w, h, 7); ctx.fill();
    const fillW = (pct: number) => (w * Math.max(0, pct)) / 100;
    const draw = (pct: number, c0: string, c1: string) => {
      const fw = fillW(pct);
      if (fw < 1) return;
      const gr = ctx.createLinearGradient(0, y, 0, y + h);
      gr.addColorStop(0, c0); gr.addColorStop(1, c1);
      ctx.fillStyle = gr;
      rrect(flip ? x + w - fw : x, y, fw, h, 7); ctx.fill();
    };
    draw(f.shown, '#fff7d6', '#fbbf24'); // thanh máu mất, tụt chậm phía sau
    ctx.globalAlpha = f.hp <= 25 && f.hp > 0 ? 0.72 + 0.28 * Math.sin(clock * 10) : 1;
    if (f.hp > 50) draw(f.hp, '#4ade80', '#15803d'); else if (f.hp > 25) draw(f.hp, '#fde047', '#ca8a04'); else draw(f.hp, '#f87171', '#b91c1c');
    ctx.globalAlpha = 1;
    const gw = fillW(f.hp);
    if (gw > 3) { ctx.fillStyle = 'rgba(255,255,255,.25)'; rrect(flip ? x + w - gw + 2 : x + 2, y + 2, gw - 4, h / 2 - 2, 5); ctx.fill(); }
    ctx.fillStyle = 'rgba(8,12,28,.42)';
    for (let i = 1; i < 10; i++) ctx.fillRect(x + (w * i) / 10 - 1, y, 2, h);
    // Thanh nộ: nhấp nháy khi dùng được chiêu, đổi màu khi đủ 100 cho tuyệt kỹ
    const sig = f.energy >= COST.sig, full = f.energy >= COST.ult;
    const ew = 170, eh = 9, ey = y + h + 8, ex = flip ? x + w - ew : x;
    ctx.fillStyle = 'rgba(8,12,28,.9)'; rrect(ex - 2, ey - 2, ew + 4, eh + 4, 6); ctx.fill();
    const efw = (ew * f.energy) / 100;
    if (efw > 1) {
      const eg = ctx.createLinearGradient(0, ey, 0, ey + eh);
      if (full) { const b = Math.floor(clock * 8) % 2; eg.addColorStop(0, b ? '#fef08a' : '#fcd34d'); eg.addColorStop(1, b ? '#f59e0b' : '#d97706'); }
      else if (sig) { const b = Math.floor(clock * 6) % 2; eg.addColorStop(0, b ? '#bae6fd' : '#7dd3fc'); eg.addColorStop(1, '#0284c7'); }
      else { eg.addColorStop(0, '#38bdf8'); eg.addColorStop(1, '#0369a1'); }
      ctx.save();
      if (full) { ctx.shadowColor = '#fbbf24'; ctx.shadowBlur = 10; }
      ctx.fillStyle = eg; rrect(flip ? ex + ew - efw : ex, ey, efw, eh, 4); ctx.fill();
      ctx.restore();
    }
    // Tên và chấm màu của nhân vật
    ctx.font = 'bold 15px ' + FONT; ctx.textBaseline = 'top';
    ctx.textAlign = flip ? 'right' : 'left';
    const tx = flip ? x + w - 16 : x + 16, ty = ey + 16;
    ctx.fillStyle = COLORS[f.skin]; ctx.beginPath(); ctx.arc(flip ? x + w - 6 : x + 6, ty + 9, 5, 0, Math.PI * 2); ctx.fill();
    ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(8,12,28,.85)';
    const nm = ui.heroes[f.skin].name + (full ? '  🌟' : sig ? '  ⚡' : '');
    ctx.strokeText(nm, tx, ty); ctx.fillStyle = '#fff'; ctx.fillText(nm, tx, ty);
  }

  function drawHud() {
    drawBar(p, 24, false);
    drawBar(c, W - 24 - 340, true);
    ctx.fillStyle = 'rgba(15,23,42,.85)'; rrect(W / 2 - 32, 14, 64, 42, 10); ctx.fill();
    ctx.fillStyle = timer < 10 ? '#fca5a5' : '#fff'; ctx.font = 'bold 26px ' + FONT;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(String(Math.ceil(timer)), W / 2, 36);
    for (let i = 0; i < 2; i++) {
      ctx.fillStyle = wins[0] > i ? '#fde047' : 'rgba(15,23,42,.7)';
      ctx.strokeStyle = '#fde047'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(W / 2 - 26 - i * 18, 72, 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = wins[1] > i ? '#fde047' : 'rgba(15,23,42,.7)';
      ctx.beginPath(); ctx.arc(W / 2 + 26 + i * 18, 72, 6, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    }
    for (const q of pops) {
      ctx.save();
      ctx.globalAlpha = Math.min(1, q.t / 0.4);
      ctx.font = 'bold 28px ' + FONT; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.lineWidth = 5; ctx.strokeStyle = 'rgba(15,23,42,.9)'; ctx.strokeText(q.text, q.x, q.y);
      ctx.fillStyle = '#fb923c'; ctx.fillText(q.text, q.x, q.y);
      ctx.restore();
    }
    let text = '', age = 0;
    if (phase === 'intro') { text = phaseT > 0.8 ? ui.round + ' ' + round : ui.go; age = phaseT > 0.8 ? 1.9 - phaseT : 0.8 - phaseT; }
    else if (phase === 'ko') { text = koText; age = 2.4 - phaseT; }
    if (text) {
      const sc = 1 + Math.max(0, 0.25 - age) * 2;
      ctx.save();
      ctx.translate(W / 2, 190); ctx.scale(sc, sc);
      ctx.font = 'bold 68px ' + FONT; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.lineWidth = 9; ctx.strokeStyle = 'rgba(15,23,42,.9)'; ctx.strokeText(text, 0, 0);
      ctx.fillStyle = phase === 'ko' ? '#fca5a5' : '#fde047'; ctx.fillText(text, 0, 0);
      ctx.restore();
    }
  }

  // ---------- Lớp nền nhiều tầng (parallax), sương, đom đóm và cỏ phía trước ----------
  const vign = (() => {
    const cv = document.createElement('canvas'); cv.width = W; cv.height = H;
    const g = cv.getContext('2d')!;
    const k = g.createRadialGradient(W / 2, H / 2, H * 0.45, W / 2, H / 2, W * 0.66);
    k.addColorStop(0, 'rgba(0,0,0,0)'); k.addColorStop(1, 'rgba(0,0,0,.5)');
    g.fillStyle = k; g.fillRect(0, 0, W, H);
    return cv;
  })();
  const camX = () => (p && c ? (p.x + c.x) / 2 - W / 2 : 0);
  const wrap = (v: number, m: number) => ((v % m) + m) % m;

  function drawBgLayers() {
    const cam = camX();
    // nền xa: dịch chuyển rất chậm và kéo giãn nhẹ để không lộ mép
    ctx.drawImage(bgs[stage], 0, 0, W, H, -cam * 0.05 - 20, 0, W + 40, H);
    // sương trôi ở tầng giữa
    const fogCol = stage === 'spirit' ? '120,230,220' : '255,220,200';
    for (let i = 0; i < 5; i++) {
      const fx0 = wrap(i * 260 + clock * (8 + (i % 3) * 5) - cam * 0.18, W + 520) - 260;
      const fy0 = GY - 30 - (i % 3) * 52;
      ctx.save();
      ctx.translate(fx0, fy0); ctx.scale(3.4, 0.55);
      const g = ctx.createRadialGradient(0, 0, 4, 0, 0, 80);
      g.addColorStop(0, `rgba(${fogCol},${stage === 'spirit' ? 0.13 : 0.09})`); g.addColorStop(1, `rgba(${fogCol},0)`);
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(0, 0, 80, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
    }
  }
  function drawAmbient() {
    const cam = camX();
    const spirit = stage === 'spirit';
    for (let i = 0; i < 22; i++) {
      const sp = 8 + (i % 5) * 5;
      let x, y;
      if (spirit) { x = wrap(i * 97 + Math.sin(clock * 0.6 + i) * 30 - cam * 0.25, W + 40) - 20; y = 60 + wrap(i * 53, 300) + Math.sin(clock * 0.9 + i * 1.7) * 18; }
      else { x = wrap(i * 83 + clock * sp - cam * 0.25, W + 40) - 20; y = H - wrap(clock * (16 + (i % 4) * 8) + i * 47, H); }
      const tw = 0.35 + 0.35 * Math.sin(clock * 3 + i * 2.1);
      ctx.fillStyle = spirit ? `rgba(167,243,208,${tw})` : `rgba(253,186,116,${tw})`;
      ctx.beginPath(); ctx.arc(x, y, spirit ? 2.6 : 1.8, 0, Math.PI * 2); ctx.fill();
    }
  }
  function drawForeground() {
    const cam = camX();
    ctx.fillStyle = stage === 'spirit' ? '#031017' : '#120826';
    for (let i = 0; i < 44; i++) {
      const x = wrap(i * 22 - cam * 0.55, W + 60) - 30;
      const h = 14 + ((i * 37) % 26), sway = Math.sin(clock * 1.6 + i) * 4;
      ctx.beginPath(); ctx.moveTo(x - 6, H); ctx.quadraticCurveTo(x - 1, H - h * 0.6, x + sway, H - h); ctx.quadraticCurveTo(x + 2, H - h * 0.5, x + 7, H); ctx.closePath(); ctx.fill();
    }
  }
  function drawFx() {
    for (const q of fx) {
      const k = 1 - q.t / q.max;
      ctx.save();
      if (q.kind === 'ring') {
        ctx.globalAlpha = 1 - k; ctx.strokeStyle = q.color; ctx.lineWidth = 2 + 7 * (1 - k);
        ctx.beginPath(); ctx.ellipse(q.x, q.y, q.r * (0.25 + k * 0.85), q.r * (0.25 + k * 0.85) * 0.7, 0, 0, Math.PI * 2); ctx.stroke();
      } else {
        ctx.globalAlpha = 1 - k;
        const g = ctx.createRadialGradient(q.x, q.y, 2, q.x, q.y, q.r * (0.5 + k * 0.6));
        g.addColorStop(0, '#ffffff'); g.addColorStop(0.35, q.color); g.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(q.x, q.y, q.r * (0.5 + k * 0.6), 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 3; ctx.lineCap = 'round';
        for (let i = 0; i < 8; i++) {
          const a = (i / 8) * Math.PI * 2 + q.x, r0 = q.r * (0.3 + k * 0.5), r1 = r0 + q.r * 0.35 * (1 - k);
          ctx.beginPath(); ctx.moveTo(q.x + Math.cos(a) * r0, q.y + Math.sin(a) * r0); ctx.lineTo(q.x + Math.cos(a) * r1, q.y + Math.sin(a) * r1); ctx.stroke();
        }
      }
      ctx.restore();
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    if (shake > 0) ctx.translate((Math.random() - 0.5) * shake * 30, (Math.random() - 0.5) * shake * 30);
    // Zoom nhẹ vào người tung tuyệt kỹ
    for (const f of [p, c]) {
      if (f.state === 'special' && f.move === 'ult' && f.st < 0.5) {
        const z = 1 + 0.12 * Math.sin(Math.min(1, f.st / 0.5) * Math.PI), zy = GY - 60;
        ctx.translate(f.x, zy); ctx.scale(z, z); ctx.translate(-f.x, -zy);
      }
    }
    drawBgLayers();
    // Võ sĩ đang ra đòn được vẽ sau để nằm trên
    const order = c.state === 'attack' || c.state === 'special' ? [p, c] : [c, p];
    order.forEach(drawFighter);
    for (const b of beams) {
      const a = Math.min(1, b.t / 0.25);
      const lo = Math.min(b.x0, b.x1), hi = Math.max(b.x0, b.x1);
      const g = ctx.createLinearGradient(0, b.y - 36, 0, b.y + 36);
      g.addColorStop(0, 'rgba(224,242,254,0)'); g.addColorStop(0.5, `rgba(255,255,255,${a})`); g.addColorStop(1, 'rgba(224,242,254,0)');
      ctx.fillStyle = g; ctx.fillRect(lo, b.y - 36, hi - lo, 72);
    }
    projs.forEach(drawProj);
    for (const q of particles) {
      ctx.globalAlpha = Math.max(0, q.life / q.max);
      ctx.fillStyle = q.color;
      ctx.fillRect(q.x - q.size / 2, q.y - q.size / 2, q.size, q.size);
    }
    ctx.globalAlpha = 1;
    drawFx();
    drawAmbient();
    drawForeground();
    ctx.restore();
    ctx.drawImage(vign, 0, 0);
    if (flashA > 0) { ctx.fillStyle = `rgba(255,255,255,${Math.min(0.6, flashA)})`; ctx.fillRect(0, 0, W, H); }
    drawHud();
  }

  function frame(now: number) {
    if (!running) { draw(); return; }
    const dt = Math.max(0, Math.min(0.05, (now - last) / 1000));
    last = now;
    update(dt);
    draw();
    raf = requestAnimationFrame(frame);
  }

  // Chỉ dùng để kiểm thử: thêm #debug vào địa chỉ trang
  if (location.hash === '#debug') {
    (window as any).__fg = {
      step(n: number, h?: Record<string, boolean>, pr?: string[]) {
        for (let i = 0; i < n; i++) {
          if (h) { held.left = !!h.left; held.right = !!h.right; held.jump = !!h.jump; held.block = !!h.block; }
          if (pr && i === 0) for (const k of pr) (press as any)[k] = true;
          update(1 / 60);
        }
        draw();
      },
      get p() { return p; }, get c() { return c; }, get phase() { return phase; },
      give() { p.energy = 100; c.energy = 100; },
      png() { return canvas.toDataURL('image/png'); },
    };
  }

  // ---------- Điều khiển ----------
  const KEY_HOLD: Record<string, keyof typeof held> = {
    ArrowLeft: 'left', a: 'left', A: 'left', ArrowRight: 'right', d: 'right', D: 'right',
    ArrowUp: 'jump', w: 'jump', W: 'jump', ArrowDown: 'block', s: 'block', S: 'block',
  };
  const DIR_OF: Record<keyof typeof held, string> = { left: 'L', right: 'R', jump: 'U', block: 'D' };
  const KEY_PRESS: Record<string, keyof typeof press> = {
    j: 'light', J: 'light', z: 'light', Z: 'light',
    k: 'heavy', K: 'heavy', x: 'heavy', X: 'heavy',
    l: 'special', L: 'special', c: 'special', C: 'special',
    i: 'ult', I: 'ult', v: 'ult', V: 'ult',
  };
  window.addEventListener('keydown', (e) => {
    if (!running || e.ctrlKey || e.metaKey || e.altKey) return;
    const h = KEY_HOLD[e.key], pr = KEY_PRESS[e.key];
    if (h) { e.preventDefault(); if (!held[h] && !e.repeat) pushDir(DIR_OF[h]); held[h] = true; }
    else if (pr) { e.preventDefault(); if (!e.repeat) press[pr] = true; }
    else if (e.key === ' ') e.preventDefault();
  });
  window.addEventListener('keyup', (e) => {
    const h = KEY_HOLD[e.key];
    if (h) held[h] = false;
  });
  window.addEventListener('blur', () => { held.left = held.right = held.jump = held.block = false; });

  // Cần điều khiển tròn: kéo trái/phải để đi, lên để nhảy, xuống để đỡ đòn. Kéo lần lượt các hướng để ra chiêu kết hợp.
  let joyCat = '';
  createJoystick(document.getElementById('fg-joy') as HTMLElement, (x, y) => {
    held.left = x < -0.35;
    held.right = x > 0.35;
    held.jump = y < -0.6;
    held.block = y > 0.6;
    const cat = Math.abs(x) >= Math.abs(y) ? (x > 0.5 ? 'R' : x < -0.5 ? 'L' : '') : y > 0.5 ? 'D' : y < -0.5 ? 'U' : '';
    if (cat && cat !== joyCat) pushDir(cat);
    joyCat = cat;
  });
  document.querySelectorAll<HTMLButtonElement>('[data-press]').forEach((btn) => {
    const k = btn.dataset.press as keyof typeof press;
    btn.addEventListener('pointerdown', (e) => { e.preventDefault(); press[k] = true; });
  });

  // ---------- Menu ----------
  const heroBtns = document.querySelectorAll<HTMLButtonElement>('.fg-hero');
  function markHero() {
    heroBtns.forEach((btn) => {
      const on = Number(btn.dataset.hero) === hero;
      btn.classList.toggle('sel', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  }
  heroBtns.forEach((btn) => {
    const i = Number(btn.dataset.hero);
    const g = btn.querySelector('canvas')!.getContext('2d')!;
    g.translate(48, 58); g.scale(1.6, 1.6);
    paint(g, i, { fx: 1, fy: 0, moving: false, s: 1, human: false }, 0);
    btn.addEventListener('click', () => {
      hero = i;
      sfx.play('select');
      try { localStorage.setItem('fight-hero', String(i)); } catch {}
      markHero();
    });
  });
  markHero();
  renderStats();

  document.querySelectorAll<HTMLButtonElement>('.fg-level').forEach((btn) => {
    btn.addEventListener('click', () => { sfx.play('click'); startMatch(btn.dataset.level || 'normal'); });
  });
  document.getElementById('fg-again')!.addEventListener('click', () => { sfx.play('click'); startMatch(level); });
  document.getElementById('fg-change')!.addEventListener('click', () => {
    sfx.play('click'); sfx.music(null);
    running = false;
    cancelAnimationFrame(raf);
    gameEl.hidden = true;
    menu.hidden = false;
    renderStats();
  });
</script>

