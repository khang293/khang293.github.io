---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];
const b = g.fight;
const levels = ['easy', 'normal', 'hard'] as const;
---
<Base lang={lang} title={b.title} description={b.sub} noindex>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{b.title}</h1>
  <p class="meta">{b.sub}</p>

  <div id="fight" data-ui={JSON.stringify(b)}>
    <div id="fg-menu">
      <h2 class="fg-h">{b.pickHero}</h2>
      {b.groups.map((gr) => (
        <div class="fg-group">
          <h3 class="fg-gh">{gr.name}</h3>
          <div class="fg-heroes">
            {gr.ids.map((i) => (
              <button class="fg-hero" type="button" data-hero={i} aria-pressed="false">
                <canvas width="96" height="100" aria-hidden="true"></canvas>
                <b>{b.heroes[i].name}</b><span>{b.heroes[i].style}</span>
                <small>⚡ {b.heroes[i].special.name}: {b.heroes[i].special.desc}</small>
                <small class="ult">🌟 {b.heroes[i].ult.name}: {b.heroes[i].ult.desc}</small>
              </button>
            ))}
          </div>
        </div>
      ))}
      <h2 class="fg-h">{b.pickLevel}</h2>
      <div class="fg-levels">
        {levels.map((lv) => (
          <button class={`fg-level fg-${lv}`} type="button" data-level={lv}>
            <b>{b.levels[lv]}</b><span>{b.levelDesc[lv]}</span>
            <em class="fg-stat" data-stat={lv}></em>
          </button>
        ))}
      </div>
      <section class="fg-combos">
        <h2 class="fg-h">{b.combosTitle}</h2>
        <ul>
          {b.combos.map((c) => (
            <li><kbd>{c.keys}</kbd> <b>{c.name}</b> <span>{c.desc}</span></li>
          ))}
        </ul>
        <p class="meta">{b.combosNote}</p>
      </section>
      <p class="meta">{b.keys}</p>
    </div>

    <div id="fg-game" hidden>
      <canvas id="fg-canvas" width="800" height="450" aria-label={b.title}></canvas>
      <div class="fg-pad">
        <div class="joy" id="fg-joy" role="application" aria-label="Joystick"></div>
        <div class="fg-acts">
          <button type="button" data-press="light">👊 {b.light}</button>
          <button type="button" data-press="heavy">💥 {b.heavy}</button>
          <button type="button" data-press="special" class="sp">⚡ {b.special}</button>
          <button type="button" data-press="ult" class="ultb">🌟 {b.ultBtn}</button>
        </div>
      </div>
      <div id="fg-result" class="fg-result" hidden>
        <div class="fg-big" id="fg-msg"></div>
        <p id="fg-rec" class="meta"></p>
        <div class="fg-actions">
          <button type="button" class="btn" id="fg-again">{b.again}</button>
          <button type="button" class="btn ghost" id="fg-change">{b.change}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { paintHero, paintFighter } from '../../data/heroArt';
  import { createJoystick } from '../../data/joystick';
  import { sfx, mountMute } from '../../data/sfx';

  const root = document.getElementById('fight') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('fg-menu') as HTMLElement;
  const gameEl = document.getElementById('fg-game') as HTMLElement;
  const canvas = document.getElementById('fg-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const resultEl = document.getElementById('fg-result') as HTMLElement;
  mountMute(gameEl);
  { const mb = gameEl.querySelector('.sfx-btn') as HTMLElement | null; if (mb) { mb.style.top = '88px'; mb.style.right = '8px'; } }

  const W = 800, H = 450, GY = 388, S = 2.5;
  const FONT = 'system-ui, "Segoe UI Emoji", "Apple Color Emoji", sans-serif';
  const COST = { sig: 35, dash: 15, ult: 100 };
  const ATK = {
    light: { pre: 0.09, act: 0.11, post: 0.15, reach: 66, kb: 170, stun: 0.22, lunge: 34 },
    heavy: { pre: 0.26, act: 0.12, post: 0.32, reach: 88, kb: 380, stun: 0.42, lunge: 64 },
  };
  // 0-3: võ sĩ, 4-5: Nhẫn Giả, 6-7: Kiếm Linh. haste < 1 là ra đòn nhanh hơn.
  const HEROES = [
    { speed: 215, light: 6, heavy: 14, jump: 830, haste: 1 },
    { speed: 240, light: 5, heavy: 11, jump: 830, haste: 1 },
    { speed: 285, light: 6, heavy: 11, jump: 900, haste: 1 },
    { speed: 262, light: 7, heavy: 12, jump: 850, haste: 0.82 },
    { speed: 250, light: 6, heavy: 12, jump: 850, haste: 0.95 },
    { speed: 300, light: 5, heavy: 10, jump: 920, haste: 0.8 },
    { speed: 225, light: 7, heavy: 14, jump: 800, haste: 1.1 },
    { speed: 245, light: 5, heavy: 11, jump: 830, haste: 1 },
  ];
  const FACTION = ['classic', 'classic', 'classic', 'classic', 'ninja', 'ninja', 'spirit', 'spirit'];
  const COLORS = ['#e2e8f0', '#c4b5fd', '#86efac', '#f87171', '#fb923c', '#5eead4', '#e2e8f0', '#93c5fd'];
  // react: giây giữa hai lần máy suy nghĩ; aggr: hay tấn công; block: hay đỡ; special/ult: hay dùng chiêu
  const DIFF: Record<string, { react: number; aggr: number; block: number; special: number; ult: number; speed: number }> = {
    easy: { react: 0.5, aggr: 0.35, block: 0.15, special: 0.25, ult: 0.15, speed: 0.85 },
    normal: { react: 0.28, aggr: 0.6, block: 0.45, special: 0.55, ult: 0.4, speed: 1 },
    hard: { react: 0.12, aggr: 0.85, block: 0.75, special: 0.9, ult: 0.75, speed: 1.1 },
  };

  type Kind = '' | 'light' | 'heavy';
  interface F {
    skin: number; human: boolean;
    x: number; y: number; vx: number; vy: number; face: number;
    hp: number; shown: number; lagT: number; energy: number;
    state: string; st: number; kind: Kind; move: string; hit: boolean; stun: number; cast: number; n: number;
    comboN: number; comboT: number;
    grounded: boolean; flash: number; ko: boolean; inv: number; vis: number;
    ai: { t: number; mt: number; cool: number; mode: string; saw: boolean };
  }
  interface Inp { left: boolean; right: boolean; jump: boolean; block: boolean; light: boolean; heavy: boolean; special: boolean; dash: boolean; ult: boolean }
  interface Proj { x: number; y: number; vx: number; vy: number; dmg: number; kb: number; stun: number; kind: string; owner: F; r: number; life: number; next: number; dead: boolean }
  interface Particle { x: number; y: number; vx: number; vy: number; g: number; life: number; max: number; size: number; color: string }
  interface Pop { text: string; x: number; y: number; t: number }
  interface Beam { x0: number; x1: number; y: number; t: number; color: string }
  interface Fx { x: number; y: number; t: number; max: number; r: number; color: string; kind: 'ring' | 'burst' }
  let fx: Fx[] = [];
  let freeze = 0;      // dừng hình ngắn khi trúng đòn mạnh
  let flashA = 0;      // chớp sáng toàn màn hình
  let introGo = false;
  let lastTick = 99;

  let level = 'normal';
  let hero = 0;
  try { const h = Number(localStorage.getItem('fight-hero')); if (h >= 0 && h < HEROES.length) hero = h; } catch {}
  let foeSkin = 1;
  let stage = 'temple';
  let p: F, c: F;
  let projs: Proj[] = [];
  let particles: Particle[] = [];
  let pops: Pop[] = [];
  let beams: Beam[] = [];
  let shake = 0;
  let clock = 0;
  let timer = 60;
  let round = 1;
  let wins = [0, 0];
  let phase = 'intro';
  let phaseT = 0;
  let koText = '';
  let running = false;
  let last = 0;
  let raf = 0;
  const held = { left: false, right: false, jump: false, block: false };
  const press = { light: false, heavy: false, special: false, ult: false };
  // Bộ nhớ đệm các hướng vừa bấm, để nhận ra chiêu kết hợp phím
  const buf: { d: string; t: number }[] = [];

  const blank = (): Inp => ({ left: false, right: false, jump: false, block: false, light: false, heavy: false, special: false, dash: false, ult: false });
  const clampX = (x: number) => Math.max(40, Math.min(W - 40, x));
  const paint = (g: CanvasRenderingContext2D, skin: number, o: { fx: number; fy: number; moving: boolean; s: number; human: boolean }, t: number) =>
    (skin < 4 ? paintHero : paintFighter)(g, skin, o, t);

  function pushDir(d: string) { buf.push({ d, t: clock }); if (buf.length > 8) buf.shift(); }
  // Trong 0,55 giây gần nhất, các hướng đã bấm có chứa chuỗi seq theo đúng thứ tự không (F = về phía đối thủ)
  function seqHas(seq: string[], face: number): boolean {
    const toks = buf.filter((b) => clock - b.t < 0.55).map((b) => (b.d === 'R' ? (face > 0 ? 'F' : 'B') : b.d === 'L' ? (face > 0 ? 'B' : 'F') : b.d));
    let i = 0;
    for (const t of toks) { if (t === seq[i]) i++; if (i === seq.length) return true; }
    return false;
  }

  function makeF(skin: number, x: number, face: number, human: boolean): F {
    return {
      skin, human, x, y: GY, vx: 0, vy: 0, face, hp: 100, shown: 100, lagT: 0, energy: 20,
      state: 'idle', st: 0, kind: '', move: '', hit: false, stun: 0, cast: 0, n: 0, comboN: 0, comboT: -9,
      grounded: true, flash: 0, ko: false, inv: 0, vis: 1,
      ai: { t: 0.4, mt: 0, cool: 0.6, mode: 'idle', saw: false },
    };
  }

  function spark(x: number, y: number, n: number, colors: string[], speed: number, g = 0) {
    for (let i = 0; i < n; i++) {
      const ang = Math.random() * Math.PI * 2, v = speed * (0.4 + Math.random() * 0.8);
      const life = 0.25 + Math.random() * 0.35;
      particles.push({ x, y, vx: Math.cos(ang) * v, vy: Math.sin(ang) * v, g, life, max: life, size: 3 + Math.random() * 4, color: colors[Math.floor(Math.random() * colors.length)] });
    }
  }

  // Bụi bay lên khi đáp đất hoặc lướt
  function dust(x: number, y: number, n: number, spread: number) {
    for (let i = 0; i < n; i++) {
      const dir = i % 2 ? 1 : -1, life = 0.3 + Math.random() * 0.3;
      particles.push({ x: x + dir * Math.random() * 10, y: y - 2, vx: dir * (spread * (0.3 + Math.random() * 0.7)), vy: -20 - Math.random() * 40, g: -30, life, max: life, size: 5 + Math.random() * 6, color: i % 3 ? '#94a3b8' : '#cbd5e1' });
    }
  }
  // Âm thanh khi tung đạn, theo từng loại
  let lastRainSnd = -9;
  function projSound(kind: string) {
    if (kind === 'fire') { sfx.tone(300, 0.26, 'sawtooth', 0.13, 90); sfx.noise(0.2, 0.15, 2500); }
    else if (kind === 'dragon') { sfx.tone(120, 0.6, 'sawtooth', 0.22, 60); sfx.noise(0.6, 0.3, 2200); }
    else if (kind === 'arrow') sfx.play('shoot');
    else if (kind === 'rain') { if (clock - lastRainSnd > 0.2) { lastRainSnd = clock; sfx.play('swoosh'); sfx.tone(700, 0.4, 'triangle', 0.1, 300); } }
    else if (kind === 'meteor') { if (clock - lastRainSnd > 0.2) { lastRainSnd = clock; sfx.tone(500, 0.6, 'sawtooth', 0.12, 90); } }
    else if (kind === 'wind') sfx.play('swoosh');
    else if (kind === 'tornado') { sfx.noise(0.7, 0.25, 2000, 400); sfx.tone(130, 0.7, 'sawtooth', 0.1, 260); }
    else if (kind === 'moon') sfx.play('laser');
    else sfx.play('zap');
  }

  // ---------- Trận đấu ----------
  function startMatch(lv: string) {
    sfx.music('action');
    level = lv;
    wins = [0, 0];
    round = 1;
    const fac = FACTION[hero];
    // Nhẫn Giả đấu Kiếm Linh, các võ sĩ còn lại đấu ngẫu nhiên
    const pool = fac === 'ninja' ? [6, 7] : fac === 'spirit' ? [4, 5] : [0, 1, 2, 3, 4, 5, 6, 7].filter((i) => i !== hero);
    foeSkin = pool[Math.floor(Math.random() * pool.length)];
    stage = fac === 'spirit' ? 'spirit' : 'temple';
    resultEl.hidden = true;
    menu.hidden = true;
    gameEl.hidden = false;
    newRound();
    running = true;
    last = performance.now();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(frame);
  }

  function newRound() {
    p = makeF(hero, 210, 1, true);
    c = makeF(foeSkin, W - 210, -1, false);
    projs = []; particles = []; pops = []; beams = []; fx = []; buf.length = 0;
    freeze = 0; flashA = 0; introGo = false; lastTick = 99;
    sfx.play('count');
    timer = 60; phase = 'intro'; phaseT = 1.9; koText = '';
    held.left = held.right = held.jump = held.block = false;
    press.light = press.heavy = press.special = press.ult = false;
  }

  function endRound(reason: string) {
    if (phase !== 'fight') return;
    phase = 'ko';
    phaseT = 2.4;
    let winner = -1;
    if (p.hp <= 0 && c.hp <= 0) winner = -1;
    else if (p.hp <= 0) winner = 1;
    else if (c.hp <= 0) winner = 0;
    else if (p.hp > c.hp) winner = 0;
    else if (c.hp > p.hp) winner = 1;
    koText = reason === 'time' ? ui.timeUp : winner < 0 ? ui.drawRound : ui.ko;
    if (reason === 'time') sfx.play('wrong');
    if (winner >= 0) wins[winner]++;
  }

  function nextRound() {
    if (wins[0] >= 2 || wins[1] >= 2 || round >= 5) { finishMatch(); return; }
    round++;
    newRound();
  }

  // ---------- Thành tích ----------
  interface Stat { played: number; won: number; streak: number; bestStreak: number }
  const EMPTY: Stat = { played: 0, won: 0, streak: 0, bestStreak: 0 };
  const loadStats = (): Record<string, Stat> => { try { return JSON.parse(localStorage.getItem('fight-stats') || '{}'); } catch { return {}; } };
  const statOf = (lv: string): Stat => ({ ...EMPTY, ...loadStats()[lv] });
  function recordResult(lv: string, won: boolean): Stat {
    const all = loadStats();
    const s = { ...EMPTY, ...all[lv] };
    s.played++;
    if (won) { s.won++; s.streak++; s.bestStreak = Math.max(s.bestStreak, s.streak); } else s.streak = 0;
    all[lv] = s;
    try { localStorage.setItem('fight-stats', JSON.stringify(all)); } catch {}
    return s;
  }
  const statLine = (s: Stat) => (s.played ? ui.statWins + ' ' + s.won + '/' + s.played + ' · ' + ui.statStreak + ' ' + s.streak + ' (' + ui.statBest + ' ' + s.bestStreak + ')' : '');
  function renderStats() {
    document.querySelectorAll<HTMLElement>('.fg-stat').forEach((el) => { el.textContent = statLine(statOf(el.dataset.stat || '')); });
  }

  function finishMatch() {
    running = false;
    sfx.music(null);
    const won = wins[0] > wins[1];
    sfx.play(won ? 'win' : 'lose');
    const before = statOf(level);
    const s = recordResult(level, won);
    resultEl.hidden = false;
    const msg = document.getElementById('fg-msg')!;
    msg.textContent = won ? ui.win : ui.lose;
    msg.className = 'fg-big ' + (won ? 'win' : 'lose');
    const parts = [wins[0] + ' - ' + wins[1], statLine(s)];
    if (won && s.streak > 1 && s.streak > before.bestStreak) parts.push(ui.statNew);
    document.getElementById('fg-rec')!.textContent = parts.join(' · ');
  }

  // ---------- Chiến đấu ----------
  function meleeHit(f: F, e: F, reach: number): boolean {
    const x0 = f.face > 0 ? f.x + 14 : f.x - 14 - reach;
    const x1 = x0 + reach;
    const y0 = f.y - 115, y1 = f.y - 5;
    return e.x + 26 > x0 && e.x - 26 < x1 && e.y > y0 && e.y - 105 < y1;
  }

  function hurt(def: F, from: { face: number }, dmg: number, kb: number, stun: number, owner?: F, launch = false) {
    if (def.ko || def.inv > 0 || phase !== 'fight') return;
    const blocked = def.state === 'block' && def.grounded;
    if (blocked) {
      def.hp -= Math.max(1, dmg * 0.2);
      def.vx = from.face * kb * 0.3;
      def.energy = Math.min(100, def.energy + 2);
      spark(def.x - from.face * 24, def.y - 60, 6, ['#93c5fd', '#ffffff'], 160);
      shake = Math.max(shake, 0.05);
      sfx.tone(760, 0.07, 'square', 0.15, 420); sfx.noise(0.05, 0.14, 6000, 2500);
      fx.push({ x: def.x - from.face * 26, y: def.y - 60, t: 0.2, max: 0.2, r: 40, color: '#93c5fd', kind: 'ring' });
    } else {
      def.hp -= dmg;
      def.lagT = 0.45;
      const heavyHit = dmg >= 11 || launch;
      sfx.play(heavyHit ? 'boom' : 'hit');
      if (heavyHit) sfx.tone(150, 0.16, 'triangle', 0.25, 60);
      fx.push({ x: def.x, y: def.y - 65, t: 0.24, max: 0.24, r: heavyHit ? 78 : 48, color: heavyHit ? '#fb923c' : '#fde047', kind: 'burst' });
      if (heavyHit) freeze = Math.max(freeze, launch ? 0.11 : 0.07);
      def.state = 'hit'; def.st = 0; def.stun = launch ? Math.max(stun, 0.55) : stun; def.kind = ''; def.vis = 1; def.comboN = 0;
      def.vx = from.face * kb;
      if (launch || !def.grounded || dmg >= 11) { def.vy = launch ? -520 : -260; def.grounded = false; }
      def.flash = 0.25;
      def.energy = Math.min(100, def.energy + 5);
      if (owner) {
        owner.energy = Math.min(100, owner.energy + 8);
        owner.comboN = (clock - owner.comboT < 0.9 ? owner.comboN : 0) + 1;
        owner.comboT = clock;
        if (owner.comboN >= 2) {
          pops.push({ text: ui.combo + ' x' + owner.comboN, x: def.x, y: def.y - 130, t: 0.9 });
          sfx.tone(500 + owner.comboN * 120, 0.1, 'triangle', 0.2, 900 + owner.comboN * 120, 0.05);
        }
      }
      spark(def.x, def.y - 65, dmg >= 11 ? 16 : 9, ['#fde047', '#fb923c', '#ffffff'], 260);
      shake = Math.max(shake, dmg >= 11 ? 0.25 : 0.12);
    }
    if (def.hp <= 0) {
      def.hp = 0; def.ko = true; def.state = 'ko'; def.st = 0;
      def.vy = -420; def.vx = from.face * 340; def.grounded = false;
      shake = 0.4;
      freeze = Math.max(freeze, 0.22); flashA = 0.55;
      sfx.play('explode');
      fx.push({ x: def.x, y: def.y - 60, t: 0.5, max: 0.5, r: 150, color: '#ffffff', kind: 'ring' });
      fx.push({ x: def.x, y: def.y - 60, t: 0.35, max: 0.35, r: 110, color: '#fde047', kind: 'burst' });
      endRound('ko');
    }
  }

  function fire(f: F, o: Partial<Proj> & { kind: string }) {
    projs.push({ x: f.x + f.face * 54, y: f.y - 62, vx: 0, vy: 0, dmg: 10, kb: 200, stun: 0.3, r: 12, life: 2, next: 0, dead: false, owner: f, ...o });
    projSound(o.kind);
  }

  function endAct(f: F) { f.state = 'idle'; f.st = 0; f.vx = 0; f.vis = 1; f.kind = ''; f.move = ''; }

  function startAttack(f: F, kind: Kind) {
    if (clock - f.comboT > 0.9) f.comboN = 0;
    f.state = 'attack'; f.kind = kind; f.st = 0; f.hit = false; f.cast = 0;
    if (f.grounded) f.vx = 0;
  }
  function startSpecial(f: F, move: 'sig' | 'dash' | 'ult') {
    f.energy -= COST[move];
    if (move === 'ult') {
      sfx.tone(180, 0.35, 'sawtooth', 0.2, 1100); sfx.play('levelup');
      flashA = Math.max(flashA, 0.35); freeze = Math.max(freeze, 0.14);
      fx.push({ x: f.x, y: f.y - 55, t: 0.45, max: 0.45, r: 120, color: COLORS[f.skin], kind: 'ring' });
    } else if (move === 'dash') sfx.play('dash');
    else sfx.play('power');
    f.state = 'special'; f.move = move; f.st = 0; f.hit = false; f.cast = 0; f.n = 0;
    if (f.grounded) f.vx = 0;
  }

  function updateAttack(f: F, e: F) {
    const a = ATK[f.kind as 'light'], k = HEROES[f.skin].haste;
    const pre = a.pre * k, post = a.post * k;
    if (!f.cast && f.st >= pre) {
      f.cast = 1;
      sfx.play('swoosh');
      if (f.kind === 'heavy') sfx.tone(190, 0.12, 'triangle', 0.15, 90);
    }
    if (f.grounded) f.vx = f.st >= pre && f.st < pre + a.act ? (f.face * a.lunge) / a.act * 0.6 : 0;
    if (!f.hit && f.st >= pre && f.st < pre + a.act) {
      // Đòn mạnh ở cuối chuỗi liên hoàn (J J K) mạnh hơn và hất tung
      const fin = f.kind === 'heavy' && f.comboN >= 2 && clock - f.comboT < 0.9;
      const dmg = (f.kind === 'light' ? HEROES[f.skin].light : HEROES[f.skin].heavy) * (fin ? 1.6 : 1);
      if (meleeHit(f, e, a.reach)) { f.hit = true; hurt(e, f, dmg, fin ? a.kb * 1.4 : a.kb, a.stun, f, fin); }
    }
    if (f.st >= pre + a.act + post) endAct(f);
  }

  // Lướt chém (→ → + K): lao tới tung đòn
  function dashMove(f: F, e: F) {
    const t = f.st;
    f.vx = t > 0.06 && t < 0.34 ? f.face * 620 : 0;
    if (t > 0.06 && t < 0.34 && Math.random() < 0.6) spark(f.x - f.face * 20, f.y - 40, 1, [COLORS[f.skin], '#ffffff'], 60);
    if (!f.hit && t > 0.06 && t < 0.36 && meleeHit(f, e, 46)) { f.hit = true; hurt(e, f, 10, 280, 0.3, f); }
    if (t >= 0.5) endAct(f);
  }

  // Chiêu đặc trưng của từng võ sĩ
  function sigMove(f: F, e: F) {
    const t = f.st, s = f.skin;
    if (s === 0) { // Xung phong
      f.vx = t > 0.08 && t < 0.4 ? f.face * 600 : 0;
      if (!f.hit && t > 0.08 && t < 0.42 && meleeHit(f, e, 50)) { f.hit = true; hurt(e, f, 16, 430, 0.45, f); }
      if (t >= 0.58) endAct(f);
    } else if (s === 1) { // Cầu lửa
      f.vx = 0;
      if (!f.cast && t >= 0.22) { f.cast = 1; fire(f, { kind: 'fire', vx: f.face * 480, dmg: 14, kb: 330, r: 20 }); }
      if (t >= 0.55) endAct(f);
    } else if (s === 2) { // Xạ tiễn
      f.vx = 0;
      if (f.cast === 0 && t >= 0.18) { f.cast = 1; fire(f, { kind: 'arrow', vx: f.face * 1000, dmg: 9, kb: 200, r: 9 }); }
      if (f.cast === 1 && t >= 0.36) { f.cast = 2; fire(f, { kind: 'arrow', vx: f.face * 1000, dmg: 9, kb: 200, r: 9 }); }
      if (t >= 0.62) endAct(f);
    } else if (s === 3) { // Thuấn bộ
      if (t < 0.14) { f.vis = 1 - t / 0.14; f.inv = 0.2; } else f.vis = Math.min(1, (t - 0.14) / 0.08);
      if (f.cast === 0 && t >= 0.14) { f.cast = 1; teleportBehind(f, e); }
      if (!f.hit && t >= 0.26 && t < 0.42 && meleeHit(f, e, 78)) { f.hit = true; hurt(e, f, 15, 320, 0.4, f); }
      if (t >= 0.62) endAct(f);
    } else if (s === 4) { // Hỏa cầu thuật
      f.vx = 0;
      if (!f.cast && t >= 0.24) { f.cast = 1; fire(f, { kind: 'fire', vx: f.face * 540, dmg: 15, kb: 340, r: 24 }); }
      if (t >= 0.55) endAct(f);
    } else if (s === 5) { // Phong nhận
      f.vx = 0;
      if (f.cast === 0 && t >= 0.16) { f.cast = 1; fire(f, { kind: 'wind', vx: f.face * 850, dmg: 8, kb: 160, stun: 0.25, r: 15 }); }
      if (f.cast === 1 && t >= 0.3) { f.cast = 2; fire(f, { kind: 'wind', vx: f.face * 850, dmg: 8, kb: 160, stun: 0.25, r: 15 }); }
      if (t >= 0.55) endAct(f);
    } else if (s === 6) { // Nguyệt ba
      f.vx = 0;
      if (!f.cast && t >= 0.26) { f.cast = 1; fire(f, { kind: 'moon', vx: f.face * 600, dmg: 16, kb: 360, stun: 0.4, r: 28 }); }
      if (t >= 0.6) endAct(f);
    } else { // Linh cầu: tự đuổi theo đối thủ
      f.vx = 0;
      if (!f.cast && t >= 0.24) { f.cast = 1; fire(f, { kind: 'orb', vx: f.face * 430, dmg: 13, kb: 260, r: 17, life: 2.4 }); }
      if (t >= 0.55) endAct(f);
    }
  }

  function teleportBehind(f: F, e: F) {
    spark(f.x, f.y - 55, 12, ['#475569', '#cbd5e1', '#ffffff'], 150);
    f.x = clampX(e.x - e.face * 78);
    f.face = e.x >= f.x ? 1 : -1;
    spark(f.x, f.y - 55, 12, ['#475569', '#cbd5e1', '#ffffff'], 150);
  }

  // Tuyệt kỹ (↓ ↓ + L hoặc phím I), cần đủ 100 nộ
  function ultMove(f: F, e: F) {
    const t = f.st, s = f.skin;
    if (t < 0.3) f.inv = Math.max(f.inv, 0.1);
    if (t < 0.3 && Math.random() < 0.5) spark(f.x + (Math.random() - 0.5) * 50, f.y - 20 - Math.random() * 70, 1, [COLORS[s], '#ffffff'], 40);
    if (s === 0) { // Thiên Kiếm Trảm
      f.vx = 0;
      if (!f.cast && t >= 0.3) {
        f.cast = 1; shake = 0.5;
        spark(f.x + f.face * 90, GY - 8, 24, ['#e2e8f0', '#facc15', '#ffffff'], 330);
        if (meleeHit(f, e, 170)) hurt(e, f, 30, 520, 0.6, f, true);
      }
      if (t >= 0.8) endAct(f);
    } else if (s === 1) { // Thiên thạch
      f.vx = 0;
      if (!f.cast && t >= 0.3) {
        f.cast = 1;
        for (const off of [-100, 0, 100]) fire(f, { kind: 'meteor', x: clampX(e.x + off), y: -30, vy: 850, dmg: 12, kb: 260, stun: 0.35, r: 22 });
      }
      if (t >= 0.8) endAct(f);
    } else if (s === 2) { // Mưa tên
      f.vx = 0;
      if (!f.cast && t >= 0.25) {
        f.cast = 1;
        for (let i = 0; i < 7; i++) fire(f, { kind: 'rain', x: clampX(e.x - 150 + i * 50), y: -20 - (i % 3) * 45, vy: 800, dmg: 7, kb: 160, stun: 0.2, r: 9 });
      }
      if (t >= 0.8) endAct(f);
    } else if (s === 3) { // Ảnh phân thân
      if (t < 0.14) { f.vis = 1 - t / 0.14; f.inv = 0.2; } else f.vis = Math.min(1, (t - 0.14) / 0.08);
      if (f.cast === 0 && t >= 0.14) { f.cast = 1; teleportBehind(f, e); }
      if (f.n < 4 && t >= 0.26 + 0.08 * f.n) {
        f.n++;
        spark(e.x, e.y - 60, 6, ['#cbd5e1', '#ffffff'], 200);
        if (meleeHit(f, e, 80)) hurt(e, f, 7, f.n === 4 ? 360 : 100, 0.25, f, f.n === 4);
      }
      if (t >= 0.8) endAct(f);
    } else if (s === 4) { // Hỏa Long
      f.vx = 0;
      if (!f.cast && t >= 0.3) { f.cast = 1; fire(f, { kind: 'dragon', vx: f.face * 600, dmg: 28, kb: 520, stun: 0.6, r: 44, life: 2 }); shake = 0.3; }
      if (t >= 0.8) endAct(f);
    } else if (s === 5) { // Lốc xoáy
      f.vx = 0;
      if (!f.cast && t >= 0.3) { f.cast = 1; fire(f, { kind: 'tornado', vx: f.face * 320, dmg: 5, kb: 120, stun: 0.25, r: 42, life: 2.2 }); }
      if (t >= 0.8) endAct(f);
    } else if (s === 6) { // Nguyệt Trảm: nhát chém xuyên cả sân
      f.vx = 0;
      if (!f.cast && t >= 0.35) {
        f.cast = 1; shake = 0.45;
        beams.push({ x0: f.x, x1: f.face > 0 ? W : 0, y: f.y - 62, t: 0.4, color: '#e0f2fe' });
        if ((e.x - f.x) * f.face > 0) hurt(e, f, 28, 460, 0.6, f, true);
      }
      if (t >= 0.85) endAct(f);
    } else { // Phong ấn
      f.vx = 0;
      if (!f.cast && t >= 0.3) {
        f.cast = 1;
        f.hp = Math.min(100, f.hp + 12);
        fire(f, { kind: 'seal', vx: f.face * 540, dmg: 8, kb: 100, stun: 1.6, r: 30 });
      }
      if (t >= 0.8) endAct(f);
    }
  }

  function updateSpecial(f: F, e: F) {
    if (f.move === 'dash') dashMove(f, e);
    else if (f.move === 'ult') ultMove(f, e);
    else sigMove(f, e);
  }

  function stepFighter(f: F, e: F, inp: Inp, dt: number) {
    f.st += dt;
    f.flash = Math.max(0, f.flash - dt);
    f.inv = Math.max(0, f.inv - dt);
    f.energy = Math.min(100, f.energy + 4 * dt);
    if (f.shown > f.hp) { f.lagT -= dt; if (f.lagT <= 0) f.shown = Math.max(f.hp, f.shown - 45 * dt); }
    else f.shown = f.hp;
    const H0 = HEROES[f.skin];
    const free = f.state === 'idle' || f.state === 'walk' || f.state === 'block';
    if (free && f.grounded && !e.ko) f.face = e.x >= f.x ? 1 : -1;

    if (f.state === 'ko') {
      f.vx *= Math.pow(0.02, dt);
    } else if (f.state === 'hit') {
      f.stun -= dt;
      f.vx *= Math.pow(0.01, dt);
      if (f.stun <= 0 && f.grounded) { f.state = 'idle'; f.st = 0; }
    } else if (f.state === 'attack') {
      updateAttack(f, e);
    } else if (f.state === 'special') {
      updateSpecial(f, e);
    } else {
      const act = inp.ult || inp.special || inp.dash || inp.light || inp.heavy;
      if (inp.block && f.grounded && !act) {
        f.state = 'block'; f.vx = 0;
      } else {
        const dir = (inp.right ? 1 : 0) - (inp.left ? 1 : 0);
        const sp = H0.speed * (f.human ? 1 : DIFF[level].speed) * (f.grounded ? 1 : 0.75);
        if (f.grounded) { f.vx = dir * sp; f.state = dir ? 'walk' : 'idle'; } else f.vx = dir * sp;
        if (inp.jump && f.grounded) { f.vy = -H0.jump; f.grounded = false; if (f.human) sfx.play('jump'); dust(f.x, GY, 4, 70); }
        if (inp.ult && f.energy >= COST.ult) startSpecial(f, 'ult');
        else if (inp.special && f.energy >= COST.sig) startSpecial(f, 'sig');
        else if (inp.dash && f.energy >= COST.dash) startSpecial(f, 'dash');
        else if (inp.light) startAttack(f, 'light');
        else if (inp.heavy) startAttack(f, 'heavy');
      }
    }

    // Vật lý
    if (!f.grounded) f.vy += 2300 * dt;
    f.x += f.vx * dt;
    f.y += f.vy * dt;
    if (f.y >= GY) {
      const impact = f.vy;
      f.y = GY; f.vy = 0;
      if (!f.grounded) {
        f.grounded = true;
        dust(f.x, GY, impact > 600 ? 10 : 6, impact > 600 ? 150 : 100);
        if (f.human && impact > 450) sfx.play('land');
      }
    }
    f.x = clampX(f.x);
  }

  // ---------- Máy điều khiển ----------
  function canSpecial(f: F, dist: number): boolean {
    if (f.skin === 0) return dist > 120 && dist < 340;
    if (f.skin === 3) return dist > 110;
    if (f.skin === 6) return dist > 90;
    return dist > 160;
  }
  function canUlt(f: F, dist: number): boolean { return f.skin === 0 ? dist < 190 : dist < 440; }

  function aiInput(f: F, e: F, dt: number): Inp {
    const cfg = DIFF[level], ai = f.ai;
    ai.t -= dt; ai.mt -= dt; ai.cool -= dt;
    const inp = blank();
    if (f.ko || f.state === 'attack' || f.state === 'special' || f.state === 'hit') return inp;
    const dist = Math.abs(e.x - f.x);
    const dir = e.x > f.x ? 1 : -1;
    // Thấy đối thủ vừa ra đòn gần mình thì quyết định đỡ ngay (mỗi đòn chỉ quyết định một lần)
    const attacking = e.state === 'attack' || e.state === 'special';
    if (attacking && !ai.saw && dist < 190) {
      ai.saw = true;
      if (Math.random() < cfg.block) { ai.mode = 'block'; ai.mt = 0.45; ai.t = 0.45; }
    }
    if (!attacking) ai.saw = false;
    if (ai.t <= 0) {
      ai.t = cfg.react * (0.6 + Math.random() * 0.8);
      if (f.energy >= COST.ult && canUlt(f, dist) && Math.random() < cfg.ult) { ai.mode = 'ult'; ai.mt = 0.05; }
      else if (e.state === 'hit' && dist < 110 && ai.mt <= 0 && Math.random() < 0.85) {
        // Đối thủ đang choáng: tung đòn nối
        ai.mode = Math.random() < 0.5 ? 'light' : 'heavy'; ai.mt = 0.05; ai.cool = 0.25;
      } else if (ai.mt <= 0) {
        if (f.energy >= COST.sig && canSpecial(f, dist) && Math.random() < cfg.special) { ai.mode = 'special'; ai.mt = 0.05; }
        else if (f.energy >= COST.dash + 20 && dist > 130 && dist < 300 && Math.random() < cfg.special * 0.3) { ai.mode = 'dash'; ai.mt = 0.05; }
        else if (dist > 95) { ai.mode = Math.random() < 0.08 ? 'jumpin' : 'approach'; ai.mt = 0.25 + Math.random() * 0.3; }
        else if (ai.cool <= 0 && Math.random() < cfg.aggr) { ai.mode = Math.random() < 0.6 ? 'light' : 'heavy'; ai.mt = 0.05; ai.cool = 0.3 + Math.random() * 0.5 * (1.2 - cfg.aggr); }
        else { ai.mode = Math.random() < 0.35 ? 'retreat' : 'idle'; ai.mt = 0.3; }
      }
    }
    if (ai.mt > 0) {
      switch (ai.mode) {
        case 'block': inp.block = true; break;
        case 'approach': if (dist > 70) { inp.left = dir < 0; inp.right = dir > 0; } break;
        case 'jumpin': inp.jump = f.grounded; inp.left = dir < 0; inp.right = dir > 0; break;
        case 'retreat': inp.left = dir > 0; inp.right = dir < 0; break;
        case 'light': inp.light = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'heavy': inp.heavy = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'special': inp.special = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'dash': inp.dash = true; ai.mt = 0; ai.mode = 'idle'; break;
        case 'ult': inp.ult = true; ai.mt = 0; ai.mode = 'idle'; break;
      }
    }
    return inp;
  }

  // Đọc phím của người chơi, nhận ra các chiêu kết hợp phím; thiếu nộ thì quay về đòn thường
  function humanInput(): Inp {
    const i = blank();
    i.left = held.left; i.right = held.right; i.jump = held.jump; i.block = held.block;
    const face = p.face, en = p.energy;
    if (press.ult && en >= COST.ult) i.ult = true;
    else if (press.special && seqHas(['D', 'D'], face) && en >= COST.ult) i.ult = true;
    else if (press.special) i.special = true;
    else if (press.light && seqHas(['D', 'F'], face) && en >= COST.sig) i.special = true;
    else if (press.heavy && seqHas(['F', 'F'], face) && en >= COST.dash) i.dash = true;
    else if (press.light) i.light = true;
    else if (press.heavy) i.heavy = true;
    if (i.ult || i.special || i.dash) buf.length = 0;
    press.light = press.heavy = press.special = press.ult = false;
    return i;
  }

  function updateProjs(dt: number) {
    for (const q of projs) {
      q.life -= dt;
      if (q.life <= 0) q.dead = true;
      const tgt = q.owner === p ? c : p;
      if (q.kind === 'orb') q.y += Math.max(-220, Math.min(220, (tgt.y - 58 - q.y) * 3.5)) * dt;
      q.x += q.vx * dt;
      q.y += q.vy * dt;
      if (q.kind !== 'rain' && q.kind !== 'meteor') spark(q.x, q.y, 1, q.kind === 'fire' || q.kind === 'dragon' || q.kind === 'meteor' ? ['#fb923c', '#fde047'] : q.kind === 'orb' || q.kind === 'seal' ? ['#7dd3fc', '#ffffff'] : q.kind === 'wind' || q.kind === 'tornado' ? ['#5eead4', '#ffffff'] : ['#86efac', '#ffffff'], 30);
      if (q.kind === 'meteor') spark(q.x, q.y - 12, 1, ['#fb923c', '#fde047'], 40);
      if (q.dead || tgt.ko) { if (tgt.ko) q.dead = true; continue; }
      const over = Math.abs(q.x - tgt.x) < 26 + q.r && q.y > tgt.y - 105 - q.r && q.y < tgt.y + q.r;
      if (q.kind === 'tornado') {
        if (over && clock >= q.next) { q.next = clock + 0.22; hurt(tgt, { face: Math.sign(q.vx) || 1 }, q.dmg, q.kb, q.stun, q.owner); }
        continue;
      }
      if (over) {
        hurt(tgt, { face: Math.sign(q.vx) || (tgt.x >= q.x ? 1 : -1) }, q.dmg, q.kb, q.stun, q.owner);
        if (q.kind === 'seal') q.owner.hp = Math.min(100, q.owner.hp + 3);
        q.dead = true;
      } else if (q.y >= GY - 4 && q.vy > 0) {
        if (q.kind === 'meteor') {
          spark(q.x, GY - 6, 14, ['#fb923c', '#fde047', '#ffffff'], 240);
          shake = Math.max(shake, 0.18);
          sfx.play('boom'); dust(q.x, GY, 8, 170);
          fx.push({ x: q.x, y: GY - 10, t: 0.3, max: 0.3, r: 70, color: '#fb923c', kind: 'ring' });
          if (Math.abs(q.x - tgt.x) < 70) hurt(tgt, { face: tgt.x >= q.x ? 1 : -1 }, q.dmg, q.kb, q.stun, q.owner);
        }
        q.dead = true;
      }
    }
    projs = projs.filter((q) => !q.dead && q.x > -80 && q.x < W + 80);
  }

  function update(dt: number) {
    for (const q of fx) q.t -= dt;
    fx = fx.filter((q) => q.t > 0);
    flashA = Math.max(0, flashA - dt * 1.6);
    if (freeze > 0) { freeze -= dt; return; } // dừng hình ngắn khi trúng đòn mạnh
    if (phase === 'ko' && phaseT > 1.7) dt *= 0.4; // quay chậm lúc K.O.
    clock += dt;
    shake = Math.max(0, shake - dt);
    for (const q of particles) { q.life -= dt; q.x += q.vx * dt; q.y += q.vy * dt; q.vy += q.g * dt; }
    particles = particles.filter((q) => q.life > 0);
    for (const q of pops) { q.t -= dt; q.y -= 40 * dt; }
    pops = pops.filter((q) => q.t > 0);
    for (const q of beams) q.t -= dt;
    beams = beams.filter((q) => q.t > 0);

    if (phase === 'intro') {
      stepFighter(p, c, blank(), dt); stepFighter(c, p, blank(), dt);
      phaseT -= dt;
      if (phaseT <= 0.8 && !introGo) { introGo = true; sfx.play('go'); }
      if (phaseT <= 0) phase = 'fight';
    } else if (phase === 'fight') {
      timer -= dt;
      const tk = Math.ceil(timer);
      if (tk <= 10 && tk < lastTick) { lastTick = tk; sfx.play('tick'); }
      stepFighter(p, c, humanInput(), dt);
      stepFighter(c, p, aiInput(c, p, dt), dt);
      updateProjs(dt);
      if (timer <= 0) { timer = 0; endRound('time'); }
    } else {
      stepFighter(p, c, blank(), dt); stepFighter(c, p, blank(), dt);
      updateProjs(dt);
      phaseT -= dt;
      if (phaseT <= 0) nextRound();
    }
    // Không cho hai võ sĩ chồng lên nhau khi cùng đứng trên mặt đất
    const dx = c.x - p.x;
    if (p.grounded && c.grounded && Math.abs(dx) < 46 && !p.ko && !c.ko) {
      const push = (46 - Math.abs(dx)) / 2 * (dx >= 0 ? 1 : -1);
      p.x = clampX(p.x - push); c.x = clampX(c.x + push);
    }
  }

  // ---------- Vẽ ----------
  function buildBg(kind: string): HTMLCanvasElement {
    const cv = document.createElement('canvas');
    cv.width = W; cv.height = H;
    const g = cv.getContext('2d')!;
    if (kind === 'temple') {
      const sky = g.createLinearGradient(0, 0, 0, GY);
      sky.addColorStop(0, '#1e1b4b'); sky.addColorStop(0.55, '#6d28d9'); sky.addColorStop(1, '#f97316');
      g.fillStyle = sky; g.fillRect(0, 0, W, H);
      g.fillStyle = 'rgba(255,255,255,.7)';
      for (let i = 0; i < 70; i++) {
        g.globalAlpha = 0.35 + ((i * 7) % 5) / 10;
        g.beginPath(); g.arc((i * 137) % W, (i * 53) % 210, 0.6 + (i % 3) * 0.5, 0, Math.PI * 2); g.fill();
      }
      g.globalAlpha = 1;
      const moon = g.createRadialGradient(620, 110, 10, 620, 110, 120);
      moon.addColorStop(0, 'rgba(254,243,199,.9)'); moon.addColorStop(0.4, 'rgba(254,243,199,.25)'); moon.addColorStop(1, 'rgba(254,243,199,0)');
      g.fillStyle = moon; g.fillRect(480, 0, 280, 260);
      g.fillStyle = '#fef3c7'; g.beginPath(); g.arc(620, 110, 44, 0, Math.PI * 2); g.fill();
      g.fillStyle = '#3b1d6e';
      g.beginPath(); g.moveTo(0, GY - 40); g.lineTo(90, 250); g.lineTo(170, 310); g.lineTo(280, 215); g.lineTo(390, 300); g.lineTo(500, 240); g.lineTo(620, 300); g.lineTo(720, 230); g.lineTo(800, 290); g.lineTo(800, GY); g.lineTo(0, GY); g.closePath(); g.fill();
      g.fillStyle = '#2a1450';
      g.beginPath(); g.moveTo(0, GY); g.lineTo(0, 320); g.lineTo(120, 300); g.lineTo(230, 335); g.lineTo(360, 310); g.lineTo(480, 340); g.lineTo(600, 312); g.lineTo(720, 335); g.lineTo(800, 318); g.lineTo(800, GY); g.closePath(); g.fill();
      g.fillStyle = '#160b30';
      g.fillRect(80, 270, 110, 118);
      for (const [w, y] of [[150, 262], [124, 232], [98, 204]] as [number, number][]) {
        g.beginPath(); g.moveTo(135 - w / 2 - 10, y + 14); g.lineTo(135, y - 16); g.lineTo(135 + w / 2 + 10, y + 14); g.closePath(); g.fill();
      }
      g.fillRect(132, 168, 6, 34);
      g.fillStyle = '#b91c1c';
      g.fillRect(640, 270, 14, 118); g.fillRect(726, 270, 14, 118);
      g.fillRect(622, 262, 136, 14); g.fillRect(634, 290, 112, 9);
      g.fillStyle = '#7f1d1d'; g.fillRect(622, 276, 136, 3);
      const floor = g.createLinearGradient(0, GY - 6, 0, H);
      floor.addColorStop(0, '#7c4a2a'); floor.addColorStop(1, '#2b170c');
      g.fillStyle = floor; g.fillRect(0, GY - 6, W, H - GY + 6);
      g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(0, GY - 6, W, 3);
      g.strokeStyle = 'rgba(0,0,0,.28)'; g.lineWidth = 2;
      for (let x = -40; x < W + 80; x += 66) { g.beginPath(); g.moveTo(x + 10, GY - 3); g.lineTo(x - 30, H); g.stroke(); }
      g.beginPath(); g.moveTo(0, GY + 28); g.lineTo(W, GY + 28); g.stroke();
    } else {
      // Nghĩa địa linh hồn
      const sky = g.createLinearGradient(0, 0, 0, GY);
      sky.addColorStop(0, '#04121f'); sky.addColorStop(0.6, '#0b3b4a'); sky.addColorStop(1, '#1f7a7a');
      g.fillStyle = sky; g.fillRect(0, 0, W, H);
      const moon = g.createRadialGradient(400, 120, 10, 400, 120, 170);
      moon.addColorStop(0, 'rgba(186,230,253,.9)'); moon.addColorStop(0.4, 'rgba(125,211,252,.25)'); moon.addColorStop(1, 'rgba(125,211,252,0)');
      g.fillStyle = moon; g.fillRect(200, 0, 400, 300);
      g.fillStyle = '#e0f2fe'; g.beginPath(); g.arc(400, 120, 58, 0, Math.PI * 2); g.fill();
      g.fillStyle = 'rgba(15,23,42,.18)'; g.beginPath(); g.arc(384, 108, 12, 0, Math.PI * 2); g.arc(418, 138, 8, 0, Math.PI * 2); g.fill();
      // Cây khô và núi xa
      g.fillStyle = '#071a26';
      g.beginPath(); g.moveTo(0, GY); g.lineTo(0, 300); g.lineTo(140, 270); g.lineTo(300, 310); g.lineTo(460, 280); g.lineTo(640, 315); g.lineTo(800, 285); g.lineTo(800, GY); g.closePath(); g.fill();
      g.strokeStyle = '#04121f'; g.lineWidth = 6; g.lineCap = 'round';
      for (const [x, h] of [[70, 150], [740, 170], [200, 100]] as [number, number][]) {
        g.beginPath(); g.moveTo(x, GY); g.lineTo(x, GY - h); g.stroke();
        g.lineWidth = 3;
        g.beginPath(); g.moveTo(x, GY - h * 0.6); g.lineTo(x - 36, GY - h * 0.85); g.moveTo(x, GY - h * 0.75); g.lineTo(x + 34, GY - h); g.moveTo(x, GY - h); g.lineTo(x - 18, GY - h - 26); g.stroke();
        g.lineWidth = 6;
      }
      // Bia mộ
      g.fillStyle = '#0a2a38';
      for (const x of [120, 175, 620, 690, 755]) {
        g.beginPath(); g.moveTo(x - 16, GY); g.lineTo(x - 16, GY - 46); g.arc(x, GY - 46, 16, Math.PI, 0); g.lineTo(x + 16, GY); g.closePath(); g.fill();
      }
      // Linh hồn lơ lửng
      for (let i = 0; i < 16; i++) {
        const x = (i * 211) % W, y = 80 + ((i * 97) % 260);
        const k = g.createRadialGradient(x, y, 1, x, y, 14);
        k.addColorStop(0, 'rgba(204,251,241,.9)'); k.addColorStop(0.5, 'rgba(94,234,212,.35)'); k.addColorStop(1, 'rgba(94,234,212,0)');
        g.fillStyle = k; g.beginPath(); g.arc(x, y, 14, 0, Math.PI * 2); g.fill();
      }
      const floor = g.createLinearGradient(0, GY - 6, 0, H);
      floor.addColorStop(0, '#1e3a46'); floor.addColorStop(1, '#06171e');
      g.fillStyle = floor; g.fillRect(0, GY - 6, W, H - GY + 6);
      g.fillStyle = 'rgba(94,234,212,.35)'; g.fillRect(0, GY - 6, W, 3);
      g.strokeStyle = 'rgba(94,234,212,.25)'; g.lineWidth = 2;
      for (let x = -40; x < W + 80; x += 66) { g.beginPath(); g.moveTo(x + 10, GY - 3); g.lineTo(x - 30, H); g.stroke(); }
