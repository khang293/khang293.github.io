---
import Base from '../../layouts/Base.astro';
import { lp, type Lang } from '../../i18n';
import { gamesUi } from '../../data/games';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const g = gamesUi[lang];

// Chữ của game Thủ Thành (/game/tower/). Xóa game thì xóa file này và 2 file route.
const T = {
  vi: {
    title: 'Thủ Thành',
    sub: 'Đặt tháp dọc đường đi để chặn quái. Nâng cấp tháp, dùng tiền thưởng thông minh và hạ boss ở các đợt 5, 10, 15, 20.',
    pickMap: 'Chọn bản đồ',
    maps: [
      { name: 'Đồng xanh', desc: 'Đường uốn lượn dài, nhiều chỗ đặt tháp.' },
      { name: 'Hẻm núi', desc: 'Đường ngắn và gấp khúc, quái đến nhanh hơn.' },
    ],
    start: 'Bắt đầu',
    best: 'Kỷ lục đợt',
    keys: 'Chọn một tháp ở thanh bên dưới rồi bấm vào ô cỏ để xây. Bấm vào tháp đã xây để nâng cấp hoặc bán. Phím 1 đến 4 chọn tháp, Space bắt đầu đợt, Esc bỏ chọn.',
    gold: 'Vàng', lives: 'Mạng', wave: 'Đợt',
    startWave: 'Bắt đầu đợt', nextWave: (n: number) => `Bắt đầu đợt ${n}`, running: 'Đang đánh...',
    speed: 'Tốc độ',
    towers: [
      { name: 'Tháp cung', desc: 'Bắn nhanh, sát thương thấp, đa dụng.' },
      { name: 'Pháo', desc: 'Đạn nổ lan, bắn chậm, hợp đàn đông.' },
      { name: 'Tháp băng', desc: 'Làm chậm quái, sát thương rất nhỏ.' },
      { name: 'Tháp sét', desc: 'Sét nhảy qua nhiều quái, xuyên giáp.' },
    ],
    enemies: { grunt: 'Quái thường', runner: 'Quái chạy', tank: 'Quái trâu', armored: 'Quái giáp', flyer: 'Quái bay', boss: 'Trùm' },
    level: 'Cấp', upgrade: 'Nâng cấp', maxed: 'Cấp tối đa', sell: 'Bán', dmg: 'Sát thương', range: 'Tầm', rate: 'Tốc độ bắn', extra: 'Hiệu ứng',
    slowX: (p: number) => `chậm ${p}%`, chainX: (n: number) => `nảy ${n} mục tiêu`, splashX: (n: number) => `nổ lan ${n}`,
    needGold: 'Không đủ vàng',
    cantBuild: 'Không xây được ở đây',
    win: 'Chiến thắng! Thành được giữ vững.',
    lose: 'Thành thất thủ.',
    reached: (n: number) => `Bạn trụ được đến đợt ${n}.`,
    clearedAll: 'Bạn đã hạ cả 20 đợt.',
    again: 'Chơi lại', change: 'Đổi bản đồ',
    waveClear: (n: number, g: number) => `Đợt ${n} xong! +${g} vàng`,
    bossWave: 'Trùm xuất hiện!',
    newBest: '🏆 Kỷ lục mới!',
    cancel: 'Bỏ chọn',
    sellTip: 'Hoàn lại 70% vàng đã bỏ ra',
  },
  en: {
    title: 'Tower Defense',
    sub: 'Place towers along the path to stop the monsters. Upgrade them, spend your gold wisely and take down the boss on waves 5, 10, 15 and 20.',
    pickMap: 'Choose a map',
    maps: [
      { name: 'Green Fields', desc: 'A long winding road with lots of room for towers.' },
      { name: 'Canyon', desc: 'A short, sharp path, so monsters arrive sooner.' },
    ],
    start: 'Start',
    best: 'Best wave',
    keys: 'Pick a tower in the bar below, then tap a grass tile to build. Tap a built tower to upgrade or sell it. Keys 1 to 4 pick a tower, Space starts a wave, Esc deselects.',
    gold: 'Gold', lives: 'Lives', wave: 'Wave',
    startWave: 'Start wave', nextWave: (n: number) => `Start wave ${n}`, running: 'Fighting...',
    speed: 'Speed',
    towers: [
      { name: 'Archer Tower', desc: 'Fast shots, low damage, all-rounder.' },
      { name: 'Cannon', desc: 'Splash shells, slow rate, great against crowds.' },
      { name: 'Frost Tower', desc: 'Slows monsters, tiny damage.' },
      { name: 'Lightning Tower', desc: 'Bolts that jump between monsters and pierce armor.' },
    ],
    enemies: { grunt: 'Grunt', runner: 'Runner', tank: 'Tank', armored: 'Armored', flyer: 'Flyer', boss: 'Boss' },
    level: 'Level', upgrade: 'Upgrade', maxed: 'Max level', sell: 'Sell', dmg: 'Damage', range: 'Range', rate: 'Fire rate', extra: 'Effect',
    slowX: (p: number) => `${p}% slow`, chainX: (n: number) => `chains ${n}`, splashX: (n: number) => `splash ${n}`,
    needGold: 'Not enough gold',
    cantBuild: 'Cannot build here',
    win: 'Victory! The castle stands.',
    lose: 'The castle has fallen.',
    reached: (n: number) => `You held out until wave ${n}.`,
    clearedAll: 'You cleared all 20 waves.',
    again: 'Play again', change: 'Change map',
    waveClear: (n: number, g: number) => `Wave ${n} clear! +${g} gold`,
    bossWave: 'A boss approaches!',
    newBest: '🏆 New best!',
    cancel: 'Deselect',
    sellTip: 'Refunds 70% of the gold spent',
  },
}[lang];

// Chỉ gửi phần chữ thường (không có hàm) xuống trình duyệt, phần có hàm đã chuyển thành chuỗi mẫu.
const ui = {
  gold: T.gold, lives: T.lives, wave: T.wave, startWave: T.startWave, running: T.running,
  nextWaveTpl: T.nextWave(0), towers: T.towers, enemies: T.enemies,
  level: T.level, upgrade: T.upgrade, maxed: T.maxed, sell: T.sell, dmg: T.dmg, range: T.range, rate: T.rate, extra: T.extra,
  slow: T.slowX(0), chain: T.chainX(0), splash: T.splashX(0),
  needGold: T.needGold, cantBuild: T.cantBuild,
  win: T.win, lose: T.lose, reachedTpl: T.reached(0), clearedAll: T.clearedAll,
  waveClearTpl: T.waveClear(0, 0), bossWave: T.bossWave, newBest: T.newBest, sellTip: T.sellTip, best: T.best,
};
---
<Base lang={lang} title={T.title} description={T.sub} noindex wide>
  <p class="meta"><a href={lp(lang, '/game/')}>{g.back}</a></p>
  <h1>{T.title}</h1>
  <p class="meta">{T.sub}</p>

  <div id="tower" data-ui={JSON.stringify(ui)}>
    <div id="td-menu">
      <h2 class="bd-h">{T.pickMap}</h2>
      <div class="td-maps">
        {T.maps.map((m, i) => (
          <button type="button" class={`bd-opt td-map${i === 0 ? ' sel' : ''}`} data-map={i}>
            <canvas width="160" height="100" aria-hidden="true"></canvas>
            <b>{m.name}</b><small>{m.desc}</small>
          </button>
        ))}
      </div>
      <p class="bd-stat" id="td-stat"></p>
      <button class="btn" type="button" id="td-start">▶ {T.start}</button>
      <p class="meta">{T.keys}</p>
    </div>

    <div id="td-game" hidden>
      <div class="td-hud">
        <span class="td-pill td-gold">🪙 <b id="td-gold">0</b></span>
        <span class="td-pill td-lives" id="td-livesp">❤️ <b id="td-lives">0</b></span>
        <span class="td-pill td-wavep">🌊 {T.wave} <b id="td-wave">0</b>/20<span class="td-prog"><i id="td-prog"></i></span></span>
        <span class="td-msg" id="td-msg" aria-live="polite"></span>
      </div>
      <div class="td-stage">
        <canvas id="td-canvas" width="864" height="540" aria-label={T.title}></canvas>
        <div class="td-ov" id="td-over" hidden>
          <div class="td-big" id="td-over-msg"></div>
          <p id="td-over-sum" class="td-sum"></p>
          <div class="td-actions">
            <button type="button" class="btn" id="td-again">{T.again}</button>
            <button type="button" class="btn ghost" id="td-change">{T.change}</button>
          </div>
        </div>
      </div>
      <div class="td-bar">
        {T.towers.map((t, i) => (
          <button type="button" class="td-tw" data-tw={i} title={t.desc}>
            <canvas width="44" height="44" aria-hidden="true"></canvas>
            <span class="td-tw-n">{i + 1}. {t.name}</span>
            <span class="td-tw-c" data-cost={i}></span>
          </button>
        ))}
      </div>
      <div class="td-info" id="td-info"></div>
      <div class="td-actions">
        <button type="button" class="btn" id="td-go">{T.startWave}</button>
        <button type="button" class="btn ghost sm" id="td-speed">{T.speed} ×1</button>
        <button type="button" class="btn ghost sm" id="td-menu-btn">{T.change}</button>
      </div>
    </div>
  </div>
</Base>

<script>
  import { sfx, mountMute } from '../../data/sfx';
  const root = document.getElementById('tower') as HTMLElement;
  const ui = JSON.parse(root.dataset.ui || '{}');
  const menu = document.getElementById('td-menu') as HTMLElement;
  const gameEl = document.getElementById('td-game') as HTMLElement;
  const canvas = document.getElementById('td-canvas') as HTMLCanvasElement;
  const g = canvas.getContext('2d')!;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const COLS = 16, ROWS = 10, CELL = 54, W = COLS * CELL, H = ROWS * CELL;
  const WAVES = 20;
  const TAU = Math.PI * 2;
  const fmt = (tpl: string, ...v: (string | number)[]) => { let i = 0; return tpl.replace(/0/g, () => String(v[i++] ?? 0)); };

  // ---------- Bản đồ: các điểm gấp khúc (cột, hàng) ----------
  const MAPS = [
    { wp: [[-1, 2], [12, 2], [12, 5], [3, 5], [3, 8], [16, 8]], rocks: [[6, 0], [9, 4], [1, 7], [14, 5], [7, 9], [15, 0], [5, 7]], g1: '#5c9a45', g2: '#66a44d', road: '#c9a56b' },
    { wp: [[-1, 1], [5, 1], [5, 7], [10, 7], [10, 3], [16, 3]], rocks: [[2, 4], [8, 1], [13, 8], [0, 8], [7, 4], [14, 0], [12, 6]], g1: '#9a8a55', g2: '#a3935c', road: '#6f7480' },
  ];

  // ---------- Tháp: thông số theo cấp ----------
  const TW = [
    { id: 'arrow', cost: 50, col: '#d9a441', range: [3.0, 3.4, 3.8], dmg: [6, 10, 16], rate: [0.5, 0.4, 0.3], up: [40, 70] },
    { id: 'cannon', cost: 90, col: '#7a6f66', range: [2.8, 3.0, 3.3], dmg: [24, 40, 64], rate: [1.5, 1.4, 1.2], splash: [50, 62, 76], up: [70, 120] },
    { id: 'frost', cost: 70, col: '#5bc0eb', range: [2.6, 3.0, 3.4], dmg: [2, 4, 6], rate: [0.9, 0.8, 0.7], slow: [0.55, 0.42, 0.3], up: [60, 100] },
    { id: 'bolt', cost: 110, col: '#b080e8', range: [2.8, 3.1, 3.4], dmg: [11, 18, 28], rate: [1.1, 1.0, 0.85], chain: [3, 4, 5], up: [90, 150] },
  ];
  // ---------- Quái ----------
  const EN: Record<string, any> = {
    grunt: { hp: 30, sp: 52, rw: 4, ar: 0, r: 11, col: '#8bc34a' },
    runner: { hp: 18, sp: 100, rw: 4, ar: 0, r: 9, col: '#f2c14e' },
    tank: { hp: 120, sp: 34, rw: 10, ar: 2, r: 15, col: '#8e5a9b' },
    armored: { hp: 70, sp: 44, rw: 8, ar: 7, r: 12, col: '#8a96a3' },
    flyer: { hp: 40, sp: 62, rw: 6, ar: 0, r: 10, col: '#e56b6f', fly: true },
    boss: { hp: 700, sp: 28, rw: 80, ar: 4, r: 22, col: '#c0392b' },
  };

  // ---------- Trạng thái ----------
  let mapIdx = 0;
  let path: { x: number; y: number }[] = [];
  let cum: number[] = [];
  let pathLen = 0;
  let grid: number[][] = []; // 0 cỏ, 1 đường, 2 có tháp, 3 đá
  let towers: any[] = [], enemies: any[] = [], projs: any[] = [], parts: any[] = [], bolts: any[] = [], floats: any[] = [];
  let gold = 0, lives = 0, wave = 0;
  let waveOn = false, queue: { t: number; type: string }[] = [], waveT = 0, waveHp = 1;
  let speed = 1, over = '', running = false, time = 0;
  let selType = -1, selTower: any = null;
  let hover = { c: -1, r: -1 };
  let msgT = 0;
  let banner: { txt: string; sub: string; t: number; max: number; boss: boolean } | null = null;
  let shake = 0;
  let torches: { x: number; y: number; ph: number }[] = [];
  const motes = Array.from({ length: 18 }, (_, i) => ({ x: (i * 97) % 864, y: (i * 53) % 540, vx: 4 + (i % 5) * 2, vy: -2 - (i % 3), s: 1 + (i % 3) * 0.5, ph: i * 1.7 }));
  mountMute(document.querySelector('.td-stage') as HTMLElement);
  // phát âm có giới hạn tần suất để không bị dồn tiếng
  const sndT: Record<string, number> = {};
  function snd(name: string, gap = 0.05) { const n = performance.now(); if (n - (sndT[name] || 0) < gap * 1000) return; sndT[name] = n; sfx.play(name); }
  function sndTone(key: string, gap: number, f: number, dur: number, type: OscillatorType, vol: number, f2?: number) { const n = performance.now(); if (n - (sndT[key] || 0) < gap * 1000) return; sndT[key] = n; sfx.tone(f, dur, type, vol, f2); }
  let best: Record<string, number> = {};
  try { const s = JSON.parse(localStorage.getItem('td-best') || 'null'); if (s) best = s; } catch {}

  function setupMap(i: number) {
    mapIdx = i;
    const m = MAPS[i];
    path = m.wp.map(([c, r]) => ({ x: c * CELL + CELL / 2, y: r * CELL + CELL / 2 }));
    cum = [0];
    for (let k = 1; k < path.length; k++) cum.push(cum[k - 1] + Math.hypot(path[k].x - path[k - 1].x, path[k].y - path[k - 1].y));
    pathLen = cum[cum.length - 1];
    grid = Array.from({ length: ROWS }, () => new Array(COLS).fill(0));
    for (let k = 1; k < m.wp.length; k++) {
      const [c0, r0] = m.wp[k - 1], [c1, r1] = m.wp[k];
      for (let c = Math.min(c0, c1); c <= Math.max(c0, c1); c++) for (let r = Math.min(r0, r1); r <= Math.max(r0, r1); r++) if (c >= 0 && c < COLS && r >= 0 && r < ROWS) grid[r][c] = 1;
    }
    for (const [c, r] of m.rocks) if (grid[r][c] === 0) grid[r][c] = 3;
  }

  function posAt(d: number) {
    d = Math.max(0, Math.min(pathLen, d));
    let k = 1;
    while (k < cum.length - 1 && cum[k] < d) k++;
    const t = (d - cum[k - 1]) / (cum[k] - cum[k - 1] || 1);
    return { x: path[k - 1].x + (path[k].x - path[k - 1].x) * t, y: path[k - 1].y + (path[k].y - path[k - 1].y) * t };
  }

  // ---------- Đạo diễn đợt quái ----------
  function waveGroups(n: number): [string, number, number][] {
    const gs: [string, number, number][] = [];
    gs.push(['grunt', Math.round(5 + n * 1.4), 0.9]);
    if (n >= 3) gs.push(['runner', Math.round(3 + n * 0.8), 0.55]);
    if (n >= 5 && n % 5 !== 0) gs.push(['tank', Math.round(1 + n * 0.3), 2.0]);
    if (n >= 7) gs.push(['armored', Math.round(2 + (n - 7) * 0.5), 1.3]);
    if (n >= 6) gs.push(['flyer', Math.round(2 + (n - 6) * 0.5), 1.1]);
    if (n % 5 === 0) gs.push(['boss', n === 20 ? 2 : 1, 5]);
    return gs;
  }
  function buildQueue(n: number) {
    const q: { t: number; type: string }[] = [];
    let cur = 0.5;
    for (const [type, cnt, gap] of waveGroups(n)) {
      for (let i = 0; i < cnt; i++) q.push({ t: cur + i * gap, type });
      cur += cnt * gap + 1.5;
    }
    q.sort((a, b) => a.t - b.t);
    return q;
  }

  // ---------- Điều khiển ván ----------
  function reset(i: number) {
    setupMap(i);
    towers = []; enemies = []; projs = []; parts = []; bolts = []; floats = [];
    gold = 160; lives = 20; wave = 0; waveOn = false; queue = []; speed = 1; over = ''; selType = -1; selTower = null; time = 0;
    banner = null; shake = 0;
    if (running) sfx.music('calm');
    ($('td-over')).hidden = true;
    setSpeedLabel();
    refreshUI();
  }
  function say(t: string) { ($('td-msg')).textContent = t; msgT = 2.2; }
  function startWave() {
    if (waveOn || over || !running) return;
    wave++;
    waveOn = true; waveT = 0; queue = buildQueue(wave);
    waveHp = 1 + (wave - 1) * 0.18 + (wave - 1) * (wave - 1) * 0.008;
    if (wave % 5 === 0) say(ui.bossWave);
    banner = { txt: `${ui.wave} ${wave}`, sub: '', t: 1.5, max: 1.5, boss: false };
    sfx.play('wave'); sfx.music('tense');
    refreshUI();
  }
  function spawn(type: string) {
    const d = EN[type];
    const hp = d.hp * waveHp * (type === 'boss' ? 1 + wave / 40 : 1);
    const e: any = { type, hp, max: hp, sp: d.sp, rw: d.rw, ar: d.ar, r: d.r, col: d.col, fly: !!d.fly, d: 0, x: path[0].x, y: path[0].y, slowT: 0, slowF: 1, anim: Math.random() * 6, prog: 0 };
    enemies.push(e);
    if (type === 'boss') {
      banner = { txt: '⚠ ' + ui.enemies.boss.toUpperCase(), sub: ui.bossWave, t: 2.2, max: 2.2, boss: true };
      shake = 0.6; sfx.play('boom'); sfx.tone(70, 0.9, 'sawtooth', 0.22, 40);
    }
  }
  function finish(win: boolean) {
    over = win ? 'win' : 'lose';
    sfx.music(null); sfx.play(win ? 'win' : 'lose');
    const reached = win ? WAVES : wave;
    const key = String(mapIdx);
    let nb = false;
    if (!best[key] || reached > best[key]) { best[key] = reached; nb = true; try { localStorage.setItem('td-best', JSON.stringify(best)); } catch {} }
    $('td-over-msg').textContent = win ? ui.win : ui.lose;
    $('td-over-sum').textContent = (win ? ui.clearedAll : fmt(ui.reachedTpl, reached)) + (nb ? '  ' + ui.newBest : '');
    ($('td-over')).hidden = false;
    refreshUI();
  }

  // ---------- Cập nhật ----------
  function towerStats(t: any) {
    const d: any = TW[t.type], l = t.lvl;
    return { range: d.range[l] * CELL, dmg: d.dmg[l], rate: d.rate[l], splash: d.splash ? d.splash[l] : 0, slow: d.slow ? d.slow[l] : 1, chain: d.chain ? d.chain[l] : 0 };
  }
  function hit(e: any, dmg: number, pierce = false) {
    if (e.hp <= 0) return;
    const eff = pierce ? dmg : Math.max(dmg * 0.25, dmg - e.ar);
    e.hp -= eff;
    e.flash = 0.08;
    if (e.hp <= 0) {
      gold += e.rw;
      floats.push({ x: e.x, y: e.y - e.r, t: 1.0, max: 1.0, txt: '+' + e.rw, coin: true, big: e.type === 'boss' });
      for (let i = 0; i < 8; i++) parts.push({ x: e.x, y: e.y, vx: (Math.random() - 0.5) * 140, vy: (Math.random() - 0.5) * 140, life: 0.5, max: 0.5, col: e.col, s: 3 });
      parts.push({ glow: true, x: e.x, y: e.y, vx: 0, vy: 0, life: 0.25, max: 0.25, col: '#fff', s: e.r * 2 });
      for (let i = 0; i < 3; i++) parts.push({ spark: true, x: e.x, y: e.y, vx: (Math.random() - 0.5) * 90, vy: -30 - Math.random() * 60, life: 0.6, max: 0.6, col: '#ffe27a', s: 4 });
      if (e.type === 'boss') { shake = Math.max(shake, 0.5); sfx.play('explode'); for (let i = 0; i < 4; i++) parts.push({ ring: true, x: e.x + (Math.random() - 0.5) * 30, y: e.y + (Math.random() - 0.5) * 30, life: 0.5 + i * 0.1, max: 0.5 + i * 0.1, col: '#ffb347', s: 30 + i * 14 }); }
      else snd('pop', 0.045);
    } else snd('hit', 0.07);
  }
  function boom(x: number, y: number, rad: number, dmg: number, col: string) {
    for (const e of enemies) if (e.hp > 0 && Math.hypot(e.x - x, e.y - y) <= rad + e.r) hit(e, dmg);
    parts.push({ ring: true, x, y, life: 0.3, max: 0.3, col, s: rad });
    parts.push({ ring: true, x, y, life: 0.45, max: 0.45, col: 'rgba(255,255,255,.7)', s: rad * 1.2 });
    parts.push({ glow: true, x, y, vx: 0, vy: 0, life: 0.28, max: 0.28, col, s: rad * 1.4 });
    for (let i = 0; i < 10; i++) { const a = Math.random() * TAU; parts.push({ x, y, vx: Math.cos(a) * 90, vy: Math.sin(a) * 90, life: 0.4, max: 0.4, col, s: 3 }); }
    for (let i = 0; i < 5; i++) { const a = Math.random() * TAU; parts.push({ glow: true, x, y, vx: Math.cos(a) * 30, vy: Math.sin(a) * 30 - 10, life: 0.7, max: 0.7, col: 'rgba(60,50,45,.5)', s: 14 + Math.random() * 8, smoke: true }); }
    snd('boom', 0.06);
  }

  function update(dt: number) {
    time += dt;
    if (msgT > 0) { msgT -= dt; if (msgT <= 0) ($('td-msg')).textContent = ''; }
    if (over) { stepFx(dt); return; }

    if (waveOn) {
      waveT += dt;
      while (queue.length && queue[0].t <= waveT) spawn(queue.shift()!.type);
    }
    // quái
    for (const e of enemies) {
      if (e.hp <= 0) continue;
      if (e.slowT > 0) { e.slowT -= dt; if (e.slowT <= 0) e.slowF = 1; }
