  function draw() {
    if (!bg) paintBg();
    g.save();
    if (shake > 0) g.translate((Math.random() - 0.5) * shake * 12, (Math.random() - 0.5) * shake * 12);
    g.drawImage(bg!, 0, 0);
    // đuốc cháy và hạt bụi bay
    for (const tc of torches) {
      const fl = 1 + Math.sin(time * 11 + tc.ph) * 0.18 + Math.sin(time * 17 + tc.ph * 2) * 0.1;
      const gl = g.createRadialGradient(tc.x, tc.y - 14, 0, tc.x, tc.y - 14, 26); gl.addColorStop(0, 'rgba(255,190,80,.38)'); gl.addColorStop(1, 'rgba(255,150,40,0)');
      g.fillStyle = gl; g.beginPath(); g.arc(tc.x, tc.y - 14, 26 * fl, 0, TAU); g.fill();
      g.fillStyle = '#ff8c1a'; g.beginPath(); g.ellipse(tc.x, tc.y - 17, 3.2 * fl, 5.5 * fl, 0, 0, TAU); g.fill();
      g.fillStyle = '#ffd95e'; g.beginPath(); g.ellipse(tc.x, tc.y - 16, 1.8 * fl, 3.4 * fl, 0, 0, TAU); g.fill();
    }
    g.fillStyle = mapIdx === 1 ? 'rgba(255,235,190,.5)' : 'rgba(255,255,200,.55)';
    for (const m of motes) {
      const mx = ((m.x + time * m.vx) % W + W) % W, my = ((m.y + time * m.vy + Math.sin(time + m.ph) * 8) % H + H) % H;
      g.globalAlpha = 0.25 + 0.25 * Math.sin(time * 1.5 + m.ph); g.beginPath(); g.arc(mx, my, m.s, 0, TAU); g.fill();
    }
    g.globalAlpha = 1;
    // xem trước ô
    const canBuild = hover.c >= 0 && grid[hover.r]?.[hover.c] === 0;
    if (hover.c >= 0 && hover.r >= 0 && hover.c < COLS && hover.r < ROWS) {
      const hx = hover.c * CELL + CELL / 2, hy = hover.r * CELL + CELL / 2;
      if (selType >= 0) {
        const ok = canBuild && gold >= TW[selType].cost;
        g.fillStyle = ok ? 'rgba(120,255,140,.22)' : 'rgba(255,90,90,.25)'; g.fillRect(hover.c * CELL, hover.r * CELL, CELL, CELL);
        g.strokeStyle = ok ? 'rgba(255,255,255,.7)' : 'rgba(255,120,120,.7)'; g.lineWidth = 2;
        g.beginPath(); g.arc(hx, hy, TW[selType].range[0] * CELL, 0, TAU); g.stroke();
        g.fillStyle = 'rgba(255,255,255,.08)'; g.fill();
        g.globalAlpha = 0.7; drawTower(g, selType, 0, hx, hy, -Math.PI / 4, time); g.globalAlpha = 1;
      } else if (canBuild) { g.fillStyle = 'rgba(255,255,255,.1)'; g.fillRect(hover.c * CELL, hover.r * CELL, CELL, CELL); }
    }
    // tháp
    for (const t of towers) {
      if (t === selTower) {
        const s = towerStats(t);
        g.fillStyle = 'rgba(255,255,255,.1)'; g.strokeStyle = 'rgba(255,255,255,.75)'; g.lineWidth = 2;
        g.beginPath(); g.arc(t.x, t.y, s.range, 0, TAU); g.fill(); g.stroke();
      }
    }
    // quái dưới (mặt đất) rồi tháp rồi quái bay
    const ground = enemies.filter((e) => !e.fly).sort((a, b) => a.y - b.y);
    for (const e of ground) drawEnemy(e);
    for (const t of towers) drawTower(g, t.type, t.lvl, t.x, t.y, t.ang, time, t.recoil > 0 ? t.recoil : 0, 1, t.flash > 0 ? t.flash : 0);
    for (const e of enemies) if (e.fly) drawEnemy(e);
    // đạn có vệt đuôi
    for (const p of projs) {
      if (p.trail && p.trail.length > 1) {
        const col = p.k === 'arrow' ? '255,240,190' : p.k === 'ball' ? '255,170,70' : '170,230,255';
        for (let i = 1; i < p.trail.length; i++) {
          const a = i / p.trail.length;
          g.strokeStyle = `rgba(${col},${a * 0.55})`; g.lineWidth = (p.k === 'arrow' ? 1.5 : 5) * a + 0.5; g.lineCap = 'round';
          g.beginPath(); g.moveTo(p.trail[i - 1].x, p.trail[i - 1].y); g.lineTo(p.trail[i].x, p.trail[i].y); g.stroke();
        }
      }
      g.save(); g.translate(p.x, p.y); g.rotate(p.ang || 0);
      if (p.k === 'arrow') { g.strokeStyle = '#f5e6b3'; g.lineWidth = 2.5; g.beginPath(); g.moveTo(-9, 0); g.lineTo(6, 0); g.stroke(); g.fillStyle = '#ddd'; g.beginPath(); g.moveTo(10, 0); g.lineTo(5, -3); g.lineTo(5, 3); g.fill(); g.fillStyle = '#c0392b'; g.fillRect(-10, -2, 3, 1.5); g.fillRect(-10, 0.5, 3, 1.5); }
      else if (p.k === 'ball') { flashAt(g, 0, 0, 12, 'rgba(255,170,60,.5)', 0.6); g.fillStyle = '#222'; g.beginPath(); g.arc(0, 0, 6, 0, TAU); g.fill(); g.fillStyle = 'rgba(255,255,255,.4)'; g.beginPath(); g.arc(-2, -2, 2, 0, TAU); g.fill(); g.fillStyle = '#ffb347'; g.beginPath(); g.arc(-5, 0, 3, 0, TAU); g.fill(); }
      else { flashAt(g, 0, 0, 13, 'rgba(150,225,255,.55)', 0.8); g.fillStyle = '#aeeaff'; g.beginPath(); g.moveTo(7, 0); g.lineTo(0, -5); g.lineTo(-6, 0); g.lineTo(0, 5); g.closePath(); g.fill(); g.fillStyle = '#fff'; g.beginPath(); g.arc(-1, -1, 2, 0, TAU); g.fill(); }
      g.restore();
    }
    // sét: ba lớp (quầng sáng, lõi màu, lõi trắng)
    for (const b of bolts) {
      const a = b.life / b.max;
      g.lineCap = 'round'; g.lineJoin = 'round';
      const pl = () => { g.beginPath(); b.jag.forEach((p: any, i: number) => (i ? g.lineTo(p.x, p.y) : g.moveTo(p.x, p.y))); };
      g.globalCompositeOperation = 'lighter';
      g.strokeStyle = `rgba(150,90,255,${a * 0.35})`; g.lineWidth = 11; pl(); g.stroke();
      g.strokeStyle = `rgba(190,140,255,${a * 0.7})`; g.lineWidth = 5; pl(); g.stroke();
      g.globalCompositeOperation = 'source-over';
      g.strokeStyle = `rgba(255,255,255,${a})`; g.lineWidth = 1.8; pl(); g.stroke();
    }
    // hạt: vòng, quầng sáng, tia lấp lánh, mảnh vuông
    for (const p of parts) {
      const a = p.life / p.max;
      if (p.ring) { g.strokeStyle = p.col; g.globalAlpha = a; g.lineWidth = 3; g.beginPath(); g.arc(p.x, p.y, p.s * (1 - a * 0.7), 0, TAU); g.stroke(); g.globalAlpha = 1; }
      else if (p.glow) {
        const rad = p.s * (p.smoke ? 0.6 + (1 - a) * 0.9 : 0.5 + (1 - a) * 0.7);
        const gr = g.createRadialGradient(p.x, p.y, 0, p.x, p.y, rad); gr.addColorStop(0, p.col); gr.addColorStop(1, 'rgba(255,255,255,0)');
        g.globalAlpha = a * (p.smoke ? 0.8 : 0.9); g.fillStyle = gr; g.beginPath(); g.arc(p.x, p.y, rad, 0, TAU); g.fill(); g.globalAlpha = 1;
      } else if (p.spark) {
        g.globalAlpha = a; g.fillStyle = p.col; const s = p.s * (0.6 + a * 0.6);
        g.beginPath(); g.moveTo(p.x, p.y - s); g.lineTo(p.x + s * 0.4, p.y); g.lineTo(p.x, p.y + s); g.lineTo(p.x - s * 0.4, p.y); g.closePath(); g.fill();
        g.beginPath(); g.moveTo(p.x - s, p.y); g.lineTo(p.x, p.y + s * 0.4); g.lineTo(p.x + s, p.y); g.lineTo(p.x, p.y - s * 0.4); g.closePath(); g.fill(); g.globalAlpha = 1;
      } else { g.fillStyle = p.col; g.globalAlpha = a; g.fillRect(p.x - p.s / 2, p.y - p.s / 2, p.s, p.s); g.globalAlpha = 1; }
    }
    // chữ nổi: vàng thưởng có đồng xu, nảy lên khi mới xuất hiện
    for (const f of floats) {
      const k = f.max ? f.t / f.max : 1, pop = 1 + Math.max(0, (k - 0.8) * 3);
      g.save(); g.translate(f.x, f.y); g.scale(pop, pop);
      g.font = `bold ${f.big ? 20 : 13}px system-ui, sans-serif`; g.textAlign = 'center';
      g.globalAlpha = Math.min(1, f.t * 2);
      const tw = g.measureText(f.txt).width, off = f.coin ? 7 : 0;
      g.strokeStyle = 'rgba(0,0,0,.65)'; g.lineWidth = 3; g.strokeText(f.txt, off, 0);
      g.fillStyle = '#ffe27a'; g.fillText(f.txt, off, 0);
      if (f.coin) { const cx = -tw / 2 + off - 8, cr = f.big ? 7 : 5; g.fillStyle = '#f1c40f'; g.strokeStyle = '#a77d00'; g.lineWidth = 1.5; g.beginPath(); g.arc(cx, -cr * 0.6, cr, 0, TAU); g.fill(); g.stroke(); g.fillStyle = '#fff1a8'; g.beginPath(); g.arc(cx - cr * 0.25, -cr * 0.85, cr * 0.3, 0, TAU); g.fill(); }
      g.restore();
    }
    g.globalAlpha = 1;
    g.restore();
    // biển báo đợt quái và trùm trượt vào giữa màn hình
    if (banner) {
      const p = 1 - banner.t / banner.max, k = Math.min(1, p / 0.16, (1 - p) / 0.16), e2 = k * k * (3 - 2 * k);
      const hh = (banner.boss ? 86 : 56) * e2, cy = H * 0.36;
      g.save();
      const bgc = g.createLinearGradient(0, cy - hh / 2, 0, cy + hh / 2);
      if (banner.boss) { bgc.addColorStop(0, 'rgba(120,10,10,.0)'); bgc.addColorStop(0.2, 'rgba(120,10,10,.82)'); bgc.addColorStop(0.8, 'rgba(120,10,10,.82)'); bgc.addColorStop(1, 'rgba(120,10,10,0)'); }
      else { bgc.addColorStop(0, 'rgba(10,20,40,0)'); bgc.addColorStop(0.25, 'rgba(10,20,40,.72)'); bgc.addColorStop(0.75, 'rgba(10,20,40,.72)'); bgc.addColorStop(1, 'rgba(10,20,40,0)'); }
      g.fillStyle = bgc; g.fillRect(0, cy - hh / 2, W, hh);
      g.globalAlpha = e2; g.textAlign = 'center'; g.textBaseline = 'middle';
      const slide = (1 - e2) * 120;
      g.font = `800 ${banner.boss ? 38 : 28}px system-ui, sans-serif`; g.lineWidth = 5; g.strokeStyle = 'rgba(0,0,0,.6)';
      g.strokeText(banner.txt, W / 2 + slide, cy - (banner.sub ? 10 : 0)); g.fillStyle = banner.boss ? '#ffd6c9' : '#e8f4ff'; g.fillText(banner.txt, W / 2 + slide, cy - (banner.sub ? 10 : 0));
      if (banner.sub) { g.font = '600 16px system-ui, sans-serif'; g.fillStyle = '#ffb4a2'; g.fillText(banner.sub, W / 2 - slide, cy + 22); }
      g.restore();
    }
  }

  // ---------- Giao diện DOM ----------
  const elGold = $('td-gold'), elLives = $('td-lives'), elWave = $('td-wave'), elGo = $('td-go'), elInfo = $('td-info');
  function costOf(i: number) { return TW[i].cost; }
  function refreshUI() {
    elGold.textContent = String(Math.floor(gold)); elLives.textContent = String(lives); elWave.textContent = String(wave);
    (document.getElementById('td-prog') as HTMLElement).style.width = Math.min(100, (wave / WAVES) * 100) + '%';
    document.querySelectorAll<HTMLElement>('.td-tw').forEach((b) => {
      const i = +b.dataset.tw!;
      b.classList.toggle('sel', selType === i);
      b.classList.toggle('poor', gold < costOf(i));
      (b.querySelector('.td-tw-c') as HTMLElement).textContent = '🪙 ' + costOf(i);
    });
    (elGo as HTMLButtonElement).disabled = waveOn || !!over;
    elGo.textContent = waveOn ? ui.running : (wave >= WAVES ? ui.startWave : ui.nextWaveTpl.replace('0', String(wave + 1)));
    renderInfo();
  }
  let lastInfoKey = '';
  function renderInfo() {
    let html = '';
    if (selTower) {
      const t = selTower, d: any = TW[t.type], s = towerStats(t), nm = ui.towers[t.type].name;
      const eff = d.id === 'cannon' ? ui.splash.replace('0', String(Math.round(s.splash))) : d.id === 'frost' ? ui.slow.replace('0', String(Math.round((1 - s.slow) * 100))) : d.id === 'bolt' ? ui.chain.replace('0', String(s.chain)) : '';
      const maxed = t.lvl >= 2;
      const upc = maxed ? 0 : d.up[t.lvl];
      html = `<b>${nm}</b> · ${ui.level} ${t.lvl + 1}/3 · ${ui.dmg} ${s.dmg} · ${ui.range} ${(s.range / CELL).toFixed(1)} · ${ui.rate} ${(1 / s.rate).toFixed(1)}/s${eff ? ' · ' + eff : ''}
        <span class="td-btns"><button type="button" class="btn sm" data-act="up" ${maxed || gold < upc ? 'disabled' : ''}>${maxed ? ui.maxed : ui.upgrade + ' 🪙' + upc}</button>
        <button type="button" class="btn ghost sm" data-act="sell" title="${ui.sellTip}">${ui.sell} +${Math.floor(t.spent * 0.7)}</button></span>`;
    } else if (selType >= 0) {
      const d: any = TW[selType];
      html = `<b>${ui.towers[selType].name}</b> · 🪙${d.cost} · ${ui.towers[selType].desc}`;
    } else html = '&nbsp;';
    const key = html;
    if (key !== lastInfoKey) { elInfo.innerHTML = html; lastInfoKey = key; }
  }
  elInfo.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button[data-act]') as HTMLElement | null;
    if (!b || !selTower || over) return;
    if (b.dataset.act === 'up') upgrade(selTower);
    else sell(selTower);
  });
  function upgrade(t: any) {
    if (t.lvl >= 2) return;
    const c = (TW[t.type] as any).up[t.lvl];
    if (gold < c) { say(ui.needGold); sfx.play('error'); return; }
    gold -= c; t.spent += c; t.lvl++;
    parts.push({ ring: true, x: t.x, y: t.y, life: 0.4, max: 0.4, col: '#ffe27a', s: 34 });
    parts.push({ glow: true, x: t.x, y: t.y, vx: 0, vy: 0, life: 0.4, max: 0.4, col: '#ffe27a', s: 40 });
    for (let i = 0; i < 6; i++) parts.push({ spark: true, x: t.x + (Math.random() - 0.5) * 30, y: t.y + (Math.random() - 0.5) * 20, vx: 0, vy: -40 - Math.random() * 30, life: 0.7, max: 0.7, col: '#ffe27a', s: 5 });
    sfx.play('levelup');
    refreshUI();
  }
  function sell(t: any) {
    gold += Math.floor(t.spent * 0.7);
    grid[t.r][t.c] = 0; towers = towers.filter((x) => x !== t); selTower = null;
    parts.push({ ring: true, x: t.x, y: t.y, life: 0.3, max: 0.3, col: '#fff', s: 28 });
    floats.push({ x: t.x, y: t.y - 10, t: 0.9, max: 0.9, txt: '+' + Math.floor(t.spent * 0.7), coin: true });
    sfx.play('sell');
    refreshUI();
  }
  function build(type: number, c: number, r: number) {
    if (grid[r]?.[c] !== 0) { say(ui.cantBuild); sfx.play('error'); return false; }
    const cost = TW[type].cost;
    if (gold < cost) { say(ui.needGold); sfx.play('error'); return false; }
    gold -= cost; grid[r][c] = 2;
    const t = { type, c, r, x: c * CELL + CELL / 2, y: r * CELL + CELL / 2, lvl: 0, cd: 0.3, ang: -Math.PI / 4, spent: cost, tgt: null, recoil: 0 };
    towers.push(t);
    parts.push({ ring: true, x: t.x, y: t.y, life: 0.3, max: 0.3, col: '#fff', s: 30 });
    for (let i = 0; i < 8; i++) { const a = Math.random() * TAU; parts.push({ x: t.x, y: t.y + 12, vx: Math.cos(a) * 60, vy: Math.sin(a) * 25 - 10, life: 0.4, max: 0.4, col: 'rgba(210,190,150,.9)', s: 4 }); }
    sfx.play('build');
    refreshUI();
    return t;
  }

  document.querySelectorAll<HTMLElement>('.td-tw').forEach((b) => {
    const i = +b.dataset.tw!;
    const cv = b.querySelector('canvas') as HTMLCanvasElement, cc = cv.getContext('2d')!;
    drawTower(cc, i, 0, 22, 20, -Math.PI / 4, 0, 0, 0.8);
    b.addEventListener('click', () => { selType = selType === i ? -1 : i; selTower = null; sfx.play('select'); refreshUI(); });
  });

  function cellFromEvent(ev: PointerEvent) {
    const rc = canvas.getBoundingClientRect();
    const x = (ev.clientX - rc.left) * (W / rc.width), y = (ev.clientY - rc.top) * (H / rc.height);
    return { c: Math.floor(x / CELL), r: Math.floor(y / CELL) };
  }
  canvas.addEventListener('pointermove', (ev) => { const p = cellFromEvent(ev); hover = p; });
  canvas.addEventListener('pointerleave', () => { hover = { c: -1, r: -1 }; });
  canvas.addEventListener('contextmenu', (ev) => { ev.preventDefault(); selType = -1; selTower = null; refreshUI(); });
  canvas.addEventListener('pointerdown', (ev) => {
    if (!running || over) return;
    const p = cellFromEvent(ev); hover = p;
    if (p.c < 0 || p.r < 0 || p.c >= COLS || p.r >= ROWS) return;
    const t = towers.find((x) => x.c === p.c && x.r === p.r);
    if (t) { selTower = t; selType = -1; sfx.play('click'); refreshUI(); return; }
    if (selType >= 0) { build(selType, p.c, p.r); return; }
    selTower = null; refreshUI();
  });
  canvas.style.touchAction = 'manipulation';

  $('td-go').addEventListener('click', startWave);
  $('td-speed').addEventListener('click', () => { speed = speed === 1 ? 2 : 1; setSpeedLabel(); sfx.play('click'); });
  function setSpeedLabel() { const b = $('td-speed'); b.textContent = (b.dataset.base || '') + ' ×' + speed; }
  $('td-speed').dataset.base = ($('td-speed').textContent || '').replace(/\s*×\d+\s*$/, '');
  $('td-again').addEventListener('click', () => { sfx.play('click'); reset(mapIdx); });
  function toMenu() { running = false; sfx.music(null); sfx.play('click'); gameEl.hidden = true; menu.hidden = false; paintStat(); drawMenuMaps(); }
  $('td-change').addEventListener('click', toMenu);
  $('td-menu-btn').addEventListener('click', toMenu);
  window.addEventListener('keydown', (ev) => {
    if (!running) return;
    if (ev.key >= '1' && ev.key <= '4') { selType = +ev.key - 1; selTower = null; refreshUI(); }
    else if (ev.key === 'Escape') { selType = -1; selTower = null; refreshUI(); }
    else if (ev.key === ' ') { ev.preventDefault(); startWave(); }
  });

  // ---------- Menu ----------
  const paintStat = () => {
    const parts = Object.keys(best).map((k) => `${(document.querySelectorAll('.td-map b')[+k] as HTMLElement)?.textContent}: ${best[k]}/${WAVES}`);
    $('td-stat').textContent = parts.length ? `${ui.best}: ${parts.join(' · ')}` : '';
  };
  function drawMenuMaps() {
    document.querySelectorAll<HTMLElement>('.td-map').forEach((b, i) => {
      const cv = b.querySelector('canvas') as HTMLCanvasElement, c = cv.getContext('2d')!, m = MAPS[i], s = cv.width / COLS;
      for (let r = 0; r < ROWS; r++) for (let q = 0; q < COLS; q++) { c.fillStyle = (r + q) % 2 ? m.g1 : m.g2; c.fillRect(q * s, r * s, s + 1, s + 1); }
      c.strokeStyle = m.road; c.lineWidth = s * 0.7; c.lineJoin = 'round'; c.lineCap = 'round'; c.beginPath();
      m.wp.forEach(([x, y], k) => { const px = (x + 0.5) * s, py = (y + 0.5) * s; k ? c.lineTo(px, py) : c.moveTo(px, py); }); c.stroke();
    });
  }
  let pickMap = 0;
  document.querySelectorAll<HTMLElement>('.td-map').forEach((b) => b.addEventListener('click', () => {
    pickMap = +b.dataset.map!;
    document.querySelectorAll('.td-map').forEach((x) => x.classList.toggle('sel', x === b));
  }));
  $('td-start').addEventListener('click', () => {
    menu.hidden = true; gameEl.hidden = false; running = true; bg = null;
    sfx.play('click');
    reset(pickMap); speed = 1; setSpeedLabel();
    last = performance.now();
  });
  drawMenuMaps(); paintStat();

  // ---------- Vòng lặp ----------
  let last = performance.now(), acc = 0;
  function frame(now: number) {
    requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    if (!running) return;
    if (!bg) paintBg();
    acc += dt * speed;
    let n = 0;
    while (acc > 0 && n < 8) { const s = Math.min(acc, 1 / 60); update(s); acc -= s; n++; }
    if (acc > 0.2) acc = 0;
    draw();
    refreshHud();
  }
  let hudT = 0;
  function refreshHud() {
    elGold.textContent = String(Math.floor(gold)); elLives.textContent = String(lives); elWave.textContent = String(wave);
    if (++hudT % 10 === 0) refreshUI();
  }
  requestAnimationFrame(frame);

  // ---------- Debug (chỉ khi URL có #debug) ----------
  if (location.hash.includes('debug')) {
    (window as any).__td = {
      start: (m = 0) => { pickMap = m; ($('td-start') as HTMLElement).click(); },
      build: (type: number, c: number, r: number) => build(type, c, r),
      upgrade: (i: number) => { const t = towers[i]; if (t) upgrade(t); },
      select: (i: number) => { selTower = towers[i] || null; selType = -1; refreshUI(); },
      wave: () => startWave(),
      step: (sec: number) => { const n = Math.round(sec * 60); for (let i = 0; i < n; i++) update(1 / 60); },
      setSpeed: (s: number) => { speed = s; },
      give: (n: number) => { gold += n; refreshUI(); },
      get: () => ({ gold, lives, wave, over, waveOn, enemies: enemies.length, towers: towers.length }),
      grid: () => grid.map((r) => r.join('')).join('|'),
      free: () => { const o: number[][] = []; for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) if (grid[r][c] === 0) o.push([c, r]); return o; },
      pathLen: () => pathLen,
    };
  }
</script>

<style is:global>
  #tower .td-maps { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin: 8px 0 14px; }
  #tower .td-map { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; padding: 10px; height: auto; }
  #tower .td-map canvas { width: 100%; max-width: 200px; height: auto; border-radius: 8px; }
  #tower .td-map small { color: var(--muted); font-weight: 400; }
  #tower .td-hud { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 10px 0; }
  #tower .td-hud { width: min(100%, 864px); margin: 10px auto; }
  #tower .td-pill { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(180deg, var(--card), color-mix(in srgb, var(--card) 80%, #000)); border: 1px solid var(--line); border-radius: 999px; padding: 5px 14px; font-size: .98rem; box-shadow: 0 2px 6px rgba(0, 0, 0, .18); }
  #tower .td-pill b { font-variant-numeric: tabular-nums; min-width: 1.6em; text-align: right; }
  #tower .td-gold { border-color: #c9a227; }
  #tower .td-gold b { color: #e8b923; }
  #tower .td-lives { border-color: #c0504d; }
  #tower .td-lives.hit { animation: td-hurt .45s ease; }
  @keyframes td-hurt { 0% { transform: scale(1); background: #c62828; } 30% { transform: scale(1.18); background: #c62828; } 100% { transform: scale(1); } }
  #tower .td-wavep { position: relative; overflow: hidden; }
  #tower .td-prog { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255, 255, 255, .12); }
  #tower .td-prog i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #4fc3f7, #81d4fa); transition: width .4s ease; }
  #tower .td-msg { color: var(--accent); font-weight: 600; font-size: .92rem; animation: td-msg .25s ease; }
  @keyframes td-msg { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  #tower .td-stage { position: relative; width: min(100%, 864px); margin: 0 auto; border-radius: 14px; box-shadow: 0 10px 30px rgba(0, 0, 0, .3), 0 0 0 3px rgba(0, 0, 0, .25); }
  #tower #td-canvas { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); background: #3b6b2f; touch-action: manipulation; }
  #tower .td-ov { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: rgba(10, 14, 22, .78); border-radius: 14px; color: #fff; text-align: center; padding: 16px; }
  #tower .td-ov[hidden] { display: none; }
  #tower .td-big { font-size: clamp(1.3rem, 4vw, 2rem); font-weight: 800; }
  #tower .td-sum { margin: 0; color: #dbe3ee; }
  #tower .td-ov .btn.ghost { color: #fff; border-color: rgba(255, 255, 255, .5); }
  #tower .td-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin: 12px 0; }
  #tower .td-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; width: min(100%, 864px); margin: 12px auto 0; }
  #tower .td-tw { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 4px; background: linear-gradient(180deg, var(--card), color-mix(in srgb, var(--card) 85%, #000)); color: var(--fg); border: 2px solid var(--line); border-radius: 12px; cursor: pointer; font: inherit; transition: transform .12s ease, border-color .12s ease, box-shadow .12s ease; box-shadow: 0 2px 6px rgba(0, 0, 0, .15); }
  #tower .td-tw:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 60%, var(--line)); }
  #tower .td-tw:active { transform: translateY(0) scale(.97); }
  #tower .td-tw.sel { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent) inset, 0 0 14px color-mix(in srgb, var(--accent) 45%, transparent); transform: translateY(-2px); }
  #tower .td-tw.poor { opacity: .72; }
  #tower .td-tw.poor .td-tw-c { color: #e57373; }
  #tower .td-tw canvas { width: 44px; height: 44px; }
  #tower .td-tw-n { font-size: .82rem; font-weight: 600; text-align: center; line-height: 1.2; }
  #tower .td-tw-c { font-size: .8rem; color: var(--muted); }
  #tower .td-info { width: min(100%, 864px); margin: 10px auto 0; min-height: 3.2em; font-size: .92rem; line-height: 1.5; background: linear-gradient(180deg, var(--card), color-mix(in srgb, var(--card) 88%, #000)); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 12px; padding: 8px 12px; }
  #tower .td-btns { display: inline-flex; gap: 8px; margin-left: 8px; vertical-align: middle; flex-wrap: wrap; }
  #tower .td-info button:disabled, #tower #td-go:disabled { opacity: .55; cursor: default; }
  @media (max-width: 640px) {
    #tower .td-bar { grid-template-columns: repeat(2, 1fr); }
  }
</style>
