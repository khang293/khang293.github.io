---
import { SITE } from '../config';
import { ui, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const items = SITE.testimonials[lang];
---
{items.length > 0 && (
  <section class="block">
    <div class="block-head"><h2>{t.testimonialsTitle}</h2></div>
    <div class="grid">
      {items.map((x) => (
        <figure class="card static quote">
          <blockquote>{x.quote}</blockquote>
          <figcaption><b>{x.name}</b>{x.role && <small>{x.role}</small>}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
