---
import { lp, ui, type Lang } from '../i18n';
import { slugOf } from '../lib';
interface Props { entry: any; lang: Lang; }
const { entry, lang } = Astro.props;
const d = entry.data;
---
<a class="card" href={lp(lang, `/services/${slugOf(entry.id)}/`)}>
  <div class="ico">{d.icon}</div>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
  <span class="more">{ui[lang].readMore}</span>
</a>
